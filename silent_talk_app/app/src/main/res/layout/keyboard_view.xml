<?xml version="1.0" encoding="utf-8"?>
<!-- Silent Talk 入力メソッド: ダイアログ風の小型キーボードパネル -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/panel"
    android:padding="6dp">

    <!-- ヘッダ: タイトル + 常設センサーバー (赤外線 + 温度計) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/kbSensor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="--"
            android:textColor="@color/cyan"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/kbSignal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:text="無音信号: タッチした文字が他アプリへ入力されます"
        android:textColor="@color/dim"
        android:fontFamily="monospace"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 文字キー -->
    <GridLayout
        android:id="@+id/kbGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="10"
        android:layout_marginTop="2dp" />

    <!-- 機能キー行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button android:id="@+id/kbShift" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1.4"
            android:text="⇧" android:textSize="14sp" android:layout_margin="2dp"/>
        <Button android:id="@+id/kbSpace" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="3"
            android:text="space" android:textAllCaps="false"
            android:textSize="14sp" android:layout_margin="2dp"/>
        <Button android:id="@+id/kbDelete" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1.4"
            android:text="⌫" android:textSize="14sp" android:layout_margin="2dp"/>
        <Button android:id="@+id/kbEnter" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1.6"
            android:text="⏎" android:textSize="14sp" android:layout_margin="2dp"/>
        <Button android:id="@+id/kbHide" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1.2"
            android:text="▾" android:textSize="14sp" android:layout_margin="2dp"/>
    </LinearLayout>
</LinearLayout>
