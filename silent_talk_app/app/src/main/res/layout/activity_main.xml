<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/gold"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle"
            android:textColor="@color/dim"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <!-- 全画面共通: 赤外線センサー + 温度計の常設バー -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/panel2"
            android:padding="12dp">

            <!-- IR -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/sensor_ir" android:textColor="@color/dim" android:textSize="12sp"/>
            <TextView android:id="@+id/valIr" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textColor="@color/gold" android:textSize="20sp" android:textStyle="bold"/>
            <ProgressBar android:id="@+id/barIr" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:max="100"/>

            <!-- Thermometer -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/sensor_thermo" android:textColor="@color/dim"
                android:textSize="12sp" android:layout_marginTop="8dp"/>
            <TextView android:id="@+id/valThermo" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textColor="@color/cyan" android:textSize="20sp" android:textStyle="bold"/>
            <ProgressBar android:id="@+id/barThermo" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:max="100"/>

            <!-- Fused -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/sensor_fused" android:textColor="@color/dim"
                android:textSize="12sp" android:layout_marginTop="8dp"/>
            <TextView android:id="@+id/valFused" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textColor="@color/ok" android:textSize="20sp" android:textStyle="bold"/>
            <ProgressBar android:id="@+id/barFused" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:max="100"/>

            <TextView android:id="@+id/valEnergy" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="T' = --"
                android:textColor="@color/violet" android:textSize="14sp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/inputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_input"
            android:textColor="@color/txt"
            android:textColorHint="@color/dim"
            android:background="@color/panel"
            android:padding="12dp"
            android:minLines="2"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:importantForAutofill="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button android:id="@+id/btnEncode" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/encode" android:textSize="13sp"/>
            <Button android:id="@+id/btnDecode" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/decode" android:textSize="13sp"
                android:layout_marginStart="8dp"/>
            <Button android:id="@+id/btnClear" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/clear" android:textSize="13sp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- サイレント・リスニング (聞き取り開始/停止 + 合言葉コマンド) -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/line" android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/listen_section"
            android:textColor="@color/gold"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/listen_help"
            android:textColor="@color/dim"
            android:textSize="12sp"/>

        <Button android:id="@+id/btnListen" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/listen_start" android:textSize="14sp"/>

        <TextView
            android:id="@+id/listenStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/listen_idle"
            android:textColor="@color/dim"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/listenHeard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/panel"
            android:padding="10dp"
            android:minLines="2"
            android:fontFamily="monospace"
            android:textColor="@color/cyan"
            android:textSize="12sp"
            android:text=""/>

        <!-- 入力メソッド(キーボード)としての有効化 -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/line" android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ime_section"
            android:textColor="@color/gold"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ime_help"
            android:textColor="@color/dim"
            android:textSize="12sp"/>

        <Button android:id="@+id/btnEnableIme" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/ime_enable" android:textSize="13sp"/>

        <Button android:id="@+id/btnPickIme" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="@string/ime_pick" android:textSize="13sp"/>

        <EditText
            android:id="@+id/imeTryField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/ime_try"
            android:textColor="@color/txt"
            android:textColorHint="@color/dim"
            android:background="@color/panel"
            android:padding="12dp"
            android:inputType="text"
            android:importantForAutofill="no"/>

        <TextView
            android:id="@+id/outputPulses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/panel"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textColor="@color/cyan"
            android:textSize="12sp"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/disclaimer"
            android:textColor="@color/dim"
            android:textSize="11sp"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
