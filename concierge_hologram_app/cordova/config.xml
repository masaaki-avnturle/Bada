<?xml version='1.0' encoding='utf-8'?>
<!--
  Cordova config for the Android APK build of まちしおり (Machi-Shiori).
  半透明シースルー・ホログラム案内アプリ。カメラ(風景の透過)・位置・
  端末センサ(方位/傾き)を使います。ワークフローが cordova プロジェクトを
  作成し、この config.xml と ../www を差し込みます。
-->
<widget id="io.github.masaaki_avnturle.machi_shiori" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>Machi-Shiori</name>
  <description>まちしおり — 半透明ホログラム・コンシェルジュ (風景にかざすと案内)</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>

  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />

  <preference name="BackgroundColor" value="0xff04060a" />
  <preference name="Orientation" value="portrait" />
  <preference name="Fullscreen" value="false" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#04060a" />

  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <!-- カメラ(風景透過)・位置(近傍POIの方位/距離) -->
    <config-file target="AndroidManifest.xml" parent="/manifest">
      <uses-permission android:name="android.permission.CAMERA" />
      <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
      <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
      <uses-feature android:name="android.hardware.camera" android:required="false" />
      <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
      <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    </config-file>
  </platform>
</widget>
