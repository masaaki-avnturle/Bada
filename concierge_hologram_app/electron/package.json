{
  "name": "machi-shiori",
  "productName": "Machi-Shiori",
  "version": "1.0.0",
  "description": "まちしおり — ホログラム・コンシェルジュ / see-through holographic AR concierge (Bada)",
  "author": { "name": "Masaaki Yamaguchi", "email": "masaaki.tabu4@gmail.com" },
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.github.masaaki_avnturle.machi_shiori",
    "productName": "Machi-Shiori",
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "Machi-Shiori-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "maintainer": "Masaaki Yamaguchi <masaaki.tabu4@gmail.com>",
      "artifactName": "Machi-Shiori-${version}-${arch}.${ext}"
    }
  }
}
