{
  "name": "bada-audioforge",
  "productName": "BadaAudioForge",
  "version": "1.0.0",
  "description": "Bada AudioForge — a dependency-free waveform audio editor. Loads MP3/WAV/OGG/M4A/FLAC, edits with cut / copy / paste / trim / silence / repeat, applies gain, normalize, fades, reverse, speed, echo, low-pass & high-pass filters, DC offset removal, pan and mono downmix, and exports 16/24-bit PCM or 32-bit float WAV with its own encoder. Single self-contained HTML, fully offline.",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.badaaudioforge",
    "productName": "BadaAudioForge",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaAudioForge-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "BadaAudioForge-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "artifactName": "BadaAudioForge-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
