<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada AudioForge (オーディオエディタ).
     ワークフロー (audioeditor-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = audio_editor/index.html) を差し込みます。
     音声の読み込みはファイル選択、保存は共有シート/ダウンロードで行います。 -->
<widget id="io.github.masaaki_avnturle.badaaudioforge" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BadaAudioForge</name>
  <description>Bada AudioForge — 波形編集ができるオーディオエディタ。MP3/WAV/OGG/M4A/FLAC を読み込み、切り取り・コピー・貼り付け・切り抜き・無音化・繰り返し、音量/ノーマライズ/フェード/逆再生/速度/エコー/フィルタ/DC 除去/パン/モノラル化を適用し、WAV (16/24bit PCM・32bit float) で書き出し。依存ゼロ・単一 HTML・オフライン動作</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
