<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config — エアシャトル・ゴーグル (AirShuttle Goggle) の Android APK 用。
     ワークフロー (airshuttle-app-build.yml) が cordova プロジェクトを生成し、
     この config.xml と ../www (自己完結アプリ = airshuttle_goggle/index.html) を差し込みます。

     ・ハンド認識のためインカメラを使用 (映像は端末内で処理し送信は一切しない)
     ・カメラが無い/許可されない端末でも「ポインタ (タッチ) モード」で同じ操作ができるため
       android.hardware.camera は required="false" -->
<widget id="io.github.masaaki_avnturle.airshuttle" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>AirShuttle Goggle</name>
  <description>エアシャトル・ゴーグル — ゴーグル型 HUD の実写映像を、空中で手をかき分けるだけで巻き戻し・早送りするスクラブ卓。肌色クロマ + 動きエネルギーによるハンド認識、One Euro Filter、編集卓デテント付きシャトル則、フリック跳躍、握ってホールド。カメラ映像は端末内でのみ処理され、外部送信は一切ありません。</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff04060b" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#04060b" />
  <!-- 横持ちでの視聴と縦持ちでの操作の双方を想定 -->
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <preference name="KeepRunning" value="true" />
    <config-file target="AndroidManifest.xml" parent="/manifest">
      <uses-permission android:name="android.permission.CAMERA" />
      <uses-feature android:name="android.hardware.camera" android:required="false" />
      <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    </config-file>
  </platform>
</widget>
