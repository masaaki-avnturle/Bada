<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Ω-Vim (Bada-language editor GUI).
     研究・概念実装. The build workflow creates a Cordova project and drops in this
     config.xml together with ../www (the self-contained editor). -->
<widget id="io.github.masaaki_avnturle.omega_vim" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Omega-Vim</name>
  <description>Ω-Vim — Bada言語のモーダルエディタ (文法チェッカー・パーサー補完・インデント補完・コマ幾何のエラー修正)</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff04060a" />
  <preference name="Orientation" value="default" />
  <preference name="Fullscreen" value="false" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#04060a" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
