{
  "name": "bada-meeting",
  "productName": "BadaMeeting",
  "version": "1.2.0",
  "description": "Bada Meeting — computers hold a planning meeting by exchanging text packets: a producer, a planner and an application engineer agent negotiate scope, estimate and schedule, with multi-line input by keyboard, a Morse telegraph key or pointer dwell and entropy measures for each utterance. Serverless: acoustic FSK telegraph (Bada Telegraph modem) or WebRTC with connection codes. Self-contained offline HTML app.",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.badameeting",
    "productName": "BadaMeeting",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "artifactName": "BadaMeeting-${version}-${arch}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "BadaMeeting-${version}-portable.${ext}" },
    "linux": { "target": ["AppImage", "deb"], "category": "Office", "artifactName": "BadaMeeting-${version}-${arch}.${ext}", "maintainer": "masaaki-avnturle" }
  }
}
