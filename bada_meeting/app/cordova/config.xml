<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada 思念会議 (BadaMeeting).
     ワークフロー (badameeting-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_meeting/index.html) を差し込みます。
     端末間の接続は WebRTC (同じ LAN) で、外部のサーバーは使いません。 -->
<widget id="io.github.masaaki_avnturle.badameeting" version="1.3.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>BadaMeeting</name>
  <description>Bada 思念会議 — コンピュータ同士がテキストのパケットで会議する。企画・プランナー・アプリケーションエンジニアの 3 役が範囲・見積り・日程を話し合い、滞留による思念入力と、発言ごとのエントロピー計測を備える</description>
  <author href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <preference name="BackgroundColor" value="0xff0d1017" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0d1017" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <!-- 音響電信の受信 (マイク) に必要 -->
    <config-file target="AndroidManifest.xml" parent="/manifest">
      <uses-permission android:name="android.permission.RECORD_AUDIO" />
      <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    </config-file>
    <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application/activity">
      <activity android:resizeableActivity="true" android:windowSoftInputMode="adjustResize" />
    </edit-config>
  </platform>
</widget>
