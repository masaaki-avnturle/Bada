{"id": 1404, "para": 637, "sentence": "\\bigoplus \\nabla C^{+}_{-} \\cong M_3, R \\supset Q, R \\cap Q, \n R \\subset M_3, C^{+} \\bigoplus M_n, E^{+} \\cap R^{+}$\n  M^{+}_{-}\\nabla C^{+}_{-}, C^{+}\\nabla H_m, E^{+} \\nabla R^{+}_{-}, E_2 \\nabla E_1 $\n  $ R^{-} \\nabla C^{+}_{-} $.", "math": true, "tokens": ["bigoplus", "nabla", "C", "_", "cong", "M_3", "R", "supset", "Q", "R", "cap", "Q", "R", "subset", "M_3", "C", "bigoplus", "M_n", "E", "cap", "R", "M", "_", "nabla", "C", "_", "C", "nabla", "H_m", "E", "nabla", "R", "_", "E_2", "nabla", "E_1", "R", "nabla", "C", "_"], "entropy": 3.715957320949174}
{"id": 1405, "para": 637, "sentence": "{\\nabla \\over \\Delta} \\int x f(x) dx,\n  {\\nabla R \\over \\Delta f}, \\square = 2{\\int {(R + \\nabla_{i} \\nabla_{j} f)^2\n  \\over -(R + \\Delta f)}}e^{-f}dV   \n     \\square = {\\nabla R \\over \\Delta f}, {d \\over dt}g_{ij} \n     = \\square \\to {\\nabla f \\over \\Delta x}, (R + \n  |\\nabla f|^2)dm \\to -2(R + \\nabla_{i} \\nabla_{j} f)^2 e^{-f}dV   \n     x^n + y^n = z^n \\to \\nabla \\psi^2 = 8 \\pi G T^{\\mu\\nu}, \n     f(x + y) \\ge f(x) \\circ f(y)   \n     \\mathrm{im}f / \\mathrm{ker}f = \\partial f, \\mathrm{ker}f \n     = \\partial f, \\mathrm{ker}f / \\mathrm{im}f \\cong\n  \\partial f, \\mathrm{ker}f = f^{-1}(x)xf(x)   \n     f^{-1}(x)xf(x) = \\int \\partial f(x) d(\\mathrm{kerf}) \\to \\nabla f = 2   \n     _{n}C_{r} = {}_{n}C_{n-r}  \\to \\mathrm{im}f / \\mathrm{ker}f \n     \\cong \\mathrm{ker}f / \\mathrm{im}f", "math": false, "tokens": ["nabla", "over", "Delta", "int", "x", "f", "x", "dx", "nabla", "R", "over", "Delta", "f", "square", "2", "int", "R", "nabla_", "i", "nabla_", "j", "f", "2", "over", "R", "Delta", "f", "e", "f", "dV", "square", "nabla", "R", "over", "Delta", "f", "d", "over", "dt", "g_", "ij", "square", "to", "nabla", "f", "over", "Delta", "x", "R", "nabla", "f", "2", "dm", "to", "2", "R", "nabla_", "i", "nabla_", "j", "f", "2", "e", "f", "dV", "x", "n", "y", "n", "z", "n", "to", "nabla", "psi", "2", "8", "pi", "G", "T", "mu", "nu", "f", "x", "y", "ge", "f", "x", "circ", "f", "y", "mathrm", "im", "f", "mathrm", "ker", "f", "partial", "f", "mathrm", "ker", "f", "partial", "f", "mathrm", "ker", "f", "mathrm", "im", "f", "cong", "partial", "f", "mathrm", "ker", "f", "f", "1", "x", "xf", "x", "f", "1", "x", "xf", "x", "int", "partial", "f", "x", "d", "mathrm", "kerf", "to", "nabla", "f", "2", "_", "n", "C_", "r", "_", "n", "C_", "n", "r", "to", "mathrm", "im", "f", "mathrm", "ker", "f", "cong", "mathrm", "ker", "f", "mathrm", "im", "f"], "entropy": 4.745963295789043}
