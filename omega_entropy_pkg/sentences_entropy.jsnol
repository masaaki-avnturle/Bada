{"id": 1383, "para": 617, "sentence": "\\pi (\\chi,x) = \\int \\mathrm{exp}[L(p,q)]d\\psi \n ds^2 = e^{-2\\pi T|\\phi|}[\\eta + \\bar{h}_{\\mu\\nu}]dx^{\\mu\\nu}dx^{\\mu\\nu} + \n T^2 d^2\\psi", "math": false, "tokens": ["pi", "chi", "x", "int", "mathrm", "exp", "L", "p", "q", "d", "psi", "ds", "2", "e", "2", "pi", "T", "phi", "eta", "bar", "h", "_", "mu", "nu", "dx", "mu", "nu", "dx", "mu", "nu", "T", "2", "d", "2", "psi"], "entropy": 4.343289445392767}
