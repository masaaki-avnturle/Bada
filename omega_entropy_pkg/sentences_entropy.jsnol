{"id": 1380, "para": 614, "sentence": "\\mathcal{O}(x) = \\left( [\\nabla_{i}\\nabla_{j}f(x)]\\right)^{'} \n  \\cong {}_{n}C_{r}(x)^{n}(y)^{n-r} \\delta(x,y) \n (\\square \\psi)' = \\nabla_{i}\\nabla_{j}(\\delta(x) \\circ \n G(x))^{\\mu\\nu} \\left({p \\over c^3} \\circ \n{V \\over S} \\right) \n F^m_t = {1 \\over 4}g^{2}_{ij}, x^{{1 \\over 2} + iy} = e^{x \\log x} \n S^{\\mu\\nu}_m \\otimes S^{\\mu\\nu}_n = G_{\\mu\\nu} \\times T^{\\mu\\nu}", "math": false, "tokens": ["mathcal", "O", "x", "left", "nabla_", "i", "nabla_", "j", "f", "x", "right", "cong", "_", "n", "C_", "r", "x", "n", "y", "n", "r", "delta", "x", "y", "square", "psi", "nabla_", "i", "nabla_", "j", "delta", "x", "circ", "G", "x", "mu", "nu", "left", "p", "over", "c", "3", "circ", "V", "over", "S", "right", "F", "m_t", "1", "over", "4", "g", "2", "_", "ij", "x", "1", "over", "2", "iy", "e", "x", "log", "x", "S", "mu", "nu", "_m", "otimes", "S", "mu", "nu", "_n", "G_", "mu", "nu", "times", "T", "mu", "nu"], "entropy": 5.114437892191024}
{"id": 1381, "para": 615, "sentence": "S^{\\mu\\nu}_m \\otimes S^{\\mu\\nu}_n  = -{2 R_{ij} \\over V(\\tau)}[D^2 \\psi]", "math": false, "tokens": ["S", "mu", "nu", "_m", "otimes", "S", "mu", "nu", "_n", "2", "R_", "ij", "over", "V", "tau", "D", "2", "psi"], "entropy": 3.725480556997868}
