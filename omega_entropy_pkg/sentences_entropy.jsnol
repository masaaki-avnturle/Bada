{"id": 38, "para": 18, "sentence": "This function is", "math": false, "tokens": ["This", "function", "is"], "entropy": 1.584962500721156}
{"id": 39, "para": 19, "sentence": "$$ \\int {1 \\over (x \\log x)}dx = i \\int x \\log xdx - \\int {1 \\over (x \\log x)}dx $$", "math": true, "tokens": ["int", "1", "over", "x", "log", "x", "dx", "i", "int", "x", "log", "xdx", "int", "1", "over", "x", "log", "x", "dx"], "entropy": 2.8205898566665457}
