{"id": 2451, "para": 898, "sentence": "$$ ||ds^2|| = e^{-2 \\pi T|\\psi|}[\\eta + \\bar{h}(x)]dx^{\\mu}dx^{\\nu}\n   + T^2 d^2 \\psi $$", "math": true, "tokens": ["ds", "2", "e", "2", "pi", "T", "psi", "eta", "bar", "h", "x", "dx", "mu", "dx", "nu", "T", "2", "d", "2", "psi"], "entropy": 3.621928094887362}
