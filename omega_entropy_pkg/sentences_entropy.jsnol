{"id": 1206, "para": 573, "sentence": "{\\vee (\\int \\nabla_{i}\\nabla_{j} (R + \\Delta f)^2) \n    \\over \\exists (R + \\Delta f)} -> =: variable array[]  \n  >> VIRTUAL_MACHINE[tuplespace] \n  => {regexpt.", "math": false, "tokens": ["vee", "int", "nabla_", "i", "nabla_", "j", "R", "Delta", "f", "2", "over", "exists", "R", "Delta", "f", "variable", "array", "VIRTUAL_MACHINE", "tuplespace", "regexpt"], "entropy": 3.9219280948873623}
