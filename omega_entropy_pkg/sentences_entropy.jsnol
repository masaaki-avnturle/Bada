{"id": 2080, "para": 800, "sentence": "Global differential manifold is newton and \n  laiptitz formula of out of range in deprivate of compute systems.", "math": false, "tokens": ["Global", "differential", "manifold", "is", "newton", "and", "laiptitz", "formula", "of", "out", "of", "range", "in", "deprivate", "of", "compute", "systems"], "entropy": 3.807763576417195}
