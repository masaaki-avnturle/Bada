{"id": 1360, "para": 594, "sentence": "cognitive_system |value| \n= { x^{{1 \\over 2} + iy} = [f(x) \\circ g(x), \\bar{h}(x)]/ \\partial f\\partial g\\partial h \n x^{{1 \\over 2} + iy} = \\mathrm{exp}[\\int \\nabla_{i}\\nabla_{j}f(g(x))g'(x)/\n \\partial f\\partial g]", "math": false, "tokens": ["cognitive_system", "value", "x", "1", "over", "2", "iy", "f", "x", "circ", "g", "x", "bar", "h", "x", "partial", "f", "partial", "g", "partial", "h", "x", "1", "over", "2", "iy", "mathrm", "exp", "int", "nabla_", "i", "nabla_", "j", "f", "g", "x", "g", "x", "partial", "f", "partial", "g"], "entropy": 3.8953944369864546}
{"id": 1361, "para": 595, "sentence": "\\mathcal{O}(x) = \\{[f(x)\\circ g(x) , \\bar{h}(x)], g^{-1}(x)\\}", "math": false, "tokens": ["mathcal", "O", "x", "f", "x", "circ", "g", "x", "bar", "h", "x", "g", "1", "x"], "entropy": 2.835237745312118}
{"id": 1362, "para": 596, "sentence": "\\exists [\\nabla_{i} \\nabla_{j} (R + \\Delta f), g(x)] = \\bigoplus_{k=0}^{\\infty}\n\\nabla \\int \\nabla_{i} \\nabla_{j}f(x)dm", "math": false, "tokens": ["exists", "nabla_", "i", "nabla_", "j", "R", "Delta", "f", "g", "x", "bigoplus_", "k", "0", "infty", "nabla", "int", "nabla_", "i", "nabla_", "j", "f", "x", "dm"], "entropy": 3.82790978214397}
{"id": 1363, "para": 597, "sentence": "\\vee (\\nabla_{i} \\nabla_{j} f) = \\bigotimes \\nabla E^{+}", "math": false, "tokens": ["vee", "nabla_", "i", "nabla_", "j", "f", "bigotimes", "nabla", "E"], "entropy": 2.94770277922009}
{"id": 1364, "para": 598, "sentence": "g(x,y) = \\mathcal{O}(x)[f(x) + \\bar{h}(x)] + T^2 d^2 \\phi", "math": false, "tokens": ["g", "x", "y", "mathcal", "O", "x", "f", "x", "bar", "h", "x", "T", "2", "d", "2", "phi"], "entropy": 3.375}
{"id": 1365, "para": 599, "sentence": "\\mathcal{O}(x) = \\left( \\int [g(x)] e^{-f}dV \\right)^{'} - \\sum \\delta (x) \n   \\mathcal{O}(x) = [\\nabla_{i}\\nabla_{j}f(x)]^{'} \\cong {}_{n}C_{r} f(x)^{n} \n   f(y)^{n-r} \\delta (x,y), \n   V(\\tau) = \\int [f(x)]dm/ \\partial f_{xy}", "math": false, "tokens": ["mathcal", "O", "x", "left", "int", "g", "x", "e", "f", "dV", "right", "sum", "delta", "x", "mathcal", "O", "x", "nabla_", "i", "nabla_", "j", "f", "x", "cong", "_", "n", "C_", "r", "f", "x", "n", "f", "y", "n", "r", "delta", "x", "y", "V", "tau", "int", "f", "x", "dm", "partial", "f_", "xy"], "entropy": 4.397896767069121}
{"id": 1366, "para": 600, "sentence": "\\square \\psi = 8 \\pi G T^{\\mu\\nu}, (\\square \\psi)^{'} = \\nabla_{i}\\nabla_{j}\n   (\\delta (x) \\circ G(x))^{\\mu\\nu}\n \\left({p \\over c^3} \\circ {V \\over S}\\right), x^{{1 \\over 2} + iy} = e^{x \\log x}", "math": false, "tokens": ["square", "psi", "8", "pi", "G", "T", "mu", "nu", "square", "psi", "nabla_", "i", "nabla_", "j", "delta", "x", "circ", "G", "x", "mu", "nu", "left", "p", "over", "c", "3", "circ", "V", "over", "S", "right", "x", "1", "over", "2", "iy", "e", "x", "log", "x"], "entropy": 4.562814895472355}
{"id": 1367, "para": 601, "sentence": "\\delta (x) \\phi = {\\vee [\\nabla_{i}\\nabla_{j} f \\circ g(x)] \\over \n   \\exists (R + \\Delta f)}", "math": false, "tokens": ["delta", "x", "phi", "vee", "nabla_", "i", "nabla_", "j", "f", "circ", "g", "x", "over", "exists", "R", "Delta", "f"], "entropy": 3.734521664779752}
{"id": 1368, "para": 602, "sentence": "{}_{-n}C_{r} = {}_{{1 \\over i}H\\psi} C_{\\hbar \\psi} + {}_{[H, \\psi]} C_{-n - r} \n   {}_{n}C_{r} = {}_{n}C_{n-r}", "math": false, "tokens": ["_", "n", "C_", "r", "_", "1", "over", "i", "H", "psi", "C_", "hbar", "psi", "_", "H", "psi", "C_", "n", "r", "_", "n", "C_", "r", "_", "n", "C_", "n", "r"], "entropy": 3.036504603290679}
{"id": 1369, "para": 603, "sentence": "\\int \\int {1 \\over (x \\log x)^2}dx_m \\to \\mathcal{O}(x) = \n [\\nabla_{i}\\nabla_{j}f]'/\\partial f_{xy}", "math": false, "tokens": ["int", "int", "1", "over", "x", "log", "x", "2", "dx_m", "to", "mathcal", "O", "x", "nabla_", "i", "nabla_", "j", "f", "partial", "f_", "xy"], "entropy": 3.9754180179138325}
{"id": 1370, "para": 604, "sentence": "\\bigcup_{x=0}^{\\infty} f(x) = \\nabla_{i}\\nabla_{j}f(x) \\oplus \\sum f(x) \n = \\bigoplus \\nabla f(x) \n \\nabla_{i}\\nabla_{j} f \\cong \\partial x \\partial y \\int \n \\nabla_{i}\\nabla_{j} f dm \n     \\cong \\int [f(x)]dm \n  \\cong \\{[f(x),g(x)],g^{-1}(x)\\} \n \\cong \\square \\psi  \n \\cong \\nabla \\psi^2 \n \\cong f(x \\circ y) \\le f(x) \\circ g(x)\n \\cong |f(x)| + |g(x)|", "math": false, "tokens": ["bigcup_", "x", "0", "infty", "f", "x", "nabla_", "i", "nabla_", "j", "f", "x", "oplus", "sum", "f", "x", "bigoplus", "nabla", "f", "x", "nabla_", "i", "nabla_", "j", "f", "cong", "partial", "x", "partial", "y", "int", "nabla_", "i", "nabla_", "j", "f", "dm", "cong", "int", "f", "x", "dm", "cong", "f", "x", "g", "x", "g", "1", "x", "cong", "square", "psi", "cong", "nabla", "psi", "2", "cong", "f", "x", "circ", "y", "le", "f", "x", "circ", "g", "x", "cong", "f", "x", "g", "x"], "entropy": 3.952452761589672}
{"id": 1371, "para": 605, "sentence": "\\delta (x) \\psi = <f,g>\\circ |h^{-1}(x)| \n  \\partial f_x \\cdot \\delta (x) \\psi = x \n  x \\in \\mathcal{O} (x) \n  \\mathcal {O} (x) = \\{[f \\circ g, h^{-1}(x)], g(x) \\}", "math": false, "tokens": ["delta", "x", "psi", "f", "g", "circ", "h", "1", "x", "partial", "f_x", "cdot", "delta", "x", "psi", "x", "x", "in", "mathcal", "O", "x", "mathcal", "O", "x", "f", "circ", "g", "h", "1", "x", "g", "x"], "entropy": 3.4598683589017414}
{"id": 1372, "para": 606, "sentence": "\\lim_{n \\to \\infty} \\sum_{k=n}^{\\infty} \\nabla f = [\\nabla \\int \n \\nabla_{i}\\nabla_{j} f(x) dx_m, g^{-1}(x)] \\to \\bigoplus_{k=0}^{\\infty}  \n \\nabla E^{+}_{-} \n  = M_{3} \n  = \\bigoplus_{k=0}^{\\infty} E^{+}_{-} \n  dx^2 = [g^2_{\\mu\\nu},dx], g^{-1} = dx \\int \\delta(x)f(x)dx \n  f(x) = \\mathrm{exp}[\\nabla_{i}\\nabla_{j}f(x),g^{-1}(x)] \n\t  \\pi(\\chi,x) = [i\\pi (\\chi,x), f(x)] \n\t  \\left({g(x) \\over f(x)}\\right)^{'} =\n\t  \\lim_{n \\to \\infty} {g(x) \\over f(x)} \n           = {g'(x) \\over f'(x)}", "math": false, "tokens": ["lim_", "n", "to", "infty", "sum_", "k", "n", "infty", "nabla", "f", "nabla", "int", "nabla_", "i", "nabla_", "j", "f", "x", "dx_m", "g", "1", "x", "to", "bigoplus_", "k", "0", "infty", "nabla", "E", "_", "M_", "3", "bigoplus_", "k", "0", "infty", "E", "_", "dx", "2", "g", "2_", "mu", "nu", "dx", "g", "1", "dx", "int", "delta", "x", "f", "x", "dx", "f", "x", "mathrm", "exp", "nabla_", "i", "nabla_", "j", "f", "x", "g", "1", "x", "pi", "chi", "x", "i", "pi", "chi", "x", "f", "x", "left", "g", "x", "over", "f", "x", "right", "lim_", "n", "to", "infty", "g", "x", "over", "f", "x", "g", "x", "over", "f", "x"], "entropy": 4.630070961187489}
{"id": 1373, "para": 607, "sentence": "\\nabla F = f \\cdot {1 \\over 4}|r|^2\n\t\t  \\nabla_{i}\\nabla_{j} f = {d \\over dx_i}\n{d \\over dx_j}f(x)g(x) \n D^2 \\psi = \\nabla \\int (\\nabla_{i}\\nabla_{j} f)^2 d\\eta \n E = m c^2, E = {1 \\over 2}mv^2 - {1 \\over 2}kx^2, G^{\\mu\\nu} = \n {1 \\over 2}\\Lambda g_{ij}, \n\\square = {1 \\over 2}kT^2", "math": false, "tokens": ["nabla", "F", "f", "cdot", "1", "over", "4", "r", "2", "nabla_", "i", "nabla_", "j", "f", "d", "over", "dx_i", "d", "over", "dx_j", "f", "x", "g", "x", "D", "2", "psi", "nabla", "int", "nabla_", "i", "nabla_", "j", "f", "2", "d", "eta", "E", "m", "c", "2", "E", "1", "over", "2", "mv", "2", "1", "over", "2", "kx", "2", "G", "mu", "nu", "1", "over", "2", "Lambda", "g_", "ij", "square", "1", "over", "2", "kT", "2"], "entropy": 4.572510679472491}
{"id": 1374, "para": 608, "sentence": "\\mathrm{ker} f / \\mathrm{im} f \\cong S^{\\mu\\nu}_m, \n S^{\\mu\\nu}_m = \\pi (\\chi,x) \\otimes h_{\\mu\\nu}", "math": false, "tokens": ["mathrm", "ker", "f", "mathrm", "im", "f", "cong", "S", "mu", "nu", "_m", "S", "mu", "nu", "_m", "pi", "chi", "x", "otimes", "h_", "mu", "nu"], "entropy": 3.663532754804254}
{"id": 1375, "para": 609, "sentence": "D^2 \\psi = \\mathcal{O} (x)\\left({p \\over c^3} + \n {V \\over S}\\right), V(x) = D^2\\psi \\otimes M^{+}_3", "math": false, "tokens": ["D", "2", "psi", "mathcal", "O", "x", "left", "p", "over", "c", "3", "V", "over", "S", "right", "V", "x", "D", "2", "psi", "otimes", "M", "_3"], "entropy": 4.001822825622231}
{"id": 1376, "para": 610, "sentence": "S^{\\mu\\nu}_{m} \\otimes S^{\\mu\\nu}_{n} = \n - {2R_{ij} \\over V(\\tau)}[D^2\\psi]", "math": false, "tokens": ["S", "mu", "nu", "_", "m", "otimes", "S", "mu", "nu", "_", "n", "2R_", "ij", "over", "V", "tau", "D", "2", "psi"], "entropy": 3.826874881864636}
{"id": 1377, "para": 611, "sentence": "\\nabla_{i}\\nabla_{j}[S^{mn}_1 \\otimes S^{mn}_2] = \n \\int {V(\\tau) \\over f(x)}[D^2 \\psi] \n  \\nabla_{i}\\nabla_{j}[S^{mn}_1 \\otimes S^{mn}_2] = \n  \\int {V(\\tau) \\over f(x)}\\mathcal{O}(x)", "math": false, "tokens": ["nabla_", "i", "nabla_", "j", "S", "mn", "_1", "otimes", "S", "mn", "_2", "int", "V", "tau", "over", "f", "x", "D", "2", "psi", "nabla_", "i", "nabla_", "j", "S", "mn", "_1", "otimes", "S", "mn", "_2", "int", "V", "tau", "over", "f", "x", "mathcal", "O", "x"], "entropy": 4.1030559073332755}
