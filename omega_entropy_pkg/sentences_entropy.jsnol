{"id": 1393, "para": 627, "sentence": "(\\log x^{1 \\over 2})^{'} = {1 \\over 2}{1 \\over (x \\log x)},\n(\\sin \\theta)^{'} = \\cos \\theta, (f_z)^{'} = i e^{i x \\log x}, \n{d \\over df}F = m(x)", "math": false, "tokens": ["log", "x", "1", "over", "2", "1", "over", "2", "1", "over", "x", "log", "x", "sin", "theta", "cos", "theta", "f_z", "i", "e", "i", "x", "log", "x", "d", "over", "df", "F", "m", "x"], "entropy": 3.6062389286533896}
{"id": 1394, "para": 628, "sentence": "{d \\over df}\\int \\int{1 \\over (x \\log x)^2}dx_m \n + {d \\over df}\\int \\int {1 \\over (y \\log y)^{1\\over2}}dy_m\n= {d \\over df} \\int \\int \\left({1 \\over (x \\log x)^2} \n+ {1 \\over (y \\log y)^{1 \\over 2}}\\right)dm  \n \\ge {d \\over df}\\int \\int \\left({1 \\over \n (x \\log x)^2 \\circ (y \\log y)^{1 \\over 2}}\\right)dm \n \\ge 2h", "math": false, "tokens": ["d", "over", "df", "int", "int", "1", "over", "x", "log", "x", "2", "dx_m", "d", "over", "df", "int", "int", "1", "over", "y", "log", "y", "1", "over2", "dy_m", "d", "over", "df", "int", "int", "left", "1", "over", "x", "log", "x", "2", "1", "over", "y", "log", "y", "1", "over", "2", "right", "dm", "ge", "d", "over", "df", "int", "int", "left", "1", "over", "x", "log", "x", "2", "circ", "y", "log", "y", "1", "over", "2", "right", "dm", "ge", "2h"], "entropy": 3.780835664681754}
{"id": 1395, "para": 629, "sentence": "{d \\over df}\\int \\int \\left({1 \\over (x \\log x)^2 \\circ \n (y \\log y)^{1 \\over 2}}\\right)dm  \\ge \\hbar \n y = x, xy = x^2, (\\square \\psi)^{'} = 8 \\pi G\n \\left({p \\over c^3}\\circ{V \\over S}\\right) \n \\square \\psi = \\int \\int \\mathrm{exp}[8 \\pi G(\\bar{h}_{\\mu\\nu}\n \\circ \\eta_{\\mu\\nu})^{\\mu\\nu}]dmd\\psi,\n\t \\sum a_k x^k = {d \\over df}\\sum \\sum {1 \\over a^2_k f^k}dx_k\n \\sum a_k f^k = {d \\over df}\\sum \\sum\n\t{\\zeta(s) \\over a_k}dx_{km}, \n\t a^2_kf^{1 \\over 2}\\to \\lim_{k \\to 1}a_k f^k = \\alpha", "math": false, "tokens": ["d", "over", "df", "int", "int", "left", "1", "over", "x", "log", "x", "2", "circ", "y", "log", "y", "1", "over", "2", "right", "dm", "ge", "hbar", "y", "x", "xy", "x", "2", "square", "psi", "8", "pi", "G", "left", "p", "over", "c", "3", "circ", "V", "over", "S", "right", "square", "psi", "int", "int", "mathrm", "exp", "8", "pi", "G", "bar", "h", "_", "mu", "nu", "circ", "eta_", "mu", "nu", "mu", "nu", "dmd", "psi", "sum", "a_k", "x", "k", "d", "over", "df", "sum", "sum", "1", "over", "a", "2_k", "f", "k", "dx_k", "sum", "a_k", "f", "k", "d", "over", "df", "sum", "sum", "zeta", "s", "over", "a_k", "dx_", "km", "a", "2_kf", "1", "over", "2", "to", "lim_", "k", "to", "1", "a_k", "f", "k", "alpha"], "entropy": 5.2941135553990355}
{"id": 1396, "para": 630, "sentence": "ds^2 = [g_{\\mu\\nu}^2, dx] \n   M_2 \n   ds^2 = g_{\\mu\\nu}^{-1}(g^2_{\\mu\\nu}(x) - dx g_{\\mu\\nu}^2) \n  M_2  \n   = h(x) \\otimes g_{\\mu\\nu}d^2x - h(x) \\otimes dx g_{\\mu\\nu}(x),\n  h(x) = (f^2(\\vec{x}) - \\vec{E}^{+}) \n   G_{\\mu\\nu} = R_{\\mu\\nu}T^{\\mu\\nu},\n   \\partial M_2 = \\bigoplus \\nabla C^{+}_{-}   \n    G_{\\mu\\nu}   equal   R_{\\mu\\nu}  {d \\over dt}g_{ij} = - 2 R_{ij} \nr = 2 f^{1 \\over 2}(x)\n     E^{+} = f^{-1}xf(x), \n   h(x) \\otimes g(\\vec{x}) \\cong {V \\over S},\n  {R \\over M_2} = E^{+} - {\\phi}   \n     = M_3 \\supset R,\n   M^{+}_2 = E^{+}_{1} \\cup E^{+}_{2} \\to E^{+}_1 \\bigoplus E^{+}_2   \n     = M_1 \\bigoplus \\nabla C^{+}_{-}, (E^{+}_{1} \\bigoplus E^{+}_{2}) \n     \\cdot (R^{-} \\subset C^{+})   \n     {R \\over M_2} = E^{+} - \\{\\phi\\}   \n     = M_3 \\supset R   \n     M^{+}_3 \\cong h(x) \\cdot R^{+}_3\n  = \\bigoplus \\nabla C^{+}_{-}, \n  R = E^{+} \\bigoplus M_2 - (E^{+} \\cap M_2)   \n     E^{+} = g_{\\mu\\nu}dxg_{\\mu\\nu},\n   M_2 = g_{\\mu\\nu}d^2x,\n   F = \\rho g l \\to {V \\over S}   \n     \\mathcal{O}(x) = \\delta(x)[f(x) + g(\\bar{x})] + \\rho g l,\n   F = {1 \\over 2}mv^2 - {1 \\over 2}kx^2,\n   M_2 = P^{2n}   \n      r = 2f^{1 \\over 2}(x),\n  f(x) = {1 \\over 4}\\|r\\|^2", "math": false, "tokens": ["ds", "2", "g_", "mu", "nu", "2", "dx", "M_2", "ds", "2", "g_", "mu", "nu", "1", "g", "2_", "mu", "nu", "x", "dx", "g_", "mu", "nu", "2", "M_2", "h", "x", "otimes", "g_", "mu", "nu", "d", "2x", "h", "x", "otimes", "dx", "g_", "mu", "nu", "x", "h", "x", "f", "2", "vec", "x", "vec", "E", "G_", "mu", "nu", "R_", "mu", "nu", "T", "mu", "nu", "partial", "M_2", "bigoplus", "nabla", "C", "_", "G_", "mu", "nu", "equal", "R_", "mu", "nu", "d", "over", "dt", "g_", "ij", "2", "R_", "ij", "r", "2", "f", "1", "over", "2", "x", "E", "f", "1", "xf", "x", "h", "x", "otimes", "g", "vec", "x", "cong", "V", "over", "S", "R", "over", "M_2", "E", "phi", "M_3", "supset", "R", "M", "_2", "E", "_", "1", "cup", "E", "_", "2", "to", "E", "_1", "bigoplus", "E", "_2", "M_1", "bigoplus", "nabla", "C", "_", "E", "_", "1", "bigoplus", "E", "_", "2", "cdot", "R", "subset", "C", "R", "over", "M_2", "E", "phi", "M_3", "supset", "R", "M", "_3", "cong", "h", "x", "cdot", "R", "_3", "bigoplus", "nabla", "C", "_", "R", "E", "bigoplus", "M_2", "E", "cap", "M_2", "E", "g_", "mu", "nu", "dxg_", "mu", "nu", "M_2", "g_", "mu", "nu", "d", "2x", "F", "rho", "g", "l", "to", "V", "over", "S", "mathcal", "O", "x", "delta", "x", "f", "x", "g", "bar", "x", "rho", "g", "l", "F", "1", "over", "2", "mv", "2", "1", "over", "2", "kx", "2", "M_2", "P", "2n", "r", "2f", "1", "over", "2", "x", "f", "x", "1", "over", "4", "r", "2"], "entropy": 5.335511368194897}
{"id": 1397, "para": 631, "sentence": "V = R^{+}\\sum K_m, W = C^{+}\\sum^{\\infty}_{k=0} K_{n+2}, \n     V/W = R^{+}\\sum K_m / C^{+}\\sum K_{n+2}   \n     = R^{+}/C^{+} \\sum{x^k \\over a_k f^k(x)}   \n     = M^+_{-}, {d \\over df} F = m(x), \\to M^{+}_{-}, \\sum^{\\infty}_{k=0}\n     {x^k \\over a_k f^k(x)} = {a_k x^k \\over \n  \\zeta(x)}", "math": false, "tokens": ["V", "R", "sum", "K_m", "W", "C", "sum", "infty", "_", "k", "0", "K_", "n", "2", "V", "W", "R", "sum", "K_m", "C", "sum", "K_", "n", "2", "R", "C", "sum", "x", "k", "over", "a_k", "f", "k", "x", "M", "_", "d", "over", "df", "F", "m", "x", "to", "M", "_", "sum", "infty", "_", "k", "0", "x", "k", "over", "a_k", "f", "k", "x", "a_k", "x", "k", "over", "zeta", "x"], "entropy": 4.309384583505888}
{"id": 1398, "para": 632, "sentence": "{\\{f,g\\} \\over [f,g]} = {fg + gf \\over fg - gf}, \n  \\nabla f = 2, \\partial H_3 = 2, {1 + f \\over 1 - f} = 1,\n  {d \\over df} F = \\bigoplus \\nabla C^{+}_{-}, \\vec{F} =\n  {1 \\over 2}   \n     H_1 \\cong H_3 = M_3", "math": false, "tokens": ["f", "g", "over", "f", "g", "fg", "gf", "over", "fg", "gf", "nabla", "f", "2", "partial", "H_3", "2", "1", "f", "over", "1", "f", "1", "d", "over", "df", "F", "bigoplus", "nabla", "C", "_", "vec", "F", "1", "over", "2", "H_1", "cong", "H_3", "M_3"], "entropy": 4.055295335502323}
{"id": 1399, "para": 633, "sentence": "H_3 \\cong H_1 \\to \\pi(\\chi,x), H_n, H_m = \n   \\mathrm{rank}(m,n), \\mathrm{mesh}(\\mathrm{rank}(m,n)) \\lim \\mathrm{mesh} \\to 0   \n   (fg)' = fg' + gf', ({f \\over g})' = {{f'g - g'f} \\over g^2}, \n   {\\{f,g\\} \\over [f,g]} = {(fg)' \\otimes dx_{fg} \\over \n({f \\over g})' \\otimes g^{-2}dx_{fg}}   \n   = {{(fg)'\\otimes dx_{fg}} \\over ({f \\over g})' \\otimes g^{-2}dx_{fg}}   \n   = {d \\over df} F", "math": false, "tokens": ["H_3", "cong", "H_1", "to", "pi", "chi", "x", "H_n", "H_m", "mathrm", "rank", "m", "n", "mathrm", "mesh", "mathrm", "rank", "m", "n", "lim", "mathrm", "mesh", "to", "0", "fg", "fg", "gf", "f", "over", "g", "f", "g", "g", "f", "over", "g", "2", "f", "g", "over", "f", "g", "fg", "otimes", "dx_", "fg", "over", "f", "over", "g", "otimes", "g", "2", "dx_", "fg", "fg", "otimes", "dx_", "fg", "over", "f", "over", "g", "otimes", "g", "2", "dx_", "fg", "d", "over", "df", "F"], "entropy": 4.230679822200085}
