{"id": 783, "para": 423, "sentence": "$$ {\\partial^n \\over \\partial f^{n-1}}F = \\int[D^2 \\psi \\otimes h_{\\mu\\nu}]dm $$\n\t$$ = {P_1P_3\\dots P_{2n-1} \\over P_0 P_2\\dots P_{2n+2}}$$ \n\t$$ = \\bigotimes \\nabla M_1 $$\n\t$$ \\bigoplus \\nabla M_1 = \\sigma_n (\\chi,x) \\oplus \\sigma_{n-1}(\\chi,x) $$\n\t$$ = \\{f,h\\}\\circ [f,h]^{-1}  $$\n\t$$ = g^{-1}(x)_{\\mu\\nu} dx g_{\\mu\\nu}(x), \\sum_{k=0}^{\\infty} \\nabla^n {}_nC_r f^n(x) $$ \n        $$ \\cong \\sum_{k=0}^{\\infty} \\nabla^n \\nabla^{n-1} {}_nC_r f^n(x)g^{n-r}(x) $$\n\t$$ \\sum_{k=0}^{\\infty}{\\partial^n \\over \\partial^{n-1}f} \\circ {\\zeta(x) \\over n!", "math": true, "tokens": ["partial", "n", "over", "partial", "f", "n", "1", "F", "int", "D", "2", "psi", "otimes", "h_", "mu", "nu", "dm", "P_1P_3", "dots", "P_", "2n", "1", "over", "P_0", "P_2", "dots", "P_", "2n", "2", "bigotimes", "nabla", "M_1", "bigoplus", "nabla", "M_1", "sigma_n", "chi", "x", "oplus", "sigma_", "n", "1", "chi", "x", "f", "h", "circ", "f", "h", "1", "g", "1", "x", "_", "mu", "nu", "dx", "g_", "mu", "nu", "x", "sum_", "k", "0", "infty", "nabla", "n", "_nC_r", "f", "n", "x", "cong", "sum_", "k", "0", "infty", "nabla", "n", "nabla", "n", "1", "_nC_r", "f", "n", "x", "g", "n", "r", "x", "sum_", "k", "0", "infty", "partial", "n", "over", "partial", "n", "1", "f", "circ", "zeta", "x", "over", "n"], "entropy": 5.015961946668008}
{"id": 784, "para": 423, "sentence": "} = \n\t\\lim_{n \\to 1} \\sum_{k=0}^{\\infty} a_k f^k$$ \n\t$$ (f)^n = {}_nC_r f^n(x)g^{n-r}(x)\\cdot \\delta(x,y) $$\n\t$$ (e^{i \\theta})^{'} = i e^{i \\theta}, \\int e^{i \\theta} = {1 \\over i}e^{i \\theta}, ihc = G, hc = \n\t{1 \\over i}G $$", "math": true, "tokens": ["lim_", "n", "to", "1", "sum_", "k", "0", "infty", "a_k", "f", "k", "f", "n", "_nC_r", "f", "n", "x", "g", "n", "r", "x", "cdot", "delta", "x", "y", "e", "i", "theta", "i", "e", "i", "theta", "int", "e", "i", "theta", "1", "over", "i", "e", "i", "theta", "ihc", "G", "hc", "1", "over", "i", "G"], "entropy": 4.310298681647991}
{"id": 785, "para": 424, "sentence": "$$ (\\square \\psi, \\nabla f^2)\\cdot ({8\\pi G \\over c^4}T^{\\mu\\nu}, 4\\pi G \\rho) $$\n\t$$ = (-{1 \\over 2}mv^2 + mc^2, {1 \\over2}kT^2 + {1 \\over 2}mv^2) \\cdot \\begin{pmatrix}\n\t\t\\cos \\theta & - \\sin \\theta \\\\\n\t\\sin \\theta & \\cos \\theta \\end{pmatrix} $$\n\t\t$$ = \\begin{pmatrix} 1 & 0 \\\\\n\t0 & i \\end{pmatrix} $$\n\t\t$$ \\left({\\{f,g\\} \\over [f,g]}\\right)^{'} = i^2, {\\nabla f^2 \\over \\square \\psi} = {1 \\over 2} $$\t\n\t\t\t$$ \\int \\int {\\{f,g\\} \\over [f,g]} = {1 \\over 2}i, \n\t\t\t \\int \\int {1 \\over (y \\log y)^{1 \\over 2}}dy_m = {1 \\over 2} $$\n\t\t\t $$ \\int \\int {1 \\over (x \\log x)^2}dx_m = {1 \\over 2}i, {d \\over dt}g_{ij} = - 2 R_{ij} $$", "math": true, "tokens": ["square", "psi", "nabla", "f", "2", "cdot", "8", "pi", "G", "over", "c", "4", "T", "mu", "nu", "4", "pi", "G", "rho", "1", "over", "2", "mv", "2", "mc", "2", "1", "over2", "kT", "2", "1", "over", "2", "mv", "2", "cdot", "begin", "pmatrix", "cos", "theta", "sin", "theta", "sin", "theta", "cos", "theta", "end", "pmatrix", "begin", "pmatrix", "1", "0", "0", "i", "end", "pmatrix", "left", "f", "g", "over", "f", "g", "right", "i", "2", "nabla", "f", "2", "over", "square", "psi", "1", "over", "2", "int", "int", "f", "g", "over", "f", "g", "1", "over", "2", "i", "int", "int", "1", "over", "y", "log", "y", "1", "over", "2", "dy_m", "1", "over", "2", "int", "int", "1", "over", "x", "log", "x", "2", "dx_m", "1", "over", "2", "i", "d", "over", "dt", "g_", "ij", "2", "R_", "ij"], "entropy": 4.803755039587932}
{"id": 786, "para": 425, "sentence": "$$ {\\partial \\over \\partial x}(f(x)g(x))^{'} = \\bigoplus \\nabla_{i}\\nabla_{j} \n\t\t\t f(x)g(x) $$ \n\t\t\t $$ \\int f'(x)g(x)dx = [f(x)g(x)] - \\int f(x)g'(x)dx $$", "math": true, "tokens": ["partial", "over", "partial", "x", "f", "x", "g", "x", "bigoplus", "nabla_", "i", "nabla_", "j", "f", "x", "g", "x", "int", "f", "x", "g", "x", "dx", "f", "x", "g", "x", "int", "f", "x", "g", "x", "dx"], "entropy": 2.9452114298468204}
