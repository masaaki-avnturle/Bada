{"id": 1177, "para": 561, "sentence": "多様体の式をバーチャルマシンに方程式としてと、データベースとして\n\\begin{quote}\n\\setlength{\\baselineskip}{12pt}\n\\begin{verbatim}", "math": false, "tokens": ["多様体の式をバーチャルマシンに方程式としてと", "データベースとして", "begin", "quote", "setlength", "baselineskip", "12pt", "begin", "verbatim"], "entropy": 2.94770277922009}
{"id": 1178, "para": 562, "sentence": "{\\bigoplus M^{+}_{-} -> =: \\nabla R^{+} \\nabla C^{+}}-< [construct_emerge_equation.", "math": false, "tokens": ["bigoplus", "M", "_", "nabla", "R", "nabla", "C", "construct_emerge_equation"], "entropy": 2.75}
{"id": 1179, "para": 562, "sentence": "built]\n  >> VIRTUALMACHINE[tuplespace]", "math": false, "tokens": ["built", "VIRTUALMACHINE", "tuplespace"], "entropy": 1.584962500721156}
{"id": 1180, "para": 563, "sentence": "\\end{verbatim}\n\\end{quote}", "math": false, "tokens": ["end", "verbatim", "end", "quote"], "entropy": 1.5}
