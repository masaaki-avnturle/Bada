// ============================================================================
//  medications.bada — Bada language preset library
// ----------------------------------------------------------------------------
//  これは「薬の名前にひもづけた “ほっとする” リラクゼーション音風景」の定義です。
//  各 preset は「対象の部位が安らぐ」体験を、音(carrier + breathing beat)と
//  部位ハイライトで表現します。
//
//  ⚠️ 重要 / IMPORTANT:
//  これらは薬効を再現・代替するものでは一切ありません。処方薬の指示に従って
//  ください。本ファイルは教育・リラクゼーション用のシミュレーションです。
//  These presets do NOT reproduce or replace any medication. They are
//  relaxation soundscapes only.
// ============================================================================

preset "risperdal" {
    label     = "リスパダール"
    feeling   = "気持ちが安静に"
    region    = limbic
    base_hz   = 96.0
    beat_hz   = 7.5          // theta — calm
    waveform  = soft
    warmth    = 0.75
    color     = "#7ec8e3"
    narration = "胸と脳がゆっくりほどけ、気持ちが安静へ向かいます。"
}

preset "levotomin" {
    label     = "レボトミン"
    feeling   = "瞑想状態"
    region    = brain
    base_hz   = 72.0
    beat_hz   = 5.0          // theta — meditative
    waveform  = sine
    warmth    = 0.85
    color     = "#9060d0"
    narration = "呼吸が深まり、静かな瞑想状態へ入っていきます。"
}

preset "brotizolam" {
    label     = "ブロチゾラム"
    feeling   = "ほっと胸と脳が安らぐ"
    region    = chest
    base_hz   = 80.0
    beat_hz   = 3.0          // delta — drowsy ease
    waveform  = soft
    warmth    = 0.9
    color     = "#40b8c0"
    narration = "胸と脳が同時にほどけ、ほっと安らいでいきます。"
}

preset "lonasen" {
    label     = "ロナセン"
    feeling   = "身体のコンディションが良く"
    region    = whole_body
    base_hz   = 110.0
    beat_hz   = 9.0          // alpha — light, present
    waveform  = sine
    warmth    = 0.6
    color     = "#5fc88a"
    narration = "全身の緊張がほどけ、コンディションが整っていきます。"
}

preset "pzc" {
    label     = "PZC (ピーゼットシー)"
    feeling   = "混乱が落ち着き、胸と脳が安らぐ"
    region    = chest
    base_hz   = 88.0
    beat_hz   = 6.0          // theta
    waveform  = soft
    warmth    = 0.8
    color     = "#c8a44a"
    narration = "ざわめきが静まり、胸と脳が落ち着いていきます。"
}

preset "trilafon" {
    label     = "トリラホン"
    feeling   = "頭の中が静かに整う"
    region    = brain
    base_hz   = 84.0
    beat_hz   = 6.5
    waveform  = soft
    warmth    = 0.78
    color     = "#b08fd0"
    narration = "考えの渦がゆっくり止まり、頭が静かになります。"
}

preset "zyprexa" {
    label     = "ジプレキサ"
    feeling   = "肩の力が抜けて落ち着く"
    region    = chest
    base_hz   = 92.0
    beat_hz   = 5.5
    waveform  = soft
    warmth    = 0.82
    color     = "#e3a07e"
    narration = "肩と胸の力が抜け、ゆったり落ち着いていきます。"
}

preset "abilify" {
    label     = "エビリファイ"
    feeling   = "穏やかに前向き"
    region    = brain
    base_hz   = 104.0
    beat_hz   = 8.5          // alpha — clear & calm
    waveform  = sine
    warmth    = 0.65
    color     = "#7ecf6d"
    narration = "頭が澄み、穏やかに前向きな静けさが広がります。"
}

preset "sycrest" {
    label     = "シクレスト"
    feeling   = "口元と肩がゆるむ"
    region    = chest
    base_hz   = 86.0
    beat_hz   = 6.0
    waveform  = soft
    warmth    = 0.8
    color     = "#9fc0e0"
    narration = "口元と肩がゆるみ、呼吸がやわらかくなります。"
}

preset "wypax" {
    label     = "ワイパックス"
    feeling   = "不安がほどける"
    region    = limbic
    base_hz   = 78.0
    beat_hz   = 7.0          // theta — anxiolytic calm
    waveform  = soft
    warmth    = 0.85
    color     = "#88c8d8"
    narration = "胸の奥の不安がほどけ、安心が満ちていきます。"
}

preset "etizolam" {
    label     = "エチゾラム / デパス"
    feeling   = "張りつめが解ける"
    region    = chest
    base_hz   = 82.0
    beat_hz   = 6.5
    waveform  = soft
    warmth    = 0.82
    color     = "#a0d0c0"
    narration = "張りつめていた身体がふっとゆるんでいきます。"
}

preset "brotizolam_sleep" {
    label     = "ブロチゾラム (入眠)"
    feeling   = "眠りへ沈む"
    region    = brain
    base_hz   = 64.0
    beat_hz   = 2.0          // delta — sleep onset
    waveform  = soft
    warmth    = 0.95
    color     = "#5b6fb0"
    narration = "まぶたが重くなり、ゆっくり眠りへ沈んでいきます。"
}

preset "rohypnol" {
    label     = "ロヒプノール"
    feeling   = "深い眠りへ"
    region    = brain
    base_hz   = 60.0
    beat_hz   = 1.5          // delta — deep sleep
    waveform  = soft
    warmth    = 0.97
    color     = "#4a5a90"
    narration = "波がゆっくり寄せては引き、深い眠りに包まれます。"
}

preset "amel_generic" {
    label     = "アメル (一般)"
    feeling   = "穏やかなニュートラル"
    region    = whole_body
    base_hz   = 100.0
    beat_hz   = 8.0          // alpha — neutral calm
    waveform  = sine
    warmth    = 0.7
    color     = "#c0c8d0"
    narration = "全身が中庸に整い、穏やかな状態に落ち着きます。"
}
