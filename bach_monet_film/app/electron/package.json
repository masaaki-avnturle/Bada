{
  "name": "bada-contrapunctus",
  "productName": "BadaContrapunctus",
  "version": "1.0.0",
  "description": "Bada Contrapunctus — arranges any music file in the spirit of J.S. Bach's unfinished Contrapunctus XIV (key detection, transposition to D minor / F major, cathedral reverb, four organ voices, the break-off ending), lets you compose and edit on 11 parallel orchestral tracks driven by a chord progression, and renders a Monet-style painting of Camille praying into a video. Self-contained HTML app, zero dependencies, fully offline.",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.badacontrapunctus",
    "productName": "BadaContrapunctus",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaContrapunctus-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "BadaContrapunctus-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "artifactName": "BadaContrapunctus-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
