<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada Contrapunctus
     (未完のフーガ × 祈るカミーユ 動画工房 — 平行ミックス作曲対応).
     ワークフロー (contrapunctus-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bach_monet_film/index.html) を差し込みます。
     楽曲の読み込みはファイル選択(どの拡張子でも)、動画 / WAV / MIDI / プロジェクトの保存は
     cordova-plugin-save-dialog (SAF の保存ダイアログ) で保存先を選んで行われます。 -->
<widget id="io.github.masaaki_avnturle.badacontrapunctus" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BadaContrapunctus</name>
  <description>Bada Contrapunctus — 楽曲を J.S. バッハ「コントラプンクトゥス XIV(未完)」の気配に編曲(調性解析 → D 短調 / F 長調へ移調、大聖堂残響、4 声オルガン対位法、未完の終止)し、コード進行に沿った 11 行の平行トラック(弦楽・合唱・フルート・チェンバロ・コントラバス・ティンパニ)で作曲・編集、モネ風の筆致で描いた「祈るカミーユ」の動画に仕立てる工房。依存ゼロ・単一 HTML・オフライン動作</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0e0c10" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0e0c10" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
