<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada 冬景 (Winter Math Music Visualizer).
     ワークフロー (fuyukei-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = winter_math_art/index.html) を差し込みます。
     楽曲の読み込みはファイル選択、動画の保存は cordova-plugin-save-dialog
     (SAF の保存ダイアログ) で保存先を選んで行われます。 -->
<widget id="io.github.masaaki_avnturle.badafuyukei" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BadaFuyukei</name>
  <description>Bada 冬景 — 冬景色と数学を融合させた抽象画で楽曲を映像化するアプリ。β–ζ 論文の方程式群 (定理1–6・系1–2) と多様体エントロピー不変量 Ξ を、雪・氷柱・雪山・オーロラ・凍った湖・雪の結晶として描き、ピアノロールと共に MP4/WebM 動画へ書き出す。依存ゼロ・単一 HTML・オフライン動作</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff070b12" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#070b12" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
