<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of 反重力リニア BadaLinear.
     ワークフローが cordova プロジェクトを作成し、この config.xml と ../www を差し込みます。 -->
<widget id="io.github.masaaki_avnturle.badalinear" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BadaLinear</name>
  <description>反重力リニア新幹線 BadaLinear — 超伝導磁石を反重力浮上に、空気抵抗を補空間包絡に置き換えた3D運行シミュレータ</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0a2748" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0a2748" />
  <preference name="Orientation" value="default" />
  <platform name="android"><preference name="AndroidXEnabled" value="true" /></platform>
</widget>
