<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of MusicTeX Studio.
     ワークフロー (musictex-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = musictex_studio/index.html) を差し込みます。 -->
<widget id="io.github.masaaki_avnturle.musictexstudio" version="1.3.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>MusicTeXStudio</name>
  <description>MusicTeX Studio — MusixTeX (texlive-music) の楽譜制作アプリ。シンセサイザー (倍音スペクトルコード・五行コード線 M/m/7/M7/sus4×12音階・ライブスペクトル) / モーツァルト・ビジョン (音=光の波長帯の映像化・色鍵盤で作曲) / 曲ファイル (MIDI / 音声) からの自動採譜 / テンプレート (B♭/E♭ 長音階・G と A の和音・HANON — レポート octave74) / ライブ楽譜プレビュー / Web Audio 試聴 / .tex 書き出し</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
