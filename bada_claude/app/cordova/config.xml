<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of BadaClaude.
     ワークフロー (badaclaude-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_claude/index.html) を差し込みます。
     ローカルモードは端末内で完結し、Claude API モードのときだけ
     https://api.anthropic.com へ接続します。 -->
<widget id="io.github.masaaki_avnturle.badaclaude" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BadaClaude</name>
  <description>BadaClaude — Claude / ChatGPT 型の対話パイプラインを量子プログラミング言語 Bada で作り換えた対話エンジン。論文 10 本と方程式 2111 本の検索、ζ・Γ・β・Riemann–Siegel Z・Jones の数値計算、Q# 型量子回路、Bada コード実行。設定で Claude API キーを入れると、Bada が組み立てた文脈を Claude に渡して回答します。</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <access origin="https://api.anthropic.com" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff1b1a18" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#1b1a18" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
