{
  "name": "bada-claude",
  "productName": "BadaClaude",
  "version": "1.0.0",
  "description": "BadaClaude — a Claude/ChatGPT-style chat assistant whose whole pipeline (tokenize, Unknown-Prior-Engine intent inference, BM25 retrieval over the Yamaguchi-framework papers and the 2111-equation registry, numeric tools, Q#-style quantum circuits, generation, append-only ledger) is written in the quantum programming language Bada. Optional Claude API mode sends the Bada-built context to Claude. Self-contained HTML app.",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.badaclaude",
    "productName": "BadaClaude",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaClaude-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "BadaClaude-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "artifactName": "BadaClaude-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
