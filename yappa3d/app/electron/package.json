{
  "name": "yappa3d",
  "productName": "Yappa3D",
  "version": "1.0.0",
  "description": "Yappa 3D — Bada 3D design app: a zero-dependency single-file WebGL 3D design / modeling tool (primitive placement, scene tree + inspector, GPU color picking, OBJ+MTL export, undo/redo)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.yappa3d",
    "productName": "Yappa3D",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "Yappa3D-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "Yappa3D-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Graphics",
      "artifactName": "Yappa3D-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
