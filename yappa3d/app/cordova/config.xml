<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Yappa 3D.
     ワークフローが cordova プロジェクトを作成し、この config.xml と
     ../www (自己完結アプリ = yappa3d/index.html) を差し込みます。 -->
<widget id="io.github.masaaki_avnturle.yappa3d" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Yappa3D</name>
  <description>Yappa 3D — Bada 3D デザインアプリ (自前WebGL・プリミティブ配置・シーンツリー/インスペクタ・OBJ書き出し・Undo/Redo)</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b0d12" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0d12" />
  <preference name="Orientation" value="landscape" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
