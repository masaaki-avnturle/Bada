{
  "name": "bada-solarcast",
  "productName": "Bada SolarCast",
  "version": "1.0.0",
  "description": "Bada SolarCast — live NOAA solar flare / geomagnetic data, 16-day regional forecasts blended with ERA5 climatology for any future date, UK Christmas weather, and a lab that tests solar-activity vs temperature lag correlation. Self-contained HTML app.",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.solarcast",
    "productName": "BadaSolarCast",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaSolarCast-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "BadaSolarCast-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Science",
      "artifactName": "BadaSolarCast-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
