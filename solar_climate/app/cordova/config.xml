<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada SolarCast.
     ワークフロー (solarcast-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = solar_climate/index.html) を差し込みます。
     アプリは NOAA SWPC と Open-Meteo の公開 API だけに接続します。 -->
<widget id="io.github.masaaki_avnturle.solarcast" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Bada SolarCast</name>
  <description>Bada SolarCast — NOAA の太陽フレア・地磁気の実測と、世界各地の 16 日予報 + ERA5 気候値による任意日付の確率予報、英国クリスマスの天気、太陽活動と気温のラグ相関を検証するラボ。</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <access origin="https://services.swpc.noaa.gov" />
  <access origin="https://api.open-meteo.com" />
  <access origin="https://archive-api.open-meteo.com" />
  <access origin="https://ensemble-api.open-meteo.com" />
  <access origin="https://geocoding-api.open-meteo.com" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0d1117" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0d1117" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
