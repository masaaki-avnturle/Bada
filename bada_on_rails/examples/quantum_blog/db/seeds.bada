# seeds.bada — 初期データ
# boot のたびに評価されるので post_count() でガードする。

if (post_count() == 0) {
  post_create([
    ["title", "Bada on Rails へようこそ"],
    ["body", "このブログは量子プログラミング言語 Bada で書かれた Rails 風フレームワーク Bada on Rails で動いています。ルーティングは @reviser : grammar 文法拡張、永続化は追記専用の Akashic 台帳 (db/akashic.jsonl) です。"],
    ["status", "published"]
  ])
  post_create([
    ["title", "作用素プログラミング"],
    ["body", "コントローラのアクションは作用素 (render_view / redirect_to / head) をリクエスト状態へ適用する関数です。DB への書き込みは create/update/destroy いずれも台帳への追記コミットになります。"],
    ["status", "draft"]
  ])
  post_create([
    ["title", "シュレディンガーの記事"],
    ["body", "この記事のステータスは draft と published の重ね合わせのまま保存されました。誰かが最初に読み出した瞬間に測定され、collapse 事実が台帳へ追記されて確定します。"],
    ["status", superpose ["draft", "published"] with [0.5, 0.5]]
  ])
  log("seeded quantum_blog: 3 posts (1 superposed)")
}
