<form method="POST" action="<%= action_url %>">
  <input type="hidden" name="_method" value="<%= form_method %>">
  <label>タイトル</label>
  <input type="text" name="title" value="<%= form_value(record, "title") %>">
  <label>本文</label>
  <textarea name="body" rows="6"><%= form_value(record, "body") %></textarea>
  <label>ステータス</label>
  <select name="status">
    <option value="draft">draft</option>
    <option value="published">published</option>
    <option value="superposed">superposed — 重ね合わせのまま保存 (最初の読み出しで測定)</option>
  </select>
  <p><button>保存</button> <a href="/posts">キャンセル</a></p>
</form>
