<h1>記事一覧 <span class="count">(<%= count %> 件)</span></h1>
<p><a class="btn" href="/posts/new">＋ 新規記事</a></p>
<table>
  <tr><th>id</th><th>タイトル</th><th>ステータス</th><th></th></tr>
<% each posts as p %>
  <tr>
    <td><%= field(p, "id") %></td>
    <td><a href="/posts/<%= field(p, "id") %>"><%= field(p, "title") %></a></td>
    <td><span class="badge"><%= field(p, "status") %></span></td>
    <td>
      <a href="/posts/<%= field(p, "id") %>/edit">編集</a>
      <form class="inline" method="POST" action="/posts/<%= field(p, "id") %>">
        <input type="hidden" name="_method" value="DELETE">
        <button>削除</button>
      </form>
    </td>
  </tr>
<% end %>
</table>

<h1>Akashic 台帳 (末尾 5 事実)</h1>
<p class="muted">作成・更新・削除・測定 — すべては追記専用台帳へのコミット。</p>
<div class="ledger"><% each ledger as f %><%= f %>
<% end %></div>
