# quantum_blog のルーティング — Bada on Rails DSL
# (lib/railtie.bada の @reviser : grammar 文法拡張がこの構文を定義する)

root to: "posts#index"
get "/quantum", to: "posts#quantum"
resources :posts

# 分岐オブジェクトをルート先に指定できる:
# /lucky へのリクエストごとに同じ重ね合わせが準備し直され、Born 則で
# どちらのアクションが応答するかが測定される。測定結果は毎回
# Akashic 台帳へ measurement 事実としてコミットされる。
get "/lucky", to: superpose ["posts#index", "posts#quantum"] with [0.5, 0.5]
