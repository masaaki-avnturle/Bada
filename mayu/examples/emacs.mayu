# emacs.mayu — Emacs 風カーソル移動を全アプリで
#
# 使い方:
#   mayu simulate examples/emacs.mayu --keys "C-b C-f C-n C-p C-a C-e"
#   sudo mayu run examples/emacs.mayu          # Linux 実フック
#
# CapsLock を Control にし、Control + b/f/n/p などを矢印キーへ変換する。

# CapsLock を Control として使う (押している間だけ)
mod control += CapsLock

keymap Global
  # CapsLock 単独では何もしない
  key CapsLock = &Ignore

  # 基本のカーソル移動
  key C-b = Left
  key C-f = Right
  key C-n = Down
  key C-p = Up

  # 行頭・行末
  key C-a = Home
  key C-e = End

  # ページ移動
  key C-v = PageDown
  key A-v = PageUp

  # 削除
  key C-h = BackSpace
  key C-d = Delete

  # C-g は Escape 相当
  key C-g = Escape

  # C-k で行末まで削除 (Shift-End してから Delete のシーケンス例)
  key C-k = S-End Delete
