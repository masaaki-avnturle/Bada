# vi-nav.mayu — Windows キーを押している間だけ hjkl が矢印になる
#
#   mayu simulate examples/vi-nav.mayu --keys "W-h W-j W-k W-l"

keymap Global
  key W-h = Left
  key W-j = Down
  key W-k = Up
  key W-l = Right
  key W-w = C-Right      # 単語送り
  key W-b = C-Left       # 単語戻り
  key W-0 = Home
  key W-4 = End          # $ の位置 (Shift 無し 4)
