# swap-ctrl-caps.mayu — CapsLock と LeftControl を入れ替える定番設定
#
#   mayu simulate examples/swap-ctrl-caps.mayu --keys "CapsLock a"

# 既定の Control 割り当てから LeftControl を外し、CapsLock を Control に
mod control -= LeftControl
mod control += CapsLock

keymap Global
  # 物理 CapsLock は修飾子として消費 (単打は無効)
  key CapsLock = &Ignore
  # 物理 LeftControl の位置では CapsLock を打てるようにする
  key LeftControl = CapsLock
