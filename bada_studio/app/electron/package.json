{
  "name": "bada-studio",
  "productName": "BadaStudio",
  "version": "1.0.0",
  "description": "Bada Studio — music production studio: polyphonic synthesizer (sine/saw/square/triangle with AR envelope), 16-step drum sequencer (synthesized kick/snare/hi-hat, sample-accurate Web Audio scheduling), mixer with delay and convolution reverb sends, and master-bus recording to WAV, as a self-contained HTML app",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.badastudio",
    "productName": "BadaStudio",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaStudio-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "BadaStudio-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "artifactName": "BadaStudio-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
