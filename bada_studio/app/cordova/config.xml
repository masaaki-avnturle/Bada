<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of BADA Studio (音・映像・作曲スタジオ).
     ワークフロー (studio-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_studio/index.html) を差し込みます。
     WAV / MIDI / 動画 / プロジェクトの保存は cordova-plugin-save-dialog
     (SAF の保存ダイアログ) で保存先を選んで行われます。音源・映像の読み込みは
     WebView の <input type="file"> (どの拡張子でも) で行われます。 -->
<widget id="io.github.masaaki_avnturle.badastudio" version="1.2.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
  <name>BadaStudio</name>
  <description>BADA Studio — 音源 (どの拡張子でも) と映像を読み込んで編集し、自分でも作曲するスタジオ。タイムラインでクリップを切り貼りし、対位法エンジンが 4 声を書き、オーケストラ版の多段 (5 行以上) コード進行を編集して合成。WAV / MIDI / 動画 / score.json に書き出し。依存ゼロ・単一 HTML・オフライン動作</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <config-file target="AndroidManifest.xml" parent="/manifest">
      <uses-permission android:name="android.permission.RECORD_AUDIO" />
      <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    </config-file>
  </platform>
</widget>
