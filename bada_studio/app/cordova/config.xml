<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada Studio.
     ワークフロー (badastudio-apps-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_studio/index.html) を差し込みます。 -->
<widget id="io.github.masaaki_avnturle.badastudio" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Bada Studio</name>
  <description>Bada Studio — 音楽制作スタジオ。ポリフォニックシンセ (サイン/ノコギリ/矩形/三角 + AR エンベロープ)、16 ステップ ドラムシーケンサー (キック/スネア/ハイハットをシンセシスで生成)、ミキサー + ディレイ/リバーブ、マスターバス録音 (WAV 書き出し)。Web Audio API による単一 HTML アプリ</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0d0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0d0e14" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <!-- 再生・録音中に画面が消えても音を止めないため -->
    <preference name="KeepRunning" value="true" />
  </platform>
</widget>
