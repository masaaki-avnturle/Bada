<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Mimir.
     ワークフロー (mimir-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = mimir/index.html) を差し込みます。 -->
<widget id="io.github.masaaki_avnturle.mimir" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Mimir</name>
  <description>Mimir — ARグラス・コンシェルジュ。タブレット/スマートフォンの画像・文章を外部ディスプレイ接続の AR グラスへ投影 (単眼ミラー / 両眼 SBS)。特殊相対性理論の光路差反射システム (ローレンツ因子・相対論的ドップラー・光行差・薄膜反射 Δ=2nd·cosθt・干渉輝度補正) と意図エンジンのコンシェルジュ「ミーミル」を搭載</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff05070d" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#05070d" />
  <!-- グラスは横長ディスプレイだが、手元操作は縦でも使うため回転自由 -->
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <!-- 投影中に画面が消えないよう維持 (グラスのミラー元になるため) -->
    <preference name="KeepRunning" value="true" />
  </platform>
</widget>
