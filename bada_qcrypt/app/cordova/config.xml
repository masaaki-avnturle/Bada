<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada QCrypt (量子暗号ソフト).
     ワークフロー (qcrypt-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_qcrypt/index.html) を差し込みます。
     このアプリは完全オフラインで、ネットワーク機能を一切使いません
     (鍵はメモリ内のみ、金庫・封印は端末内に暗号文だけを保管)。 -->
<widget id="io.github.masaaki_avnturle.badaqcrypt" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BadaQCrypt</name>
  <description>Bada QCrypt — 量子暗号ソフト。暗号処理 (BB84 量子鍵配送 / ワンタイムパッド / 検疫タグ) を量子プログラミング言語 Bada のプログラムとして記述し、光子 1 個ずつを状態ベクトル実行系に通します。量子検疫室では大切なテキスト・ファイルを量子封印し、ウイルス感染を含むあらゆる改変をバイト単位で検出して封印時の状態へ復元します。</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
