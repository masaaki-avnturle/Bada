<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Laevateinn.
     ワークフロー (laevateinn-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = laevateinn/index.html) を差し込みます。 -->
<widget id="io.github.masaaki_avnturle.laevateinn" version="3.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>Laevateinn</name>
  <description>Laevateinn — 自動走行の自動車アシスタントAI「アル」。トランスフォーマー知覚 (16レイ attention)、衛星を使わないWeb地図測位 (推測航法+ランドマーク補正+AEAD検証つき地図タイル受信) と人工衛星測位 (最小二乗トリラテレーション) の2モード、A* 経路計画。v2.0: 赤外線カメラ×温度計の熱画像からガンマ関数の大域的部分積分多様体エントロピー Ξ を求める熱画像知覚、口形 (無発声) によるサイレントトーク操縦。v3.0: 目的地を Bluetooth でタブレットへ送る目的地リンク (BLE ペリフェラル/NUS/送信機モード) と、受理→A*→自動発進→迂回再計画→到着→次へ の完全自動走行ミッション</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff070a12" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#070a12" />
  <preference name="Orientation" value="landscape" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <!-- 実車接続: cordova-plugin-ble-central (ワークフローが追加) が
         BLUETOOTH_SCAN / BLUETOOTH_CONNECT / 位置情報の権限を注入します。
         走行中も画面と BLE セッションを維持 -->
    <preference name="KeepRunning" value="true" />
    <!-- v2.0: 赤外線カメラ (外付け UVC) と サイレントトーク (前面カメラ) 用のカメラ権限。
         実行時の許可は cordova-plugin-android-permissions (ワークフローが追加) で要求し、
         WebView の getUserMedia は Cordova の WebChromeClient が許可します -->
    <config-file target="AndroidManifest.xml" parent="/manifest">
      <uses-permission android:name="android.permission.CAMERA" />
      <uses-feature android:name="android.hardware.camera" android:required="false" />
      <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    </config-file>
  </platform>
</widget>
