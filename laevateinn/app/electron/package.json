{
  "name": "laevateinn",
  "productName": "Laevateinn",
  "version": "1.0.0",
  "description": "Laevateinn — autonomous-driving car assistant AI 'Al': transformer perception over 16 sensor rays, satellite-free web-map positioning (dead reckoning + landmark fixes + AEAD-verified map tiles) and satellite positioning (least-squares trilateration), A* route planning, as a self-contained HTML app",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.laevateinn",
    "productName": "Laevateinn",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "Laevateinn-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "Laevateinn-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Science",
      "artifactName": "Laevateinn-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
