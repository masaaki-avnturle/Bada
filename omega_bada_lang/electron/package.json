{
  "name": "omega-bada-studio",
  "productName": "Omega-Bada-Studio",
  "version": "1.0.0",
  "description": "Ω-Bada Studio — the Bada language: compiler + interpreter + quantum backend (state-vector simulator + OpenQASM)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "repository": { "type": "git", "url": "https://github.com/masaaki-avnturle/Bada.git" },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.omega_bada_studio",
    "productName": "Omega-Bada-Studio",
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "artifactName": "Omega-Bada-Studio-${version}-${arch}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "synopsis": "The Bada language: compiler + interpreter + quantum backend",
      "maintainer": "Masaaki Yamaguchi <masaaki.tabu4@gmail.com>",
      "artifactName": "Omega-Bada-Studio-${version}-${arch}.${ext}"
    }
  }
}
