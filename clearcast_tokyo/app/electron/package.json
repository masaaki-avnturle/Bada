{
  "name": "clearcast-tokyo",
  "productName": "ClearCast Tokyo",
  "version": "1.0.0",
  "description": "ClearCast Tokyo — watch Tokyo TV and radio with zero noise via official digital streams only: official 24h YouTube news lives of the Tokyo key stations embedded in-app, one-tap links to TVer / NHK+ / ABEMA / radiko / NHK Radiru, and a clean-signal engine (RTT jitter stats, ITU-T G.107 E-model MOS, recommended quality and buffer). No unauthorized retransmission. Self-contained HTML app.",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.clearcast",
    "productName": "ClearCastTokyo",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "ClearCastTokyo-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "ClearCastTokyo-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "artifactName": "ClearCastTokyo-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
