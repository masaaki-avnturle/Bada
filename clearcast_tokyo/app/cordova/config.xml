<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of ClearCast Tokyo.
     ワークフロー (clearcast-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = clearcast_tokyo/index.html) を差し込みます。

     ・公式 YouTube 埋め込み (iframe) を WebView 内で再生するため
       youtube.com / youtube-nocookie.com への navigation を許可
     ・TVer / radiko などの外部リンクは allow-intent で端末の既定ブラウザ/公式アプリへ -->
<widget id="io.github.masaaki_avnturle.clearcast" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>ClearCast Tokyo</name>
  <description>クリアキャスト東京 — 東京のテレビ・ラジオを雑音・画像乱れゼロの公式デジタル配信で視聴。在京キー局の公式 24 時間ニュースライブ (YouTube 公式チャンネル) のアプリ内再生、TVer・NHKプラス・ABEMA・radiko・らじる★らじる への公式リンク、回線診断エンジン (RTT ジッタ統計 / ITU-T G.107 E モデル MOS / 推奨画質・推奨バッファ) を搭載。無許諾再送信は行いません。</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <!-- アプリ内の公式埋め込みプレーヤー (iframe) 用 -->
  <allow-navigation href="https://www.youtube.com/*" />
  <allow-navigation href="https://www.youtube-nocookie.com/*" />
  <allow-navigation href="https://*.ytimg.com/*" />
  <allow-navigation href="https://*.googlevideo.com/*" />
  <preference name="BackgroundColor" value="0xff05070d" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#05070d" />
  <!-- 視聴は横画面・操作は縦画面の両方を想定して回転自由 -->
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <!-- 音声・ラジオのバックグラウンド継続のため維持 -->
    <preference name="KeepRunning" value="true" />
  </platform>
</widget>
