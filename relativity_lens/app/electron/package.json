{
  "name": "bada-relativity-lens",
  "productName": "BadaRelativityLens",
  "version": "1.0.0",
  "description": "Bada Relativity Lens — runs any image through the optics of special relativity (relativistic aberration, Doppler shift, relativistic beaming, Terrell rotation) and then cancels the resulting visual misalignment with the exact inverse map. The aberration map is its own inverse under beta -> -beta, so the geometric correction is exact to machine precision. Self-contained offline HTML app.",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.badarelativitylens",
    "productName": "BadaRelativityLens",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaRelativityLens-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "BadaRelativityLens-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Graphics",
      "artifactName": "BadaRelativityLens-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
