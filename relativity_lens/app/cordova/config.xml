<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada Relativity Lens (相対論レンズ).
     ワークフロー (relativitylens-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = relativity_lens/index.html) を
     差し込みます。アプリは端末内で完結し、画像を外部へ送信しません。 -->
<widget id="io.github.masaaki_avnturle.badarelativitylens" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>BadaRelativityLens</name>
  <description>Bada Relativity Lens — 任意の画像を特殊相対性理論の光学 (相対論的光行差・ドップラー偏移・ビーミング・テレル回転) に通し、そこで生じる見た目のズレを厳密な逆変換で打ち消す「ズレ防止」アプリケーション。光時計の幾何 (鏡のバーと交差する光線) をそのまま実装しています。</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <!-- 端末のギャラリー / カメラから画像を選ぶため (<input type="file" accept="image/*">) -->
    <config-file target="AndroidManifest.xml" parent="/manifest">
      <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
      <uses-feature android:name="android.hardware.camera" android:required="false" />
    </config-file>
    <!-- タブレット / 分割画面でも状態を保ったままリサイズできるようにする -->
    <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application/activity">
      <activity android:resizeableActivity="true"
                android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|navigation|fontScale" />
    </edit-config>
  </platform>
</widget>
