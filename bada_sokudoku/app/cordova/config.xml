<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada 瞬読 (速読スタジオ).
     ワークフロー (sokudoku-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_sokudoku/index.html) を差し込みます。
     アプリはネットワークを一切使わず、頁の画像も解析も録画もすべて端末内で完結します。 -->
<widget id="io.github.masaaki_avnturle.badasokudoku" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BadaSokudoku</name>
  <description>Bada 瞬読 — 対象者の本の頁を画像処理トランスフォーマー (Swin 型の窓自己注意 + 注意ロールアウト) で解析し、文字の固まり・行・ブロック・読み順を復元して、視野幅と目標速度に合わせてブロックを順に照らす速読スタジオ。速読している画面はそのまま WebM 動画として録画できる。文字認識は行わず、頁の画像の上で「どこを見るか」だけを解く。</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
