{
  "name": "heatsense",
  "productName": "HeatSense",
  "version": "1.1.0",
  "description": "HeatSense — the real searches for transmission channels beyond EM/gravity: Dyson waste-heat IR (Wien's law + Jones heat palette), neutrinos (demonstrated at Fermilab 2012), axions, cosmic rays; entanglement honestly excluded",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.github.masaaki_avnturle.heatsense",
    "productName": "HeatSense",
    "publish": null,
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../www",
        "to": "www"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "HeatSense-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "artifactName": "HeatSense-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
