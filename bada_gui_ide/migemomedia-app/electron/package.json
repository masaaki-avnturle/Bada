{
  "name": "migemogram-media",
  "productName": "Migemogram Media",
  "version": "1.1.0",
  "description": "Migemogram Media — an Instagram-like gallery of your own photos/videos (PC + Google Drive/Photos), with pop-out (どアップ), video CM preview, migemo romaji search, and import into the ultra-network zone://url.or.jp",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.migemogrammedia",
    "productName": "Migemogram-Media",
    "publish": null,
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "Migemogram-Media-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Graphics",
      "artifactName": "Migemogram-Media-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
