{
  "name": "laevatein",
  "productName": "LAEVATEIN",
  "version": "1.0.0",
  "description": "LAEVATEIN — Λ-driver neutralization heat-budget simulator: gamma-function global integration-by-parts manifold, Jones/Landauer thermal accounting, and blue-LED electroluminescent cooling",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.laevatein",
    "productName": "LAEVATEIN",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "LAEVATEIN-${version}-x64-setup.${ext}"
    },
    "portable": { "artifactName": "LAEVATEIN-${version}-x64-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Science",
      "artifactName": "LAEVATEIN-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle",
      "desktop": {
        "Name": "LAEVATEIN",
        "Comment": "Λ ドライバ無力化シミュレータ — 暴走エネルギーの熱収支",
        "Categories": "Science;Physics;Education;"
      }
    }
  }
}
