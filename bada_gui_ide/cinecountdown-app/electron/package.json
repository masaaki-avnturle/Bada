{
  "name": "bada-cinecountdown",
  "productName": "BadaCineCountdown",
  "version": "1.0.0",
  "description": "Bada movie countdown editor - design a classic SMPTE film-leader countdown (sweeping hand, numbers, crosshair, grain, beep) and export it as WebM video, PNG, JSON or a standalone HTML player",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.cinecountdown",
    "productName": "BadaCineCountdown",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaCineCountdown-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BadaCineCountdown-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "BadaCineCountdown-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "artifactName": "BadaCineCountdown-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
