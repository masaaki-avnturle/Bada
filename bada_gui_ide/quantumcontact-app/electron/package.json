{
  "name": "quantumcontact",
  "productName": "QuantumContact",
  "version": "1.1.0",
  "description": "QuantumContact — compose an Arecibo-format interstellar message, protect it with a live BB84 quantum-key-distribution simulation (eavesdropper exposed at QBER 25 percent) and a Jones-polynomial key, and watch the real-scale light journey to real targets incl. the actually-messaged GJ 273b and M13; honest: zero contact as of 2026, no real transmission",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.github.masaaki_avnturle.quantumcontact",
    "productName": "QuantumContact",
    "publish": null,
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../www",
        "to": "www"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "QuantumContact-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "artifactName": "QuantumContact-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
