<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of MadoKey.
     注意: Android では他アプリのグローバル キーを奪って Word/Excel/LibreOffice を
     操作することはできません。APK は「設定エディタ」として動作し、キーバインドの
     編集・その場デモ・madokey.mayu / madokey.ahk の書き出しに使えます。
     実際の常駐キーバインドは Windows/Ubuntu のデスクトップ版で行います。 -->
<widget id="io.github.masaaki_avnturle.madokey" version="1.1.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>MadoKey</name>
  <description>窓使いのキー — Word/Excel/LibreOffice のキーバインド設定エディタ (ルビ/合計/コピー/独自バインド。窓使いの憂鬱オマージュ)</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <preference name="BackgroundColor" value="0xff04060a" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#04060a" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
