{
  "name": "madokey",
  "productName": "MadoKey",
  "version": "1.1.0",
  "description": "MadoKey (窓使いのキー) — a keybinding tool for Word/Excel/LibreOffice: bind keys to ruby, sum, copy and custom actions from an editable config file (homage to 窓使いの憂鬱)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.madokey",
    "productName": "MadoKey",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "MadoKey-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "artifactName": "MadoKey-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
