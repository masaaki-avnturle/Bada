# ============================================================
# zone.bada -- the SECURE zone:// URL scheme of the ULTRA NETWORK
# WWW, written in the Bada quantum programming language, hardened
# with the Jones-polynomial quantum cipher (omega_jones_crypto).
#
# zone://url.or.jp/ replaces https:// and http://: there is no
# DNS root and no origin server. A zone URL is resolved by the
# peers themselves -- a P2P ring (DHT) built from nothing but the
# peers' own hashes -- and every record is committed to the
# append-only tuplespace (the Akashic zone table).
#
# SECURITY (the quantum cipher, ported into Bada) ---------------
# The confidentiality + integrity layer is the same construction
# as omega_jones_crypto_pkg (relativity_jones_paper.pdf,
# quantum_computer4.pdf):
#   1. KEY   -- a zone's long-term key is DERIVED FROM A KNOT
#               DIAGRAM by sampling the Kauffman bracket / Jones
#               polynomial at several loop-variable values A and
#               hashing the results (jones_key). The knot is the
#               zone's secret; the polynomial is its key schedule.
#   2. QKD   -- a Bell pair (H + CNOT + Measure) agrees a fresh
#               per-session salt. Zero-preservation (the forbidden
#               |01>,|10> outcomes stay EXACTLY 0) is the tamper
#               evidence: a tapped channel breaks the correlation.
#   3. AEAD  -- content is encrypted under a keystream seeded by
#               (jones_key, session salt) and sealed with a keyed
#               authentication tag (zone_seal / zone_open). A
#               forged or tampered record fails the tag and is
#               rejected 409; a peer without the knot cannot read
#               the plaintext at all (confidentiality).
#
# Layer cake (after dessrtist.pdf, the Dessertist architecture) --
#   L1 sponge  : zone:// naming        (URL parser, pure Bada)
#   L2 cream   : P2P resolution        (chaotic ring DHT, caostics)
#   L3 topping : quantum cipher guard  (Jones-key AEAD + Bell QKD)
#   L4 cherry  : precog cache          (PrecogBada: entropy of the
#                                       next fetch decreases)
# ============================================================

print("================================================================")
print("SECURE ZONE BADA -- zone:// ultra-network WWW + Jones quantum cipher")
print("================================================================")

RING := 4096

# ---- grammar transaction: teach the parser the zone verbs -----------
@reviser : grammar {
    rule "zone-put" stmt [ 'PUT' expr expr ] => zone_publish(NET, _1, _2)
    rule "zone-get" stmt [ 'GET' expr ]      => zone_get(NET, _1)
}
print("zone verbs committed to the grammar ledger:", len(tuplespace), "facts")

# ====================================================================
# L1 sponge: zone:// naming, in pure Bada
# ====================================================================
def str_hash(s) {
    h := 7
    i := 0
    n := len(s)
    while (i < n) {
        h := (h * 31 + ord(s, i)) % 999983
        i := i + 1
    }
    return h
}

def zone_id(s) { return str_hash(s) % RING }

# zone://host/path -> [host, path, labels]  ([] if not a zone URL)
def zone_parse(url) {
    if (str_find(url, "zone://") != 0) { return [] }
    rest := substr(url, 7, len(url) - 7)
    cut := str_find(rest, "/")
    if (cut < 0) { return [rest, "/", split(rest, ".")] }
    host := substr(rest, 0, cut)
    path := substr(rest, cut, len(rest) - cut)
    return [host, path, split(host, ".")]
}

# ====================================================================
# L3 (key schedule): the Jones-polynomial quantum cipher, in Bada
# --------------------------------------------------------------------
# The Kauffman bracket state sum <D>(A) = sum over A/B smoothings of
# A^(a-b) * d^(loops-1),  d = -A^2 - 1/A^2 .  Sampling it at several A
# and hashing yields the zone's key -- exactly the derivation shipped
# in omega_jones_crypto_pkg/lib/jones_key.c, transcribed into Bada.
# ====================================================================
def ipow(base, e) {
    if (e < 0) {
        r := 1.0
        k := 0
        m := 0 - e
        while (k < m) { r := r * base; k := k + 1 }
        return 1.0 / r
    }
    r := 1.0
    k := 0
    while (k < e) { r := r * base; k := k + 1 }
    return r
}

def uf_find(parent, x) {
    r := x
    while (parent[r] >= 0) { r := parent[r] }
    return r
}

# a crossing is [id, e0, e1, e2, e3, sign]; the bracket ignores sign
def kauffman(cross, A) {
    n := len(cross)
    if (n == 0) { return 1.0 }
    maxlbl := 0
    i := 0
    while (i < n) {
        k := 1
        while (k <= 4) {
            if (cross[i][k] > maxlbl) { maxlbl := cross[i][k] }
            k := k + 1
        }
        i := i + 1
    }
    U := maxlbl + 1
    states := 1
    p := 0
    while (p < n) { states := states * 2; p := p + 1 }
    d := (0 - (A * A)) - (1.0 / (A * A))
    sum := 0.0
    bits := []
    i := 0
    while (i < n) { bits <- 0; i := i + 1 }
    st := 0
    while (st < states) {
        parent := []
        q := 0
        while (q < U) { parent <- (0 - 1); q := q + 1 }
        a_cnt := 0
        b_cnt := 0
        i := 0
        while (i < n) {
            e0 := cross[i][1]
            e1 := cross[i][2]
            e2 := cross[i][3]
            e3 := cross[i][4]
            if (bits[i] == 0) {
                ra := uf_find(parent, e0)
                rb := uf_find(parent, e1)
                if (ra != rb) { parent[ra] = rb }
                ra := uf_find(parent, e2)
                rb := uf_find(parent, e3)
                if (ra != rb) { parent[ra] = rb }
                a_cnt := a_cnt + 1
            } else {
                ra := uf_find(parent, e1)
                rb := uf_find(parent, e2)
                if (ra != rb) { parent[ra] = rb }
                ra := uf_find(parent, e3)
                rb := uf_find(parent, e0)
                if (ra != rb) { parent[ra] = rb }
                b_cnt := b_cnt + 1
            }
            i := i + 1
        }
        seen := []
        q := 0
        while (q < U) { seen <- 0; q := q + 1 }
        loops := 0
        lbl := 0
        while (lbl < U) {
            r := uf_find(parent, lbl)
            if (seen[r] == 0) { seen[r] = 1; loops := loops + 1 }
            lbl := lbl + 1
        }
        weight := ipow(A, a_cnt - b_cnt)
        lf := ipow(d, loops - 1)
        sum := sum + weight * lf
        c := 0
        carry := 1
        while (c < n && carry == 1) {
            if (bits[c] == 0) { bits[c] = 1; carry := 0 }
            else { bits[c] = 0 }
            c := c + 1
        }
        st := st + 1
    }
    return sum
}

# derive a zone key from a knot diagram (Jones sampling + hash)
def jones_key(diagram) {
    As := [0.8, 1.0, 1.2, 1.5, 2.0]
    acc := "jones|"
    i := 0
    while (i < len(As)) {
        acc := acc + f5(kauffman(diagram, As[i])) + "|"
        i := i + 1
    }
    return str_hash(acc)
}

# the zone's identity knots (its secret). trefoil for url.or.jp,
# figure-eight for bada.or.jp -- distinct knots => distinct keys.
def zone_diagram(host) {
    if (host == "bada.or.jp") {
        return [ [0,1,2,3,4,1], [1,3,4,5,6,1], [2,5,6,7,8,1], [3,7,8,1,2,1] ]
    }
    return [ [0,1,2,3,4,1], [1,3,4,5,6,1], [2,5,6,1,2,1] ]
}

# ---- the keystream AEAD (seeded by the Jones key + session salt) ----
def lcg(state) { return (state * 48271) % 2147483647 }

def key_seed(key, salt) {
    state := (key + salt * 2654435761) % 2147483647
    if (state <= 0) { state := state + 2147483646 }
    return state
}

# the keystream works on 16-bit code units so any character (incl. CJK)
# round-trips through encrypt/decrypt.
def zone_encrypt(plain, key, salt) {
    state := key_seed(key, salt)
    out := []
    i := 0
    while (i < len(plain)) {
        state := lcg(state)
        out <- (ord(plain, i) + (state % 65536)) % 65536
        i := i + 1
    }
    return out
}

def zone_decrypt(ct, key, salt) {
    state := key_seed(key, salt)
    out := ""
    i := 0
    while (i < len(ct)) {
        state := lcg(state)
        out := out + chr((ct[i] - (state % 65536) + 65536) % 65536)
        i := i + 1
    }
    return out
}

# keyed authentication tag over the ciphertext (GCM-style seal)
def zone_tag(ct, key, salt) {
    h := (key % 999983) + salt + 1
    i := 0
    while (i < len(ct)) {
        h := (h * 31 + ct[i] + 7) % 2147483647
        i := i + 1
    }
    return h
}

# seal -> [ciphertext, salt, tag] ; open -> plaintext or "" on failure
def zone_seal(plain, key, salt) {
    ct := zone_encrypt(plain, key, salt)
    return [ct, salt, zone_tag(ct, key, salt)]
}

def zone_open(sealed, key) {
    ct := sealed[0]
    salt := sealed[1]
    tag := sealed[2]
    if (zone_tag(ct, key, salt) != tag) { return [] }
    return [zone_decrypt(ct, key, salt)]
}

# ---- Bell-pair QKD: fresh session salt + channel-tamper evidence ----
def qkd_session() {
    bell := qubit(2)
    bell := H(bell, 0)
    bell := CNOT(bell, 0, 1)
    outcome := Measure(bell)
    ok := (outcome[1] == 0) && (outcome[2] == 0)
    salt := (len(tuplespace) * 131 + 17) % 4096
    return [ok, salt]
}

# ====================================================================
# L2 cream: the P2P ring (chaotic circular manifold metric)
# ====================================================================
def ring_dist(a, b) {
    d := a - b
    if (d < 0) { d := 0 - d }
    e := RING - d
    if (e < d) { return e }
    return d
}

# a peer is [name, node-id, store, ring-index]
def peer_new(name) { return [name, zone_id("peer:" + name), [], 0] }

def net_sort(net) {
    sorted := []
    i := 0
    while (i < len(net)) {
        p := net[i]
        pos := len(sorted)
        found := false
        j := 0
        while (j < len(sorted)) {
            if (!found) {
                if (p[1] < sorted[j][1]) { pos := j; found := true }
            }
            j := j + 1
        }
        out := []
        k := 0
        while (k < len(sorted)) {
            if (k == pos) { out <- p }
            out <- sorted[k]
            k := k + 1
        }
        if (pos == len(sorted)) { out <- p }
        sorted := out
        i := i + 1
    }
    m := 0
    while (m < len(sorted)) { sorted[m][3] = m; m := m + 1 }
    return sorted
}

def peer_neighbors(net, p) {
    n := len(net)
    i := p[3]
    return [ net[(i + 1) % n], net[(i + n - 1) % n], net[(i + 2) % n] ]
}

def dht_nearest(net, key) {
    best := net[0]
    bd := ring_dist(best[1], key)
    i := 1
    while (i < len(net)) {
        d := ring_dist(net[i][1], key)
        if (d < bd) { best := net[i]; bd := d }
        i := i + 1
    }
    return best
}

def zone_route(net, key) {
    route := []
    cur := net[0]
    route <- cur[0]
    hop := 0
    moved := true
    while (moved && hop < 16) {
        moved := false
        nb := peer_neighbors(net, cur)
        best := cur
        j := 0
        while (j < 3) {
            if (ring_dist(nb[j][1], key) < ring_dist(best[1], key)) { best := nb[j] }
            j := j + 1
        }
        if (best[1] != cur[1]) { cur := best; route <- cur[0]; moved := true }
        hop := hop + 1
    }
    return route
}

def store_lookup(store, url) {
    i := 0
    while (i < len(store)) {
        if (store[i][0] == url) { return store[i] }
        i := i + 1
    }
    return []
}

# ====================================================================
# publish / fetch  (encrypted end to end with the Jones key)
# ====================================================================
def zone_publish(net, url, content) {
    p := zone_parse(url)
    if (len(p) == 0) { print("PUT", url, ": 400 not a zone:// URL"); return false }
    host := p[0]
    key := zone_id(url)
    owner := dht_nearest(net, key)
    jk := jones_key(zone_diagram(host))
    sess := qkd_session()
    salt := sess[1]
    sealed := zone_seal(content, jk, salt)         # [ct, salt, tag]
    rec := store_lookup(owner[2], url)
    if (len(rec) == 0) { owner[2] <- [url, sealed[0], sealed[1], sealed[2]] }
    else { rec[1] = sealed[0]; rec[2] = sealed[1]; rec[3] = sealed[2] }
    ["zone-record", url, owner[0], key, sealed[2]] >> tuplespace
    print("PUT", url, "-> node", owner[0])
    print("    encrypted", len(sealed[0]), "bytes (Jones key, salt", salt, ", tag", sealed[2], ")")
    return true
}

def zone_get(net, url) {
    print("")
    print("GET", url)
    p := zone_parse(url)
    if (len(p) == 0) { print("  status  : 400 not a zone:// URL"); return "" }
    print("  zone    : host", p[0], " path", p[1], " labels", p[2])
    host := p[0]
    key := zone_id(url)
    route := zone_route(net, key)
    owner := dht_nearest(net, key)
    sess := qkd_session()
    if (sess[0]) { print("  qkd     : Bell-pair session ok (|01>,|10> stayed 0; channel untapped)") }
    else { print("  qkd     : channel compromised -- abort"); return "" }
    print("  key     :", key, " route :", route)
    rec := store_lookup(owner[2], url)
    if (len(rec) == 0) { print("  status  : 404 zone-not-found on", owner[0]); return "" }
    ["zone-fetch", url, owner[0]] >> tuplespace
    jk := jones_key(zone_diagram(host))
    sealed := [ rec[1], rec[2], rec[3] ]
    opened := zone_open(sealed, jk)                # AEAD verify + decrypt
    if (len(opened) == 0) {
        print("  guard   : AEAD TAG FAILED -- forged/tampered or wrong knot (Jones cipher)")
        print("  status  : 409 zone-guard-reject")
        return ""
    }
    print("  cipher  : [" + f5(rec[1][0]) + ", " + f5(rec[1][1]) + ", " + f5(rec[1][2]) + ", ...] (" + f5(len(rec[1])) + " bytes on the wire)")
    print("  guard   : Jones-key AEAD verified (tag", rec[3], ")")
    print("  status  : 200 zone-delivered from", owner[0])
    print("  body    :", opened[0])
    return opened[0]
}

# ====================================================================
# boot the ultra network -- six peers, no server
# ====================================================================
raw := []
raw <- peer_new("tokyo.zone.jp")
raw <- peer_new("osaka.zone.jp")
raw <- peer_new("nagoya.zone.jp")
raw <- peer_new("sapporo.zone.jp")
raw <- peer_new("fukuoka.zone.jp")
raw <- peer_new("naha.zone.jp")
NET := net_sort(raw)

print("")
print("ultra-network ring (RING =", RING, ", built from peer hashes):")
for p in NET {
    print("  node", p[3], ":", p[0], " id =", p[1])
}

print("")
print("zone identity knots -> Jones keys:")
print("  url.or.jp  (trefoil)      key =", jones_key(zone_diagram("url.or.jp")))
print("  bada.or.jp (figure-eight) key =", jones_key(zone_diagram("bada.or.jp")))

# ---- publish the encrypted zone WWW ---------------------------------
print("")
PUT "zone://url.or.jp/" "<zone-page>| Ultra Network home | a worldwide web with no http, no center, no single point of failure"
PUT "zone://url.or.jp/labs/quantum" "<zone-page>| Bada quantum lab | qubits route the zone"
PUT "zone://bada.or.jp/" "<zone-page>| Bada language portal | programs are ledger facts"

# ---- browse it ------------------------------------------------------
GET "zone://url.or.jp/"
GET "zone://url.or.jp/labs/quantum"
GET "zone://mist.or.jp/void"

# ---- attack 1: tamper with the stored ciphertext --------------------
print("")
print("================================================================")
print("attack 1: flip a ciphertext byte in the owner's store")
print("================================================================")
key := zone_id("zone://url.or.jp/")
victim := dht_nearest(NET, key)
rec := store_lookup(victim[2], "zone://url.or.jp/")
rec[1][0] = (rec[1][0] + 1) % 65536
GET "zone://url.or.jp/"

# heal: republish -- the append-only Akashic record still holds truth
print("")
PUT "zone://url.or.jp/" "<zone-page>| Ultra Network home | restored from the append-only Akashic record"
GET "zone://url.or.jp/"

# ---- attack 2: an eavesdropper without the knot ---------------------
print("")
print("================================================================")
print("attack 2: eavesdropper reads the store but lacks the trefoil knot")
print("================================================================")
rec := store_lookup(victim[2], "zone://url.or.jp/")
wrong := jones_key(zone_diagram("bada.or.jp"))   # attacker guesses wrong knot
sealed := [ rec[1], rec[2], rec[3] ]
opened := zone_open(sealed, wrong)
if (len(opened) == 0) {
    print("  eavesdropper: AEAD tag fails under the wrong Jones key -> cannot read")
} else {
    print("  eavesdropper: leaked", opened[0])
}
print("  ciphertext on the wire stays opaque:", rec[1][0], rec[1][1], rec[1][2], "...")

# ---- L4 cherry: precog prefetch (PrecogBada) ------------------------
print("")
print("================================================================")
print("precog cache -- the network learns the next fetch (entropy drops)")
print("================================================================")
sites := ["zone://url.or.jp/", "zone://url.or.jp/labs/quantum", "zone://bada.or.jp/"]
prior := unknown_prior(3)
print("  prior over next fetch  :", prior, " entropy =", entropy(prior))
prior := update(prior, [0.0, 1.0, 0.0])
prior := update(prior, [0.0, 1.0, 0.0])
prior >> tuplespace
print("  after 2 observed hits  :", prior, " entropy =", entropy(prior))
print("  prefetch decision      ->", sites[1])

# ---- the Akashic zone table -----------------------------------------
print("")
print("Akashic zone table: ledger =", len(tuplespace), "append-only facts")
print("(grammar rules + encrypted zone records + fetches + measurements + priors)")
print("================================================================")
