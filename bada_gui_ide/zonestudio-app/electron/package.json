{
  "name": "zone-studio",
  "productName": "Zone Studio",
  "version": "1.1.0",
  "description": "Zone Studio — author your own WWW addressed by zone:// URIs and publish it into the ultra-network over the NTT NGN line (UltraDatabase quorum + Jones quantum cipher), written in the Bada quantum language",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.zonestudio",
    "productName": "Zone-Studio",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "Zone-Studio-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "artifactName": "Zone-Studio-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
