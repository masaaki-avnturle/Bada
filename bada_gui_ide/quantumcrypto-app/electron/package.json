{
  "name": "bada-quantumcrypto",
  "productName": "BadaQuantumCrypto",
  "version": "1.0.0",
  "description": "Bada QuantumCrypto — Jones-polynomial quantum cipher encrypt/decrypt tool (Kauffman bracket key derivation + Bell-pair QKD salt + ChaCha20/HMAC AEAD)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.quantumcrypto",
    "productName": "BadaQuantumCrypto",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaQuantumCrypto-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BadaQuantumCrypto-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "BadaQuantumCrypto-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "artifactName": "BadaQuantumCrypto-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
