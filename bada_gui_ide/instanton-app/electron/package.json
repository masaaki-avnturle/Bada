{
  "name": "instanton",
  "productName": "InstantOn",
  "version": "1.1.0",
  "description": "InstantOn — power off saves state to disk (hibernate / fast startup) so the next power-on skips the normal boot and resumes instantly from where you left off",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.instanton",
    "productName": "InstantOn",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "InstantOn-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "System",
      "artifactName": "InstantOn-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
