{
  "name": "bada-quantumshield",
  "productName": "BadaQuantumShield",
  "version": "1.0.0",
  "description": "Bada QuantumShield - quantum-key-synchronized moving-target defense: on attacker contact it rotates a service port/IP/password so the intruder is locked out (concept simulation)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.quantumshield",
    "productName": "BadaQuantumShield",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaQuantumShield-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BadaQuantumShield-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "BadaQuantumShield-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "artifactName": "BadaQuantumShield-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
