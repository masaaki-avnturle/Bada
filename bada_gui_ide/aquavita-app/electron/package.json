{
  "name": "aquavita",
  "productName": "AquaVita",
  "version": "1.1.0",
  "description": "AquaVita — atlas of the real water of life and tree of life in space: the 140-trillion-ocean quasar water reservoir, galactic water masers, the subsurface oceans of Enceladus/Europa, the Pillars of Creation, Sgr B2 sugar, uracil in the Ryugu sample and all five nucleobases in Bennu — positions, surroundings and imagery, analysed with the Gamma partial-integral manifold and Jones-polynomial heat sensing",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.github.masaaki_avnturle.aquavita",
    "productName": "AquaVita",
    "publish": null,
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../www",
        "to": "www"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "AquaVita-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "artifactName": "AquaVita-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
