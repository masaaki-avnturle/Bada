{
  "name": "safepower",
  "productName": "SafePower",
  "version": "1.1.0",
  "description": "SafePower — safe instant power-off (sync + hibernate so a sudden power cut can't corrupt anything) and a rehalt-style soft reboot (reload the OS without a full hardware restart)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.safepower",
    "productName": "SafePower",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "SafePower-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "System",
      "artifactName": "SafePower-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
