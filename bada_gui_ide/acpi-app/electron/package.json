{
  "name": "acpi",
  "productName": "ACPI",
  "version": "1.0.0",
  "description": "ACPI — 原子の臨界期の強度シミュレータ (Atomic Critical-Period Intensity): barrier-suppression field, ADK tunnelling and the Yamaguchi Omega operator layer",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.acpi",
    "productName": "ACPI",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "ACPI-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Science",
      "artifactName": "ACPI-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle",
      "desktop": {
        "Name": "ACPI",
        "Comment": "原子の臨界期の強度シミュレータ",
        "Categories": "Science;Physics;Education;"
      }
    }
  }
}
