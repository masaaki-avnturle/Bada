// qevolve.bada — a self-evolving quantum-algorithm source-code prototype, Bada.
//
// A quantum program is a gene: a sequence of real-amplitude meta-gates
//   0 = IDENTITY, 1 = ORACLE (phase-flip the marked state),
//   2 = DIFFUSE  (inversion about the mean).
// A genetic algorithm (tournament selection + crossover + mutation, elitism)
// evolves the gene to maximize the amplitude on the marked state — rediscovering
// Grover amplification by selection.  emit_source() then writes the evolved
// program back out *as Bada source code*: the self-evolving source-code seed.
//
// Reuses fsqrt / pow2 via qcache.bada (-> hologram.bada).

#include qcache.bada

// --- the quantum machine the gene programs --------------------------------
def uniform_amp(nq) {
  bign <- pow2(nq)
  amp <- []
  a0 <- 1.0 / fsqrt(bign)
  i <- 0
  -> i < bign { append(amp, a0)  i <- i + 1 }
  return amp
}

def apply_oracle(amp, m) { amp[m] <- 0 - amp[m]  return 0 }

def apply_diffuse(amp) {
  n <- len(amp)
  s <- 0.0
  i <- 0
  -> i < n { s <- s + amp[i]  i <- i + 1 }
  mean <- s / n
  i <- 0
  -> i < n { amp[i] <- 2.0 * mean - amp[i]  i <- i + 1 }
  return 0
}

// run a gene (gate sequence) and return the final amplitude vector
def run_program(nq, marked, prog) {
  amp <- uniform_amp(nq)
  i <- 0
  -> i < len(prog) {
    g <- prog[i]
    -< g <-> 1 { apply_oracle(amp, marked) }
    -< g <-> 2 { apply_diffuse(amp) }
    i <- i + 1
  }
  return amp
}

// fitness = probability on the marked state = |amplitude|^2
def fitness(nq, marked, prog) {
  amp <- run_program(nq, marked, prog)
  return amp[marked] * amp[marked]
}

// --- deterministic PRNG (LCG); state threaded through a 1-element array ----
def nextr(rng) {
  rng[0] <- imod(1103515245 * rng[0] + 12345, 2147483648)
  return rng[0]
}
def randint(rng, n) { return imod(nextr(rng), n) }

// --- genetic operators -----------------------------------------------------
def random_prog(rng, L) {
  out <- []
  i <- 0
  -> i < L { append(out, randint(rng, 3))  i <- i + 1 }
  return out
}

def copy_prog(p) {
  out <- []
  i <- 0
  -> i < len(p) { append(out, p[i])  i <- i + 1 }
  return out
}

def mutate(rng, p, rate) {
  out <- copy_prog(p)
  i <- 0
  -> i < len(out) {
    -< randint(rng, rate) <-> 0 { out[i] <- randint(rng, 3) }
    i <- i + 1
  }
  return out
}

def crossover(rng, a, b) {
  pt <- randint(rng, len(a))
  out <- []
  i <- 0
  -> i < len(a) {
    -< i < pt { append(out, a[i]) } >- { append(out, b[i]) }
    i <- i + 1
  }
  return out
}

def tournament(rng, pops, nq, marked) {
  i <- randint(rng, len(pops))
  j <- randint(rng, len(pops))
  fi <- fitness(nq, marked, pops[i])
  fj <- fitness(nq, marked, pops[j])
  -< fi >= fj { return copy_prog(pops[i]) }
  return copy_prog(pops[j])
}

// --- the evolution loop ----------------------------------------------------
// returns [best_program, best_fitness_per_generation]
def evolve_run(nq, marked, L, pop_n, gens, seed) {
  rng <- [seed]
  pops <- []
  i <- 0
  -> i < pop_n { append(pops, random_prog(rng, L))  i <- i + 1 }

  best <- copy_prog(pops[0])
  bestf <- fitness(nq, marked, best)
  curve <- []

  g <- 0
  -> g < gens {
    i <- 0
    -> i < pop_n {
      f <- fitness(nq, marked, pops[i])
      -< f > bestf { bestf <- f  best <- copy_prog(pops[i]) }
      i <- i + 1
    }
    append(curve, bestf)

    newpop <- []
    append(newpop, copy_prog(best))            // elitism
    -> len(newpop) < pop_n {
      a <- tournament(rng, pops, nq, marked)
      b <- tournament(rng, pops, nq, marked)
      child <- crossover(rng, a, b)
      child <- mutate(rng, child, 4)
      append(newpop, child)
    }
    pops <- newpop
    g <- g + 1
  }
  return [best, curve]
}

def evolve_best(nq, marked, L, pop_n, gens, seed) {
  r <- evolve_run(nq, marked, L, pop_n, gens, seed)
  return r[0]
}

def evolve_curve(nq, marked, L, pop_n, gens, seed) {
  r <- evolve_run(nq, marked, L, pop_n, gens, seed)
  return r[1]
}

// --- source-code-ization: write the evolved program back out as Bada -------
def emit_source(nq, marked, prog) {
  out <- "// evolved quantum algorithm — self-generated by qevolve\n"
  out <- out + "def evolved_amp() {\n"
  out <- out + "  amp <- uniform_amp(" + nq + ")\n"
  i <- 0
  -> i < len(prog) {
    g <- prog[i]
    -< g <-> 1 { out <- out + "  apply_oracle(amp, " + marked + ")\n" }
    -< g <-> 2 { out <- out + "  apply_diffuse(amp)\n" }
    i <- i + 1
  }
  out <- out + "  return amp\n}\n"
  out <- out + "def evolved_fitness() {\n"
  out <- out + "  a <- evolved_amp()\n"
  out <- out + "  return a[" + marked + "] * a[" + marked + "]\n}\n"
  print out
  return 0
}
