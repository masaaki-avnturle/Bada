// keyboard.bada — the Happy Hacking Keyboard (HHKB Professional, US) layout,
// in Bada, for the holographic floating keyboard.
//
// The layout is returned as a flat list of keys [x, y, w, code]:
//   x  : left edge in key-units (U), accumulated per row
//   y  : row index 0..4 (top to bottom)
//   w  : width in U
//   code: ASCII for printable keys, 256+ for specials, 0 = blank (skipped)
// Python maps `code` to the glyph; the geometry (which key, where, how wide —
// the HHKB arrangement itself) lives here in Bada.
//
// Signature HHKB traits captured: 60% size (no F-row, no arrows/nav), Control
// where Caps Lock sits (left of A), split right Shift + Fn, a 1U Delete at the
// top-right (no wide Backspace), a 6U spacebar with diamond/Alt keys and the
// iconic sparse bottom corners.

// special key codes
def K_ESC()   { return 256 }
def K_TAB()   { return 257 }
def K_CTRL()  { return 258 }
def K_SHIFT() { return 259 }
def K_ENTER() { return 260 }
def K_DEL()   { return 261 }
def K_FN()    { return 262 }
def K_SUPER() { return 263 }
def K_ALT()   { return 264 }
def K_SPACE() { return 265 }
def K_BLANK() { return 0 }

// append every key of one row (list of [w, code]) at row y, accumulating x.
// blanks (code 0) advance x but emit no key (the HHKB's empty corners).
def kbd_row(out, keys, y) {
  x <- 0.0
  i <- 0
  -> i < len(keys) {
    w <- keys[i][0]
    code <- keys[i][1]
    -< code != 0 { append(out, [x, y, w, code]) }
    x <- x + w
    i <- i + 1
  }
  return out
}

// the full HHKB layout (60 keys over 5 rows, 15U wide)
def hhkb_keys() {
  out <- []

  // row 0: Esc 1 2 3 4 5 6 7 8 9 0 - = \ Del   (all 1U)
  r0 <- [[1, 256], [1, 49], [1, 50], [1, 51], [1, 52], [1, 53], [1, 54],
         [1, 55], [1, 56], [1, 57], [1, 48], [1, 45], [1, 61], [1, 92],
         [1, 261]]
  kbd_row(out, r0, 0)

  // row 1: Tab(1.5) Q W E R T Y U I O P [ ] `(1.5)
  r1 <- [[1.5, 257], [1, 81], [1, 87], [1, 69], [1, 82], [1, 84], [1, 89],
         [1, 85], [1, 73], [1, 79], [1, 80], [1, 91], [1, 93], [1.5, 96]]
  kbd_row(out, r1, 1)

  // row 2: Control(1.75) A S D F G H J K L ; ' Enter(2.25)
  r2 <- [[1.75, 258], [1, 65], [1, 83], [1, 68], [1, 70], [1, 71], [1, 72],
         [1, 74], [1, 75], [1, 76], [1, 59], [1, 39], [2.25, 260]]
  kbd_row(out, r2, 2)

  // row 3: Shift(2.25) Z X C V B N M , . / Shift(1.75) Fn(1)
  r3 <- [[2.25, 259], [1, 90], [1, 88], [1, 67], [1, 86], [1, 66], [1, 78],
         [1, 77], [1, 44], [1, 46], [1, 47], [1.75, 259], [1, 262]]
  kbd_row(out, r3, 3)

  // row 4: [blank 2] Super(1.5) Alt(1) Space(6) Alt(1) Super(1.5) [blank 2]
  r4 <- [[2.0, 0], [1.5, 263], [1, 264], [6, 265], [1, 264], [1.5, 263],
         [2.0, 0]]
  kbd_row(out, r4, 4)

  return out
}

def hhkb_width()  { return 15 }
def hhkb_rows()   { return 5 }
def hhkb_count()  { return len(hhkb_keys()) }
