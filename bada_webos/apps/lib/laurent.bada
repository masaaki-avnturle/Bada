// laurent.bada — Laurent polynomials in A, written in the Bada language.
//
// A polynomial is an array of [exponent, coefficient] terms, e.g.
//   A^2 - A^-2   is   [[2, 1], [-2, -1]]
// This is the algebra the Kauffman bracket lives in (see jones.bada).

// a single monomial c*A^e  (empty polynomial when c = 0)
def lt_mono(e, c) {
  if c == 0 { return [] }
  return [[e, c]]
}

// add coefficient c at exponent e into accumulator acc (mutating)
def lt_addinto(acc, e, c) {
  i <- 0
  while i < len(acc) {
    if acc[i][0] == e {
      acc[i][1] <- acc[i][1] + c
      return acc
    }
    i <- i + 1
  }
  append(acc, [e, c])
  return acc
}

// drop zero-coefficient terms, returning a fresh polynomial
def lt_clean(p) {
  out <- []
  i <- 0
  while i < len(p) {
    if p[i][1] != 0 { append(out, [p[i][0], p[i][1]]) }
    i <- i + 1
  }
  return out
}

// p + q
def lt_add(p, q) {
  acc <- []
  i <- 0
  while i < len(p) {
    lt_addinto(acc, p[i][0], p[i][1])
    i <- i + 1
  }
  j <- 0
  while j < len(q) {
    lt_addinto(acc, q[j][0], q[j][1])
    j <- j + 1
  }
  return lt_clean(acc)
}

// p * q  (distribute every pair of terms)
def lt_mul(p, q) {
  acc <- []
  i <- 0
  while i < len(p) {
    j <- 0
    while j < len(q) {
      lt_addinto(acc, p[i][0] + q[j][0], p[i][1] * q[j][1])
      j <- j + 1
    }
    i <- i + 1
  }
  return lt_clean(acc)
}

// p ^ n   (n >= 0)
def lt_pow(p, n) {
  r <- [[0, 1]]
  k <- 0
  while k < n {
    r <- lt_mul(r, p)
    k <- k + 1
  }
  return r
}

// coefficient of A^e in p (0 if absent)
def lt_get(p, e) {
  i <- 0
  while i < len(p) {
    if p[i][0] == e { return p[i][1] }
    i <- i + 1
  }
  return 0
}

// insertion sort of terms by ascending exponent (fresh array)
def lt_sort(p) {
  out <- []
  i <- 0
  while i < len(p) {
    append(out, [p[i][0], p[i][1]])
    i <- i + 1
  }
  i <- 1
  while i < len(out) {
    j <- i
    while j > 0 {
      if out[j - 1][0] > out[j][0] {
        t0 <- out[j][0]
        t1 <- out[j][1]
        out[j][0] <- out[j - 1][0]
        out[j][1] <- out[j - 1][1]
        out[j - 1][0] <- t0
        out[j - 1][1] <- t1
        j <- j - 1
      } else {
        j <- 0
      }
    }
    i <- i + 1
  }
  return out
}
