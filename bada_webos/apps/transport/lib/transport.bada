// transport.bada — "Integrate of theorem" equation generator + manifolds, in Bada.
//
// From the report (middle pages):
//   zeta(x) = P^{2n} * sum_{k>=0} a_k x^k ,   a_k = sum_r nCr  (binomial),
//   sum a_k f^k = 1/(1-z)  (geometric closure),  chi(x) = (-1)^k a_k,
//   Gamma = Beta,  AM-GM  (x+y)/2 >= sqrt(xy),  zeta steady on Re = 1/2.
// So a_k = C(n,r) makes  sum a_k f^k = (1+f)^n  exactly, and zeta generates the
// equation group through this binomial series.

// ---------- math ----------
def two_pi() { return 6.283185307179586 }
def fabs(v) { -< v < 0 { return 0 - v }  return v }
def fpow(b, n) { r <- 1.0  k <- 0  -> k < n { r <- r * b  k <- k + 1 } return r }

def fsqrt(x) {
  -< x <= 0 { return 0 }
  g <- x  i <- 0
  -> i < 40 { g <- (g + x / g) / 2  i <- i + 1 }
  return g
}

def fsin(theta) {
  tp <- 6.283185307179586  pi <- 3.141592653589793
  m <- idiv(theta / tp, 1)  x <- theta - m * tp
  -> x > pi { x <- x - tp }
  -> x < 0 - pi { x <- x + tp }
  x2 <- x * x  term <- x  sum <- x  n <- 1
  -> n < 8 { d <- (2 * n) * (2 * n + 1)  term <- 0 - term * x2 / d
    sum <- sum + term  n <- n + 1 }
  return sum
}
def fcos(theta) { return fsin(theta + 1.5707963267948966) }

def fexp(x) {
  term <- 1.0  sum <- 1.0  k <- 1
  -> k < 40 { term <- term * x / k  sum <- sum + term  k <- k + 1 }
  return sum
}
def fln(x) {
  y <- (x - 1.0) / (x + 1.0)  y2 <- y * y
  term <- y  sum <- y  k <- 1
  -> k < 40 { term <- term * y2  sum <- sum + term / (2 * k + 1)  k <- k + 1 }
  return 2 * sum
}

def zeta(s, N) {
  total <- 0.0  k <- 1
  -> k <= N { total <- total + 1.0 / fpow(k, s)  k <- k + 1 }
  return total
}

// ---------- the equation generator (report relations) ----------

// binomial coefficient C(n,r)  (the report's a_k = sum_r nCr)
def binom(n, r) {
  -< r < 0 { return 0 }
  -< r > n { return 0 }
  c <- 1  i <- 1
  -> i <= r { c <- c * (n - i + 1) / i  i <- i + 1 }
  return c
}

// sum_{r=0}^{n} C(n,r) f^r  == (1+f)^n  (the binomial equation group)
def series_binom(n, f) {
  s <- 0.0  r <- 0
  -> r <= n { s <- s + binom(n, r) * fpow(f, r)  r <- r + 1 }
  return s
}

// chi(x) = (-1)^k a_k:  alternating binomial sum  == (1-f)^n
def series_alt(n, f) {
  s <- 0.0  r <- 0  sign <- 1
  -> r <= n { s <- s + sign * binom(n, r) * fpow(f, r)
    sign <- 0 - sign  r <- r + 1 }
  return s
}

// zeta(s) = P^{2n} * series  =>  P = (zeta/series)^{1/(2n)}
def generate_P(s, n, f, N) {
  ser <- series_binom(n, f)
  q <- zeta(s, N) / ser
  return fexp(fln(q) / (2 * n))
}

// flow-in: f making the binomial series equal zeta(s)  ((1+f)^n = zeta)
def flow_in(s, n, N, flo, fhi, steps) {
  target <- zeta(s, N)
  bestf <- flo  beste <- 1000000.0
  i <- 0
  -> i <= steps {
    f <- flo + (fhi - flo) * i / steps
    e <- fabs(series_binom(n, f) - target)
    -< e < beste { beste <- e  bestf <- f }
    i <- i + 1
  }
  return [bestf, beste]
}

// geometric closure  sum a_k f^k = 1/(1-z)
def geometric_closure(z) {
  -< fabs(1 - z) < 0.0001 { return 0 }
  return 1.0 / (1 - z)
}

// AM-GM gap  (a+b)/2 - sqrt(ab)  >= 0
def amgm_gap(a, b) {
  return (a + b) / 2 - fsqrt(a * b)
}

// ---------- the report's manifolds (for the video dictionary) ----------

// Seifert fibered space: rotating concentric fibres over a disk
def surf_seifert(x, y, t) {
  r <- fsqrt(x * x + y * y)
  return fcos(two_pi() * (3 * r - t))
}

// Kaluza-Klein 5th dimension: two compactified circle modes
def surf_kaluza(x, y, t) {
  return fsin(two_pi() * (x + t)) + 0.5 * fcos(2 * two_pi() * (y - 2 * t))
}

// critical line Re=1/2: |sum_{n=1}^{8} n^{-(1/2 + i*s)}|  (zeros = valleys)
def surf_critline(x, y, t) {
  s <- (x + 1) * 14 + y * 2 + t * 6
  re <- 0.0  im <- 0.0  n <- 1
  -> n <= 8 {
    w <- 1.0 / fsqrt(n)
    ang <- s * fln(n)
    re <- re + w * fcos(ang)
    im <- im - w * fsin(ang)
    n <- n + 1
  }
  return fsqrt(re * re + im * im)
}

// AM-GM inequality manifold: gap (a+b)/2 - sqrt(ab) >= 0, valley along a=b
def surf_amgm(x, y, t) {
  a <- 1.2 + x * fcos(two_pi() * t) - y * fsin(two_pi() * t)
  b <- 1.2 + x * fsin(two_pi() * t) + y * fcos(two_pi() * t)
  -< a < 0.05 { a <- 0.05 }
  -< b < 0.05 { b <- 0.05 }
  return amgm_gap(a, b)
}

// binomial equation surface  (1+g)^n , n morphing with t
def surf_binom(x, y, t) {
  n <- 2 + idiv(t * 3, 1)
  g <- 0.5 * (x + 0.5 * y)
  return series_binom(n, g)
}

def surf(name, x, y, t) {
  -< name <-> "seifert"  { return surf_seifert(x, y, t) }
  -< name <-> "kaluza"   { return surf_kaluza(x, y, t) }
  -< name <-> "critline" { return surf_critline(x, y, t) }
  -< name <-> "amgm"     { return surf_amgm(x, y, t) }
  -< name <-> "binom"    { return surf_binom(x, y, t) }
  return 0
}

def catalog_names() { return ["seifert", "kaluza", "critline", "amgm", "binom"] }

def frame_flat(name, n, t) {
  out <- []  i <- 0
  -> i < n {
    j <- 0
    -> j < n {
      x <- 0 - 1 + 2.0 * i / (n - 1)
      y <- 0 - 1 + 2.0 * j / (n - 1)
      append(out, surf(name, x, y, t))
      j <- j + 1
    }
    i <- i + 1
  }
  return out
}

def displacement(name, T) {
  prev <- surf(name, 0.3, 0.2, 0.0)  total <- 0.0  k <- 1
  -> k < T {
    cur <- surf(name, 0.3, 0.2, 1.0 * k / T)
    d <- cur - prev
    -< d < 0 { d <- 0 - d }
    total <- total + d  prev <- cur  k <- k + 1
  }
  return total
}
