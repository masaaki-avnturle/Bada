// eqvideo_app.bada — the equation-group 3D animation dictionary, in Bada.

#include lib/manifolds.bada

say "=== equation-group 3D animation dictionary ==="

names <- catalog_names()
say "dictionary entries:"
print names

say "displacement per entry over 20 frames (sample point):"
disp <- []
i <- 0
-> i < len(names) {
  append(disp, [names[i], displacement(names[i], 20)])
  i <- i + 1
}
print disp

Omega::DATABASE[eqvideo] {
  push(names)
  push(disp)
  push("3D animated dictionary of zeta/beta equation-group manifolds")
}
say "done: 5 animated 3D manifolds in the dictionary"
