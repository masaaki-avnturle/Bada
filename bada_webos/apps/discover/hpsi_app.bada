// hpsi_app.bada — discover patterns of  H.Psi = (+)(i.hbar.grad)^(+)L  in Bada.

#include lib/hpsi.bada

say "=== H.Psi = (+)(i.hbar.grad)^(+)L  pattern finder ==="

period <- detect_period()
say "phase period of (i x)^k:"
print period

eig <- find_real_eigen(1, 12)
say "x=1 real-eigenvalue L (im = 0)  [L mod 4 in {0, 3}]:"
print eig

g2 <- growth_ratio(2, 8)
say "geometric growth ratio at x=2 (-> 2):"
print g2

Omega::DATABASE[hpsi] {
  push(period)
  push(eig)
  push("pattern: phase period 4; im=0 at L mod 4 in {0,3}; |S| grows like x")
}
say "discovered: period-4 phase, real spectrum at L mod 4 in {0,3}, growth -> x"
