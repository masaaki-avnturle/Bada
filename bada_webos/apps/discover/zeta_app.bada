// zeta_app.bada — discover the odd-zeta regularity, in Bada.

#include lib/zeta.bada

say "=== odd zeta general regularity ==="

z3 <- zeta(3, 2000)
say "zeta(3):"
print z3

r <- odd_ratios(2000)
say "ratios (zeta(s+2)-1)/(zeta(s)-1) for s=3,5,7,9  (-> 1/4):"
print r

Omega::DATABASE[zeta] {
  push(z3)
  push(r)
  push("regularity: the excess zeta(s)-1 quarters at each +2 step (-> 1/4)")
}
say "discovered: odd-zeta excess quarters each step of +2 (limit 1/4)"
