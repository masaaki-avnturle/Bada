// zeta.bada — the Riemann zeta function and the odd-zeta regularity, in Bada.

#include disclib.bada

// zeta(s) ~ sum_{k=1..N} 1/k^s   (s integer >= 2, converges fast for s >= 3)
def zeta(s, N) {
  total <- 0.0
  k <- 1
  -> k <= N {
    total <- total + 1.0 / fpow(k, s)
    k <- k + 1
  }
  return total
}

// the "excess" beyond 1: d_s = zeta(s) - 1  (~ 2^-s)
def excess(s, N) {
  return zeta(s, N) - 1.0
}

// DISCOVERED regularity: (zeta(s+2)-1)/(zeta(s)-1) -> 1/4 for odd s.
// returns the ratios for s = 3,5,7,9
def odd_ratios(N) {
  out <- []
  prev <- excess(3, N)
  s <- 5
  -> s <= 11 {
    cur <- excess(s, N)
    append(out, cur / prev)
    prev <- cur
    s <- s + 2
  }
  return out
}
