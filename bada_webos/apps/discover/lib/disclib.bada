// disclib.bada — shared math for the discovery apps, in Bada.

// integer power: base^n  (n >= 0), as a real
def fpow(base, n) {
  r <- 1.0
  k <- 0
  -> k < n {
    r <- r * base
    k <- k + 1
  }
  return r
}

def fabs(v) {
  -< v < 0 { return 0 - v }
  return v
}

// square root by Newton's method
def fsqrt(x) {
  -< x <= 0 { return 0 }
  g <- x
  i <- 0
  -> i < 40 {
    g <- (g + x / g) / 2
    i <- i + 1
  }
  return g
}

// nearest integer (for non-negative x)
def fround(x) {
  return idiv(x + 0.5, 1)
}

// --- complex numbers as [re, im] ---
def cadd(a, b) {
  return [a[0] + b[0], a[1] + b[1]]
}

def cmul(a, b) {
  return [a[0] * b[0] - a[1] * b[1], a[0] * b[1] + a[1] * b[0]]
}

def cabs2(a) {
  return a[0] * a[0] + a[1] * a[1]
}
