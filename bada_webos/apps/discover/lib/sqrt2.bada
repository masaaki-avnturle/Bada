// sqrt2.bada — adapt the irrational sqrt(2) to differential-geometry
// quantization, and use it as an odd-zeta a-priori engine, in Bada.
//
// Quantization = the continued fraction sqrt(2) = [1; 2,2,2,...] gives lattice
// (Pell) levels q_k = 2 q_{k-1} + q_{k-2}; the ratio q_{k+1}/q_k -> 1+sqrt(2)
// (the silver ratio) is the causal-relationship regularity. The Pell levels
// are the quantized DENOMINATORS for the odd-zeta general-form search.

#include zeta.bada

// Pell denominators (sqrt2 convergent denominators): 1,2,5,12,29,70,...
def pell_denoms(n) {
  out <- []
  q0 <- 1
  q1 <- 2
  append(out, q0)
  append(out, q1)
  k <- 2
  -> k < n {
    q2 <- 2 * q1 + q0
    append(out, q2)
    q0 <- q1
    q1 <- q2
    k <- k + 1
  }
  return out
}

// Pell numerators (sqrt2 convergent numerators): 1,3,7,17,41,...
def pell_nums(n) {
  out <- []
  p0 <- 1
  p1 <- 3
  append(out, p0)
  append(out, p1)
  k <- 2
  -> k < n {
    p2 <- 2 * p1 + p0
    append(out, p2)
    p0 <- p1
    p1 <- p2
    k <- k + 1
  }
  return out
}

// sqrt(2) approximation from the n-th convergent
def sqrt2_approx(n) {
  q <- pell_denoms(n)
  p <- pell_nums(n)
  return 1.0 * p[len(p) - 1] / q[len(q) - 1]
}

// causal regularity: q_{k+1}/q_k -> 1 + sqrt(2) (silver ratio ~ 2.4142)
def silver_ratios(n) {
  q <- pell_denoms(n)
  out <- []
  i <- 1
  -> i < len(q) {
    append(out, 1.0 * q[i] / q[i - 1])
    i <- i + 1
  }
  return out
}

def frac_dist(x) {
  return fabs(x - fround(x))
}

// best sqrt2-quantized (Pell) denominator q*m for value zval -> [p, q, err]
def best_pell_denom(zval, n, maxmult) {
  q <- pell_denoms(n)
  bestq <- 1
  bestp <- fround(zval)
  beste <- frac_dist(zval)
  ci <- 0
  -> ci < len(q) {
    m <- 1
    -> m <= maxmult {
      qq <- q[ci] * m
      e <- frac_dist(zval * qq) / qq
      -< e < beste {
        beste <- e
        bestq <- qq
        bestp <- fround(zval * qq)
      }
      m <- m + 1
    }
    ci <- ci + 1
  }
  return [bestp, bestq, beste]
}

// odd-zeta general form with sqrt2-quantized denominators: [p,q,err] s=3,5,7,9
def pell_numerator_seq(N, n, maxmult) {
  out <- []
  s <- 3
  -> s <= 9 {
    append(out, best_pell_denom(zeta(s, N), n, maxmult))
    s <- s + 2
  }
  return out
}
