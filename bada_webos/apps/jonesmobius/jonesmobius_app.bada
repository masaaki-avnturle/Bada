// jonesmobius_app.bada — are the Beta/Zeta equations Jones-polynomial Mobius
// equations?  Build the causal graph of all the equations, in Bada.
//
// Key facts checked here:
//   * Jones mirror is the Mobius INVERSION  t -> 1/t   ([0,1,1,0]).
//   * Beta step recurrence  B(2,2) -> B(2,3)  is a Mobius SCALING.
//   * Zeta link  B(2,2) -> zeta(2)=pi^2/6     is a Mobius SCALING.

#include lib/mobius.bada
#include ../lib/jones.bada
#include ../beta/lib/betalib.bada

// term [e,c] present in polynomial p ?
def term_in(p, e, c) {
  i <- 0
  -> i < len(p) {
    -< p[i][0] <-> e {
      -< p[i][1] <-> c { return 1 }
    }
    i <- i + 1
  }
  return 0
}

// Jones-Mobius test: V(mirror) == V(1/t) ?  (exponents negate)
def jones_inversion_holds(a, b) {
  i <- 0
  -> i < len(a) {
    -< term_in(b, 0 - a[i][0], a[i][1]) <-> 0 { return 0 }
    i <- i + 1
  }
  return 1
}

say "=== are the equations Jones-polynomial Mobius equations? ==="

// 1. Jones mirror = Mobius inversion t -> 1/t
inv <- [0, 1, 1, 0]
say "Jones mirror Mobius [0,1,1,0] class (4=inversion):"
print mobius_class(inv)
say "is it an involution?"
print mobius_is_involution(inv)
tref <- jones_t([1, 1, 1], 2)
mirr <- jones_t([-1, -1, -1], 2)
say "V(mirror) == V(1/t) ? (Jones is a Mobius equation):"
print jones_inversion_holds(tref, mirr)

// 2. Beta step recurrence B(2,2) -> B(2,3) is a Mobius scaling [2,0,0,4]
bscale <- [2, 0, 0, 4]
say "Beta B(2,2)->B(2,3) Mobius class (2=scaling), links?:"
print mobius_class(bscale)
print mobius_links(bscale, beta(2, 2), beta(2, 3))

// 3. Zeta link B(2,2) -> zeta(2) is a Mobius scaling [pi^2,0,0,1]
zscale <- [9.869604401089358, 0, 0, 1]
say "Beta->zeta(2) Mobius class (2=scaling), links?:"
print mobius_class(zscale)
print mobius_links(zscale, beta(2, 2), zeta2_from_beta())

// causal graph: [source, target, mobius-class, verified]
graph <- []
append(graph, ["B22", "B23", mobius_class(bscale),
               mobius_links(bscale, beta(2, 2), beta(2, 3))])
append(graph, ["B22", "zeta2", mobius_class(zscale),
               mobius_links(zscale, beta(2, 2), zeta2_from_beta())])
append(graph, ["Jones", "Jones_mirror", mobius_class(inv),
               jones_inversion_holds(tref, mirr)])
say "causal graph [src, dst, mobius_class, verified]:"
print graph

Omega::DATABASE[causal] {
  push(graph)
  push("Jones mirror = Mobius inversion; Beta/Zeta links = Mobius scalings")
}
say "conclusion: every listed equation is a Mobius equation (causally linked)"
