// rng.bada — a small reproducible PRNG (linear congruential), in Bada.
// state is a 1-element array [seed] so functions can advance it in place.

def rng_next(state) {
  s <- imod(state[0] * 1103515245 + 12345, 2147483648)
  state[0] <- s
  return imod(idiv(s, 65536), 32768)
}

// uniform real in [0, 1)
def randf(state) {
  return rng_next(state) / 32768.0
}
