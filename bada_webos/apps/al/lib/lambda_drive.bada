// lambda_drive.bada — Lambda Driver: pilot gamma -> AT field + anti-gravity.
//
// The pilot's (biofeedback-stabilised) gamma, amplified by the resonance
// device, projects an AT field; coupling the resonance to the supercooled-metal
// reactor produces anti-gravity lift. Returns [at_field, anti_gravity].

def lambda_driver(eff_gamma, resonance, supercool) {
  at_field <- eff_gamma * resonance * 10
  anti_gravity <- supercool * resonance * resonance * 5
  return [at_field, anti_gravity]
}
