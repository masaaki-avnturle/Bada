// components.bada — geometry generated by the verified equations.
// Every part is [name, vertices, edges] (edges are part-local index pairs).

#include eqgroup.bada

def vadd(a, b) { return [a[0] + b[0], a[1] + b[1], a[2] + b[2]] }
def translate(part, off) {
  vs <- []  i <- 0
  -> i < len(part[1]) { append(vs, vadd(part[1][i], off))  i <- i + 1 }
  return [part[0], vs, part[2]]
}
def closed_loop(n, base) {
  es <- []  i <- 0
  -> i < n { append(es, [base + i, base + imod(i + 1, n)])  i <- i + 1 }
  return es
}
def cat(a, b) { i <- 0  -> i < len(b) { append(a, b[i])  i <- i + 1 }  return a }

// satellite k (0..7) sits on the ring of the eight Thurston ports
def site_pos(k, door) {
  a <- two_pi() * k / 8 + door
  return [62.0 * fcos(a), 62.0 * fsin(a), 0.0]
}

// ---- AdS5 throat:  rho(z) = rho0 e^{-2 pi T |psi|},  T = (ztop - z)/ztop
def ads_throat(ztop, rho0, psi) {
  vs <- []  es <- []  L <- 12  M <- 16  i <- 0
  -> i <= L {
    z <- ztop * (1.0 - 1.0 * i / L)
    T <- (ztop - z) / ztop
    rho <- rho0 * fexp(0 - two_pi() * T * psi)
    j <- 0
    -> j < M {
      a <- two_pi() * j / M
      append(vs, [rho * fcos(a), rho * fsin(a), z])
      j <- j + 1
    }
    i <- i + 1
  }
  i <- 0
  -> i <= L {
    j <- 0
    -> j < M {
      a <- i * M + j
      -< imod(i, 3) == 0 { append(es, [a, i * M + imod(j + 1, M)]) }
      -< i < L { append(es, [a, a + M]) }
      j <- j + 1
    }
    i <- i + 1
  }
  return ["ads5_throat", vs, es]
}

// ---- Kaluza-Klein torus: compact 5th circle of radius phi around the hub
def kk_torus(Rm, phi, hub) {
  vs <- []  es <- []  NU <- 48  NV <- 12  i <- 0
  -> i < NU {
    u <- two_pi() * i / NU
    j <- 0
    -> j < NV {
      v <- two_pi() * j / NV
      append(vs, [(Rm + phi * fcos(v)) * fcos(u), (Rm + phi * fcos(v)) * fsin(u), hub + phi * fsin(v)])
      j <- j + 1
    }
    i <- i + 1
  }
  i <- 0
  -> i < NU {
    j <- 0
    -> j < NV {
      a <- i * NV + j
      -< imod(i, 4) == 0 { append(es, [a, i * NV + imod(j + 1, NV)]) }
      -< imod(j, 3) == 0 { append(es, [a, imod(i + 1, NU) * NV + j]) }
      j <- j + 1
    }
    i <- i + 1
  }
  return ["kk_torus", vs, es]
}

// ---- Moebius band (centre line + single boundary curve + rungs)
def mobius_band(R, w, lift) {
  vs <- []  es <- []  N <- 48  i <- 0
  -> i < N { append(vs, vadd(mobius_point(two_pi() * i / N, 0.0, R, w), [0.0, 0.0, lift]))  i <- i + 1 }
  es <- closed_loop(N, 0)
  i <- 0
  -> i < 2 * N { append(vs, vadd(mobius_point(two_pi() * i / N, 1.0, R, w), [0.0, 0.0, lift]))  i <- i + 1 }
  es <- cat(es, closed_loop(2 * N, N))
  i <- 0
  -> i < N {
    -< imod(i, 2) == 0 {
      append(es, [N + i, N + i + N])
    }
    i <- i + 1
  }
  return ["mobius", vs, es]
}
def mobius_arrow(u, R, w, lift) {
  p <- vadd(mobius_point(u, 0.0, R, w), [0.0, 0.0, lift])
  n <- mobius_normal(u, R, w)
  return ["mobius_normal", [p, vadd(p, [3 * n[0], 3 * n[1], 3 * n[2]])], [[0, 1]]]
}

// ---- 4D -> 3D projection used by the Hopf fibres and the 600-cell
def proj4(q, scale, c) {
  k <- scale / (1.6 - q[0])
  return [c[0] + k * q[1], c[1] + k * q[2], c[2] + k * q[3]]
}
// one representative per Hopf fibre (fibres of left mult. by e^{alpha u})
def fibre_reps(G) {
  reps <- []  maps <- []  i <- 0
  -> i < len(G) {
    m <- hopf_map(G[i])
    seen <- 0  j <- 0
    -> j < len(maps) { -< qdist(maps[j], m) < 0.000001 { seen <- 1 }  j <- j + 1 }
    -< seen == 0 { append(reps, G[i])  append(maps, m) }
    i <- i + 1
  }
  return reps
}
def hopf_fibres(reps, scale, c) {
  vs <- []  es <- []  N <- 40  f <- 0
  -> f < len(reps) {
    k <- 0
    -> k < N { append(vs, proj4(qmul(qexp_axis(two_pi() * k / N), reps[f]), scale, c))  k <- k + 1 }
    es <- cat(es, closed_loop(N, f * N))
    f <- f + 1
  }
  return ["hopf_fibres", vs, es]
}
def cell600(G, E, alpha, scale, c) {
  vs <- []  r <- qexp_axis(alpha)  i <- 0
  -> i < len(G) { append(vs, proj4(qmul(r, G[i]), scale, c))  i <- i + 1 }
  return ["cell600", vs, E]
}

// ---- Ricci-flow sphere (reuse the pod wire sphere)
def ricci_sphere(r, c) {
  p <- pod_part(r, 0.0, 6, 12)
  return translate(["ricci_sphere", p[1], p[2]], c)
}

// ---- tetrahedron a0 a1 a2 a3 (the report's X(3) simplex)
def tetra(edge, c) {
  s <- edge / (2 * fsqrt(2.0))
  vs <- [[s, s, s], [s, 0 - s, 0 - s], [0 - s, s, 0 - s], [0 - s, 0 - s, s]]
  es <- [[0, 1], [0, 2], [0, 3], [1, 2], [1, 3], [2, 3]]
  return translate(["tetra", vs, es], c)
}

// ---- Bloch sphere + Heisenberg precession arrow
def bloch_sphere(r, c) {
  p <- pod_part(r, 0.0, 6, 16)
  return translate(["bloch_sphere", p[1], p[2]], c)
}
def bloch_arrow(r, angle, tilt, c) {
  tip <- [r * fsin(tilt) * fcos(angle), r * fsin(tilt) * fsin(angle), r * fcos(tilt)]
  back <- [0.8 * tip[0], 0.8 * tip[1], 0.8 * tip[2]]
  side <- vunit(vcross(tip, [0.0, 0.0, 1.0]))
  h1 <- vadd(back, [0.6 * side[0], 0.6 * side[1], 0.6 * side[2]])
  h2 <- vadd(back, [-0.6 * side[0], -0.6 * side[1], -0.6 * side[2]])
  vs <- [c, vadd(tip, c), vadd(h1, c), vadd(h2, c)]
  return ["bloch_arrow", vs, [[0, 1], [1, 2], [1, 3]]]
}

// ---- paraboloid f(r) = r^2 / 4
def paraboloid(c) {
  vs <- []  es <- []  NR <- 8  NA <- 24  i <- 1
  -> i <= NR {
    r <- 0.75 * i
    j <- 0
    -> j < NA {
      a <- two_pi() * j / NA
      append(vs, [r * fcos(a), r * fsin(a), r * r / 4])
      j <- j + 1
    }
    es <- cat(es, closed_loop(NA, (i - 1) * NA))
    i <- i + 1
  }
  append(vs, [0.0, 0.0, 0.0])
  o <- len(vs) - 1  j <- 0
  -> j < NA {
    -< imod(j, 2) == 0 {
      append(es, [o, j])
      i <- 1
      -> i < NR { append(es, [(i - 1) * NA + j, i * NA + j])  i <- i + 1 }
    }
    j <- j + 1
  }
  return translate(["paraboloid", vs, es], c)
}

// ---- zeta on the critical line: (3 Re zeta, 3 Im zeta, 0.6 t)
def zeta_curve(tmax, n, c) {
  vs <- []  es <- []  k <- 0
  -> k <= n {
    t <- 0.5 + (tmax - 0.5) * k / n
    z <- zeta_em([0.5, t])
    append(vs, vadd([3 * z[0], 3 * z[1], 0.6 * t], c))
    -< k > 0 { append(es, [k - 1, k]) }
    k <- k + 1
  }
  return ["zeta_curve", vs, es]
}
def cross_at(p, s) {
  return [[p[0] - s, p[1], p[2]], [p[0] + s, p[1], p[2]], [p[0], p[1] - s, p[2]], [p[0], p[1] + s, p[2]]]
}
def zeta_zero_marks(c) {
  vs <- []  es <- []  z <- zeta_zeros()  i <- 0
  -> i < len(z) {
    vs <- cat(vs, cross_at(vadd([0.0, 0.0, 0.6 * z[i]], c), 1.2))
    append(es, [4 * i, 4 * i + 1])
    append(es, [4 * i + 2, 4 * i + 3])
    i <- i + 1
  }
  return ["zeta_zeros", vs, es]
}
def zeta_runner(t, c) {
  z <- zeta_em([0.5, t])
  p <- vadd([3 * z[0], 3 * z[1], 0.6 * t], c)
  return ["zeta_runner", cross_at(p, 1.0), [[0, 1], [2, 3]]]
}

// ---- Gaussian bell z = 8 e^{-(x^2+y^2)/16}
def gauss_bell(c) {
  vs <- []  es <- []  n <- 13  i <- 0
  -> i < n {
    j <- 0
    -> j < n {
      x <- 0 - 8.0 + 16.0 * i / (n - 1)  y <- 0 - 8.0 + 16.0 * j / (n - 1)
      append(vs, [x, y, 8 * fexp(0 - (x * x + y * y) / 16)])
      -< j > 0 { append(es, [i * n + j - 1, i * n + j]) }
      -< i > 0 { append(es, [(i - 1) * n + j, i * n + j]) }
      j <- j + 1
    }
    i <- i + 1
  }
  return translate(["gauss_bell", vs, es], c)
}

// ---- stream helpers
def verts_line(vs) {
  out <- ""  j <- 0
  -> j < len(vs) {
    out <- out + str(r3(vs[j][0])) + " " + str(r3(vs[j][1])) + " " + str(r3(vs[j][2])) + " "
    j <- j + 1
  }
  return out
}
def edges_line(es) {
  out <- ""  j <- 0
  -> j < len(es) { out <- out + str(es[j][0]) + " " + str(es[j][1]) + " "  j <- j + 1 }
  return out
}
// PART <name> <static 0/1> <site> <nverts> | <edges>
def emit_part(p, static, site) {
  say "PART " + p[0] + " " + str(static) + " " + str(site) + " " + str(len(p[1])) + " | " + edges_line(p[2])
  -< static == 1 { say "SV " + p[0] + " | " + verts_line(p[1]) }
  return 0
}
def emit_frame_part(k, p) {
  say "FV " + str(k) + " " + p[0] + " | " + verts_line(p[1])
  return 0
}
