// contact.bada — the "Contact" Machine blueprint generator, in Bada.
//
// A design-fiction pipeline that chains the Yamaguchi-framework papers into a
// 3-D blueprint of the transport Machine from the film "Contact" (1997):
//
//   1. collider door   : the missing-transverse-momentum vector of a collision
//                        event (the real LHC signature searched for gravitons
//                        escaping into extra dimensions) fixes the door axis.
//   2. time budget     : 1 s on Earth  <->  18 h in the pod  =>  Lorentz factor
//                        gamma = 64800, rapidity phi = acosh(gamma).
//   3. koma (top)      : the boost is a rotation by the imaginary angle i*phi;
//                        the three gimbal rings are the precession / nutation /
//                        spin axes of the complex rotating top (koma_ecc).
//   4. Gamma / Jones   : ring radii from Gamma(k+1/2)/(Gamma(k+1)Gamma(1/2)),
//                        ring spin ratios from |V(e^{i P_J})| of the trefoil
//                        Jones polynomial V(t) = t + t^3 - t^4 (3 rings = 3
//                        crossings of the braid sigma_1^3).
//   5. port directory  : destination port = the IDPD port whose AdS5 warp
//                        address e^{-2 pi T} best matches 1/gamma; its mirror
//                        partner comes from the reflection R (R^2 = id).
//   6. blueprint       : wire-frame geometry emitted as Wavefront OBJ text.
//
// Everything numeric here is real, checkable arithmetic; the physical reading
// (that it opens a door to another dimension) is the papers' hypothesis, not
// established physics.

// ============================================================ math kernel
def c_pi() { return 3.141592653589793 }
def two_pi() { return 6.283185307179586 }
def fabs(v) { -< v < 0 { return 0 - v }  return v }

def fsqrt(x) {
  -< x <= 0 { return 0.0 }
  g <- x
  -< g < 1 { g <- 1.0 }
  i <- 0
  -> i < 80 { g <- (g + x / g) / 2  i <- i + 1 }
  return g
}

// e^x with range reduction: e^x = (e^{x/2^k})^{2^k}
def fexp(x) {
  -< x < 0 { return 1.0 / fexp(0 - x) }
  k <- 0
  -> x > 0.5 { x <- x / 2  k <- k + 1 }
  term <- 1.0  sum <- 1.0  n <- 1
  -> n < 30 { term <- term * x / n  sum <- sum + term  n <- n + 1 }
  -> k > 0 { sum <- sum * sum  k <- k - 1 }
  return sum
}

// ln x with range reduction: x = m * 2^k, m in [0.75, 1.5)
def fln(x) {
  -< x <= 0 { return 0.0 - 1000000.0 }
  k <- 0
  -> x >= 1.5 { x <- x / 2  k <- k + 1 }
  -> x < 0.75 { x <- x * 2  k <- k - 1 }
  y <- (x - 1.0) / (x + 1.0)  y2 <- y * y
  term <- y  sum <- y  n <- 1
  -> n < 40 { term <- term * y2  sum <- sum + term / (2 * n + 1)  n <- n + 1 }
  return 2 * sum + k * 0.6931471805599453
}

def fpowr(b, e) { return fexp(e * fln(b)) }

def fsin(theta) {
  tp <- two_pi()  pi <- c_pi()
  m <- idiv(theta / tp, 1)  x <- theta - m * tp
  -> x > pi { x <- x - tp }
  -> x < 0 - pi { x <- x + tp }
  x2 <- x * x  term <- x  sum <- x  n <- 1
  -> n < 12 { d <- (2 * n) * (2 * n + 1)  term <- 0 - term * x2 / d
    sum <- sum + term  n <- n + 1 }
  return sum
}
def fcos(theta) { return fsin(theta + 1.5707963267948966) }

// atan for |z| <= 1 by argument halving, then atan2 by quadrant
def fatan_unit(z) {
  k <- 0
  -> fabs(z) > 0.2 { z <- z / (1.0 + fsqrt(1.0 + z * z))  k <- k + 1 }
  z2 <- z * z  term <- z  sum <- z  n <- 1
  -> n < 30 { term <- 0 - term * z2  sum <- sum + term / (2 * n + 1)  n <- n + 1 }
  -> k > 0 { sum <- sum * 2  k <- k - 1 }
  return sum
}
def fatan2(y, x) {
  pi <- c_pi()
  -< x == 0 {
    -< y > 0 { return pi / 2 }
    -< y < 0 { return 0 - pi / 2 }
    return 0.0
  }
  -< fabs(y) <= fabs(x) {
    a <- fatan_unit(y / x)
    -< x < 0 {
      -< y < 0 { return a - pi }
      return a + pi
    }
    return a
  }
  a <- pi / 2 - fatan_unit(x / y)
  -< y < 0 { return a - pi }
  return a
}

// Gamma function (Lanczos, g = 7), valid for x >= 0.5
def lanczos() {
  return [0.99999999999980993, 676.5203681218851, 0.0 - 1259.1392167224028,
          771.32342877765313, 0.0 - 176.61502916214059, 12.507343278686905,
          0.0 - 0.13857109526572012, 0.0000099843695780195716,
          0.00000015056327351493116]
}
def fgamma(x) {
  c <- lanczos()
  x <- x - 1
  a <- c[0]  i <- 1
  -> i < 9 { a <- a + c[i] / (x + i)  i <- i + 1 }
  t <- x + 7.5
  return 2.5066282746310002 * fpowr(t, x + 0.5) * fexp(0 - t) * a
}

// ============================================================ 1. collider door
// Missing transverse momentum: MET = -(sum of visible p_T vectors).
// An imbalance means something left the detector unseen (neutrinos, or in
// ADD-type models a graviton leaking into the extra dimensions).
def met_vector(event) {
  sx <- 0.0  sy <- 0.0  i <- 0
  -> i < len(event) { sx <- sx + event[i][0]  sy <- sy + event[i][1]  i <- i + 1 }
  return [0 - sx, 0 - sy]
}
def door_axis(event) {
  m <- met_vector(event)
  return [fsqrt(m[0] * m[0] + m[1] * m[1]), fatan2(m[1], m[0])]
}

// ============================================================ 2. time budget
// Earth clock dt_short vs pod clock dt_long.  gamma = dt_long / dt_short.
def lorentz_gamma(dt_long, dt_short) { return dt_long / dt_short }
// 1 - beta computed stably: 1 - sqrt(1 - 1/g^2) = (1/g^2) / (1 + sqrt(1 - 1/g^2))
def one_minus_beta(g) {
  u <- 1.0 / (g * g)
  return u / (1.0 + fsqrt(1.0 - u))
}
def rapidity(g) { return fln(g + fsqrt(g * g - 1.0)) }

// the Minkowski norm conserved by the boost: gamma^2 - (gamma beta)^2 = 1
// (the hyperbolic twin of |e^{i theta}|^2 = 1 used by the koma ECC).
// Evaluated as gamma^2 (1-beta)(1+beta) to avoid cancellation at large gamma.
def boost_invariant(g) {
  omb <- one_minus_beta(g)
  return g * g * omb * (2.0 - omb)
}

// ============================================================ 3. koma rings
// psi_i = sqrt(a_i) e^{i theta_i};  |psi_i|^2 = a_i  must survive any rotation.
def koma_psi(a, thetas) {
  out <- []  i <- 0
  -> i < len(a) {
    r <- fsqrt(a[i])
    append(out, [r * fcos(thetas[i]), r * fsin(thetas[i])])
    i <- i + 1
  }
  return out
}
def koma_residual(a, thetas) {
  psi <- koma_psi(a, thetas)
  worst <- 0.0  i <- 0
  -> i < len(a) {
    q <- psi[i][0] * psi[i][0] + psi[i][1] * psi[i][1]
    d <- fabs(q - a[i])
    -< d > worst { worst <- d }
    i <- i + 1
  }
  return worst
}

// ============================================================ 4. Gamma / Jones
// radius ratio of ring k: Gamma(k+1/2) / (Gamma(k+1) Gamma(1/2)) = C(2k,k)/4^k
def ring_ratio(k) {
  return fgamma(k + 0.5) / (fgamma(k + 1.0) * fgamma(0.5))
}

// |V(e^{i theta})| for the trefoil V(t) = t + t^3 - t^4
def trefoil_abs(theta) {
  re <- fcos(theta) + fcos(3 * theta) - fcos(4 * theta)
  im <- fsin(theta) + fsin(3 * theta) - fsin(4 * theta)
  return fsqrt(re * re + im * im)
}
// spin ratio of ring k = |V| at the Jones-period phase P_J = k*pi/2
def ring_spin(k) { return trefoil_abs(k * c_pi() / 2) }

// ============================================================ 5. port directory
def zeta_zeros() {
  return [14.1347251417, 21.0220396388, 25.0108575801, 30.4248761259,
          32.9350615877, 37.5861781588, 40.9187190121, 43.3270732809,
          48.0051508811, 49.7738324776]
}
def thurston_names() {
  return ["E3", "S3", "H3", "S2xR", "H2xR", "SL2", "Nil", "Sol"]
}
def cy_slots() { return ["x", "y", "a", "b", "c"] }
// CY conjugation (x,y) <-> (a,b), c fixed
def cy_conj(s) {
  -< s <-> "x" { return "a" }
  -< s <-> "y" { return "b" }
  -< s <-> "a" { return "x" }
  -< s <-> "b" { return "y" }
  return "c"
}

// port n (1-based): [Pg, PJ(0..3), PC, depth T, PW, Re PZ, Im PZ]
def port(n) {
  g <- imod(n - 1, 8) + 1
  j <- imod(n - 1, 4)
  slots <- cy_slots()
  zz <- zeta_zeros()
  c <- slots[imod(n - 1, 5)]
  T <- (n - 1) / 2.0
  return [g, j, c, T, fexp(0 - two_pi() * T), 0.5, zz[n - 1]]
}

// reflection R: Pg -> 9-Pg, PJ -> -PJ, PC -> conj, PW -> 1/PW, PZ -> 1-PZ
def reflect(p) {
  return [9 - p[0], imod(4 - p[1], 4), cy_conj(p[2]), 0 - p[3],
          1.0 / p[4], 1.0 - p[5], 0 - p[6]]
}
def same_port(p, q) {
  -< p[0] != q[0] { return 0 }
  -< p[1] != q[1] { return 0 }
  -< p[2] != q[2] { return 0 }
  -< fabs(p[4] - q[4]) > 0.000000001 * fabs(q[4]) { return 0 }
  -< fabs(p[5] - q[5]) > 0.000000001 { return 0 }
  -< fabs(p[6] - q[6]) > 0.000000001 { return 0 }
  return 1
}

// port whose warp e^{-2 pi T} is closest (in log) to 1/gamma
def warp_matched_port(g) {
  target <- fln(1.0 / g)
  best <- 1  beste <- 1000000.0  n <- 1
  -> n <= 10 {
    e <- fabs((0 - two_pi() * (n - 1) / 2.0) - target)
    -< e < beste { beste <- e  best <- n }
    n <- n + 1
  }
  return best
}

// ============================================================ 6. blueprint geometry
// Rotations about the principal axes.
def rot_x(p, a) {
  c <- fcos(a)  s <- fsin(a)
  return [p[0], c * p[1] - s * p[2], s * p[1] + c * p[2]]
}
def rot_y(p, a) {
  c <- fcos(a)  s <- fsin(a)
  return [c * p[0] + s * p[2], p[1], 0 - s * p[0] + c * p[2]]
}
def rot_z(p, a) {
  c <- fcos(a)  s <- fsin(a)
  return [c * p[0] - s * p[1], s * p[0] + c * p[1], p[2]]
}

// the design: every part is [name, vertices, edges]
// ring k starts in the plane orthogonal to axis k and tumbles about an axis
// lying IN that plane (a gimbal spins about a diameter, not its own normal):
//   x_k(t) = hub + R_z(door) S_k(phase) r_k (cos t, sin t, 0)
//   S_0 = R_z(th) R_y(pi/2),  S_1 = R_x(th) R_x(pi/2),  S_2 = R_y(th)
// at phase 0 the three ring planes are mutually orthogonal.
def ring_part(name, radius, axis, phase, door, hub, nseg) {
  vs <- []  es <- []  i <- 0
  -> i < nseg {
    t <- two_pi() * i / nseg
    p <- [radius * fcos(t), radius * fsin(t), 0.0]
    -< axis == 0 { p <- rot_z(rot_y(p, c_pi() / 2), phase) }
    -< axis == 1 { p <- rot_x(rot_x(p, c_pi() / 2), phase) }
    -< axis == 2 { p <- rot_y(p, phase) }
    p <- rot_z(p, door)
    append(vs, [p[0], p[1], p[2] + hub])
    append(es, [i, imod(i + 1, nseg)])
    i <- i + 1
  }
  return [name, vs, es]
}

// the pod: a lat/long wire sphere at height h
def pod_part(radius, h, nlat, nlon) {
  vs <- []  es <- []  i <- 1
  -> i < nlat {
    th <- c_pi() * i / nlat
    j <- 0
    -> j < nlon {
      ph <- two_pi() * j / nlon
      append(vs, [radius * fsin(th) * fcos(ph), radius * fsin(th) * fsin(ph),
                  h + radius * fcos(th)])
      j <- j + 1
    }
    i <- i + 1
  }
  append(vs, [0.0, 0.0, h + radius])
  append(vs, [0.0, 0.0, h - radius])
  top <- len(vs) - 2  bot <- len(vs) - 1
  i <- 0
  -> i < nlat - 1 {
    j <- 0
    -> j < nlon {
      a <- i * nlon + j
      append(es, [a, i * nlon + imod(j + 1, nlon)])
      -< i < nlat - 2 { append(es, [a, a + nlon]) }
      j <- j + 1
    }
    i <- i + 1
  }
  j <- 0
  -> j < nlon {
    append(es, [top, j])
    append(es, [bot, (nlat - 2) * nlon + j])
    j <- j + 1
  }
  return ["pod", vs, es]
}

// the drop column: gantry over the rings, drop axis through the hub
def gantry_part(R, hub, top) {
  vs <- []  es <- []
  i <- 0
  -> i < 4 {
    a <- two_pi() * i / 4 + c_pi() / 4
    append(vs, [R * fcos(a), R * fsin(a), 0.0])
    append(vs, [R * fcos(a), R * fsin(a), top])
    i <- i + 1
  }
  i <- 0
  -> i < 4 {
    append(es, [2 * i, 2 * i + 1])
    append(es, [2 * i + 1, 2 * imod(i + 1, 4) + 1])
    i <- i + 1
  }
  append(vs, [0.0, 0.0, top])
  append(vs, [0.0, 0.0, 0.0])
  n <- len(vs)
  append(es, [n - 2, n - 1])
  return ["gantry", vs, es]
}

// build the whole machine: returns the list of parts
// spec = [R_outer, pod_radius, hub_height, door_angle, phi, tau]
//   phase of ring k at pod-time tau (0..1) = spin_k * phi * tau
def machine(spec, nseg) {
  R <- spec[0]  pr <- spec[1]  hub <- spec[2]  door <- spec[3]
  phi <- spec[4]  tau <- spec[5]
  parts <- []
  names <- ["ring_precession", "ring_nutation", "ring_spin"]
  k <- 0
  -> k < 3 {
    radius <- R * ring_ratio(k) / ring_ratio(0)
    phase <- ring_spin(k + 1) * phi * tau
    append(parts, ring_part(names[k], radius, k, phase, door, hub, nseg))
    k <- k + 1
  }
  append(parts, pod_part(pr, hub + (1.0 - 2.0 * tau) * 1.5 * R, 6, 12))
  append(parts, gantry_part(1.15 * R, hub, hub + 1.6 * R))
  return parts
}

// ring radii used by machine(): R * Gamma ratio  ->  R, R/2, 3R/8
def ring_radii(R) {
  return [R * ring_ratio(0), R * ring_ratio(1), R * ring_ratio(2)]
}

// Wavefront OBJ: one 'o' block per part, 'v' vertices, 'l' line elements
def to_obj(parts) {
  out <- "# Contact Machine blueprint — generated by contact.bada\n"
  base <- 1  i <- 0
  -> i < len(parts) {
    p <- parts[i]
    out <- out + "o " + p[0] + "\n"
    j <- 0
    -> j < len(p[1]) {
      v <- p[1][j]
      out <- out + "v " + str(v[0]) + " " + str(v[1]) + " " + str(v[2]) + "\n"
      j <- j + 1
    }
    j <- 0
    -> j < len(p[2]) {
      e <- p[2][j]
      out <- out + "l " + str(e[0] + base) + " " + str(e[1] + base) + "\n"
      j <- j + 1
    }
    base <- base + len(p[1])
    i <- i + 1
  }
  return out
}

def count_vertices(parts) {
  n <- 0  i <- 0
  -> i < len(parts) { n <- n + len(parts[i][1])  i <- i + 1 }
  return n
}

// ============================================================ 7. video stream
// round to 3 decimals for the frame stream
def r3(x) {
  -< x < 0 { return 0 - r3(0 - x) }
  return idiv(x * 1000 + 0.5, 1) / 1000.0
}

// all vertices of all parts on one line: "x y z x y z ..."
def frame_line(parts) {
  out <- ""  i <- 0
  -> i < len(parts) {
    vs <- parts[i][1]  j <- 0
    -> j < len(vs) {
      out <- out + str(r3(vs[j][0])) + " " + str(r3(vs[j][1])) + " " + str(r3(vs[j][2])) + " "
      j <- j + 1
    }
    i <- i + 1
  }
  return out
}

// topology header: "name nverts a b a b ..." per part (edges part-local)
def topology_lines(parts) {
  out <- ""  i <- 0
  -> i < len(parts) {
    p <- parts[i]
    out <- out + "PART " + p[0] + " " + str(len(p[1]))
    j <- 0
    -> j < len(p[2]) { out <- out + " " + str(p[2][j][0]) + " " + str(p[2][j][1])  j <- j + 1 }
    out <- out + "\n"
    i <- i + 1
  }
  return out
}
