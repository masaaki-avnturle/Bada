// 12 — Regular expressions.

// compile a pattern (flags: "i" ignorecase, "m" multiline, "s" dotall)
let word <- regex("[A-Za-z]+")
print "test 'hi5':", word.test("hi5")
print "find_all:", word.find_all("the quick brown fox")

// capture groups: match returns [whole, group1, group2, ...] or nil
let date <- regex("([0-9]{4})-([0-9]{2})-([0-9]{2})")
let m <- date.match("today is 2026-05-30 ok")
print "match:", m
print "year:", m[1], "month:", m[2], "day:", m[3]

// replace and split
let spaces <- regex("\\s+")
print "replace:", spaces.replace("a   b    c", "_")
print "split:", spaces.split("one two   three")

// convenience builtins (no explicit compile)
print "re_test:", re_test("^\\d+$", "12345")
print "re_replace:", re_replace("[aeiou]", "vowels here", "*")

// a tiny tokenizer
let tok <- regex("\\d+|[+*/-]|\\(|\\)")
print "tokens:", tok.find_all("12 + (34 * 5)")
