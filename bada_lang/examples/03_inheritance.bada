// 03 — Inheritance via `<-`, method override, and `super`.

class Animal {
    field name

    method init(name) {
        self.name <- name
    }

    method speak() {
        return self.name + " makes a sound"
    }
}

// Dog inherits from Animal:  class Dog <- Animal
class Dog <- Animal {
    method speak() {
        // call the parent implementation, then extend it
        let base <- super.speak()
        return base + " (woof!)"
    }
}

class Cat <- Animal {
    method speak() {
        return self.name + " says meow"
    }
}

let animals <- [Animal.new("Thing"), Dog.new("Rex"), Cat.new("Tom")]

for a in animals {
    print a.speak()
}
