// 14 — Calculus: derivatives, integrals and differential equations.

// --- numerical derivative -------------------------------------------------

fun f(x) { return x * x * x }          // f(x) = x^3,  f'(x) = 3x^2
print "f'(2) ~ 12:", derivative(f, 2)

// gradient of a multivariate function g(p) where p = [x, y]
fun g(p) { return p[0] * p[0] + 3 * p[1] }   // grad = [2x, 3]
print "grad g at [2,5]:", gradient(g, [2, 5])

// --- definite integrals ---------------------------------------------------

fun parabola(x) { return x * x }
print "∫ x^2 dx [0,1] ~ 1/3:", integrate(parabola, 0, 1)

fun bell(x) { return exp(0 - x * x) }
print "∫ e^-x^2 dx [-3,3] ~ sqrt(pi):", integrate(bell, -3, 3)

// double integral over a rectangle (area integral on a 2-patch)
fun one(x, y) { return 1 }
print "∬ 1 over [0,2]x[0,3] = 6:", integrate2(one, 0, 2, 0, 3)

// --- root finding (Newton-Raphson) ----------------------------------------

fun root_eq(x) { return x * x - 2 }
print "sqrt(2) via newton:", newton(root_eq, 1)

// --- ordinary differential equations --------------------------------------

import diffeq

// exponential decay: dy/dt = -0.5 y, y(0)=10
let decay <- diffeq.exponential(-0.5)
decay.solve(10, 0, 4, 400)
print "decay y(4):", decay.value_at_end()

// logistic growth toward carrying capacity K=100
let pop <- diffeq.logistic(0.8, 100)
pop.solve(5, 0, 10, 500)
print "logistic y(10):", pop.value_at_end()

// Newton cooling toward 20 degrees from 90
let cup <- diffeq.cooling(0.3, 20)
cup.solve(90, 0, 10, 500)
print "coffee temp at t=10:", cup.value_at_end()
