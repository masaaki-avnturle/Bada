// 02 — Object-oriented programming: classes, fields, methods, operators.

class Vector {
    field x <- 0
    field y <- 0

    method init(x, y) {
        self.x <- x
        self.y <- y
    }

    method length() {
        return sqrt(self.x * self.x + self.y * self.y)
    }

    // operator overloading: v + w
    operator + (other) {
        return Vector.new(self.x + other.x, self.y + other.y)
    }

    method show() {
        print "Vector(" + str(self.x) + ", " + str(self.y) + ")"
    }
}

let a <- Vector.new(3, 4)
let b <- Vector.new(1, 2)

a.show()
b.show()
print "length(a) =", a.length()

let c <- a + b
c.show()
print "length(c) =", c.length()
