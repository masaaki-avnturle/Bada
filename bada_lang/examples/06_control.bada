// 06 — Control flow, functions, recursion and closures.

fun factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

fun fib(n) {
    let a <- 0
    let b <- 1
    let i <- 0
    while i < n {
        let t <- a + b
        a <- b
        b <- t
        i <- i + 1
    }
    return a
}

print "factorial(5) =", factorial(5)
print "fib(10)      =", fib(10)

// for-loop over a range
let sum <- 0
for k in range(1, 11) {
    sum <- sum + k
}
print "sum 1..10 =", sum

// closures: make_adder returns a function capturing `n`
fun make_adder(n) {
    fun adder(x) {
        return x + n
    }
    return adder
}

let add10 <- make_adder(10)
print "add10(5) =", add10(5)

// fizzbuzz
for i in range(1, 16) {
    if i % 15 == 0 {
        print "FizzBuzz"
    } else if i % 3 == 0 {
        print "Fizz"
    } else if i % 5 == 0 {
        print "Buzz"
    } else {
        print i
    }
}
