// 01 — Hello, Bada!  Basic values, variables and printing.

print "Hello, Bada!"

let x <- 3.14
let y <- 2
print "x + y =", x + y
print "x * y =", x * y

let name <- "Masaaki"
print "Hello,", name + "!"

// strings, lists, maps
let parts <- split("one,two,three", ",")
print "parts:", parts, "len:", len(parts)
push(parts, "four")
print "after push:", parts

let scores <- {"alice": 90, "bob": 75}
print "alice:", scores["alice"]
scores["carol"] <- 88
print "scores:", scores

// math
print "sin(0) =", sin(0)
print "sqrt(2) =", sqrt(2)
print "2^10 =", pow(2, 10)
