// 11 — Libraries and the extended import system.
//
// `import name` loads name.bada from the library search path
// (the current file's dir, ./lib, $BADA_PATH, and the bundled stdlib) and
// binds a namespace whose members are the library's top-level definitions.

import mathx
import collections

// access module members with `.`
print "gcd(48, 36)  =", mathx.gcd(48, 36)
print "lcm(4, 6)    =", mathx.lcm(4, 6)
print "mean of list =", mathx.mean([10, 20, 30, 40])
print "is_prime(97) =", mathx.is_prime(97)
print "mathx.PI     =", mathx.PI

// classes from a library work just like local ones
let st <- collections.Stack.new()
st.push(1)
st.push(2)
st.push(3)
print "stack size   =", st.size()
print "pop          =", st.pop()
print "peek         =", st.peek()

let q <- collections.Queue.new()
q.enqueue("a")
q.enqueue("b")
print "dequeue      =", q.dequeue()
print "queue size   =", q.size()

// `import ... as` lets you rename, and built-in namespaces import too
import mathx as M
print "M.TAU        =", M.TAU

import Omega::DATABASE as DB
let space <- DB.new("imported")
space.push("x", 42)
print "imported DB  =", space.get("x")
