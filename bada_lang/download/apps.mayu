# apps.mayu - per-application remaps (target by exe / window class).
# Notepad uses the full Emacs keymap (mayu.exe).  For vim in Notepad run
# mayu.exe --vim (or run_mayu_vim.bat).
app "Notepad" {
  exe notepad.exe
  class Notepad
  base emacs
  key F5 -> type "%date% %time%"
}
app "Explorer" {
  exe explorer.exe
  class CabinetWClass
  base vim-normal
  key j -> send Down
  key k -> send Up
}
