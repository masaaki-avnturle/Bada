# vim.mayu - vim key bindings (included by keybindings.mayu).
keymap vim-normal {
  key h -> cursor-left
  key j -> cursor-down
  key k -> cursor-up
  key l -> cursor-right
  key 0 -> line-start
  key $ -> line-end
  key w -> word-forward
  key b -> word-back
  key x -> delete-char
  key d d -> delete-line
  key y y -> yank-line
  key p -> paste
  key i -> insert-mode
  key a -> append
  key o -> open-line
  key / -> search
}
keymap vim-insert {
  key ESC -> normal-mode
  key RET -> newline
}
