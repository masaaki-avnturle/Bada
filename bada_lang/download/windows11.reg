Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Mayu\win11\apps\Explorer]
"(exe)"="explorer.exe"
"(class)"="CabinetWClass"
"(inherits)"="vim-normal"
"j"="send Down"
"k"="send Up"

[HKEY_CURRENT_USER\Software\Mayu\win11\apps\Notepad]
"(exe)"="notepad.exe"
"(class)"="Notepad"
"(inherits)"="emacs"
"F5"="type \"%date% %time%\""

[HKEY_CURRENT_USER\Software\Mayu\win11\emacs]
"C-a"="move-beginning-of-line"
"C-e"="move-end-of-line"
"C-f"="forward-char"
"C-b"="backward-char"
"C-n"="next-line"
"C-p"="previous-line"
"C-d"="delete-char"
"C-k"="kill-line"
"C-y"="yank"
"C-w"="kill-region"
"M-w"="copy-region"
"C-s"="isearch-forward"
"C-r"="isearch-backward"
"M-f"="forward-word"
"M-b"="backward-word"
"C-SPC"="set-mark-command"
"C-g"="keyboard-quit"
"C-slash"="undo"
"C-x C-s"="save-buffer"

[HKEY_CURRENT_USER\Software\Mayu\win11\vim-insert]
"ESC"="normal-mode"
"RET"="newline"

[HKEY_CURRENT_USER\Software\Mayu\win11\vim-normal]
"h"="cursor-left"
"j"="cursor-down"
"k"="cursor-up"
"l"="cursor-right"
"0"="line-start"
"$"="line-end"
"w"="word-forward"
"b"="word-back"
"x"="delete-char"
"d d"="delete-line"
"y y"="yank-line"
"p"="paste"
"i"="insert-mode"
"a"="append"
"o"="open-line"
"/"="search"
