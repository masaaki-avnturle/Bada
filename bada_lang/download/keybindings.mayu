# keybindings.mayu - 窓使いの憂鬱 (mayu) key bindings.  EDIT ME.
#
# Compiled into the Windows registry under HKCU\Software\Mayu\<os>.
# Change 'os win11' to 'os win10' for Windows 10, add your own
# 'key CHORD -> action' lines, then re-run the installer.

os win11
define MOD = C

# ---- Emacs -------------------------------------------------------------
keymap emacs {
  key $MOD-a -> move-beginning-of-line
  key $MOD-e -> move-end-of-line
  key C-f -> forward-char
  key C-b -> backward-char
  key C-n -> next-line
  key C-p -> previous-line
  key C-d -> delete-char
  key C-k -> kill-line
  key C-y -> yank
  key C-w -> kill-region
  key M-w -> copy-region
  key C-s -> isearch-forward
  key C-r -> isearch-backward
  key M-f -> forward-word
  key M-b -> backward-word
  key C-g -> keyboard-quit
  key C-x C-s -> save-buffer
}

# ---- vim ---------------------------------------------------------------
keymap vim-normal {
  key h -> cursor-left
  key j -> cursor-down
  key k -> cursor-up
  key l -> cursor-right
  key 0 -> line-start
  key $ -> line-end
  key w -> word-forward
  key b -> word-back
  key x -> delete-char
  key d d -> delete-line
  key y y -> yank-line
  key p -> paste
  key i -> insert-mode
  key a -> append
  key o -> open-line
  key / -> search
}

keymap vim-insert {
  key ESC -> normal-mode
  key RET -> newline
}

# ---- per-application remaps (target by exe / window class) -------------
app "Notepad" {
  exe notepad.exe
  class Notepad
  base emacs
  key C-k -> send S-End Delete
  key F5 -> type "%date% %time%"
}

app "Explorer" {
  exe explorer.exe
  class CabinetWClass
  base vim-normal
  key j -> send Down
  key k -> send Up
}
