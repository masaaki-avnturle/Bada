# chrome.mayu - Chrome / Edge tab navigation (vim-ish).
#
# Matched by window class "Chrome_WidgetWin_1".  Note VS Code shares this
# class, so vscode.mayu narrows by window TITLE to disambiguate.

window Chrome /Chrome_WidgetWin_1/ : Global
  key S-j = C-Tab            # next tab
  key S-k = C-S-Tab          # previous tab
  key C-l = C-l              # focus the address bar
  key d d = C-w              # close tab (two-stroke dd)
  key x   = C-w
