# vscode.mayu - Visual Studio Code.
#
# VS Code uses the same window class as Chrome (Chrome_WidgetWin_1), so we
# match on class AND title (/class:title/) - the title bar always contains
# "Visual Studio Code".

window VSCode /Chrome_WidgetWin_1:Visual Studio Code/ : Global
  key C-p   = C-p            # quick open
  key C-S-p = C-S-p          # command palette
  key C-b   = C-b            # toggle sidebar
  key C-grave = C-grave      # toggle terminal
  key A-Up  = A-Up           # move line up
  key A-Down = A-Down        # move line down
