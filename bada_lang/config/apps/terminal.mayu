# terminal.mayu - Windows Terminal (class CASCADIA_HOSTING_WINDOW_CLASS).
#
# A prefix keymap (keymap2) demonstrates yamy's multi-stroke bindings: press
# the prefix C-t, then a key, to act on tabs - the tmux convention.

keymap2 TermPrefix : Global
  key c = C-S-t              # new tab
  key n = C-Tab              # next tab
  key p = C-S-Tab            # previous tab
  key x = C-S-w              # close pane

window Terminal /CASCADIA_HOSTING_WINDOW_CLASS/ : Global
  key C-t = &Prefix TermPrefix   # enter the prefix keymap
  key C-S-f = C-S-f              # find
