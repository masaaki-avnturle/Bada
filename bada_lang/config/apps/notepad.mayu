# notepad.mayu - Notepad gets emacs-like editing keys.
#
# Matched by window class "Notepad" (notepad.exe).  Inherits the Global
# keymap, so C-f/C-b/C-a/C-e etc. are already present; these add the editing
# commands as key SEQUENCES on the right-hand side.

window Notepad /Notepad/ : Global
  key C-k  = S-End Delete      # kill to end of line
  key C-d  = Delete            # delete char under cursor
  key A-w  = C-c               # emacs copy
  key C-w  = C-x               # emacs cut
  key C-y  = C-v               # emacs yank
  key C-_  = C-z               # undo
  key C-s  = C-s               # keep Save
  key C-g  = Escape            # emacs quit
  key F5   = "%date% %time%"   # Notepad's date/time stamp
