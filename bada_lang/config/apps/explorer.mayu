# explorer.mayu - File Explorer gets vim-like navigation.
#
# Matched by window class "CabinetWClass" (explorer.exe).

window Explorer /CabinetWClass/ : Global
  key h     = Left
  key j     = Down
  key k     = Up
  key l     = Right
  key S-g   = End
  key g g   = Home            # two-stroke (gg), yamy keyseq style
  key slash = C-e             # focus the address / search bar
  key Return = Return
