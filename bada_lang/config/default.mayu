# default.mayu - yamy (Yet Another Madotsukai no Yuuutsu) main configuration
#
# Load order: the keyboard layout, then a Global keymap that applies to every
# window, then one keymap file per application under apps/.  Each per-app file
# describes that application's key bindings and inherits from Global.
#
# Compile with:  yamy.compile_file("config/default.mayu", registry)
# which registers everything under HKEY_CURRENT_USER\Software\yamy.

include "109.mayu"

# ---- Global: bindings that apply to every window -------------------------
keymap Global
  key A-F4   = &Maximize
  key C-A-h  = &Help
  key C-S-q  = &Ignore
  # emacs-style cursor motion, available everywhere
  key C-f = Right
  key C-b = Left
  key C-n = Down
  key C-p = Up
  key C-a = Home
  key C-e = End

# ---- per-application keymaps (one file each) -----------------------------
include "apps/notepad.mayu"
include "apps/explorer.mayu"
include "apps/chrome.mayu"
include "apps/vscode.mayu"
include "apps/terminal.mayu"
