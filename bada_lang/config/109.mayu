# 109.mayu - Japanese 109 keyboard layout (scan-code key definitions)
#
# The real yamy ships 104.mayu / 109.mayu describing each physical key by its
# scan code.  default.mayu includes this file first so the names below can be
# used on the left/right side of `key` bindings.

def key Escape        = 0x01
def key F1            = 0x3b
def key F2            = 0x3c
def key F3            = 0x3d
def key F4            = 0x3e
def key F5            = 0x3f
def key Tab           = 0x0f
def key Return        = 0x1c
def key Space         = 0x39
def key BackSpace     = 0x0e
def key Delete        = 0xd3
def key Home          = 0xc7
def key End           = 0xcf
def key Up            = 0xc8
def key Down          = 0xd0
def key Left          = 0xcb
def key Right         = 0xcd

# Japanese-specific keys
def key Yen           = 0x7d
def key Henkan        = 0x79
def key Muhenkan      = 0x7b
def key Hiragana      = 0x70
def key Eisuu         = 0x3a
