// mathx — extra math helpers (Bada standard library module).
// Imported with:  import mathx   then used as  mathx.gcd(...), mathx.PI, ...

let PI <- 3.141592653589793
let TAU <- 6.283185307179586

fun gcd(a, b) {
    while b != 0 {
        let t <- b
        b <- a % b
        a <- t
    }
    if a < 0 { return -a }
    return a
}

fun lcm(a, b) {
    if a == 0 or b == 0 { return 0 }
    return abs(a * b) / gcd(a, b)
}

fun clamp(x, lo, hi) {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

fun sum(items) {
    let total <- 0
    for x in items { total <- total + x }
    return total
}

fun mean(items) {
    if len(items) == 0 { return 0 }
    return sum(items) / len(items)
}

fun is_prime(n) {
    if n < 2 { return false }
    let i <- 2
    while i * i <= n {
        if n % i == 0 { return false }
        i <- i + 1
    }
    return true
}
