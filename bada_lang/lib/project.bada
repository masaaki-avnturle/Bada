// project — analyse a web project, generate missing files and auto-fix them.
//
//   import project
//   let result <- project.complete(files)      // files: map {name: content}
//   zip_write("fixed.zip", result["files"])
//
// Reads a project (a map of filename -> content, e.g. from zip_read or
// read_tree), finds the REQUIRED files that are missing - assets that
// index.html references but that are absent, plus standard scaffolding - and
// auto-GENERATES them, then auto-FIXES every text file by restoring its
// bracket/quote invariants (the same integrable-system correction as Forge).

import forge

// ---- reference analysis ---------------------------------------------------

// extract local asset paths referenced from HTML (href/src), skipping URLs
fun referenced_assets(html) {
    let out <- []
    let rx <- regex("(?:href|src)\\s*=\\s*[\"']([^\"'#]+)[\"']", "i")
    for m in rx.find_all(html) {
        let path <- m
        if not (starts(path, "http") or starts(path, "//") or starts(path, "data:") or path == "") {
            push(out, path)
        }
    }
    return out
}

fun starts(s, p) { return contains(s, p) and s[0] == p[0] }

// ---- generators for missing files ----------------------------------------

fun gen_for(name) {
    if ends(name, ".css") { return gen_css() }
    if ends(name, ".js") { return gen_js(name) }
    if ends(name, ".html") { return gen_html(name) }
    if ends(name, ".json") { return "{\n  \"name\": \"" + name + "\"\n}\n" }
    if ends(name, ".md") { return "# " + name + "\n\nGenerated by Bada Project Forge.\n" }
    return "/* " + name + " - generated by Bada Project Forge */\n"
}

fun ends(s, suffix) {
    let n <- len(suffix)
    if len(s) < n { return false }
    let tail <- ""
    let i <- len(s) - n
    while i < len(s) { tail <- tail + s[i]  i <- i + 1 }
    return tail == suffix
}

fun gen_css() {
    return "/* generated stylesheet */\n"
        + "*{box-sizing:border-box}\n"
        + "body{font-family:system-ui,sans-serif;margin:0;padding:24px;\n"
        + "     background:#0a0e16;color:#e8eef7;line-height:1.5}\n"
        + "h1{color:#c8a44a}\n"
        + "a{color:#4a80d0}\n"
}

fun gen_js(name) {
    return "// generated script: " + name + "\n"
        + "document.addEventListener('DOMContentLoaded', function () {\n"
        + "  console.log('" + name + " loaded');\n"
        + "});\n"
}

fun gen_html(name) {
    return "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n"
        + "<meta charset=\"utf-8\">\n"
        + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
        + "<title>" + name + "</title>\n"
        + "<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n"
        + "<h1>" + name + "</h1>\n"
        + "<p>Scaffolded by Bada Project Forge.</p>\n"
        + "<script src=\"script.js\"></script>\n</body>\n</html>\n"
}

// ---- generic bracket/quote auto-fix (works for HTML/CSS/JS) ---------------

fun fix_brackets(src) {
    let cur <- src
    let step <- 0
    while forge.defect(cur) > 0 and step < 12 {
        let inv <- forge.invariants(cur)
        if inv["quote_open"] { cur <- forge.fix_quotes(cur, inv) }
        if inv["paren"] != 0 { cur <- forge.balance(cur, "(", ")", inv["paren"]) }
        if inv["square"] != 0 { cur <- forge.balance(cur, "[", "]", inv["square"]) }
        if inv["brace"] != 0 { cur <- forge.balance(cur, "{", "}", inv["brace"]) }
        step <- step + 1
    }
    return cur
}

// ---- the project completer ------------------------------------------------

class Forge {
    field log <- []
    method init() {}
    method note(m) { push(self.log, m) }

    method complete(files) {
        self.log <- []
        let out <- {}
        // copy input files
        for k in keys(files) { out[k] <- files[k] }

        // 1. ensure an index.html exists (the entry point)
        let has_index <- false
        for k in keys(out) {
            if ends(k, "index.html") { has_index <- true }
        }
        if not has_index {
            out["index.html"] <- gen_html("index.html")
            self.note("GENERATED index.html (entry point was missing)")
        }

        // 2. find every asset referenced by HTML files and generate the missing
        let required <- {}
        for k in keys(out) {
            if ends(k, ".html") {
                for asset in referenced_assets(out[k]) {
                    required[asset] <- true
                }
            }
        }
        for asset in keys(required) {
            if not has(out, asset) {
                out[asset] <- gen_for(asset)
                self.note("GENERATED " + asset + " (referenced but missing)")
            }
        }

        // 3. standard scaffolding files
        if not has(out, "style.css") {
            out["style.css"] <- gen_css()
            self.note("GENERATED style.css (default stylesheet)")
        }
        if not has(out, "script.js") {
            out["script.js"] <- gen_js("script.js")
            self.note("GENERATED script.js (default script)")
        }
        if not has(out, "README.md") {
            out["README.md"] <- "# Project\n\nCompleted and auto-fixed by Bada Project Forge.\n"
            self.note("GENERATED README.md")
        }

        // 4. auto-fix every text file (restore bracket/quote invariants)
        let fixed_count <- 0
        for k in keys(out) {
            if ends(k, ".html") or ends(k, ".css") or ends(k, ".js") {
                let before <- forge.defect(out[k])
                if before > 0 {
                    out[k] <- fix_brackets(out[k])
                    self.note("FIXED " + k + " (invariant defect " + str(before)
                        + " -> " + str(forge.defect(out[k])) + ")")
                    fixed_count <- fixed_count + 1
                }
            }
        }

        return {"files": out, "log": self.log,
                "generated": len(out) - len(files),
                "fixed": fixed_count}
    }
}

fun complete(files) {
    let f <- Forge.new()
    return f.complete(files)
}
