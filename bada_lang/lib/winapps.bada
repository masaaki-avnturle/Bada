// winapps — catalog of installed Windows applications (window class + exe).
//
//   import winapps
//   for a in winapps.catalog() { print a["name"], a["exe"], a["class"] }
//
// mayu targets a window by its WINDOW CLASS or executable name (the same way
// the real 窓使いの憂鬱 / AutoHotkey identify the focused application).  This is
// the table of common apps installed on a Windows PC, with the default editor
// key-map style each one suits.

fun catalog() {
    return [
        {"name": "Notepad",     "exe": "notepad.exe",      "class": "Notepad",            "style": "emacs"},
        {"name": "WordPad",     "exe": "wordpad.exe",      "class": "WordPadClass",       "style": "emacs"},
        {"name": "Explorer",    "exe": "explorer.exe",     "class": "CabinetWClass",      "style": "vim"},
        {"name": "Command",     "exe": "cmd.exe",          "class": "ConsoleWindowClass", "style": "emacs"},
        {"name": "PowerShell",  "exe": "powershell.exe",   "class": "ConsoleWindowClass", "style": "emacs"},
        {"name": "Edge",        "exe": "msedge.exe",       "class": "Chrome_WidgetWin_1", "style": "vim"},
        {"name": "Chrome",      "exe": "chrome.exe",       "class": "Chrome_WidgetWin_1", "style": "vim"},
        {"name": "VSCode",      "exe": "Code.exe",         "class": "Chrome_WidgetWin_1", "style": "emacs"},
        {"name": "Word",        "exe": "WINWORD.EXE",      "class": "OpusApp",            "style": "emacs"},
        {"name": "Excel",       "exe": "EXCEL.EXE",        "class": "XLMAIN",             "style": "vim"},
        {"name": "Terminal",    "exe": "WindowsTerminal.exe", "class": "CASCADIA_HOSTING_WINDOW_CLASS", "style": "emacs"}
    ]
}

// look up an app entry by name
fun by_name(name) {
    for a in catalog() { if a["name"] == name { return a } }
    return {}
}
