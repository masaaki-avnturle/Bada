// collections — simple OOP data structures (Bada standard library module).
// Imported with:  import collections   then  collections.Stack.new(), ...

class Stack {
    field items <- []

    method push(x) { push(self.items, x) }

    method pop() {
        if len(self.items) == 0 { throw "Stack.pop: empty stack" }
        return pop(self.items)
    }

    method peek() { return last(self.items) }
    method size() { return len(self.items) }
    method is_empty() { return len(self.items) == 0 }
}

class Queue {
    field items <- []

    method enqueue(x) { push(self.items, x) }

    method dequeue() {
        if len(self.items) == 0 { throw "Queue.dequeue: empty queue" }
        let head <- self.items[0]
        let rest <- []
        let i <- 1
        while i < len(self.items) {
            push(rest, self.items[i])
            i <- i + 1
        }
        self.items <- rest
        return head
    }

    method size() { return len(self.items) }
}
