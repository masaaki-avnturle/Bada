#!/usr/bin/env ruby
# frozen_string_literal: true

# BadaUFO-OS ランチャ
#
#   bin/badaufo                 対話 REPL（反重力コンソール）
#   bin/badaufo boot            ブートバナーのみ表示
#   bin/badaufo demo            自動デモ（ブート→物理→上昇→AI問答）
#   bin/badaufo run FILE.bada   Bada 言語スクリプトを実行（bada_ruby 同梱時）
#   bin/badaufo "physics"       単発コマンド実行

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "badaufo"

def run_bada_script(path)
  root = File.expand_path("../..", __dir__)
  lib  = File.join(root, "bada_ruby", "lib")
  unless File.directory?(lib)
    warn "bada_ruby が見つかりません（Bada 言語インタプリタ非同梱）"
    exit 1
  end
  $LOAD_PATH.unshift(lib)
  require "bada/language"
  require "bada/tuplespace"
  src = File.read(path, encoding: "UTF-8")
  out = BadaUFO::OS.new.boot
  puts out
  puts "── Bada 言語ブートシーケンス実行: #{File.basename(path)} ──"
  interp = Bada::Interpreter.new
  interp.run(src).each { |l| puts "  #{l}" }
end

def repl
  os = BadaUFO::OS.new
  puts os.boot
  puts "\n反重力コンソール。'help' でコマンド一覧、'exit' で終了。"
  loop do
    print "\nBadaUFO> "
    line = $stdin.gets
    break if line.nil?
    line = line.strip
    next if line.empty?
    break if %w[exit quit q].include?(line)
    begin
      puts os.command(line)
    rescue StandardError => e
      puts "エラー: #{e.message}"
    end
  end
  puts "\nΩ::DATABASE に航跡を保存しました。安全な帰投を。"
end

def demo
  os = BadaUFO::OS.new
  puts os.boot
  [ "physics",
    "ascend 10",
    "status",
    "ask 反重力の補空間エネルギーとは何か？",
    "hover 3",
    "ask 真空エネルギーはなぜ無尽蔵なのか？",
    "akashic ask" ].each do |c|
    puts "\nBadaUFO> #{c}"
    puts os.command(c)
  end
end

case ARGV[0]
when nil        then repl
when "boot"     then puts BadaUFO::OS.new.boot
when "demo"     then demo
when "run"      then run_bada_script(ARGV[1] || File.expand_path("../boot.bada", __dir__))
else
  os = BadaUFO::OS.new
  puts os.boot
  puts os.command(ARGV.join(" "))
end
