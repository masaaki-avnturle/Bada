{
  "name": "antigravity-aircraft",
  "productName": "AntigravityAircraft",
  "version": "1.0.0",
  "description": "反重力発生器 航空機 YMG-AG01 — an interactive 3D antigravity aircraft and blueprint driven by the BadaUFO-OS antigravity equations (E_ag=U_grav*cosh(x log x), E_vac=rho*x^x, E_perp=mc^2-1/2mv^2)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.antigravityaircraft",
    "productName": "AntigravityAircraft",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "AntigravityAircraft-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Science",
      "artifactName": "AntigravityAircraft-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
