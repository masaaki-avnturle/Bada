// hello.bada — a tour of the Bada language

// non-commutative left action `<-` binds a name
greeting <- "Bada" >- " language"     // `>-` quantum right action = combine
say greeting

// arithmetic and the manifold operators
x <- 6
y <- 7
print x * y                            // 42

nums <- [1, 2, 3]
print nums => 10                       // map/transform: [10, 20, 30]
print 3 -< 4                           // manifold integral / spawn: [3, 4]

// the Akashic store Omega::DATABASE[tuplespace]
Omega::DATABASE[akashic] {
  push(x * y)
  push(greeting)
}

// control flow
total <- 0
repeat 3 {
  total <- total + 10
}
if total >= 30 {
  say "manifold converged"
} else {
  say "diverged"
}
