// commands.bada — emit the Bada method-command manifest (one name per line).
// The C backend reads this list (produced BY Bada) and generates one C
// executable per reserved word / builtin / operator-command.

#include lang.bada

def print_all(arr) {
  i <- 0
  -> i < len(arr) {
    print arr[i]
    i <- i + 1
  }
  return 0
}

print_all(reserved_words())
print_all(builtin_funcs())
print_all(operator_commands())
