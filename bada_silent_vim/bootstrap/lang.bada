// lang.bada — Bada described in Bada.
// The reserved words, builtins and operator-commands of the language, plus
// predicates over them. This is the seed of "Bada built in Bada".

def reserved_words() {
  return ["print", "say", "if", "else", "while", "repeat", "return", "def",
          "push", "pop", "true", "false", "nil", "Omega"]
}

def builtin_funcs() {
  return ["len", "append", "idiv", "imod", "abs", "pow2", "str"]
}

// operator method-commands (names for the C backend)
def operator_commands() {
  return ["add", "sub", "mul", "div", "mod", "eq", "lt", "gt"]
}

def in_list(arr, w) {
  i <- 0
  -> i < len(arr) {
    -< arr[i] <-> w { return 1 }
    i <- i + 1
  }
  return 0
}

def is_reserved(w) {
  return in_list(reserved_words(), w)
}

def is_builtin(w) {
  return in_list(builtin_funcs(), w)
}
