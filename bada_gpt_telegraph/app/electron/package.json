{
  "name": "bada-gpt-telegraph",
  "productName": "BadaGPTTelegraph",
  "version": "1.0.0",
  "description": "BadaGPT電信 — 思考入力 (文章・音声・電信) から依頼の全体を捉えてアプリケーションを生成し、検証し、論文にまとめる Bada 言語駆動アプリ",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.badagpttelegraph",
    "productName": "BadaGPTTelegraph",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaGPTTelegraph-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "BadaGPTTelegraph-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "artifactName": "BadaGPTTelegraph-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    },
    "deb": { "depends": ["fonts-noto-cjk"] }
  }
}
