<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of BadaGPT電信 (BadaGPT Telegraph).
     ワークフロー (badagpt-telegraph-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_gpt_telegraph/index.html) を差し込みます。 -->
<widget id="io.github.masaaki_avnturle.badagpttelegraph" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>BadaGPTTelegraph</name>
  <description>BadaGPT電信 — 思考入力 (文章・音声・電信) から依頼の全体を捉えてアプリケーションを生成し、検証し、論文にまとめる Bada 言語駆動アプリ</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <!-- 任意の Claude API (api.anthropic.com) へ接続するため -->
  <access origin="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff080b14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#080b14" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <!-- 「スマホから電信で受信」(FSK 音響モデム) と音声入力のためのマイク -->
    <config-file target="AndroidManifest.xml" parent="/*">
      <uses-permission android:name="android.permission.RECORD_AUDIO" />
      <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    </config-file>
  </platform>
</widget>
