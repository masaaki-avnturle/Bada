<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada PatchGuard.
     ワークフロー (badapatchguard-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_patchguard/index.html) を差し込みます。
     ネットワークは使わず、検査するソースは端末の外に出ません。 -->
<widget id="io.github.masaaki_avnturle.badapatchguard" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BadaPatchGuard</name>
  <description>Bada Reviser PatchGuard — PHP サイトの書き換えの副作用を防ぐパッチ・セキュリティ。書き換えの基と後をタプル空間に置き、差をパッチとして扱い、複数回の書き換えを 1 本の正味パッチに折り畳んで、Bada の @reviser で定義した規則で ACCEPT / REVIEW / REJECT を判定します。安全な部分パッチとロールバック用の逆パッチも書き出します。</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff151816" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#151816" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
