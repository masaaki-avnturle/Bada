<?xml version='1.0' encoding='utf-8'?>
<!--
  Cordova config — 音色リストア (Sound Restore Studio) の Android APK ビルド用。
  変調(声・楽器)された録音を元の質音へ逆変換するアプリ。すべて端末内処理・非送信。
  ワークフローが cordova プロジェクトを作成し、この config.xml と ../www を差し込みます。
-->
<widget id="io.github.masaaki_avnturle.sound_restore" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>Sound-Restore-Studio</name>
  <description>変調された声・楽器の録音を元の質音へ逆変換(端末内処理・非送信)</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff04060a" />
  <preference name="Orientation" value="portrait" />
  <preference name="Fullscreen" value="false" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#04060a" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <!-- マイク録音を使う端末向け(ファイル読み込み・処理・保存は権限不要) -->
    <config-file target="AndroidManifest.xml" parent="/manifest">
      <uses-permission android:name="android.permission.RECORD_AUDIO" />
      <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    </config-file>
  </platform>
</widget>
