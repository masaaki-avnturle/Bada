{
  "name": "sound-restore-studio",
  "productName": "Sound-Restore-Studio",
  "version": "1.0.0",
  "description": "Sound Restore Studio — restore pitch/formant/tone-modulated voice & instrument recordings toward their original timbre (on-device, no upload)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.github.masaaki_avnturle.sound_restore",
    "productName": "Sound-Restore-Studio",
    "publish": null,
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "Sound-Restore-Studio-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "artifactName": "Sound-Restore-Studio-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
