<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config (Android APK) — tools/prepare.js がアプリ ID・名前・説明を差し込んで使う。
     アプリ本体は ../www (自己完結 HTML)。PDF / mp4 の保存は cordova-plugin-save-dialog
     (SAF の保存ダイアログ) で保存先を選んで行う。 -->
<widget id="__APPID__" version="__VERSION__"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>__NAME__</name>
  <description>__DESC__</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b2447" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b2447" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
