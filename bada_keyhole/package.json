{
  "name": "bada-keyhole",
  "version": "1.0.0",
  "description": "BADA KEYHOLE — KeyHole TV を参考にした P2P インターネットTV（視聴・P2P放送・P2P受信）を Bada 言語で駆動するアプリ",
  "main": "electron/main.js",
  "author": "Masaaki Yamaguchi (山口 雅旭)",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "io.github.masaaki.badakeyhole",
    "productName": "BadaKeyhole",
    "publish": null,
    "directories": { "output": "dist" },
    "files": ["electron/**/*", "www/**/*", "resources/**/*"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": { "artifactName": "BadaKeyhole-${version}-portable.exe" }
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
