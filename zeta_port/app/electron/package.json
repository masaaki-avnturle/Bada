{
  "name": "zetaport",
  "productName": "ZetaPort",
  "version": "1.0.0",
  "description": "ZetaPort — the interdimensional port timetable simulator: the shape of the zeta functional equation zeta(s) = chi(s) zeta(1-s) computed as an entropy value by the Bada quantum programming language (pure-Bada Riemann-Siegel Z(t), monopole balance gates with exact box*antibox = 1, port:// addresses and celestial coordinates), after visto.pdf 'M theory in monopolity of extra dimension', as a self-contained HTML app",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.zetaport",
    "productName": "ZetaPort",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "ZetaPort-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "ZetaPort-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Science",
      "artifactName": "ZetaPort-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
