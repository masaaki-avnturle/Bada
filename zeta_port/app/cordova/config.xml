<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of ZetaPort (ゼータ・ポート).
     ワークフロー (zetaport-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = zeta_port/index.html) を差し込みます。 -->
<widget id="io.github.masaaki_avnturle.zetaport" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>ZetaPort</name>
  <description>ゼータ・ポート — visto.pdf「M theory in monopolity of extra dimension」のゼータ関数関係式(関数等式)の形をエントロピー値として Bada 言語で実行し、異次元ポートの開閉時刻表と port:// 住所・天球座標をシミュレーションするアプリ。Riemann-Siegel Z(t) 純Bada実装、□·□⁻=1 ゲート検出、Bell対の量子封緘</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff04060a" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#04060a" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
