<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of こんにゃく照合器 (Konnyaku Collator).
     ワークフロー (konnyaku-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = omega_konnyaku_dialog/index.html) を差し込みます。 -->
<widget id="io.github.masaaki_avnturle.konnyaku" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>KonnyakuCollator</name>
  <description>こんにゃく照合器 — 手帳の方程式と絵を箱ごとの数値入力ダイアログに畳み込み、絵の形のエントロピーと入力数値のエントロピーを照合して、弾力性・優しさ・同値類 ≡ を判定し、ハッシュ連鎖のアカシックレコードに綴じるアプリ</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b0f14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0f14" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
