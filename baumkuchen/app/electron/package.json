{
  "name": "bada-baumkuchen",
  "productName": "BadaBaumkuchen",
  "version": "1.0.0",
  "description": "Bada Baumkuchen — a search-and-accumulate archive for acts of kindness. Each event is baked as one ring (inner = older, outer = newer); every ring carries a price tag 100(1+c)(1+b/10)rho(1+k/8), eight kindness genes switch on and off per ring, and the people involved form a graph whose first Betti number g = E - V + C counts the holes. Reading from the outside in peels the rings, showing the peeled price, the residual core and the remaining genus. Self-contained HTML app, zero dependencies, fully offline.",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.github.masaaki_avnturle.badabaumkuchen",
    "productName": "BadaBaumkuchen",
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../www",
        "to": "www"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "BadaBaumkuchen-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "BadaBaumkuchen-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icons",
      "artifactName": "BadaBaumkuchen-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
