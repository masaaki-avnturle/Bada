<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada Baumkuchen (優しさのソース検索・蓄積).
     ワークフロー (baumkuchen-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = baumkuchen/index.html) を差し込みます。
     蓄積は端末内 (localStorage) に保存され、外に出ることはありません。 -->
<widget id="io.github.masaaki_avnturle.badabaumkuchen" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BadaBaumkuchen</name>
  <description>Bada Baumkuchen — 優しさのソースを検索し、層として蓄積するアプリ。出来事ひとつを一層として焼き重ね、後ろから (外側から) 剥いて読む。値札 100(1+c)(1+b/10)rho(1+k/8)、DNA スイッチ 8 本の発現率と最後の反転、種数 g = E - V + C と輪を閉じた層の閉路復元。依存ゼロ・単一 HTML・オフライン動作</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <icon density="ldpi"    src="res/icon-36.png" />
    <icon density="mdpi"    src="res/icon-48.png" />
    <icon density="hdpi"    src="res/icon-72.png" />
    <icon density="xhdpi"   src="res/icon-96.png" />
    <icon density="xxhdpi"  src="res/icon-144.png" />
    <icon density="xxxhdpi" src="res/icon-192.png" />
  </platform>
</widget>
