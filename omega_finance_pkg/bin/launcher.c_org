#include <stdio.h>
#include <stdlib.h>
int omega_interp(const char*);
int main(int argc, char **argv){ if(argc<2){ fprintf(stderr, "Usage: %s <command> [args]\nExamples:\n  ingest data/prices.csv\n  analyze_day 2025-09-25\n  predict AAPL 1\", argv[0]); return 1; } char script[1024]; int i; script[0]=0; for(i=1;i<argc;i++){ if(i>1) strcat(script, " "); strcat(script, argv[i]); } return omega_interp(script); }

