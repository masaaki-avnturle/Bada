<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/thermal_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/thermal_subtitle"
            android:textSize="13sp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/txtSensorStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sensor_status_init"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/inIr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/lbl_ir"
            android:inputType="numberSigned|numberDecimal"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/inTemp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/lbl_temp"
            android:inputType="numberSigned|numberDecimal"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btnReadSensors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_read_sensors"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <Button
                android:id="@+id/btnThermalAssess"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_thermal_direct" />

            <Button
                android:id="@+id/btnThermalDemo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_demo" />
        </LinearLayout>

        <Button
            android:id="@+id/btnThermalDerived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_thermal_derived"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/txtThermalResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/result_placeholder"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
