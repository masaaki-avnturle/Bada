<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/camera_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/camera_subtitle"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="#20808080" />

        <TextView
            android:id="@+id/txtCameraStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/camera_init"
            android:textSize="13sp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/inCamIr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/lbl_ir"
            android:inputType="numberSigned|numberDecimal"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/inCamTemp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/lbl_temp"
            android:inputType="numberSigned|numberDecimal"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btnCapture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_capture"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <Button
                android:id="@+id/btnCamAssess"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_thermal_direct" />

            <Button
                android:id="@+id/btnCamDerived"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_tablet_estimate" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtCameraResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/result_placeholder"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
