<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitle"
            android:textSize="13sp"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_z"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/inFmri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/lbl_fmri"
            android:inputType="numberSigned|numberDecimal"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/inMri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/lbl_mri"
            android:inputType="numberSigned|numberDecimal"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/inTopo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/lbl_topo"
            android:inputType="numberSigned|numberDecimal"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/inDna"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/lbl_dna"
            android:inputType="numberSigned|numberDecimal"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/inBlood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/lbl_blood"
            android:inputType="numberSigned|numberDecimal"
            android:importantForAutofill="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/btnAssess"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_assess" />

            <Button
                android:id="@+id/btnDemo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_demo" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/result_placeholder"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
