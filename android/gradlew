#!/usr/bin/env sh
#
# Minimal Gradle wrapper launcher for the Bada CodeFix Android app.
# Locates a JVM and runs org.gradle.wrapper.GradleWrapperMain, which downloads
# the Gradle distribution named in gradle/wrapper/gradle-wrapper.properties and
# executes the build. Sufficient for CI (Linux/macOS) and local POSIX shells.
#
set -e

APP_HOME=$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd)
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

if ! command -v "$JAVACMD" >/dev/null 2>&1 && [ ! -x "$JAVACMD" ]; then
    echo "ERROR: JAVA_HOME is not set and no 'java' command found on PATH." >&2
    exit 1
fi

exec "$JAVACMD" $JAVA_OPTS $GRADLE_OPTS \
    -classpath "$WRAPPER_JAR" \
    org.gradle.wrapper.GradleWrapperMain "$@"
