<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada 位相 (思考中枢の量子回路).
     ワークフロー (topos-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_topos/index.html) を差し込みます。
     アプリはネットワークを一切使わず、すべて端末内で完結します。 -->
<widget id="io.github.masaaki_avnturle.badatopos" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BadaTopos</name>
  <description>Bada 位相 — 数学のトポロジー(位相幾何学)を人間の思考中枢の量子回路として作り換えた処理系。思考中枢 = 単体的複体、思考 = 鎖 (単体ひとつ = 量子ビットひとつ)、境界作用素 ∂ = CNOT 回路、観念 = ker ∂ / im ∂。重ね合わせた思考に ∂̂ を通し面レジスタの観測 0 で閉じた思考だけを残す閉路フィルタ、ホッジ・ラプラシアンの量子歩行で観念成分が時間で動かないことを示す</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
