<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada 光量子制限装置.
     ワークフローが cordova プロジェクトを作成し、この config.xml と
     ../www (自己完結アプリ = light_quantum/index.html) を差し込みます。 -->
<widget id="io.github.masaaki_avnturle.lightquantum" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BadaLightQuantum</name>
  <description>Bada 光量子制限装置 — 特殊相対論 × 光量子仮説 (E=hν) × AdS5 整数制限法による「新幹線の窓の塗り絵」光シミュレーション</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0d1220" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0d1220" />
  <preference name="Orientation" value="landscape" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
