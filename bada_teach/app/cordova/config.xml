<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of BadaGPT 道場 (BadaTeach).
     ワークフロー (badateach-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_teach/index.html) を差し込みます。 -->
<widget id="io.github.masaaki_avnturle.badateach" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>BadaTeach</name>
  <description>BadaGPT 道場 — ChatGPT が応答してアプリケーションを作る技 (要件抽出・仕様化・コード生成・実行と反復) を、量子プログラミング言語 Bada を題材にユーザーへ伝授する教習アプリ。ミニ Bada インタープリタ (qubit/H/CNOT/Measure、softmax/entropy、append-only 台帳 tuplespace) 内蔵、8 章カリキュラム + 自動判定演習 + BadaGPT 先生チャット</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
