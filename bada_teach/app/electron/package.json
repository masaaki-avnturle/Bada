{
  "name": "bada-teach",
  "productName": "BadaTeach",
  "version": "1.0.0",
  "description": "BadaGPT Dojo (BadaTeach) — teaches users the technique ChatGPT uses to build applications by responding (requirement extraction, spec, code generation, run-and-iterate), using the quantum programming language Bada. Ships a mini Bada interpreter (qubit/H/CNOT/Measure, softmax/entropy, append-only tuplespace ledger), an 8-chapter curriculum with auto-graded exercises, and the BadaGPT-sensei chat, as a self-contained HTML app",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.badateach",
    "productName": "BadaTeach",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaTeach-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "BadaTeach-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Education",
      "artifactName": "BadaTeach-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
