<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#070A0E"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BadaSleep — 量子波動フィードバック 入眠ガイド"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#D8E0E8" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/disclaimer"
        android:textSize="10sp"
        android:textColor="#7A8690"
        android:paddingTop="2dp"
        android:paddingBottom="4dp" />

    <!-- breathing orb driven by the wave function -->
    <com.yamaguchi.sleep.SleepView
        android:id="@+id/orb"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/breath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="準備完了 / ready"
        android:textSize="22sp"
        android:textColor="#AEE6EA"
        android:paddingTop="4dp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="#8A96A0"
        android:text="開始を押すと、波動関数のペースで呼吸をゆっくり誘導します" />

    <TextView
        android:id="@+id/psi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="10sp"
        android:textColor="#55707A"
        android:paddingTop="4dp"
        android:text="|ψ⟩ …" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp">
        <Button
            android:id="@+id/pulseBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="脈拍タップ" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="分:"
            android:textColor="#8A96A0"
            android:paddingStart="8dp"
            android:paddingEnd="4dp" />
        <EditText
            android:id="@+id/minutes"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="12"
            android:textColor="#D8E0E8" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">
        <Button
            android:id="@+id/startBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="開始 / Start" />
        <Button
            android:id="@+id/stopBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="停止 / Stop" />
    </LinearLayout>
</LinearLayout>
