<?xml version='1.0' encoding='utf-8'?>
<!--
  Cordova config — Bada Biofeedback (Android APK).
  娯楽・非医療・非予知。アカシックレコード/未来予知の機能はありません。
  CI ワークフローが cordova プロジェクトを作成し、この config.xml と ../www を差し込みます。
-->
<widget id="io.github.masaaki_avnturle.bada_biofeedback" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BadaBiofeedback</name>
  <description>バイオフィードバック音・センサー可視化・娯楽オラクル (非医療・非予知)</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff181a20" />
  <preference name="Orientation" value="portrait" />
  <preference name="Fullscreen" value="false" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#181a20" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
