{
  "name": "omega-canis-dna",
  "productName": "Omega-Canis-DNA",
  "version": "1.0.0",
  "description": "Ω-Canis DNA — dog (Canis lupus familiaris) DNA detection in sequence data by k-mer matching against mtDNA references, plus a conceptual gamma x Jones thermal view (NOT medical)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.github.masaaki_avnturle.omega_canis_dna",
    "productName": "Omega-Canis-DNA",
    "publish": null,
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../www",
        "to": "www"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Omega-Canis-DNA-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Science",
      "artifactName": "Omega-Canis-DNA-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
