{
  "name": "omega-silenttalk",
  "productName": "Omega-SilentTalk-BadaGPT",
  "version": "1.0.0",
  "description": "Ω-SilentTalk → BadaGPT — silent (no-audio) mouth/thought input to app & paper generation (concept; NOT real mind/lip reading)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win --x64", "dist:linux": "electron-builder --linux --x64" },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.omega_silenttalk",
    "productName": "Omega-SilentTalk-BadaGPT",
    "publish": null,
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "artifactName": "Omega-SilentTalk-${version}-${arch}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": ["AppImage", "deb"], "category": "Utility", "artifactName": "Omega-SilentTalk-${version}-${arch}.${ext}", "maintainer": "masaaki-avnturle" }
  }
}
