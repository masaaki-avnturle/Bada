{
  "name": "omega-biofeedback",
  "productName": "Omega-Biofeedback-Oracle",
  "version": "1.0.0",
  "description": "Ω-Biofeedback Oracle — generative biofeedback sound art (entertainment; NOT prediction, NOT medical)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.github.masaaki_avnturle.omega_biofeedback",
    "productName": "Omega-Biofeedback-Oracle",
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "Omega-Biofeedback-Oracle-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
