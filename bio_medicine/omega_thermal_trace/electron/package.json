{
  "name": "omega-thermal-trace",
  "productName": "Omega-Thermal-Trace",
  "version": "1.0.0",
  "description": "Ω-Thermal Trace — gamma-manifold body/brain heat-flow tracing (simulation; NOT medical, does not measure real temperature)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win --x64" },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.omega_thermal_trace",
    "productName": "Omega-Thermal-Trace",
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "artifactName": "Omega-Thermal-Trace-${version}-${arch}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
