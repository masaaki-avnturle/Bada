{
  "name": "omega-whispered",
  "productName": "Omega-Whispered",
  "version": "1.0.0",
  "description": "Omega-Whispered - mathematical symbol and equation-meaning aptitude test (unofficial fan homage; for learning/entertainment, not a real ability assessment)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win --x64" },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.omega_whispered",
    "productName": "Omega-Whispered",
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "artifactName": "Omega-Whispered-${version}-${arch}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
