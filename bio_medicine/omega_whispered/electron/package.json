{
  "name": "omega-whispered",
  "productName": "Omega-Whispered",
  "version": "1.1.0",
  "description": "Omega-Whispered - flash-reading and mathematical symbol/equation aptitude test (unofficial fan homage; for learning and entertainment, not a real ability assessment)",
  "author": "Masaaki Yamaguchi <masaaki.tabu4@gmail.com>",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64",
    "dist:deb": "electron-builder --linux deb --x64",
    "dist:appimage": "electron-builder --linux AppImage --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.omega_whispered",
    "productName": "Omega-Whispered",
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "publish": null,
    "win": {
      "target": ["nsis", "portable"],
      "icon": "../build/icons/512x512.png",
      "artifactName": "Omega-Whispered-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Omega-Whispered"
    },
    "linux": {
      "target": ["deb", "AppImage"],
      "icon": "../build/icons",
      "category": "Education;Science;Math",
      "maintainer": "Masaaki Yamaguchi <masaaki.tabu4@gmail.com>",
      "vendor": "Masaaki Yamaguchi",
      "synopsis": "Whispered aptitude test: flash reading of math terms and equations",
      "description": "Omega-Whispered is an offline aptitude test app: flash (shundoku) presentation of mathematical terms, symbols and scrambled equations, equation-meaning analysis, PDF math-symbol extraction, and a mathematical field-aptitude profile. Unofficial fan homage; for learning and entertainment only.",
      "desktop": {
        "Name": "Omega-Whispered",
        "Comment": "Flash-reading and mathematical aptitude test",
        "Categories": "Education;Science;Math;"
      },
      "artifactName": "Omega-Whispered-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0"]
    },
    "appImage": {
      "artifactName": "Omega-Whispered-${version}-linux-${arch}.${ext}"
    }
  }
}
