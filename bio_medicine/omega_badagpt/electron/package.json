{
  "name": "badagpt",
  "productName": "BadaGPT",
  "version": "1.0.0",
  "description": "BadaGPT — Bada language ζ-Entropy a-priori prediction engine. Upload PDF/source, enter Claude API key, generate & download answers as PDF/source (concept simulation).",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win --x64" },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.omega_badagpt",
    "productName": "BadaGPT",
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "artifactName": "BadaGPT-${version}-${arch}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
