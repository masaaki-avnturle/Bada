{
  "name": "omega-badagpt",
  "productName": "BadaGPT",
  "version": "1.0.0",
  "description": "BadaGPT (improved) — thought-input to app/PDF/source-code generation studio (concept; thought-input is the conceptual Omega-Telepathy text, not real mind-reading)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.github.masaaki_avnturle.omega_badagpt",
    "productName": "BadaGPT",
    "publish": null,
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "artifactName": "BadaGPT-${version}-${arch}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": ["AppImage", "deb"], "category": "Development", "artifactName": "BadaGPT-${version}-${arch}.${ext}", "maintainer": "masaaki-avnturle" }
  }
}
