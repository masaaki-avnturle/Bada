{
  "name": "omega-drug-forge",
  "version": "1.0.0",
  "description": "Ω-DrugForge — 形態形成場による薬剤製造シミュレーション (概念実証・教育用)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist-linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.bada.omega.drugforge",
    "productName": "Omega-DrugForge",
    "files": ["main.js", "../www/**/*"],
    "win": {
      "target": "portable",
      "icon": "../www/icon.png"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
