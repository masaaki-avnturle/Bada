{
  "name": "omega-drug-forge",
  "version": "1.0.0",
  "description": "Ω-DrugForge — 形態形成場による薬剤製造シミュレーション (概念実証・教育用)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist-linux": "electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "com.bada.omega.drugforge",
    "productName": "Omega-DrugForge",
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "../www/icon.png",
      "artifactName": "Omega-DrugForge-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "../www/icon.png",
      "category": "Education",
      "artifactName": "Omega-DrugForge-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
