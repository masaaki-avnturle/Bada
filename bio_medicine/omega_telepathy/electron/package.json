{
  "name": "omega-telepathy",
  "productName": "Omega-Telepathy",
  "version": "1.0.0",
  "description": "Ω-Telepathy — conceptual BCI thought-typing simulator (sim/art; NOT a real BCI, reads no thoughts, unaffiliated with Neuralink)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win --x64" },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.omega_telepathy",
    "productName": "Omega-Telepathy",
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "artifactName": "Omega-Telepathy-${version}-${arch}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
