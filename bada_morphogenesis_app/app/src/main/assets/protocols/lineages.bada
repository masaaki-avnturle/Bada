// ============================================================================
//  lineages.bada — Bada protocol library (iPS 分化 + 製造シミュレーション)
// ----------------------------------------------------------------------------
//  各 protocol は「カタストロフィ理論の双安定分岐＋反応拡散の形態形成場」を
//  使った “分化シミュレーションの設定” です。field_strength / cusp_a /
//  cusp_b / branch_prob が分岐の強さを決めます。
//
//  ⚠️ 重要: これは数学シミュレーションの設定値であり、実在の細胞培養プロトコル・
//  医薬品製造ではありません。反重力や逆流電磁気の実機でもありません。
// ============================================================================

protocol "cardio" {
    label          = "心筋細胞 分化"
    target         = "心筋細胞"
    field_strength = 0.65
    cusp_a         = -1.4      // 強い双安定 => 分岐が活発
    cusp_b         = 0.0
    branch_prob    = 0.64
    feed           = 0.037
    kill           = 0.060
    drug           = "心筋再生候補 BX-1 (シミュレーション)"
    note           = "中胚葉経由の分岐を強め、心筋細胞の収率を狙う設定。"
}

protocol "neuro" {
    label          = "神経細胞 分化"
    target         = "神経細胞"
    field_strength = 0.5
    cusp_a         = -1.1
    cusp_b         = 0.1
    branch_prob    = 0.58
    feed           = 0.030
    kill           = 0.062
    drug           = "神経再生候補 NX-2 (シミュレーション)"
    note           = "外胚葉系の分岐に偏らせる設定。"
}

protocol "hepato" {
    label          = "肝細胞 分化"
    target         = "肝細胞"
    field_strength = 0.55
    cusp_a         = -1.2
    cusp_b         = -0.05
    branch_prob    = 0.6
    feed           = 0.039
    kill           = 0.058
    drug           = "肝再生候補 HX-3 (シミュレーション)"
    note           = "内胚葉系の分岐を狙う設定。"
}

protocol "beta" {
    label          = "膵β細胞 分化"
    target         = "膵β細胞"
    field_strength = 0.7
    cusp_a         = -1.5
    cusp_b         = 0.0
    branch_prob    = 0.66
    feed           = 0.038
    kill           = 0.061
    drug           = "糖尿病候補 PX-4 (シミュレーション)"
    note           = "内胚葉→膵系への深い分岐を強める設定。"
}

protocol "blood" {
    label          = "血球細胞 分化"
    target         = "血球細胞"
    field_strength = 0.45
    cusp_a         = -1.0
    cusp_b         = 0.05
    branch_prob    = 0.55
    feed           = 0.036
    kill           = 0.060
    drug           = "造血候補 RX-5 (シミュレーション)"
    note           = "中胚葉→血球系の分岐設定。"
}
