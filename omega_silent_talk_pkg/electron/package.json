{
  "name": "omega-silent-talk",
  "productName": "Omega-SilentTalk",
  "version": "1.0.0",
  "description": "Ω Silent-Talk — gamma-manifold AGI thought-input simulator (sim/art; NOT a real BCI, reads no thoughts, non-medical)",
  "author": "Masaaki Yamaguchi <masaaki.tabu4@gmail.com>",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.omega_silent_talk",
    "productName": "Omega-SilentTalk",
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "publish": null,
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "Omega-SilentTalk-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Science",
      "maintainer": "Masaaki Yamaguchi <masaaki.tabu4@gmail.com>",
      "vendor": "Masaaki Yamaguchi",
      "artifactName": "Omega-SilentTalk-${version}-linux-${arch}.${ext}",
      "synopsis": "Gamma-manifold thought-input simulator (sim/art, non-medical)",
      "description": "Omega-SilentTalk is a conceptual thought-input simulator: gamma-function global partial-integration manifold pipeline with Markov language emergence, zeta/Shannon statistics, Jones-polynomial thermal observation and a 5-qubit quantum mode. Simulation/art only; non-medical, reads no thoughts.",
      "desktop": {
        "Name": "Omega-SilentTalk",
        "Comment": "Gamma-manifold thought-input simulator",
        "Categories": "Science;Education;"
      }
    }
  }
}
