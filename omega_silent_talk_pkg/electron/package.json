{
  "name": "omega-silent-talk",
  "productName": "Omega-SilentTalk",
  "version": "1.0.0",
  "description": "Ω Silent-Talk — gamma-manifold AGI thought-input simulator (sim/art; NOT a real BCI, reads no thoughts, non-medical)",
  "author": { "name": "Masaaki Yamaguchi", "email": "masaaki.tabu4@gmail.com" },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.omega_silent_talk",
    "productName": "Omega-SilentTalk",
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "Omega-SilentTalk-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Science",
      "artifactName": "Omega-SilentTalk-${version}-${arch}.${ext}",
      "synopsis": "Gamma-manifold thought-input simulator (sim/art, non-medical)"
    }
  }
}
