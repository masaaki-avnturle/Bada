<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of BADA Compose (作曲スタジオ).
     ワークフロー (compose-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_compose/index.html) を差し込みます。
     WAV / MIDI / 動画 / プロジェクトの保存は cordova-plugin-save-dialog
     (SAF の保存ダイアログ) で保存先を選んで行われます。 -->
<widget id="io.github.masaaki_avnturle.badacompose" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BadaCompose</name>
  <description>BADA Compose — Piano Concerto BADA のコード進行エンジンで作曲するアプリ。小節ごとに和音・役割 (ソロ / トゥッティ / 合奏 / カデンツァ)・テンポ・主題を編集すると、対位法エンジンが 4 声を作り、ピアノと管弦楽の合成音で再生。WAV / MIDI / 動画 / score.json に書き出し。依存ゼロ・単一 HTML・オフライン動作</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
