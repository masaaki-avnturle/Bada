{
  "name": "bada-compose",
  "productName": "BadaCompose",
  "version": "1.0.0",
  "description": "BADA Compose — a composition studio built on the Piano Concerto BADA chord-progression engine. Edit chords, roles (solo / tutti / both / cadenza), tempo and themes bar by bar; a rule-based counterpoint engine writes the four voices; play with a synthesized piano and orchestra; export WAV, MIDI, video (MP4/WebM) and score.json. Self-contained HTML app, zero dependencies, fully offline.",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.badacompose",
    "productName": "BadaCompose",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaCompose-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "BadaCompose-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "artifactName": "BadaCompose-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
