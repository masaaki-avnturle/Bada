# cffi.bada — C実装の Bada から C 共有ライブラリを dlopen/dlsym して呼ぶ。
#   cfn(lib, fn, ...nums) -> double    （libm の cos/pow/tgamma 等）
#   cint(lib, fn, arg)    -> int       （文字列→strlen / 数値→abs）
#   cstr(lib, fn, str)    -> string    （getenv 等の char* 戻り）

# libm を Bada の関数として薄くラップ（import の代わり）
def cos(x)
  return cfn("m", "cos", x)
end
def powf(a, b)
  return cfn("m", "pow", a, b)
end
def tgamma(x)
  return cfn("m", "tgamma", x)
end

print "C cos(0)        = " + str(cos(0))
print "C pow(2,16)     = " + str(powf(2, 16))
print "C tgamma(5)     = " + str(tgamma(5))
print "C strlen(hello) = " + str(cint("c", "strlen", "hello"))
print "C abs(-7)       = " + str(cint("c", "abs", 0 - 7))
print "C getenv(HOME)  = " + str(cstr("c", "getenv", "HOME"))

# 指示指向オブジェクトに適応：C 関数（や builtin）を分岐ディレクティブに渡す
def add(a, b)
  return a + b
end
print "Σgamma builtin  = " + str((0 <- 0) -< [2, 3, 4, 5] -< gamma >- add)
print "Σtgamma C-FFI   = " + str((0 <- 0) -< [2, 3, 4, 5] -< tgamma >- add)
