# evolve.bada — 自己進化：Bada 自身を使って、改良された Bada プログラムを生成する。
# 進化のゲート（中枢トリガー）は、ガンマ関数における大域的部分積分多様体の
# エントロピー不変量 Xi。Xi がしきい値を超えたとき、新しい世代のコードを書き出す。

let trigger = xi([0.5, 0.3, 0.2])
print "self-evolution trigger Xi = " + str(trigger)

if trigger > 0.1
  # Bada が Bada のソースコードを生成する（文字列＝リスト構造の上に構築）
  let src = "# auto-generated by Bada self-evolution\n"
  src = src + "def evolved_energy(m, v)\n"
  src = src + "  return m * pow(v, 2) + " + str(trigger) + "\n"
  src = src + "end\n"
  src = src + "print \"evolved_energy(2,3) = \" + str(evolved_energy(2, 3))\n"
  write_file("/tmp/bada_evolved.bada", src)
  print "evolved program written -> /tmp/bada_evolved.bada"
else
  print "trigger idle; no evolution"
end
