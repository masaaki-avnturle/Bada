# directive.bada — 指示指向オブジェクト（C実装の Bada）
#   <- 代入 / -< 分岐 / >- 合流。指示オブジェクトは cons リスト (directive ...) で表現。

def add(a, b)
  return a + b
end
def maxd(a, b)
  if a > b
    return a
  end
  return b
end

print "代入 <- :   " + str(0 <- 7)
let p = (0 <- 7) -< [def(x) return x end, def(x) return x * x end, def(x) return x * x * x end]
print "分岐 -< :   " + str(p)
print "合流(和) :  " + str(p >- add)
print "合流(最大): " + str(p >- maxd)
# map-reduce: Σ k^2 (k=1..5)
print "Σk^2(1..5): " + str((0 <- 0) -< [1, 2, 3, 4, 5] -< def(x) return x * x end >- add)
