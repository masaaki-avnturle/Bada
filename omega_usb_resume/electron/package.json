{
  "name": "omega-usb-resume",
  "productName": "Omega-USB-Resume",
  "version": "1.0.0",
  "description": "Ω-USB Resume — revive dead USB ports via complex-rotation-body / integrable n進数 drift correction (simulation UI; the browser/app does not touch the host's real USB)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "repository": { "type": "git", "url": "https://github.com/masaaki-avnturle/Bada.git" },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.omega_usb_resume",
    "productName": "Omega-USB-Resume",
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "artifactName": "Omega-USB-Resume-${version}-${arch}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "synopsis": "Revive dead USB ports via complex-rotation-body / integrable n-ary drift correction (simulation)",
      "maintainer": "Masaaki Yamaguchi <masaaki.tabu4@gmail.com>",
      "artifactName": "Omega-USB-Resume-${version}-${arch}.${ext}"
    }
  }
}
