# engines.bada — 未知事前エンジン群を Bada 言語でまとめるライブラリ
# 情報生成・命題証明・大脳基底核ゲーティング・ペンローズ図式を Bada から呼ぶ。

library Engines
  # 情報生成（サーストン・ペレルマン / カタストロフィ / ミレニアム）
  def info(q)
    return Info.render(q)
  end

  # 未知事前エンジン：未解決風命題を想像して健全に証明
  def prove(q, n)
    return Prover.render(q, n)
  end

  # 大脳基底核の体内神経システムで取り組む順序を選択して証明
  def deliberate(q, n)
    return Basal.deliberate(q, n)
  end

  # ペンローズ絵記号を計算（アインシュタイン縮約）
  def penrose(drawing)
    return Penrose.compute(drawing)
  end
end
