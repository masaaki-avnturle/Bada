# core.bada — Bada 言語で書かれた基盤ライブラリ
# (Bada 言語のネイティブ橋渡し機能の上に、Bada 言語自身で構築)

library Core
  # 区切り線
  def rule(label)
    return "──────── " + label + " ────────"
  end

  # 値を見出し付きで整形
  def labeled(name, value)
    return name + " = " + str(value)
  end

  # 2値の最大
  def max2(a, b)
    if a > b
      return a
    end
    return b
  end
end
