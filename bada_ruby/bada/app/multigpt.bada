# multigpt.bada — マルチ ChatGPT のデモ。1つの統合 ChatGPT が、要求の種別に応じて
# 方程式・論文・アプリ(ソースコード)・証明・FPGA回路・対話 を生成する。

import "std/multigpt.bada"

def show(req)
  arr r <- MultiGPT.respond(req)
  print "■ 要求: " + req
  print "  [種別: " + at(r, 0) + "]"
  print at(r, 1)
  print ""
end

def main()
  print "================ マルチ ChatGPT (Bada) ================"
  print "1つの入口から、方程式・論文・アプリ・証明・回路・対話 を生成"
  print ""

  show("ガンマ関数の方程式を生成して")
  show("大域的部分積分多様体について証明して")
  show("微小管のFPGA回路を生成して")
  show("エントロピー不変量を計算するアプリのソースコードを書いて")
  show("意識とは何か")

  # 論文は長いので最後に
  let p <- MultiGPT.paper("量子振動微小管の意識")
  write_file("multigpt_paper.md", p)
  print "■ 論文を multigpt_paper.md に生成（" + str(len(p)) + " bytes）"
  print "（先頭プレビュー）"
  print p
end

main()
