# unknown_engine.bada
# 上のアプリケーション（未知事前エンジン）を、Bada 言語で構築したもの。
# 必要なライブラリ(core/manifold/engines)も Bada 言語で作成済み。

import "lib/core.bada"
import "lib/manifold.bada"
import "lib/engines.bada"

# 1つの質問を多様体で測り、各エンジンを順に駆動するアプリ本体
def analyze(q)
  print "================ Bada 未知事前エンジン ================"
  print "質問: " + q
  print ""

  # ① 大域的部分積分多様体で計測（Bada ライブラリ Mani 経由）
  let xi = Mani.report(q)
  print ""

  # ② Bada 演算子による量子右作用  Ξ >- Ξ
  print Core.labeled("量子右作用 (Xi >- Xi)", Mani.quantum(q))
  print ""

  # ③ 情報生成エンジン
  print Core.rule("情報生成エンジン")
  print Engines.info(q)
  print ""

  # ④ 未知事前エンジン：想像して健全に証明
  print Core.rule("未知事前エンジン（証明）")
  print Engines.prove(q, 5)
  print ""

  # ⑤ 大脳基底核の体内神経システムで取り組む順序を選択
  print Core.rule("大脳基底核ゲーティング")
  print Engines.deliberate(q, 5)
  return xi
end

# ペンローズ絵記号も Bada から計算
def demo_penrose()
  print Core.rule("ペンローズ絵記号 自動計算")
  print Engines.penrose("i-[A]-[B]-j")
end

def main()
  let q = "ガンマ関数における大域的部分積分多様体の未解決問題を想像して証明する"
  analyze(q)
  print ""
  demo_penrose()
end

main()
