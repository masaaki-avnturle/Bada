# std/entropy.bada — シャノンのエントロピーを「指示指向の map-reduce」で実装
#   各確率レーンを項 -p log2 p に分岐(-<)し、和で合流(>-)する。

import "std/math.bada"
import "std/flow.bada"

library Entropy
  def term(p)
    if p > 0
      return 0 - p * M.log2(p)
    end
    return 0
  end

  def shannon(ps)
    if len(ps) == 0
      return 0
    end
    # 確率リストをレーンに載せ、項に分岐し、和で合流
    return Flow.mapreduce(ps, def(p) return Entropy.term(p) end, def(a, b) return a + b end)
  end
end
