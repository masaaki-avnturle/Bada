# std/entropy.bada — シャノンのエントロピーを Bada 言語で実装
# 確率分布（リスト）H = -Σ p log2 p

import "std/math.bada"

library Entropy
  def shannon(ps)
    let h = 0
    let i = 0
    while i < len(ps)
      let p = at(ps, i)
      if p > 0
        h = h - p * M.log2(p)
      end
      i = i + 1
    end
    return h
  end
end
