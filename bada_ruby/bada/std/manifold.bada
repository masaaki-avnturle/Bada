# std/manifold.bada — ガンマ関数における大域的部分積分多様体を Bada 言語で実装
# 多様体線素 1/(x log x)^2、∬、エントロピー不変量 Ξ = β(H+1,M+1)/log(N+1)

import "std/special.bada"
import "std/entropy.bada"

library Mani
  def x_log_x(x)
    return Special.x_log_x(x)
  end

  # 多様体線素  dμ(x) = 1/(x log x)^2
  def element(x)
    if x <= 1
      return 1
    end
    let xl = x_log_x(x)
    if abs(xl) < 0.000000001
      return 1
    end
    return 1 / (xl * xl)
  end

  # ∬ 1/(x log x)^2 dμ を確率分布のランク座標で離散積分
  def integral(ps)
    let m = 0
    let i = 0
    while i < len(ps)
      let x = i + 2
      m = m + at(ps, i) * element(x)
      i = i + 1
    end
    return m
  end

  # 大域的部分積分多様体のエントロピー不変量 Ξ
  def invariant(ps)
    let h = Entropy.shannon(ps)
    let m = integral(ps)
    let n = len(ps)
    return Special.zeta_gauge(h + 1, m + 1, n + 1)
  end
end
