# std/manifold.bada — ガンマ関数における大域的部分積分多様体を指示指向で実装。
# ∬ 1/(x log x)^2 を「ランク座標の分岐(-<)→重み付き和の合流(>-)」で計算する。

import "std/special.bada"
import "std/entropy.bada"
import "std/flow.bada"

library Mani
  def x_log_x(x)
    return Special.x_log_x(x)
  end

  # 多様体線素  dμ(x) = 1/(x log x)^2
  def element(x)
    if x <= 1
      return 1
    end
    let xl = x_log_x(x)
    if abs(xl) < 0.000000001
      return 1
    end
    return 1 / (xl * xl)
  end

  # ∬ 1/(x log x)^2 dμ を、ランク添字の分岐→重み付き和の合流で計算
  def integral(ps)
    let n = len(ps)
    if n == 0
      return 0
    end
    return Flow.mapreduce(range(n),
      def(i) return at(ps, i) * Mani.element(i + 2) end,
      def(a, b) return a + b end)
  end

  # 大域的部分積分多様体のエントロピー不変量 Ξ
  def invariant(ps)
    let h = Entropy.shannon(ps)
    let m = integral(ps)
    let n = len(ps)
    return Special.zeta_gauge(h + 1, m + 1, n + 1)
  end
end
