# telomere.bada — 分裂テロメア（ヘイフリック限界）モデル。
# 各分裂でテロメアが1短縮し、0 で老化（分裂停止）。テロメラーゼで自己複製能を維持。

library Telo
  # まだ分裂可能か（テロメア残量 > 0）
  def alive(telomere)
    return telomere > 0
  end

  # 分裂：テロメア1短縮
  def divide(telomere)
    return telomere - 1
  end

  # テロメラーゼ：高フィットネス時のみ伸長（幹細胞的自己複製）。bounded。
  def telomerase(telomere, fitness)
    if fitness > 0.2
      return telomere + 1
    end
    return telomere
  end
end
