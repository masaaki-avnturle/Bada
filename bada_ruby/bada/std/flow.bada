# std/flow.bada — 指示指向オブジェクトのコンビネータ（Bada 言語）
#   <- 代入 / -< 分岐 / >- 合流 だけで map / reduce / find を組み立てる。

library Flow
  # リスト xs をレーンに載せた指示オブジェクトを作る（代入 <- ＋ 分岐 -<）
  def seed(xs)
    return (0 <- 0) -< xs
  end

  # 各レーンを写像（分岐 -<）
  def map(d, f)
    return d -< f
  end

  # レーンを合流（マージ >-）
  def reduce(d, f)
    return d >- f
  end

  # map → reduce のパイプライン：seed -< mf >- rf
  def mapreduce(xs, mf, rf)
    return Flow.seed(xs) -< mf >- rf
  end

  # 合流：左から最初の非ゼロを返す（探索のエンコードに使う）
  def first_positive(a, b)
    if a > 0
      return a
    end
    return b
  end

  # 合流：和
  def add(a, b)
    return a + b
  end

  # 並列レーン結合：2つのリストをレーンごとに f で結合した指示オブジェクトを返す。
  # 各レーン i は f(xs[i], ys[i]) として独立に評価される（並列レーン）。
  def zip(xs, ys, f)
    return Flow.seed(range(len(xs))) -< def(i) return f(at(xs, i), at(ys, i)) end
  end

  # 並列結合してから合流まで一気に行う（zip → reduce）
  def zipreduce(xs, ys, f, rf)
    return Flow.zip(xs, ys, f) >- rf
  end

  # ── 条件分岐レーン ──
  # 述語 pred を満たすレーンだけ残した指示オブジェクトを返す
  def filter(xs, pred)
    let kept = []
    let i = 0
    while i < len(xs)
      let x = at(xs, i)
      if pred(x)
        kept = push(kept, x)
      end
      i = i + 1
    end
    return Flow.seed(kept)
  end

  # 条件ルーティング：pairs = [[述語, 変換], ...]。最初に述語が真になる変換を適用し、
  # その結果を単一レーンの指示オブジェクトとして返す（条件分岐レーン）。
  def route(x, pairs)
    let i = 0
    while i < len(pairs)
      let pr = at(pairs, i)
      let pred = at(pr, 0)
      let fn = at(pr, 1)
      if pred(x)
        return 0 <- fn(x)
      end
      i = i + 1
    end
    return 0 <- x
  end

  # ── 名前付きレーン ──
  # 値リストに名前を付けた [名前, 値] のレーン列を作る
  def label(values, names)
    let out = []
    let i = 0
    while i < len(values)
      out = push(out, [at(names, i), at(values, i)])
      i = i + 1
    end
    return out
  end

  # 名前でレーンの値を取り出す
  def pluck(labeled, name)
    let i = 0
    while i < len(labeled)
      let pr = at(labeled, i)
      if at(pr, 0) == name
        return at(pr, 1)
      end
      i = i + 1
    end
    return nil
  end
end
