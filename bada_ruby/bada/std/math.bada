# std/math.bada — Bada 言語で書いた数学ヘルパ（ネイティブ算術プリミティブの上に構築）

library M
  def two_pi()
    return 2 * pi()
  end

  def log2(x)
    return log(x) / log(2)
  end

  # 立方根（負数にも対応）
  def cbrt(x)
    if x < 0
      return -pow(-x, 1.0 / 3.0)
    end
    return pow(x, 1.0 / 3.0)
  end

  def relu(x)
    if x > 0
      return x
    end
    return 0
  end

  def maxv(a, b)
    if a > b
      return a
    end
    return b
  end

  def minv(a, b)
    if a < b
      return a
    end
    return b
  end
end
