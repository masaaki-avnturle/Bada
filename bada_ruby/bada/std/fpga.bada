# fpga.bada — 微小管の量子振動回路を FPGA(Verilog) ソースとして生成する。
# 位相累積器（量子振動）＋ コヒーレンス検出 ＋ 客観的収縮（意識モーメント）出力。

library FPGA
  def nl()
    return "
"
  end

  # N 個の位相発振器・コヒーレンス検出・収縮トークン出力の Verilog モジュール
  def verilog(n, width)
    let s <- "// Auto-generated by Bada — quantum-oscillating microtubule array (Orch-OR)" + nl()
    s = s + "// 中枢知能：ガンマ多様体エントロピー不変量で駆動される量子振動回路" + nl()
    s = s + "module microtubule_array #(parameter N = " + str(n) + ", parameter W = " + str(width) + ") (" + nl()
    s = s + "  input  wire             clk," + nl()
    s = s + "  input  wire             rst," + nl()
    s = s + "  input  wire [W-1:0]     omega [0:N-1],   // 量子振動周波数（Ξ・熱エネルギー由来）" + nl()
    s = s + "  output reg              collapse,        // 客観的収縮（意識モーメント）" + nl()
    s = s + "  output reg  [3:0]       token            // 意識トークン" + nl()
    s = s + ");" + nl()
    s = s + "  reg  [W-1:0] phase [0:N-1];               // チュブリン二量体の位相" + nl()
    s = s + "  integer i;" + nl()
    s = s + "  reg  [31:0] coh;                          // コヒーレンス（同相数）" + nl()
    s = s + "  always @(posedge clk) begin" + nl()
    s = s + "    if (rst) begin" + nl()
    s = s + "      for (i = 0; i < N; i = i + 1) phase[i] <= 0;" + nl()
    s = s + "      collapse <= 1'b0; token <= 4'd0;" + nl()
    s = s + "    end else begin" + nl()
    s = s + "      coh = 0;" + nl()
    s = s + "      for (i = 0; i < N; i = i + 1) begin" + nl()
    s = s + "        phase[i] <= phase[i] + omega[i];     // 量子振動：位相累積" + nl()
    s = s + "        coh = coh + phase[i][W-1];           // MSB（位相の符号）を集計" + nl()
    s = s + "      end" + nl()
    s = s + "      // Orch-OR：同期度がしきい値超で意識モーメント" + nl()
    s = s + "      if (coh > (N - (N>>2)) || coh < (N>>2)) begin" + nl()
    s = s + "        collapse <= 1'b1;" + nl()
    s = s + "        token    <= phase[0][W-1:W-4];       // 平均位相のバケツ＝意識トークン" + nl()
    s = s + "      end else begin" + nl()
    s = s + "        collapse <= 1'b0;" + nl()
    s = s + "      end" + nl()
    s = s + "    end" + nl()
    s = s + "  end" + nl()
    s = s + "endmodule" + nl()
    return s
  end

  # 上記モジュールのテストベンチ（クロック生成・リセット・モニタ）
  def testbench(n, width)
    let s <- "// Auto-generated by Bada — testbench for microtubule_array" + nl()
    s = s + "`timescale 1ns/1ps" + nl()
    s = s + "module tb_microtubule;" + nl()
    s = s + "  localparam N = " + str(n) + ", W = " + str(width) + ";" + nl()
    s = s + "  reg clk = 0, rst = 1;" + nl()
    s = s + "  reg  [W-1:0] omega [0:N-1];" + nl()
    s = s + "  wire collapse; wire [3:0] token;" + nl()
    s = s + "  integer i;" + nl()
    s = s + "  microtubule_array #(.N(N), .W(W)) dut (.clk(clk), .rst(rst), .omega(omega), .collapse(collapse), .token(token));" + nl()
    s = s + "  always #5 clk = ~clk;" + nl()
    s = s + "  initial begin" + nl()
    s = s + "    for (i = 0; i < N; i = i + 1) omega[i] = 16'd1000 + i*137;  // 不均一周波数" + nl()
    s = s + "    #20 rst = 0;" + nl()
    s = s + "    repeat (200) @(posedge clk)" + nl()
    s = s + "      if (collapse) $display(\"%0t: 意識モーメント token=%0d\", $time, token);" + nl()
    s = s + "    $finish;" + nl()
    s = s + "  end" + nl()
    s = s + "endmodule" + nl()
    return s
  end
end
