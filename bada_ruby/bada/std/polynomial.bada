# std/polynomial.bada — 多項式（係数リスト）を Bada 言語で実装
# coeffs[i] は x^i の係数。整数係数で厳密に評価する。

library Poly
  # ホーナー法で整数評価 E(n)
  def eval(coeffs, n)
    let acc = 0
    let i = len(coeffs) - 1
    while i >= 0
      acc = acc * n + at(coeffs, i)
      i = i - 1
    end
    return acc
  end

  # x^a - x  （長さ a+1 の係数リスト）。フェルマーの小定理型。
  def power_minus_x(a)
    let c = fill(a + 1, 0)
    c = set_at(c, a, 1)
    c = set_at(c, 1, -1)
    return c
  end
end
