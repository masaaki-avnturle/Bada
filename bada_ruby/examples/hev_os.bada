# hev_os.bada — the hybrid energy-split arbitration in the Bada language.
# Run with:  bin/bada run examples/hev_os.bada
#
# BadaOS-HEV's energy manager (ECMS) decides, every cycle, how to meet the
# driver's power demand from the engine and/or the battery. Here that decision
# is sketched with the three Bada manifold operators, and the result is written
# to the Ω::DATABASE (Akashic) flight recorder.
#
#   <-   left non-commutative act   π(χ,x) = [iπ, f(x)]   (fuse the power demand)
#   -<   manifold integral          ∬ 1/(x log x)^2 dx_m  (ECMS equivalence cost)
#   >-   quantum right act          e^{-x log x}           (BSFC efficiency law)
#   Omega::push                     write to the HEV black box

# --- driver power demand ---------------------------------------------------
set demand = 45.0                              # wheel power demand (kW)
demand <- "hybrid power split engine battery"  # fuse the manifold signature
print demand

# --- ECMS equivalence cost (engine vs battery) -----------------------------
demand -< 2.6                                  # manifold integral ~ s-cost
print demand

# --- engine brake-specific fuel consumption (BSFC) -------------------------
set ice = 40.0                                 # engine operating point (kW)
ice >- ice                                     # e^{-x log x} -> efficiency law
print ice

# --- record the arbitration to the Ω::DATABASE black box -------------------
Omega::push demand as ecms_split_node
Omega::push ice as engine_bsfc_node
print demand
