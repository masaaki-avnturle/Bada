# iq_pipeline.bada — the IQ assessment pipeline expressed with Bada operators.
#
# This is the symbolic operator-front of Bada::IQ. Each biosignal is loaded as
# a manifold node, acted on by the three core Bada operators, then pushed to the
# Akashic TupleSpace. The full numeric assessment (mirror statistics, Bayesian
# posterior, whispered judge) is produced by:  bin/bada iq examples/subject.json
#
# Operators:
#   <-   left non-commutative act   π(χ,x) = [iπ, f(x)]   (imprint the biosignal)
#   -<   manifold integral          ∬ 1/(x log x)^2 dx_m  (curve onto the manifold)
#   >-   quantum right act          e^{-x log x}          (collapse to a readout)

set fmri = 2.1
fmri <- "functional connectivity efficiency"
fmri -< 1.0
print fmri
Omega::push fmri as fmri_node

set mri = 1.7
mri <- "gray matter cortical thickness"
mri -< 1.0
print mri
Omega::push mri as mri_node

set eeg = 1.9
eeg <- "brain topography neural conduction speed"
eeg -< 1.0
print eeg
Omega::push eeg as topography_node

set dna = 1.2
dna <- "cognitive polygenic score"
dna -< 1.0
print dna
Omega::push dna as dna_node

set blood = 0.6
blood <- "BDNF metabolic inflammation biomarker"
blood >- blood
print blood
Omega::push blood as blood_node
