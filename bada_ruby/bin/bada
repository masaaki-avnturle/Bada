#!/usr/bin/env ruby
# frozen_string_literal: true

# bada — CLI for the Bada/Ruby OmegaChat 分派.
#
#   bin/bada repl                       start the chat REPL
#   bin/bada ask "質問..."              one-shot question (incl. info block)
#   bin/bada info "質問..."             Thurston/catastrophe/millennium info gen
#   bin/bada prove "質問..."            imagine unsolved problems & soundly prove them
#   bin/bada basal "質問..."            basal-ganglia thermal action-selection over proofs
#   bin/bada palette                    show the Penrose graphical-notation palette
#   bin/bada penrose draw.penrose       draw -> auto-compute -> answer + paper + code
#   bin/bada neural                     train the neural LLM, then REPL
#   bin/bada train [model.json]         train and save a checkpoint
#   bin/bada run script.bada            run a legacy operator script (<- -< >-)
#   bin/bada lang [app.bada]            run a Bada-language program (libs + app)
#   bin/bada gpt "要求..."             マルチ ChatGPT (方程式/論文/アプリ/証明/回路/対話)
#   bin/bada llm "質問..."             real LLM API (鍵があれば本物) else ローカル分派
#   bin/bada llm versions              バージョン台帳を表示
#   bin/bada llm --downgrade [N] "..."  前のバージョンへN段ダウングレードして質問
#   bin/bada dialects                   language branching system: fork variants (亜種)
#   bin/bada learn file1 file2 ...      ingest then start REPL
#   bin/bada xi "text"                  show entropy + manifold invariant

Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8
ARGV.map! { |a| a.dup.force_encoding("UTF-8") }

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "bada"

CORPUS_DIR = File.expand_path("../corpus", __dir__)

def load_corpus(chat)
  return unless Dir.exist?(CORPUS_DIR)
  Dir.glob(File.join(CORPUS_DIR, "*.txt")).sort.each do |f|
    chat.learn_file(f)
  end
end

cmd = ARGV.shift || "repl"

case cmd
when "repl"
  chat = Bada::OmegaChat.new
  load_corpus(chat)
  chat.repl
when "ask"
  chat = Bada::OmegaChat.new
  load_corpus(chat)
  puts chat.ask(ARGV.join(" "))
when "learn"
  chat = Bada::OmegaChat.new
  ARGV.each { |f| chat.learn_file(f) }
  chat.repl
when "run"
  path = ARGV.shift or abort("usage: bada run script.bada")
  interp = Bada::Interpreter.new
  interp.run(File.read(path)).each { |line| puts line }
when "lang"
  # Run a program written in the Bada scripting language (functions, libraries,
  # import, native bridge). Defaults to the unknown-engine app.
  path = ARGV.shift || File.expand_path("../bada/app/unknown_engine.bada", __dir__)
  Bada::Lang.run_file(path)
when "directive"
  # Directive-oriented objects demo: <- 代入 / -< 分岐 / >- 合流.
  Bada::Lang.run_file(File.expand_path("../bada/app/directive.bada", __dir__))
when "syntax"
  # Array / range / index / hash / typed-let / loop syntax demo.
  Bada::Lang.run_file(File.expand_path("../bada/app/syntax.bada", __dir__))
when "consciousness"
  # Quantum-oscillating microtubule (Orch-OR) consciousness app that generates
  # consciousness language and emits an FPGA (Verilog) central-intelligence circuit.
  Bada::Lang.run_file(File.expand_path("../bada/app/consciousness.bada", __dir__))
when "genai"
  # Generative AI: connect the FPGA Bada source to the ChatGPT branch and
  # generate the next-candidate source code (Bada + Verilog + testbench).
  Bada::Lang.run_file(File.expand_path("../bada/app/genai_fpga.bada", __dir__))
when "evolve", "self-evolve"
  # Self-evolving ChatGPT-variant: quantum BIOS + NPU FPGA SoC that evolves its
  # own source code across telomere-bounded (Hayflick) generations.
  Bada::Lang.run_file(File.expand_path("../bada/app/self_evolve.bada", __dir__))
when "llm"
  # Ask through a real LLM API (Anthropic / OpenAI-compatible) when a key is
  # configured, otherwise fall back to the local 分派. The model is chosen from
  # a version ladder you can downgrade/upgrade/pin.
  #
  #   bada llm versions                    list the version ladder
  #   bada llm "質問"                      ask at the current version
  #   bada llm --model claude-opus-4-7 "質問"   pin a specific previous version
  #   bada llm --downgrade [N] "質問"      step down N versions, then ask
  if ARGV[0] == "versions"
    cur = Bada::Lang::LLM.version_id
    puts "#{Bada::Lang::LLM.codename} — ChatGPT バージョン台帳（上=高性能 / 下=ローカル）:"
    Bada::Lang::LLM::LADDER.each do |e|
      mark = e[:id] == cur ? " ← 現在" : ""
      puts format("  %-18s %-14s %s%s", e[:id], e[:label], e[:note], mark)
    end
  else
    # parse optional version flags before the question text
    until ARGV.empty?
      case ARGV[0]
      when "--model", "--use"
        ARGV.shift
        v = ARGV.shift
        warn "[unknown version: #{v}]" unless Bada::Lang::LLM.use(v)
      when "--downgrade"
        ARGV.shift
        n = ARGV[0] =~ /\A\d+\z/ ? ARGV.shift.to_i : 1
        Bada::Lang::LLM.downgrade(n)
      when "--upgrade"
        ARGV.shift
        n = ARGV[0] =~ /\A\d+\z/ ? ARGV.shift.to_i : 1
        Bada::Lang::LLM.upgrade(n)
      else
        break
      end
    end
    q = ARGV.join(" ")
    q = "意識とは何か" if q.empty?
    if Bada::Lang::LLM.live?
      warn "[llm: #{Bada::Lang::LLM.version_label} (#{Bada::Lang::LLM.model}) / backend: #{Bada::Lang::LLM.backend}]"
    elsif Bada::Lang::LLM.current_model == "local"
      warn "[llm: ローカル分派にダウングレード済み（#{Bada::Lang::LLM.version_label}）]"
    else
      warn "[llm: #{Bada::Lang::LLM.version_label} 選択中だが鍵なし → ローカル分派にフォールバック]"
    end
    src = %(import "std/multigpt.bada"\nprint Chat.llm(#{q.inspect})\n)
    Bada::Lang.run(src, base_dir: File.expand_path("../bada", __dir__))
  end
when "gpt"
  # Multi ChatGPT: one request -> equation / paper / app source / proof / circuit / chat.
  req = ARGV.join(" ")
  if req.empty?
    Bada::Lang.run_file(File.expand_path("../bada/app/multigpt.bada", __dir__))
  else
    src = %(import "std/multigpt.bada"\n) +
          %(arr r <- MultiGPT.respond(#{req.inspect})\n) +
          %(print "[種別: " + at(r, 0) + "]"\nprint at(r, 1)\n)
    Bada::Lang.run(src, base_dir: File.expand_path("../bada", __dir__))
  end
when "foreign"
  # Import Ruby / Python / C libraries from Bada.
  Bada::Lang.run_file(File.expand_path("../bada/app/foreign.bada", __dir__))
  puts
  # Directive-oriented objects applied to the foreign libraries.
  Bada::Lang.run_file(File.expand_path("../bada/app/directive_foreign.bada", __dir__))
when "dialects"
  # Language branching system: fork variants (亜種) with the Reviser, run a
  # program in each, and show the branch genealogy.
  ja = Bada::Lang.fork(name: "bada-ja") do
    rename :def, "関数"; rename :end, "終"; rename :print, "表示"; rename :return, "返す"
    builtin("二乗") { |x| x * x }
  end
  ja_pi = Bada::Lang.fork(name: "bada-ja-π", parent: ja) do
    builtin("円周率") { Math::PI }
    note "adds 円周率 (pi)"
  end
  # a science variant with Ruby/Python/C libraries baked in (no import needed)
  sci = Bada::Lang.fork(name: "bada-ja-sci", parent: ja) do
    ruby "Math", as: "M"
    python "statistics", as: "Stat"
    c "m", as: "LibM"
  end
  puts "── 言語分岐システム (Reviser / 亜種) ──"
  prog = "関数 sq(x)\n  返す 二乗(x)\n終\n表示 \"sq(9) = \" + str(sq(9))"
  puts "[bada-ja で実行]"
  Bada::Lang.run(prog, dialect: ja)
  puts
  puts "[bada-ja-sci で実行（Ruby/Python/C を最初から内蔵）]"
  Bada::Lang.run("表示 \"M.sqrt2=\" + str(M.sqrt(2)) + \" Stat.mean=\" + str(Stat.mean([2,4,6])) + \" LibM.tgamma5=\" + str(LibM.tgamma(5))", dialect: sci)
  puts
  puts "[分岐の系譜]"
  puts Bada::Lang::Dialect.base.render_tree
  puts
  puts "lineage(bada-ja-π): " + ja_pi.lineage.map(&:name).join(" → ")
  puts "bada-ja-sci の外部ライブラリ: " + sci.foreign.map { |s, t, a| "#{s}:#{t}>#{a}" }.join(", ")
when "info"
  # Information generation: Thurston-Perelman placement + catastrophe branching
  # + millennium theory decomposition for a question.
  chat = Bada::OmegaChat.new
  load_corpus(chat)
  puts chat.info(ARGV.join(" "))
when "palette"
  # Show the Roger Penrose graphical-notation palette.
  puts Bada::Penrose::Palette.render
when "penrose"
  # Draw -> auto-compute -> answer + paper + source code.
  #   bada penrose <drawing-file> [--values vals.json] [--q "question"]
  require "json"
  path = ARGV.shift or abort("usage: bada penrose <drawing-file> [--values json] [--q question]")
  values = {}
  question = nil
  until ARGV.empty?
    case ARGV.shift
    when "--values" then values = JSON.parse(File.read(ARGV.shift))
    when "--q" then question = ARGV.shift
    end
  end
  drawing = File.read(path)
  studio = Bada::Penrose::Studio.new
  studio.draw(drawing, values: values)
  puts studio.report(question: question)
when "prove", "discover", "imagine"
  # Unknown a-priori engine: imagine unsolved-style problems and soundly
  # prove / disprove / flag-open them.
  q = ARGV.join(" ")
  q = "大域的部分積分多様体の未解決問題を想像して証明する" if q.empty?
  puts Bada::Prover::Engine.new.render(q, count: 5)
when "basal", "deliberate"
  # Basal-ganglia in-body neural system: imagine problems, let the thermal
  # action-selection network choose the order, prove each, and learn (dopamine).
  q = ARGV.join(" ")
  q = "大脳基底核の熱ネットワークで未解決問題を想像して証明する" if q.empty?
  puts Bada::Basal::AprioriEngine.new(seed: 42).render(q, count: 5)
when "xi"
  text = ARGV.join(" ")
  s = Bada::Manifold.invariant(text)
  puts format("text       : %s", text)
  puts format("entropy H  : %.6f bits", s[:entropy])
  puts format("manifold M : %.6f  (∬ 1/(x log x)^2)", s[:manifold_integral])
  puts format("extent N   : %d tokens", s[:extent])
  puts format("invariant Ξ: %.6f  (β(H+1,M+1)/log(N+1))", s[:invariant])
when "neural"
  # Train the from-scratch neural LLM on the corpus, then start the REPL.
  chat = Bada::NN::NeuralOmegaChat.new(seed: 42)
  if Dir.exist?(CORPUS_DIR)
    Dir.glob(File.join(CORPUS_DIR, "*.txt")).sort.each { |f| chat.learn_file(f) }
  end
  ARGV.each { |f| chat.learn_file(f) if File.file?(f) }
  puts "ニューラルネットワーク学習中…（純Ruby・バックプロップ）"
  chat.train!(epochs: 8, lr: 0.01, max_samples: 4000)
  chat.repl
when "train"
  # Train and save a model checkpoint (Memento) to a JSON file.
  out = ARGV.shift || "model.json"
  chat = Bada::NN::NeuralOmegaChat.new(seed: 42)
  if Dir.exist?(CORPUS_DIR)
    Dir.glob(File.join(CORPUS_DIR, "*.txt")).sort.each { |f| chat.learn_file(f) }
  end
  chat.train!(epochs: 8, lr: 0.01, max_samples: 4000)
  chat.save(out)
  puts "saved checkpoint -> #{out}"
when "version", "-v", "--version"
  puts "bada #{Bada::VERSION} — codename #{Bada::Lang::LLM.codename}"
else
  warn "unknown command: #{cmd}"
  warn "commands: repl | ask | info | prove | basal | penrose | palette | run | lang | directive | syntax | consciousness | genai | evolve | gpt | llm | foreign | dialects | learn | xi | neural | train | version"
  exit 1
end
