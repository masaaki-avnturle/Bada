#!/usr/bin/env ruby
# frozen_string_literal: true

# bada — CLI for the Bada/Ruby OmegaChat 分派.
#
#   bin/bada repl                       start the chat REPL
#   bin/bada ask "質問..."              one-shot question (incl. info block)
#   bin/bada info "質問..."             Thurston/catastrophe/millennium info gen
#   bin/bada palette                    show the Penrose graphical-notation palette
#   bin/bada penrose draw.penrose       draw -> auto-compute -> answer + paper + code
#   bin/bada quantum "MESSAGE"          entangled-pair space telegraph (prove+send)
#   bin/bada qc [bell|ghz|run f.qasm]   von-Neumann pseudo QC: monitor + statevector
#   bin/bada qc verilog [ghz|f.qasm]    emit semiconductor (Verilog) control source
#   bin/bada mind "信号..."             thought verbalization + image + code (sim)
#   bin/bada silent                     silent-talk IME: verbalize cues -> text/code
#   bin/bada whisper "qntm lght wv"     whispered English / unknown-language verbalize
#   bin/bada code "intent" [-l python]  thought-to-code: auto lang detect (EN+JA)
#   bin/bada complete def [-l ruby]     reserved-word / builtin word completion
#   bin/bada detect "code..."           auto-detect the programming language
#   bin/bada coder                      interactive command console (completion)
#   bin/bada neural                     train the neural LLM, then REPL
#   bin/bada train [model.json]         train and save a checkpoint
#   bin/bada run script.bada            run a Bada language script
#   bin/bada learn file1 file2 ...      ingest then start REPL
#   bin/bada xi "text"                  show entropy + manifold invariant

Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8
ARGV.map! { |a| a.dup.force_encoding("UTF-8") }

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "bada"

CORPUS_DIR = File.expand_path("../corpus", __dir__)

def load_corpus(chat)
  return unless Dir.exist?(CORPUS_DIR)
  Dir.glob(File.join(CORPUS_DIR, "*.txt")).sort.each do |f|
    chat.learn_file(f)
  end
end

cmd = ARGV.shift || "repl"

case cmd
when "repl"
  chat = Bada::OmegaChat.new
  load_corpus(chat)
  chat.repl
when "ask"
  chat = Bada::OmegaChat.new
  load_corpus(chat)
  puts chat.ask(ARGV.join(" "))
when "learn"
  chat = Bada::OmegaChat.new
  ARGV.each { |f| chat.learn_file(f) }
  chat.repl
when "run"
  path = ARGV.shift or abort("usage: bada run script.bada")
  interp = Bada::Interpreter.new
  interp.run(File.read(path)).each { |line| puts line }
when "info"
  # Information generation: Thurston-Perelman placement + catastrophe branching
  # + millennium theory decomposition for a question.
  chat = Bada::OmegaChat.new
  load_corpus(chat)
  puts chat.info(ARGV.join(" "))
when "palette"
  # Show the Roger Penrose graphical-notation palette.
  puts Bada::Penrose::Palette.render
when "penrose"
  # Draw -> auto-compute -> answer + paper + source code.
  #   bada penrose <drawing-file> [--values vals.json] [--q "question"]
  require "json"
  path = ARGV.shift or abort("usage: bada penrose <drawing-file> [--values json] [--q question]")
  values = {}
  question = nil
  until ARGV.empty?
    case ARGV.shift
    when "--values" then values = JSON.parse(File.read(ARGV.shift))
    when "--q" then question = ARGV.shift
    end
  end
  drawing = File.read(path)
  studio = Bada::Penrose::Studio.new
  studio.draw(drawing, values: values)
  puts studio.report(question: question)
when "quantum", "telegraph"
  # Quantum-entanglement Bell-test universal space telegraph:
  #   bada quantum "MESSAGE" [--material GaAs] [--temp 4] [--redundancy 3]
  # Certifies the physics (CHSH / Jones / uncertainty / semiconductor), then
  # carries the message across space by superdense coding.
  message = nil
  material = "GaAs"
  temp = 4.0
  redundancy = 3
  until ARGV.empty?
    case (a = ARGV.shift)
    when "--material" then material = ARGV.shift
    when "--temp" then temp = ARGV.shift.to_f
    when "--redundancy" then redundancy = ARGV.shift.to_i
    else message = message ? "#{message} #{a}" : a
    end
  end
  message ||= "HELLO SPACE"
  tg = Bada::Quantum::SpaceTelegraph.new(material: material, temp_k: temp, redundancy: redundancy)
  puts tg.render(message)
when "qc"
  # Von-Neumann pseudo quantum computer (disk-backed, semiconductor control):
  #   bada qc                         run the Bell demo, project the monitor
  #   bada qc ghz                     run the 3-qubit GHZ demo
  #   bada qc run prog.qasm [--n N]   run a BadaQASM program
  #   bada qc verilog [ghz|file]      emit the semiconductor (Verilog) source
  sub = ARGV.shift || "bell"
  emit_verilog = (sub == "verilog")
  sub = ARGV.shift || "bell" if emit_verilog

  machine =
    case sub
    when "bell" then Bada::QC::Machine.bell
    when "ghz"  then Bada::QC::Machine.ghz
    when "run"
      path = ARGV.shift or abort("usage: bada qc run prog.qasm [--n N]")
      n = 2
      n = ARGV[ARGV.index("--n") + 1].to_i if ARGV.include?("--n")
      Bada::QC::Machine.new(n_qubits: n).load(File.read(path)).run
    else
      # treat a bare token as a .qasm path
      Bada::QC::Machine.new(n_qubits: 2).load(File.read(sub)).run
    end

  if emit_verilog
    puts machine.verilog
  else
    puts machine.report
  end
  machine.close
when "mind"
  # Thought verbalization simulation (uses the pseudo QC + manifold-gauge
  # transformer): verbalize + mental image + the Bada-language "app in the mind".
  # The corpus/*.txt files train a bigram model so the verbalization is fluent.
  #   bada mind "光 と 音 の 記憶"  [--subject 名前] [--raw]
  subject = "対象"
  raw = false
  words = []
  until ARGV.empty?
    case (a = ARGV.shift)
    when "--subject" then subject = ARGV.shift
    when "--raw" then raw = true # skip corpus, use raw transformer decode
    else words << a
    end
  end
  signal = words.join(" ")
  reader = raw ? Bada::Mind::Reader.new(corpus_texts: nil) : Bada::Mind::Reader.new
  puts reader.render(signal, subject: subject)
when "silent"
  # Silent-talk input method for EVERY engine (発声せず文章/ソース/構文を入力):
  #   :text 言語化 / :code コード / :qc QCソース＋実行 / :verilog 半導体 / :telegraph 宇宙電信
  #   :bada Bada言語 構文入力（予約語・構文規則・:reserved・:complete）
  #   :whisper 英語ウィスパード復元／未知言語の言語化（発声せず）
  #   bada silent                       interactive IME REPL
  #   bada silent "光 記憶 波" ":code" "fibonacci 10"   feed lines then print doc
  #   bada silent ":qc" "bell" ":verilog" "ghz"        QC 実行 → 半導体 Verilog を入力
  #   bada silent ":bada" "光 記憶"                     Bada言語の構文を発声せず入力
  #   bada silent ":whisper" "qntm lght wv"             英語ウィスパードを完全文に復元
  #   bada silent ":whisper" "φωτ μνημη"                未知言語を英語に言語化
  session = Bada::SilentTalk::Session.new
  if ARGV.empty?
    session.repl
  else
    ARGV.each { |line| out = session.render(session.feed(line)); puts out unless out.empty? }
    puts "\n--- 入力結果 (document) ---"
    puts session.text
    puts format("precision = %.1f%%  -> %s", session.precision * 100,
                session.exceeds_silent_talk? ? "EXCEEDS silent talk" : "below")
  end
when "whisper"
  # Whispered English reconstruction / unknown-language verbalization (発声せず).
  #   bada whisper "qntm lght wv"     -> quantum light wave
  #   bada whisper "φωτ μνημη"        -> (未知言語を英語へ言語化)
  r = Bada::SilentTalk::Whisper.verbalize(ARGV.join(" "))
  puts format("# whisper source=%s  precision=%.1f%%  (silent-talk %.1f%%)",
              r[:lang], r[:precision] * 100, Bada::SilentTalk::SILENT_TALK_BASELINE * 100)
  puts r[:text]
when "code"
  # Thought-to-code (EN + 日本語). Auto-detects the language unless --lang given.
  #   bada code "print hello 3 times" [--lang python]
  lang = nil
  words = []
  until ARGV.empty?
    case (a = ARGV.shift)
    when "--lang", "-l" then lang = ARGV.shift
    else words << a
    end
  end
  r = Bada::Coder.generate(words.join(" "), language: lang)
  puts format("# language : %s  (confidence %.2f)", r[:language], r[:detected][:confidence])
  puts format("# reserved : %s", r[:reserved_used].join(" "))
  puts format("# precision: %.1f%%  (silent-talk %.1f%%)  valid=%s",
              r[:precision] * 100, Bada::Coder::SILENT_TALK_BASELINE * 100, r[:valid])
  puts
  puts r[:code]
when "complete"
  # Word completion (reserved words + builtins).  bada complete def [--lang ruby]
  lang = nil
  prefix = nil
  until ARGV.empty?
    case (a = ARGV.shift)
    when "--lang", "-l" then lang = ARGV.shift
    else prefix = a
    end
  end
  puts Bada::Coder.complete(prefix.to_s, language: lang).join("\n")
when "detect"
  d = Bada::Coder.detect(ARGV.join(" "))
  puts format("language  : %s", d[:language])
  puts format("confidence: %.2f", d[:confidence])
  puts format("scores    : %s", d[:scores].reject { |_, v| v.zero? })
when "coder"
  # Interactive command console: :lang :reserved :complete :gen :use, or plain intent.
  console = Bada::Coder::Console.new
  puts "Bada coder console — :lang :reserved :complete :gen :use <lang> | intent | 'exit'"
  loop do
    print "coder> "
    line = $stdin.gets
    break if line.nil?
    line = line.chomp
    break if %w[exit quit].include?(line)
    out = console.run(line)
    puts out unless out.empty?
  end
when "xi"
  text = ARGV.join(" ")
  s = Bada::Manifold.invariant(text)
  puts format("text       : %s", text)
  puts format("entropy H  : %.6f bits", s[:entropy])
  puts format("manifold M : %.6f  (∬ 1/(x log x)^2)", s[:manifold_integral])
  puts format("extent N   : %d tokens", s[:extent])
  puts format("invariant Ξ: %.6f  (β(H+1,M+1)/log(N+1))", s[:invariant])
when "neural"
  # Train the from-scratch neural LLM on the corpus, then start the REPL.
  chat = Bada::NN::NeuralOmegaChat.new(seed: 42)
  if Dir.exist?(CORPUS_DIR)
    Dir.glob(File.join(CORPUS_DIR, "*.txt")).sort.each { |f| chat.learn_file(f) }
  end
  ARGV.each { |f| chat.learn_file(f) if File.file?(f) }
  puts "ニューラルネットワーク学習中…（純Ruby・バックプロップ）"
  chat.train!(epochs: 8, lr: 0.01, max_samples: 4000)
  chat.repl
when "train"
  # Train and save a model checkpoint (Memento) to a JSON file.
  out = ARGV.shift || "model.json"
  chat = Bada::NN::NeuralOmegaChat.new(seed: 42)
  if Dir.exist?(CORPUS_DIR)
    Dir.glob(File.join(CORPUS_DIR, "*.txt")).sort.each { |f| chat.learn_file(f) }
  end
  chat.train!(epochs: 8, lr: 0.01, max_samples: 4000)
  chat.save(out)
  puts "saved checkpoint -> #{out}"
when "version", "-v", "--version"
  puts "bada #{Bada::VERSION}"
else
  warn "unknown command: #{cmd}"
  warn "commands: repl | ask | info | penrose | palette | quantum | qc | mind | silent | whisper | code | complete | detect | coder | run | learn | xi | neural | train | version"
  exit 1
end
