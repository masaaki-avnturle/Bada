<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Coda Studio (坂本龍一トリビュート・非公式).
     ワークフロー (codastudio-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = coda_studio/index.html) を差し込みます。 -->
<widget id="io.github.masaaki_avnturle.codastudio" version="2.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>CodaStudio</name>
  <description>Coda Studio — 坂本龍一トリビュート・スペクトル・コード作曲スタジオ(非公式)。音符を表示しないスペクトル・コード・シーケンサー(コード記号の行 × 16 ステップ、タップで 4 段階のスペクトル・レベル、縦線プレイヘッドの移動で演奏)/ リアルタイム・スペクトラム表示 / 鍵盤 / コードパッド / リバーブ・ディレイ / WAV 書き出し。全音源 Web Audio リアルタイム・シンセシス、依存ゼロ・単一 HTML・オフライン動作のオリジナル作品。</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
