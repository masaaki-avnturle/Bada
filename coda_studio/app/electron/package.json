{
  "name": "coda-studio",
  "productName": "CodaStudio",
  "version": "1.0.0",
  "description": "Coda Studio — an original music-making studio app created as an unofficial tribute to Ryuichi Sakamoto: piano keyboard, chord pads, a 16-step ambient sequencer (incl. miyako-bushi and ryukyu scales), reverb/delay, and WAV export. All sound is real-time Web Audio synthesis; zero dependencies, single self-contained HTML, fully offline",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.codastudio",
    "productName": "CodaStudio",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "CodaStudio-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "CodaStudio-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "artifactName": "CodaStudio-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
