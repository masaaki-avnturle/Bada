{
  "name": "bada-soundfilm",
  "productName": "BadaSoundFilm",
  "version": "1.0.0",
  "description": "Bada SoundFilm — converts MP3 (and other audio) into videos with an audio-reactive visualizer. Reads ID3v2/ID3v1 tags (title / artist / album art), renders spectrum bars / waveform / circle visuals on a canvas, and records canvas + audio with MediaRecorder into MP4 (where supported) or WebM. Self-contained HTML app, zero dependencies, fully offline.",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.badasoundfilm",
    "productName": "BadaSoundFilm",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaSoundFilm-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "BadaSoundFilm-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "artifactName": "BadaSoundFilm-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
