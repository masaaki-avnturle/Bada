<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada SoundFilm (MP3 → 動画 変換スタジオ).
     ワークフロー (soundfilm-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = mp3_to_video/index.html) を差し込みます。
     MP3 の読み込みはファイル選択、動画の保存はダウンロードとして行われます。 -->
<widget id="io.github.masaaki_avnturle.badasoundfilm" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BadaSoundFilm</name>
  <description>Bada SoundFilm — MP3 を動画に変換するソフト。ID3v2/ID3v1 タグ (曲名・アーティスト・ジャケット画像) を解析し、Canvas ビジュアライザ (スペクトラムバー / 波形 / サークル / シンプル) を Web Audio と合成して MediaRecorder で MP4/WebM 動画に録画。依存ゼロ・単一 HTML・オフライン動作</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
