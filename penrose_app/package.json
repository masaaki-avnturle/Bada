{
  "name": "penrose-studio",
  "productName": "Penrose Studio",
  "version": "1.0.0",
  "description": "ロジャー・ペンローズ絵記号スタジオ — パレットで絵記号を選び、組み合わせると清書方程式と計算方程式を生成 (Bada)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "gen": "ruby -I../bada_ruby/lib ../bada_ruby/bin/bada html www/index.html",
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "cap:sync": "cap sync android",
    "cap:add": "cap add android",
    "apk:debug": "cap sync android && cd android && gradle assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/share": "^6.0.3"
  },
  "build": {
    "appId": "io.github.masaaki_avnturle.penrose",
    "productName": "PenroseStudio",
    "copyright": "© Masaaki Yamaguchi — Bada",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Penrose Studio"
    },
    "portable": {
      "artifactName": "PenroseStudio-${version}-portable.exe"
    }
  }
}
