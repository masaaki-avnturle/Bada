    print("合格 " + TEST[1] + " / " + TEST[0] + "  — すべて合格")
} else {
    print("合格 " + TEST[1] + " / " + TEST[0] + "  不合格 " + (TEST[0] - TEST[1]))
}
print("SELFTEST-RESULT " + TEST[1] + " " + TEST[0])
print("==============================================================")
