# ============================================================
# 07_json.bada -- BADA ULTRA NETWORK / JSON の解析と生成
#
# LINE Messaging API と Instagram Graph API の Webhook 本文は JSON で
# 届く。署名 (HMAC-SHA256) は「生の本文そのもの」に対して計算するので、
# 本文の文字列と、そこから取り出した値の両方が要る。
#
# Bada に連想配列は無いので、値はタグつきの配列で表す:
#   ["obj", 鍵の並び, 値の並び]
#   ["arr", 要素の並び]
#   ["str", 文字列]  ["num", 数]  ["bool", 真偽]  ["null"]
# ============================================================

def json_is(v, tag) {
    if (len(v) == 0) { return false }
    return v[0] == tag
}

def json_num(v)  { if (json_is(v, "num"))  { return v[1] } return 0 }
def json_str(v)  { if (json_is(v, "str"))  { return v[1] } return "" }
def json_bool(v) { if (json_is(v, "bool")) { return v[1] } return false }

# オブジェクトから鍵で引く。無ければ ["null"]
def json_get(v, key) {
    if (!json_is(v, "obj")) { return ["null"] }
    keys := v[1]
    i := 0
    while (i < len(keys)) {
        if (keys[i] == key) { return v[2][i] }
        i := i + 1
    }
    return ["null"]
}

def json_has(v, key) { return !json_is(json_get(v, key), "null") }

# 配列の i 番目。範囲外なら ["null"]
def json_at(v, i) {
    if (!json_is(v, "arr")) { return ["null"] }
    if (i < 0) { return ["null"] }
    if (i >= len(v[1])) { return ["null"] }
    return v[1][i]
}

def json_len(v) {
    if (json_is(v, "arr")) { return len(v[1]) }
    if (json_is(v, "obj")) { return len(v[1]) }
    return 0
}

# "entry.0.messaging.0.message.text" のような経路で潜る
def json_path(v, path) {
    parts := split(path, ".")
    cur := v
    i := 0
    while (i < len(parts)) {
        p := parts[i]
        c0 := ord(p, 0)
        if (c0 >= 48 && c0 <= 57) {
            n := 0
            k := 0
            while (k < len(p)) { n := n * 10 + (ord(p, k) - 48); k := k + 1 }
            cur := json_at(cur, n)
        } else {
            cur := json_get(cur, p)
        }
        i := i + 1
    }
    return cur
}

# ---- 解析 ----------------------------------------------------------
# st は [text, pos] 。pos を進めながら読む。
def js_peek(st) {
    if (st[1] >= len(st[0])) { return 0 }
    return ord(st[0], st[1])
}

def js_skip_ws(st) {
    while (st[1] < len(st[0])) {
        c := ord(st[0], st[1])
        ws := false
        if (c == 32) { ws := true }
        if (c == 9)  { ws := true }
        if (c == 10) { ws := true }
        if (c == 13) { ws := true }
        if (ws) { st[1] = st[1] + 1 } else { return 0 }
    }
    return 0
}

def js_hexval(c) {
    if (c >= 48 && c <= 57) { return c - 48 }
    if (c >= 97 && c <= 102) { return c - 87 }
    if (c >= 65 && c <= 70) { return c - 55 }
    return 0
}

def js_parse_string(st) {
    st[1] = st[1] + 1               # 開きの "
    out := ""
    while (st[1] < len(st[0])) {
        c := ord(st[0], st[1])
        if (c == 34) { st[1] = st[1] + 1; return out }
        if (c == 92) {
            st[1] = st[1] + 1
            e := ord(st[0], st[1])
            if (e == 110) { out := out + chr(10) }
            else { if (e == 116) { out := out + chr(9) }
            else { if (e == 114) { out := out + chr(13) }
            else { if (e == 98)  { out := out + chr(8) }
            else { if (e == 102) { out := out + chr(12) }
            else { if (e == 117) {
                     v := js_hexval(ord(st[0], st[1] + 1)) * 4096 +
                          js_hexval(ord(st[0], st[1] + 2)) * 256 +
                          js_hexval(ord(st[0], st[1] + 3)) * 16 +
                          js_hexval(ord(st[0], st[1] + 4))
                     out := out + chr(v)
                     st[1] = st[1] + 4
                   }
            else { out := out + chr(e) } } } } } }
            st[1] = st[1] + 1
        } else {
            out := out + chr(c)
            st[1] = st[1] + 1
        }
    }
    return out
}

# 数の字句を切り出す。JSON では数の切れ目は必ず区切り文字なので、
# 数字・小数点・指数・符号が続くかぎり読めばよい。
def js_parse_number(st) {
    text := st[0]
    n := len(text)
    start := st[1]
    e := start
    scanning := true
    while (scanning && e < n) {
        c := ord(text, e)
        good := false
        if (c >= 48 && c <= 57) { good := true }
        if (c == 46) { good := true }
        if (c == 101) { good := true }
        if (c == 69)  { good := true }
        if (c == 43)  { good := true }
        if (c == 45)  { good := true }
        if (good) { e := e + 1 } else { scanning := false }
    }
    st[1] = e
    return str_to_num(substr(text, start, e - start))
}

# 十進文字列 -> 数 (符号・小数・指数に対応)
def str_to_num(txt) {
    n := len(txt)
    i := 0
    sign := 1
    if (i < n) {
        c := ord(txt, i)
        if (c == 45) { sign := 0 - 1; i := i + 1 }
        else { if (c == 43) { i := i + 1 } }
    }
    # 整数部
    ip := 0.0
    reading := true
    while (reading && i < n) {
        c := ord(txt, i)
        if (c >= 48 && c <= 57) { ip := ip * 10 + (c - 48); i := i + 1 }
        else { reading := false }
    }
    # 小数部
    frac := 0.0
    if (i < n) {
        if (ord(txt, i) == 46) {
            i := i + 1
            scale := 0.1
            reading := true
            while (reading && i < n) {
                c := ord(txt, i)
                if (c >= 48 && c <= 57) { frac := frac + (c - 48) * scale; scale := scale / 10; i := i + 1 }
                else { reading := false }
            }
        }
    }
    v := (ip + frac) * sign
    # 指数部
    if (i < n) {
        c := ord(txt, i)
        isexp := false
        if (c == 101) { isexp := true }
        if (c == 69)  { isexp := true }
        if (isexp) {
            i := i + 1
            esign := 1
            if (i < n) {
                c2 := ord(txt, i)
                if (c2 == 45) { esign := 0 - 1; i := i + 1 }
                else { if (c2 == 43) { i := i + 1 } }
            }
            ev := 0
            reading := true
            while (reading && i < n) {
                c3 := ord(txt, i)
                if (c3 >= 48 && c3 <= 57) { ev := ev * 10 + (c3 - 48); i := i + 1 }
                else { reading := false }
            }
            v := v * ipow(10, ev * esign)
        }
    }
    return v
}

def js_parse_value(st) {
    js_skip_ws(st)
    c := js_peek(st)
    if (c == 123) { return js_parse_object(st) }
    if (c == 91)  { return js_parse_array(st) }
    if (c == 34)  { return ["str", js_parse_string(st)] }
    if (c == 116) { st[1] = st[1] + 4; return ["bool", true] }
    if (c == 102) { st[1] = st[1] + 5; return ["bool", false] }
    if (c == 110) { st[1] = st[1] + 4; return ["null"] }
    return ["num", js_parse_number(st)]
}

def js_parse_object(st) {
    st[1] = st[1] + 1
    keys := []
    vals := []
    js_skip_ws(st)
    if (js_peek(st) == 125) { st[1] = st[1] + 1; return ["obj", keys, vals] }
    while (st[1] < len(st[0])) {
        js_skip_ws(st)
        k := js_parse_string(st)
        js_skip_ws(st)
        st[1] = st[1] + 1            # :
        v := js_parse_value(st)
        keys <- k
        vals <- v
        js_skip_ws(st)
        c := js_peek(st)
        if (c == 44) { st[1] = st[1] + 1 }
        else { st[1] = st[1] + 1; return ["obj", keys, vals] }
    }
    return ["obj", keys, vals]
}

def js_parse_array(st) {
    st[1] = st[1] + 1
    items := []
    js_skip_ws(st)
    if (js_peek(st) == 93) { st[1] = st[1] + 1; return ["arr", items] }
    while (st[1] < len(st[0])) {
        v := js_parse_value(st)
        items <- v
        js_skip_ws(st)
        c := js_peek(st)
        if (c == 44) { st[1] = st[1] + 1 }
        else { st[1] = st[1] + 1; return ["arr", items] }
    }
    return ["arr", items]
}

def json_parse(text) {
    st := [text, 0]
    return js_parse_value(st)
}

# ---- 生成 ----------------------------------------------------------
def json_escape(s) {
    out := ""
    i := 0
    while (i < len(s)) {
        c := ord(s, i)
        if (c == 34) { out := out + chr(92) + chr(34) }
        else { if (c == 92) { out := out + chr(92) + chr(92) }
        else { if (c == 10) { out := out + chr(92) + "n" }
        else { if (c == 13) { out := out + chr(92) + "r" }
        else { if (c == 9)  { out := out + chr(92) + "t" }
        else { out := out + chr(c) } } } } }
        i := i + 1
    }
    return out
}

def json_q(s) { return chr(34) + json_escape(s) + chr(34) }

def json_stringify(v) {
    if (json_is(v, "str"))  { return json_q(v[1]) }
    if (json_is(v, "num"))  { return "" + v[1] }
    if (json_is(v, "bool")) { if (v[1]) { return "true" } return "false" }
    if (json_is(v, "null")) { return "null" }
    if (json_is(v, "arr")) {
        out := "["
        i := 0
        while (i < len(v[1])) {
            if (i > 0) { out := out + "," }
            out := out + json_stringify(v[1][i])
            i := i + 1
        }
        return out + "]"
    }
    if (json_is(v, "obj")) {
        out := "{"
        i := 0
        while (i < len(v[1])) {
            if (i > 0) { out := out + "," }
            out := out + json_q(v[1][i]) + ":" + json_stringify(v[2][i])
            i := i + 1
        }
        return out + "}"
    }
    return "null"
}

# 組み立ての補助
def jobj(keys, vals) { return ["obj", keys, vals] }
def jarr(items)      { return ["arr", items] }
def jstr(s)          { return ["str", s] }
def jnum(n)          { return ["num", n] }
def jbool(b)         { return ["bool", b] }
