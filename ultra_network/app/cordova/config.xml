<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada UltraNetwork.
     ワークフロー (ultranet-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = ultra_network/index.html) を
     差し込みます。tel: の allow-intent により、写像した NTT 番号への発信は
     端末の電話回線 (標準アプリ) へ委譲されます。 -->
<widget id="io.github.masaaki_avnturle.ultranetwork" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BadaUltraNetwork</name>
  <description>Bada UltraNetwork — Panasonic HD-PLC で家の電力線を物理層にし、NTT の加入者線へ写像して zone://url.or.jp ウルトラネットワークを走らせ、LINE / Instagram のメッセージ機能を取り込む通信システム。量子プログラミング言語 Bada 製で、層の組み方は AT&amp;T ベル研究所の STREAMS に倣う。通信は Jones 多項式量子暗号 (結び目鍵 AEAD + Bell 対 QKD) で保護。</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <!-- 写像した NTT 番号への発信・SMS は端末 OS の標準機能へ委譲 -->
  <allow-intent href="tel:*" />
  <allow-intent href="sms:*" />
  <allow-intent href="mailto:*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
