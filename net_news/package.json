{
  "name": "net-news-live",
  "productName": "NetNewsLive",
  "version": "1.0.0",
  "description": "NET NEWS LIVE — インターネットTVニュース (各局公式の無料ライブ配信を視聴する実映像ニュースビューア)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "repository": "https://github.com/masaaki-avnturle/Bada",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64 --publish never",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "apk:debug": "cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  },
  "build": {
    "appId": "io.github.masaaki.netnews",
    "productName": "NetNewsLive",
    "directories": { "output": "dist", "buildResources": "resources" },
    "publish": null,
    "files": ["electron/**/*", "www/**/*"],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Net News Live" },
    "portable": { "artifactName": "NetNewsLive-${version}-portable.exe" }
  }
}
