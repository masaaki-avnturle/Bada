<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of 小槌の家計簿 (Kozuchi Kakeibo).
     ワークフロー (kozuchi-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = kozuchi_kakeibo/index.html) を差し込みます。
     カメラ撮影は cordova-plugin-camera (ワークフローが追加) が端末のカメラを
     起動します。必要な権限はプラグインが AndroidManifest に注入し、
     実行時の権限リクエストもプラグインが行います。 -->
<widget id="io.github.masaaki_avnturle.kozuchi" version="1.3.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>小槌の家計簿</name>
  <description>小槌の家計簿 — レシートをカメラで撮影すると OCR (Tesseract.js・端末内実行) が日付・品目・金額を読み取り、勘定科目を自動判定して複式簿記 (仕訳帳・総勘定元帳・試算表・損益計算書・貸借対照表) に自動登録する家計簿</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <access origin="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <!-- 【文字化け対策・必須】cordova-android 12 の既定 (WebViewAssetLoader /
       https://localhost 配信) は WebResourceResponse の encoding が null のため、
       Android WebView が UTF-8 の日本語ページを Latin-1 で解釈して全面的に
       文字化けする既知問題がある。file:// 読み込み (従来方式) に切り替えると
       WebView 自身が <meta charset="UTF-8"> を正しく処理して文字化けしない。 -->
  <preference name="AndroidInsecureFileModeEnabled" value="true" />
  <preference name="BackgroundColor" value="0xff04060a" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#04060a" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <!-- OCR (Tesseract.js) のエンジン・日本語辞書を初回のみ CDN から取得するため
         ネットワークアクセスを許可 (INTERNET 権限は cordova-android が既定で付与) -->
    <preference name="KeepRunning" value="true" />
  </platform>
</widget>
