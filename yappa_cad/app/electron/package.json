{
  "name": "yappacad",
  "productName": "YappaCAD",
  "version": "1.0.0",
  "description": "Yappa CAD — futuristic-vehicle CAD (car / UFO / bike parametric templates, functional design with live spec calculation) extensible with the built-in Bada language interpreter; zero-dependency single-file WebGL app",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.yappacad",
    "productName": "YappaCAD",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "YappaCAD-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "YappaCAD-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Graphics",
      "artifactName": "YappaCAD-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
