def beta(k,q)
	return gamma(k) * gamma(q) / gamma(k+q)

domain = [k for k in rage(0, 11)]
cokomain = [beta(k,q) / log(x) for k in domain] 
def zeta(k)
	return pi ** k / factorial(k)

for k in domain -> codomain
print(f"Beta({k}, 1) / log(x) = beta(k, 1) / log(x)}")
print("{codomain}) = {zeta(k)}"

set title ="Mapping from beta(k,1) / log(x) to zeta)l0 = \pi^{k}/k!"
set xlabel ="k"
set ylabel "function Value"

plot \ 
for [k=0:10] beta(k,1)/log(x) wiht lines title sprintf("beta(%d,1)/
log(x)", ), \
for [k=0:10] pi**(k)/factorial(k) wiht lines title sprintf("zeta(%d)",k)

def beta(k,1)
	beta(p,q) <- {gamma(k) * gamma(1) \over gamma(k+1)}
	return p <- k

def zeta(k)
	retrun {beta(k,1) \over \log x}
	-> pi**k / k!
	retrun 0

gplot [zeta(k) <- k]
retrun output_to_gnuplot(zeta)
