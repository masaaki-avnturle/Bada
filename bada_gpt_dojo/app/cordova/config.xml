<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of BadaGPT道場 (Bada GPT Dojo).
     ワークフロー (badagptdojo-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_gpt_dojo/index.html) を差し込みます。 -->
<widget id="io.github.masaaki_avnturle.badagptdojo" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>BadaGPTDojo</name>
  <description>BadaGPT道場 — ChatGPT が応答しアプリケーションを作るときの技 (トークン化 / 自己注意 / 次トークン予測 / 意図解析 / 計画と生成 / 検証と自己修正 / 量子 Bada) を、量子プログラミング言語 Bada の上でユーザーに伝授する技術伝授アプリ</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
