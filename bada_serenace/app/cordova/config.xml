<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada Serenace (病気予防機構の解明).
     ワークフロー (serenace-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_serenace/index.html) を差し込みます。
     アプリはオフライン・自己完結で、外部通信も端末データの読み取りも行いません。 -->
<widget id="io.github.masaaki_avnturle.badaserenace" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>BadaSerenace</name>
  <description>Bada Serenace — 積み木の真逆(不変量から生成語を読み戻す逆像)から、Jones 多項式の Γ 熱感知・大域的部分積分多様体を通して、構築可能な RNA 干渉とセレネースの作用機序を突き合わせる、病気予防機構の解明シミュレータ。概念シミュレーション・非医療。</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff070b12" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#070b12" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <!-- タブレット・DeX・分割画面でのリサイズを許可し、つまんで拡縮しても
         アクティビティが再生成されないようにする (計算途中の状態を保つ) -->
    <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application/activity">
      <activity android:resizeableActivity="true"
                android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|navigation|fontScale" />
    </edit-config>
    <config-file target="AndroidManifest.xml" parent="/manifest/application/activity">
      <layout android:defaultWidth="1080dp" android:defaultHeight="720dp"
              android:gravity="center" android:minWidth="360dp" android:minHeight="300dp" />
    </config-file>
  </platform>
</widget>
