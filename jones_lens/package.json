{
  "name": "jones-lens",
  "productName": "JonesLens",
  "version": "1.0.0",
  "description": "JONES LENS — ホログラフィック・アイウェア (Jones多項式 × 特殊相対性理論のレンズ焦点で、アイウェアのレンズにインターネットTVの動画を投影)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "repository": "https://github.com/masaaki-avnturle/Bada",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64 --publish never",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "apk:debug": "cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  },
  "build": {
    "appId": "io.github.masaaki.joneslens",
    "productName": "JonesLens",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "publish": null,
    "files": [
      "electron/**/*",
      "www/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jones Lens"
    },
    "portable": {
      "artifactName": "JonesLens-${version}-portable.exe"
    }
  }
}
