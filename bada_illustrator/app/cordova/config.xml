<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada Illustrator.
     ワークフロー (badaillustrator-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_illustrator/index.html) を差し込みます。 -->
<widget id="io.github.masaaki_avnturle.badaillustrator" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Bada Illustrator</name>
  <description>Bada Illustrator — 量子建築設計スタジオ。Illustrator 流のベクター作図 (壁・部屋・柱・ドア・窓・寸法・文字, mm グリッドスナップ, レイヤー, SVG/PNG 出力) を、量子プログラミング言語 Bada (H/X/Z/RY/CNOT ゲート, Born 則 Measure, 追記専用 tuplespace 台帳, @reviser 拡張トランザクション) でスクリプト操作・拡張できる建築アプリ</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff05070d" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#05070d" />
  <!-- 図面は横長が基本だが、タブレット縦持ちでも使えるよう回転自由 -->
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
