{
  "name": "bada-illustrator",
  "productName": "BadaIllustrator",
  "version": "1.0.0",
  "description": "Bada Illustrator — architecture-design studio (Illustrator-style vector CAD for floor plans: walls, rooms, columns, doors, windows, dimensions, mm grid snapping, layers, SVG/PNG export) scriptable and extensible with the Bada quantum programming language (state-vector core with H/X/Z/RY/CNOT gates, Born-rule Measure, append-only tuplespace ledger, @reviser extension transactions), as a self-contained HTML app",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.badaillustrator",
    "productName": "BadaIllustrator",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaIllustrator-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "BadaIllustrator-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Graphics",
      "artifactName": "BadaIllustrator-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
