{
  "name": "bada-gpt-kai",
  "productName": "BadaGPTKai",
  "version": "1.0.0",
  "description": "BadaGPT Kai — turns what you imagine (text / voice / sketch / photo) plus heart-rate and breathing biofeedback into Android APK / Windows EXE projects, PDF documents, or source code with Claude",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.badagptkai",
    "productName": "BadaGPTKai",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaGPTKai-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "BadaGPTKai-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "artifactName": "BadaGPTKai-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
