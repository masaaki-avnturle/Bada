<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of BadaGPT改 (BadaGPT Kai).
     ワークフロー (badagptkai-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_gpt_kai/index.html) を差し込みます。 -->
<widget id="io.github.masaaki_avnturle.badagptkai" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>BadaGPTKai</name>
  <description>BadaGPT改 — イメージ (文章・音声・スケッチ・写真) と心拍・呼吸のバイオフィードバックから、Claude で APK / Windows EXE / PDF / 任意のソースコードを生成するアプリ</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <!-- Claude API (api.anthropic.com) と GitHub API (api.github.com) へ接続するため -->
  <access origin="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <!-- 心拍 (指先の脈波をカメラで) と呼吸 (マイク) の測定、音声入力用 -->
    <config-file target="AndroidManifest.xml" parent="/*">
      <uses-permission android:name="android.permission.CAMERA" />
      <uses-permission android:name="android.permission.RECORD_AUDIO" />
      <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
      <uses-feature android:name="android.hardware.camera" android:required="false" />
      <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    </config-file>
  </platform>
</widget>
