<?xml version='1.0' encoding='utf-8'?>
<!--
  Cordova config — 動画リストア (Video Restore Studio) の Android APK ビルド用。
  編集された動画を逆補正して元の映像へ近づけるアプリ。すべて端末内処理・非送信。
  ワークフローが cordova プロジェクトを作成し、この config.xml と ../www を差し込みます。
-->
<widget id="io.github.masaaki_avnturle.video_restore" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>Video-Restore-Studio</name>
  <description>編集された動画を逆補正して元の映像へ近づける(端末内処理・非送信)</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff04060a" />
  <preference name="Orientation" value="default" />
  <preference name="Fullscreen" value="false" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#04060a" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <config-file target="AndroidManifest.xml" parent="/manifest">
      <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    </config-file>
  </platform>
</widget>
