<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada VM Pro.
     ワークフロー (badavmpro-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結 OS = bada_vm_pro/index.html) を差し込みます。 -->
<widget id="io.github.masaaki_avnturle.badavmpro" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>BadaVMPro</name>
  <description>Bada VM Pro — 量子プログラミング言語 Bada の OS。デスクトップは w9wm window manager、ベースは BadaGPT (OS update/upgrade 担当)。bash/apt/vim/emacs/ssh/xinetd/texlive-full/screen/fcitx-mozc を事前インストール、日本語入力対応ターミナル (xterm / x-terminal-emulator / terminal)、Bada on Rails、合い言葉コマンド、トランスフォーマー補完</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <!-- 合い言葉の音声モード (Web Speech API) 用 — WebView が対応する端末でのみ有効 -->
    <config-file target="AndroidManifest.xml" parent="/*">
      <uses-permission android:name="android.permission.RECORD_AUDIO" />
    </config-file>
  </platform>
</widget>
