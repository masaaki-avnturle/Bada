<?xml version="1.0" encoding="utf-8"?>
<!--
  Bada IQ / Telomere-Jones measurement app.
  APK-format manifest for the BadaOS runtime (Android-style layout).
  The activity is driven by app/main.bada through lib/omega_iq (the Bada runtime).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.bada.omega.iqtelomere"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />

    <!-- タブレットの赤外線カメラ + 温度計 -->
    <uses-feature android:name="android.hardware.camera.ir" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.ambient_temperature" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="io.bada.permission.THERMAL_SENSOR" />

    <application
        android:label="@string/app_name"
        android:description="@string/app_desc"
        android:allowBackup="true">

        <!-- Bada runtime entry point: app/main.bada -->
        <meta-data android:name="bada.entry" android:value="app/main.bada" />
        <meta-data android:name="bada.runtime" android:value="lib/omega_iq" />
        <meta-data android:name="bada.property.mirror" android:value="true" />

        <activity
            android:name="io.bada.omega.iqtelomere.MeasureActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
