# main.bada — Bada 赤外線IQ・テロメア分裂測定アプリ
#
# 上の写真の絵を方程式化し、赤の矢印の順に線を読み、Jones多項式の
# テロメア分裂過程を、タブレットの赤外線カメラと温度計で駆動して、
# IQ を測定する。真逆(mirror)の性質も同時に測定する。
#
# run:  bin/run_iq app/main.bada

set diagram = "assets/diagram_arrows.txt"
set thermal = "assets/thermal_frame.pgm"

# [1] 絵 -> 方程式  (bond-lines read in red-arrow order)
load  drawing from diagram

# [2] Jones多項式
jones

# [3] 真逆の性質 (mirror knot, V(1/t))
mirror

# [4] テロメアの分裂過程 (skein splitting, Hayflick generations)
split telomere

# [5] 赤外線カメラ + 温度計 (tablet IR sensor + thermometer)
sense thermal from thermal

# [6] IQ測定 (順 + 真逆)
measure iq

# full human-readable report
report
