# ---- generated: 00_prelude.bada + 01_form_entropy.bada (tools/run-papers.js) ----
# ============================================================
# 00_prelude.bada -- BadaGPT 未知事前エンジン論文集 / 共通核
#
# 量子プログラミング言語 Bada の組み込みは softmax / entropy /
# unknown_prior / update / cognitive_system / dist / zeros_of /
# maxdiff / len / sqrt / log / exp / abs / f5 / sci と、量子部分言語
# qubit / H / X / S / T / Rz / CNOT / Measure / commit_measurement、
# 追記専用台帳 tuplespace だけである。床関数も三角関数も Γ も ζ も
# 無い。この核でそれを全部こしらえ、各巻はこの上に乗る。
#
#   数値      floor_ round_ pow_ ipow sin_ cos_ atan_ sinh_ cosh_ log1p_
#   Γ 族      log_gamma gamma_ inv_gamma log_beta beta_ digamma_
#   Bernoulli BERN bernoulli_poly
#   Hurwitz ζ hurwitz (Euler–Maclaurin)  zeta_r  dirichlet_beta
#   二重指数  de_default de_gamma_zeta zeta_de lambda_de zeta_V zm_dist_raw
#   修正核    lambda_em kappa_      (ζ(x,y) = B(y,x−1)·Λ(x,y))
#   配列      arr_zeros set_at arr_sum arr_max arr_maxabs rel_err ...
#   表示      fx f3 f8 f10 f12 pad
#   検査      check check_close check_rel verdict  (結果は台帳へ commit)
#
# 方言上の注意 (この処理系で実測した制約):
#   * 配列の索引代入 a[i] := v は無い -> set_at / 再構築で書く
#   * 論理和 or / || は無い -> && と ! と入れ子の if で書く
#   * 関数の中から大域変数へ := しても外へ出ない -> 配列への <- 追記だけが届く
#   * for は本体の代入を外へ出さない -> 累積は while で書く
# ============================================================

PI          := 3.141592653589793
TWO_PI      := 6.283185307179586
HALF_PI     := 1.5707963267948966
LN2         := 0.6931471805599453
LN10        := 2.302585092994046
SQRT_2PI    := 2.5066282746310002
EULER_GAMMA := 0.5772156649015329
GLAISHER    := 1.2824271291006226
INF         := exp(800)

# ---- 床・丸め・べき --------------------------------------------------
def floor_(x) { r := x - (x % 1)  if (r > x) { r := r - 1 }  return r }
def ceil_(x)  { r := floor_(x)  if (r < x) { r := r + 1 }  return r }
def round_(x) { return floor_(x + 0.5) }
def max_(a, b) { if (a > b) { return a }  return b }
def min_(a, b) { if (a < b) { return a }  return b }
def is_int(x) { return abs(x - round_(x)) < 0.000000000001 }
def sign_(x) { if (x < 0) { return -1 }  if (x > 0) { return 1 }  return 0 }

def ipow(b, n) {                      # 整数べき (n >= 0)
    r := 1.0  k := 0
    while (k < n) { r := r * b  k := k + 1 }
    return r
}
def pow_(b, e) {                      # 実数べき: exp(e log b)  (小さな整数べきは乗算で厳密に)
    if (e % 1 == 0) { if (abs(e) <= 64) {
        if (e >= 0) { return ipow(b, e) }
        return 1.0 / ipow(b, 0 - e)
    } }
    if (b > 0) { return exp(e * log(b)) }
    if (b == 0) { if (e > 0) { return 0.0 }  if (e == 0) { return 1.0 }  return INF }
    if (is_int(e)) {
        n := round_(e)
        if (n >= 0) { return ipow(b, n) }
        return 1.0 / ipow(b, 0 - n)
    }
    return 0 / 0
}

# ---- 三角関数 (Taylor 級数 + 範囲縮約 [-pi/2, pi/2]) ---------------------
def sin_(x) {
    x := x % TWO_PI
    if (x > PI) { x := x - TWO_PI }
    if (x < 0 - PI) { x := x + TWO_PI }
    if (x > HALF_PI) { x := PI - x }
    if (x < 0 - HALF_PI) { x := 0 - PI - x }
    term := x  s := x  k := 1
    while (k <= 12) {
        term := 0 - term * x * x / ((2 * k) * (2 * k + 1))
        s := s + term
        k := k + 1
    }
    return s
}
def cos_(x) { return sin_(HALF_PI - x) }
def tan_(x) { return sin_(x) / cos_(x) }
def sinh_(t) {
    if (abs(t) < 0.5) {               # 桁落ちを避ける級数
        t2 := t * t
        return t * (1 + t2 / 6 * (1 + t2 / 20 * (1 + t2 / 42 * (1 + t2 / 72 * (1 + t2 / 110)))))
    }
    return (exp(t) - exp(0 - t)) / 2
}
def cosh_(t) { return (exp(t) + exp(0 - t)) / 2 }
def atan_(z) {
    neg := false  inv := false
    if (z < 0) { z := 0 - z  neg := true }
    if (z > 1) { z := 1 / z  inv := true }
    z := z / (1 + sqrt(1 + z * z))    # 半角に二度縮約: |z| <= tan(pi/16)
    z := z / (1 + sqrt(1 + z * z))
    s := 0.0  t := z  k := 0  sg := 1
    while (k < 18) { s := s + sg * t / (2 * k + 1)  t := t * z * z  sg := 0 - sg  k := k + 1 }
    s := 4 * s
    if (inv) { s := HALF_PI - s }
    if (neg) { s := 0 - s }
    return s
}
def log1p_(z) {
    if (abs(z) > 0.01) { return log(1 + z) }
    return z * (1 - z * (1/2 - z * (1/3 - z * (1/4 - z * (1/5 - z * (1/6 - z * (1/7 - z * (1/8 - z / 9))))))))
}
def log2_(x)  { return log(x) / LN2 }
def log10_(x) { return log(x) / LN10 }

# ---- 階乗・二項 ----------------------------------------------------------
def fact_(n) { r := 1.0  k := 2  while (k <= n) { r := r * k  k := k + 1 }  return r }
def binom_(n, k) {                    # C(n,k) 整数
    if (k < 0) { return 0 }  if (k > n) { return 0 }
    r := 1.0  j := 0
    while (j < k) { r := r * (n - j) / (j + 1)  j := j + 1 }
    return round_(r)
}
def binom_gen(s, k) {                 # 一般二項係数 C(s+k-1, k) = Γ(s+k)/(Γ(s) k!)
    p := 1.0  j := 0
    while (j < k) { p := p * (s + j)  j := j + 1 }
    return p / fact_(k)
}

# ---- Γ 関数族 (Lanczos g=7, n=9 / 反射公式) -------------------------------
LANCZOS := [0.99999999999980993, 676.5203681218851, -1259.1392167224028,
            771.32342877765313, -176.61502916214059, 12.507343278686905,
            -0.13857109526572012, 0.0000099843695780195716,
            0.00000015056327351493116]
def log_gamma_pos(z) {                # z >= 0.5
    zz := z - 1  a := LANCZOS[0]  t := zz + 7.5  i := 1
    while (i < 9) { a := a + LANCZOS[i] / (zz + i)  i := i + 1 }
    return 0.5 * log(TWO_PI) + (zz + 0.5) * log(t) - t + log(a)
}
def log_gamma(z) {                    # log |Γ(z)|
    if (z >= 0.5) { return log_gamma_pos(z) }
    return log(PI / abs(sin_(PI * z))) - log_gamma_pos(1 - z)
}
def gamma_(z) {                       # Γ(z) 符号つき
    if (z >= 0.5) { return exp(log_gamma_pos(z)) }
    return PI / (sin_(PI * z) * exp(log_gamma_pos(1 - z)))
}
def inv_gamma(z) {                    # 1/Γ(z) 整関数 (非正整数で 0)
    if (z > 0.5) { return exp(0 - log_gamma_pos(z)) }
    return exp(log_gamma_pos(1 - z)) * sin_(PI * z) / PI
}
def log_beta(p, q) { return log_gamma(p) + log_gamma(q) - log_gamma(p + q) }
def beta_(p, q)    { return exp(log_beta(p, q)) }
def digamma_(z) {                     # ψ(z): 漸化式で z >= 10 に上げて漸近展開
    r := 0.0
    while (z < 10) { r := r - 1 / z  z := z + 1 }
    f := 1 / (z * z)
    return r + log(z) - 0.5 / z - f * (1/12 - f * (1/120 - f * (1/252 - f * (1/240 - f / 132))))
}

# ---- Bernoulli 数と多項式 ----------------------------------------------------
BERN := [1, -0.5, 1/6, 0, -1/30, 0, 1/42, 0, -1/30, 0, 5/66, 0, -691/2730, 0, 7/6, 0, -3617/510]
B2K  := [1/6, -1/30, 1/42, -1/30, 5/66, -691/2730, 7/6, -3617/510]
def bernoulli_poly(n, x) {            # B_n(x) = Σ C(n,k) B_k x^{n-k}
    s := 0.0  k := 0
    while (k <= n) { s := s + binom_(n, k) * BERN[k] * pow_(x, n - k)  k := k + 1 }
    return s
}

# ---- Hurwitz ζ(s,a) — Euler–Maclaurin (s != 1 の全域で解析接続として妥当) ----
def hurwitz_nk(s, a, N, K) {
    tot := 0.0  n := 0
    while (n < N) { tot := tot + pow_(n + a, 0 - s)  n := n + 1 }
    A := N + a
    tot := tot + pow_(A, 1 - s) / (s - 1) + 0.5 * pow_(A, 0 - s)
    k := 1
    while (k <= K) {
        p := 1.0  j := 0
        while (j < 2 * k - 1) { p := p * (s + j)  j := j + 1 }
        tot := tot + B2K[k - 1] / fact_(2 * k) * p * pow_(A, 0 - s - 2 * k + 1)
        k := k + 1
    }
    return tot
}
def hurwitz(s, a)      { return hurwitz_nk(s, a, 30, 8) }
def zeta_r(s)          { return hurwitz(s, 1.0) }                 # Riemann ζ
def dirichlet_beta(s)  { return pow_(4, 0 - s) * (hurwitz(s, 0.25) - hurwitz(s, 0.75)) }

# ---- 二重指数節点 (Takahasi–Mori, ロジスティック変換) -------------------------
#   u_k = σ(π sinh(k h)),  w_k = π cosh(k h) h,  h = 2^-5, |k| <= 195 -> 391 節点
#   節点表は (log u, log(1-u), log w) の三つ組で持つ。
def de_nodes(h, kmax) {
    LU := []  LV := []  LW := []
    k := 0 - kmax
    while (k <= kmax) {
        t := k * h
        s := PI * sinh_(t)
        if (s < 700) { if (s > -700) {
            lu := 0.0  lv := 0.0
            if (s >= 0) {
                e := exp(0 - s)
                lu := 0 - log1p_(e)
                lv := (0 - s) - log1p_(e)
            } else {
                e := exp(s)
                lu := s - log1p_(e)
                lv := 0 - log1p_(e)
            }
            if (lu < 0) {
                LU <- lu
                LV <- lv
                LW <- log(PI * cosh_(t) * h)
            }
        } }
        k := k + 1
    }
    return [LU, LV, LW]
}
def de_default() { return de_nodes(0.03125, 195) }

# Σ_k w_k (1-u_k) u_k^{n+y} (log 1/u_k)^{s-1} = Γ(s)/(n+y)^s
def de_moment(nd, s, y, n) {
    LU := nd[0]  LV := nd[1]  LW := nd[2]
    acc := 0.0  i := 0
    while (i < len(LU)) {
        lu := LU[i]
        c := LW[i] + (s - 1) * log(0 - lu) + LV[i] + (n + y) * lu
        if (c > -700) { acc := acc + exp(c) }
        i := i + 1
    }
    return acc
}
# Σ_k w_k u_k^{y} (log 1/u_k)^{s-1} = Γ(s) ζ(s,y)   (1/(1-u) はヤコビアンと相殺)
def de_gamma_zeta(nd, s, y) {
    LU := nd[0]  LW := nd[2]
    acc := 0.0  i := 0
    while (i < len(LU)) {
        lu := LU[i]
        c := LW[i] + (s - 1) * log(0 - lu) + y * lu
        if (c > -700) { acc := acc + exp(c) }
        i := i + 1
    }
    return acc
}
def zeta_de(nd, s, y)   { return exp(log(de_gamma_zeta(nd, s, y)) - log_gamma(s)) }
def zeta_V(nd, x, y, V) { return zeta_de(nd, x, y) - zeta_de(nd, x, y + V) }   # 離散 Newton–Leibniz

# ---- 修正核  ζ(x,y) = B(y,x−1)·Λ(x,y),  Λ = E_Beta(y,x−1)[κ^{x−1}]/Γ(x) ------
def kappa_(u) {                       # κ(u) = log(1/u)/(1−u) = 情報量 ÷ 残余質量
    if (1 - u < 0.000000000001) { e := 1 - u  return 1 + e / 2 + e * e / 3 }
    return (0 - log(u)) / (1 - u)
}
def lambda_de(nd, x, y) { return exp(log(zeta_de(nd, x, y)) - log_beta(y, x - 1)) }
def lambda_em(x, y)     { return hurwitz(x, y) / beta_(y, x - 1) }
def poch_ratio(x, y) {                # Γ(x+y−1)/Γ(x−1) (y が正整数なら多項式で厳密)
    if (is_int(y)) { if (y >= 1) {
        k := round_(y)  p := 1.0  j := 0
        while (j < k) { p := p * (x - 1 + j)  j := j + 1 }
        return p
    } }
    b := x + y - 1
    if (b > 0) { return gamma_(b) * inv_gamma(x - 1) }
    return inv_gamma(x - 1) * PI / (sin_(PI * b) * gamma_(1 - b))
}
def lambda_cont(x, y) { return hurwitz(x, y) * poch_ratio(x, y) / gamma_(y) }   # 解析接続版 Λ

# Zipf–Mandelbrot 分布 (未規格化): P(n) ∝ Σ_k w_k (1-u_k) u_k^{n+y} (log 1/u_k)^{x-1}
def zm_dist_raw(nd, x, y, V) {
    p := []  n := 0
    while (n < V) { p <- de_moment(nd, x, y, n)  n := n + 1 }
    return p
}
def zm_exact(x, y, V) {               # 厳密 (n+y)^{-x} を V 項で切って規格化
    p := []  n := 0
    while (n < V) { p <- pow_(n + y, 0 - x)  n := n + 1 }
    return dist(p)
}

# ---- 複素数 [re, im] (第十巻 Mellin 畳み込み・第十三巻 偏角原理で使う) ------------------
def atan2_(y, x) {
    if (x > 0) { return atan_(y / x) }
    if (x < 0) { if (y >= 0) { return atan_(y / x) + PI }  return atan_(y / x) - PI }
    if (y > 0) { return HALF_PI }
    if (y < 0) { return 0 - HALF_PI }
    return 0.0
}
def c_add(a, b)   { return [a[0] + b[0], a[1] + b[1]] }
def c_sub(a, b)   { return [a[0] - b[0], a[1] - b[1]] }
def c_mul(a, b)   { return [a[0] * b[0] - a[1] * b[1], a[0] * b[1] + a[1] * b[0]] }
def c_div(a, b)   { d := b[0] * b[0] + b[1] * b[1]  return [(a[0] * b[0] + a[1] * b[1]) / d, (a[1] * b[0] - a[0] * b[1]) / d] }
def c_scale(a, k) { return [a[0] * k, a[1] * k] }
def c_abs(a)      { return sqrt(a[0] * a[0] + a[1] * a[1]) }
def c_arg(a)      { return atan2_(a[1], a[0]) }
def c_exp(a)      { r := exp(a[0])  return [r * cos_(a[1]), r * sin_(a[1])] }
def c_log(a)      { return [log(c_abs(a)), atan2_(a[1], a[0])] }
def c_pow(a, z)   { return c_exp(c_mul(z, c_log(a))) }              # a^z (主値)
def c_powr(b, z)  { l := log(b)  return c_exp([z[0] * l, z[1] * l]) } # 実数 b > 0 の複素べき b^z
def c_sin(a)      { return [sin_(a[0]) * cosh_(a[1]), cos_(a[0]) * sinh_(a[1])] }
def c_gamma(z) {                       # 複素 Γ (Lanczos g=7, Re z < 1/2 は反射公式)
    if (z[0] < 0.5) {
        s := c_sin(c_scale(z, PI))
        return c_div([PI, 0], c_mul(s, c_gamma([1 - z[0], 0 - z[1]])))
    }
    zz := [z[0] - 1, z[1]]
    x := [LANCZOS[0], 0]  i := 1
    while (i < 9) { x := c_add(x, c_div([LANCZOS[i], 0], [zz[0] + i, zz[1]]))  i := i + 1 }
    t := [zz[0] + 7.5, zz[1]]
    return c_mul(c_mul(c_scale(c_pow(t, [zz[0] + 0.5, zz[1]]), SQRT_2PI), c_exp([0 - t[0], 0 - t[1]])), x)
}
def c_hurwitz(s, a, N, K) {            # 複素 s の Hurwitz ζ(s,a) (a 実、Euler–Maclaurin)
    tot := [0, 0]  n := 0
    while (n < N) { tot := c_add(tot, c_powr(n + a, [0 - s[0], 0 - s[1]]))  n := n + 1 }
    A := N + a
    tot := c_add(tot, c_div(c_powr(A, [1 - s[0], 0 - s[1]]), [s[0] - 1, s[1]]))
    tot := c_add(tot, c_scale(c_powr(A, [0 - s[0], 0 - s[1]]), 0.5))
    k := 1
    while (k <= K) {
        p := [1, 0]  j := 0
        while (j < 2 * k - 1) { p := c_mul(p, [s[0] + j, s[1]])  j := j + 1 }
        tot := c_add(tot, c_scale(c_mul(p, c_powr(A, [0 - s[0] - 2 * k + 1, 0 - s[1]])), B2K[k - 1] / fact_(2 * k)))
        k := k + 1
    }
    return tot
}

# ---- 配列補助 ---------------------------------------------------------------
def arr_zeros(n) { a := []  i := 0  while (i < n) { a <- 0.0  i := i + 1 }  return a }
def arr_fill(n, v) { a := []  i := 0  while (i < n) { a <- v  i := i + 1 }  return a }
def set_at(a, i, v) {
    b := []  k := 0
    while (k < len(a)) { if (k == i) { b <- v } else { b <- a[k] }  k := k + 1 }
    return b
}
def arr_copy(a)  { b := []  i := 0  while (i < len(a)) { b <- a[i]  i := i + 1 }  return b }
def arr_sum(a)   { s := 0.0  i := 0  while (i < len(a)) { s := s + a[i]  i := i + 1 }  return s }
def arr_max(a)   { m := a[0]  i := 1  while (i < len(a)) { if (a[i] > m) { m := a[i] }  i := i + 1 }  return m }
def arr_min(a)   { m := a[0]  i := 1  while (i < len(a)) { if (a[i] < m) { m := a[i] }  i := i + 1 }  return m }
def arr_maxabs(a){ m := 0.0  i := 0  while (i < len(a)) { if (abs(a[i]) > m) { m := abs(a[i]) }  i := i + 1 }  return m }
def arr_argmax(a){ m := 0  i := 1  while (i < len(a)) { if (a[i] > a[m]) { m := i }  i := i + 1 }  return m }
def arr_scale(a, c) { b := []  i := 0  while (i < len(a)) { b <- a[i] * c  i := i + 1 }  return b }
def arr_add(a, b)   { c := []  i := 0  while (i < len(a)) { c <- a[i] + b[i]  i := i + 1 }  return c }
def arr_dot(a, b)   { s := 0.0  i := 0  while (i < len(a)) { s := s + a[i] * b[i]  i := i + 1 }  return s }
def arr_maxdiff(a, b) {
    m := 0.0  i := 0
    while (i < len(a)) { d := abs(a[i] - b[i])  if (d > m) { m := d }  i := i + 1 }
    return m
}
def arr_maxrel(a, b) {               # max |a_i - b_i| / |b_i|
    m := 0.0  i := 0
    while (i < len(a)) { if (b[i] != 0) { d := abs(a[i] - b[i]) / abs(b[i])  if (d > m) { m := d } }  i := i + 1 }
    return m
}
def rel_err(got, want) { if (want == 0) { return abs(got) }  return abs(got - want) / abs(want) }
def arr_order_desc(a) {               # 値の降順の添字列 (選択ソート)
    idx := []  i := 0
    while (i < len(a)) { idx <- i  i := i + 1 }
    out := []  used := arr_fill(len(a), false)
    k := 0
    while (k < len(a)) {
        best := -1  j := 0
        while (j < len(a)) {
            if (!used[j]) { if (best < 0) { best := j } else { if (a[j] > a[best]) { best := j } } }
            j := j + 1
        }
        out <- best
        used := set_at(used, best, true)
        k := k + 1
    }
    return out
}
def shannon_(p) {                     # −Σ q log q  (x log x 核, 零は寄与ゼロ)
    h := 0.0  i := 0
    while (i < len(p)) { q := p[i]  if (q > 0) { h := h - q * log(q) }  i := i + 1 }
    return h
}

# ---- 表示 (組み込みは f5 / sci のみ。桁を選べる固定小数を自作) ------------------
def fx(x, d) {
    if (x != x) { return "nan" }
    if (x > 1e300) { return "inf" }
    if (x < -1e300) { return "-inf" }
    s := ""
    if (x < 0) { s := "-"  x := 0 - x }
    x := x + 0.5 * pow_(10, 0 - d)
    ip := floor_(x)  fr := x - ip
    s := s + ip
    if (d > 0) { s := s + "." }
    k := 0
    while (k < d) { fr := fr * 10  dg := floor_(fr)  if (dg > 9) { dg := 9 }  s := s + dg  fr := fr - dg  k := k + 1 }
    return s
}
def f3(x)  { return fx(x, 3) }
def f8(x)  { return fx(x, 8) }
def f10(x) { return fx(x, 10) }
def f12(x) { return fx(x, 12) }
def arr_str(a) {                      # 配列を "[a, b, c]" の文字列に (文字列連結では配列が潰れるため)
    s := "["  i := 0
    while (i < len(a)) { if (i > 0) { s := s + ", " }  s := s + a[i]  i := i + 1 }
    return s + "]"
}
def bstr(b)    { if (b) { return "true" }  return "false" }   # 真偽値を文字列連結すると潰れるため
def pad(s, n)  { s := "" + s  while (len(s) < n) { s := " " + s }  return s }
def padr(s, n) { s := "" + s  while (len(s) < n) { s := s + " " }  return s }

# ---- 検査台帳 -------------------------------------------------------------------
#   関数の中から大域の数を書き換えられないので、結果は配列 CHECKS に積み、
#   同時に追記専用台帳 tuplespace へ ["check", label, ok] として commit する。
CHECKS := []
def check(label, ok) {
    if (ok) { print("  [OK] " + label) } else { print("  [NG] " + label) }
    fact := ["check", label, ok]      # 改行は文の区切りではないので、配列リテラルは束縛してから commit する
    fact >> tuplespace
    CHECKS <- ok
    return ok
}
def check_close(label, got, want, tol) {
    err := abs(got - want)
    return check(label + "  got " + fx(got, 10) + "  want " + fx(want, 10) + "  |err| " + sci(err) + " <= " + sci(tol), err <= tol)
}
def check_rel(label, got, want, tol) {
    err := rel_err(got, want)
    return check(label + "  got " + fx(got, 10) + "  want " + fx(want, 10) + "  rel " + sci(err) + " <= " + sci(tol), err <= tol)
}
def checks_failed() {
    n := 0  i := 0
    while (i < len(CHECKS)) { if (!CHECKS[i]) { n := n + 1 }  i := i + 1 }
    return n
}
def verdict(sentinel) {
    total := len(CHECKS)  bad := checks_failed()
    print("")
    print("---- 検査 " + (total - bad) + " / " + total + " 合格  (台帳 " + len(tuplespace) + " facts) ----")
    if (bad == 0) { print(sentinel) } else { print("@@FAILED " + bad + " check(s)") }
}
def section(title) {
    print("")
    print("================================================================")
    print(title)
    print("================================================================")
}


# ================= 01_form_entropy.bada =================
# ============================================================
# 01_form_entropy.bada -- 第一巻
# 方程式の記号形状エントロピーによるアプリケーション合成
# — Bada 量子言語の位相核上に BadaGPT を構成する機構 —
#
# 論文の主張を、そのまま実行できる Bada プログラムに作り換えたもの。
#   §3  記号形状エントロピー H_form = (H0 + H1 + (H2+H3)/2)/3   (式5)
#   命題0 α 変換不変性 (名前の付け替えで H0, Hshape が厳密に不変)
#   定理1 単一位相は不活性 (cognitive_system で q = a を機械精度で確認)
#   定理2 二分岐干渉の閉形式 p_i = a_i(1+cos(β ΔH φ_i))/Z   (式7)
#   系1・2 零点の単調増加 (非復活・最大破壊的干渉が厳密零を生む)
#   命題1 共通位相場では順位が変わらない (否定的結果2)
#   §6  設計行列 W と方程式由来の位相場 φ(E) による合成パイプライン (表E)
#   §5  @reviser : grammar による eqload / shape / synth 規則の台帳 commit
# 予備知識は持たない: 事前分布は unknown_prior(8) の一様 (Jaynes) から出発し、
# 方程式の「形」だけが干渉係数として確率へ作用する。
# ============================================================

section("第一巻  方程式の記号形状エントロピーによるアプリケーション合成")

# ---- §5 文法拡張: 三規則を台帳へ commit ---------------------------------------
@reviser : grammar < Omega::DATABASE[grammar].mechanism {
    rule "eqload" postfix [ 'eq'    '(' expr ')' ] => eq_parse(_1)
    rule "shape"  postfix [ 'shape' '(' expr ')' ] => form_entropy(_1)
    rule "synth"  stmt    [ 'synth' '(' expr ',' expr ',' expr ',' expr ')' ] => commit_measurement(interfere2(_1, _2, _3, _4))
}
print("grammar rules committed :", len(tuplespace), "facts (eqload / shape / synth)")

# ---- S 式 -> 記号木 ----------------------------------------------------------------
# 木は ["N", head, kids] / 葉は ["L", token] で表す (Bada に型判別が無いため)。
def sx_tokenize(s) {
    toks := []  cur := ""  i := 0  n := len(s)
    while (i < n) {
        c := substr(s, i, 1)
        if (c == "(") { if (len(cur) > 0) { toks <- cur  cur := "" }  toks <- "(" }
        else { if (c == ")") { if (len(cur) > 0) { toks <- cur  cur := "" }  toks <- ")" }
        else { if (c == " ") { if (len(cur) > 0) { toks <- cur  cur := "" } }
        else { cur := cur + c } } }
        i := i + 1
    }
    if (len(cur) > 0) { toks <- cur }
    return toks
}
def sx_read(toks, pos) {                     # -> [node, next_pos]
    t := toks[pos]
    if (t == "(") {
        head := toks[pos + 1]
        kids := []
        p := pos + 2
        while (toks[p] != ")") {
            r := sx_read(toks, p)
            kids <- r[0]
            p := r[1]
        }
        return [["N", head, kids], p + 1]
    }
    return [["L", t], pos + 1]
}
def eq_parse(s) {
    toks := sx_tokenize(s)
    r := sx_read(toks, 0)
    fact := ["eq", s]
    fact >> tuplespace                       # 木化は決定的で、方程式は台帳事実になる
    return r[0]
}
def sx_tokens(node, out) {                   # 前順走査
    if (node[0] == "L") { out <- node[1]  return out }
    out <- node[1]
    kids := node[2]  i := 0
    while (i < len(kids)) { sx_tokens(kids[i], out)  i := i + 1 }
    return out
}
def sx_depths(node, d, out) {
    out <- d
    if (node[0] == "N") { kids := node[2]  i := 0  while (i < len(kids)) { sx_depths(kids[i], d + 1, out)  i := i + 1 } }
    return out
}
def sx_arities(node, out) {
    if (node[0] == "L") { out <- 0  return out }
    kids := node[2]
    out <- len(kids)
    i := 0
    while (i < len(kids)) { sx_arities(kids[i], out)  i := i + 1 }
    return out
}
def flatten(node) { return sx_tokens(node, []) }

# ---- 記号類 (付録 B.1) ---------------------------------------------------------------
BIND_SYMS := ["Sum", "Int", "Prod", "lim", "d/ds", "partial", "nabla"]
FN_SYMS   := ["zeta", "beta", "Gamma", "psi", "sin", "cos", "log", "exp", "sqrt", "softmax", "H"]
OP_SYMS   := ["+", "-", "*", "/", "^", "="]
NUM_SYMS  := ["1", "2", "pi", "e", "0", "1/2"]
DEL_SYMS  := ["(", ")", "[", "]", ",", "_"]
CLASS_NAMES := ["BIND", "FN", "OP", "VAR", "NUM", "DEL"]
def in_list(xs, v) { i := 0  while (i < len(xs)) { if (xs[i] == v) { return true }  i := i + 1 }  return false }
def klass(tok) {
    if (in_list(BIND_SYMS, tok)) { return 0 }
    if (in_list(FN_SYMS, tok))   { return 1 }
    if (in_list(OP_SYMS, tok))   { return 2 }
    if (in_list(NUM_SYMS, tok))  { return 4 }
    if (in_list(DEL_SYMS, tok))  { return 5 }
    return 3                                  # 未登録の名前は一律 VAR (命題0 を壊さない)
}

# ---- 頻度分布と Shannon 核 -------------------------------------------------------------
def counts_of(items) {                         # 相異なる値ごとの出現数 (順不同)
    keys := []  cnt := []  i := 0
    while (i < len(items)) {
        v := items[i]  j := 0  found := -1
        while (j < len(keys)) { if (keys[j] == v) { found := j }  j := j + 1 }
        if (found < 0) { keys <- v  cnt <- 1 } else { cnt := set_at(cnt, found, cnt[found] + 1) }
        i := i + 1
    }
    return cnt
}
def class_counts(toks) {
    c := arr_zeros(6)  i := 0
    while (i < len(toks)) { k := klass(toks[i])  c := set_at(c, k, c[k] + 1)  i := i + 1 }
    return c
}
def counts_to_dist(c) { return dist(c) }       # dist() が規格化する

# ---- §3 三階層の測定 (式2〜5) -----------------------------------------------------------
def form_layers(tree) {                          # [H0, H1, Hshape, N]
    toks := flatten(tree)
    H0 := shannon_(counts_to_dist(counts_of(toks)))
    H1 := shannon_(counts_to_dist(class_counts(toks)))
    H2 := shannon_(counts_to_dist(counts_of(sx_depths(tree, 0, []))))
    H3 := shannon_(counts_to_dist(counts_of(sx_arities(tree, []))))
    return [H0, H1, (H2 + H3) / 2, len(toks)]
}
def form_entropy(tree) {
    L := form_layers(tree)
    return (L[0] + L[1] + L[2]) / 3            # 式(5)
}

# ---- 表1: 出典論文から採取した方程式 6 本 + 1 -----------------------------------------------
E1 := eq("(= (zeta s) (* (^ 2 s) (* (^ pi (- s 1)) (* (sin (/ (* pi s) 2)) (* (/ (beta s (- 1 s)) (Gamma s)) (zeta (- 1 s)))))))")
E2 := eq("(= (log (beta (+ 1 alpha) (+ 1 beta_v))) (+ (- (log (+ 1 (+ alpha beta_v)))) (Sum n (* (/ (* (^ (- 1) n) (zeta n)) n) (- (+ (^ alpha n) (^ beta_v n)) (^ (+ alpha beta_v) n))))))")
E3 := eq("(= gamma_v (Sum n (/ (* (^ (- 1) n) (zeta n)) n)))")
E4 := eq("(= psi (* (sqrt a) (exp (* i theta))))")
E5 := eq("(= (zeta s) (* (zeta s) (exp (* i (* beta_v (H sigma))))))")
E6 := eq("(= H (- (Sum i (* q (log q)))))")
E7 := eq("(= theta (Sum m (* beta_v (* H phi))))")
EQS   := [E1, E2, E3, E4, E5, E6, E7]
NAMES := ["E1", "E2", "E3", "E4", "E5", "E6", "E7"]
DESC  := ["ζ(s) のベータ型関数等式", "log B(1+α,1+β) のゼータ差分展開", "γ = Σ(−1)^n ζ(n)/n",
          "psi = sqrt(a)·exp(iθ) (エンジン核)", "ζ_NS = ζ·exp(iβH)", "H = −Σ q log q", "θ = Σ β_m H_m φ_m"]
# 論文 表1 の実測値 (H0, H1, Hshape, H_form) — 本実装が同じ S 式から同じ値を返すことを検査する
PAPER_T1 := [[2.33875, 1.32534, 1.52700, 1.73037],
             [2.41643, 1.26772, 1.48136, 1.72184],
             [2.13840, 1.32692, 1.44860, 1.63797],
             [2.04319, 1.09861, 1.32098, 1.48759],
             [2.09815, 1.09283, 1.48885, 1.55994],
             [2.04319, 1.31078, 1.39799, 1.58399],
             [2.04319, 1.21489, 1.13403, 1.46404]]

print("")
print("表1. 記号形状エントロピー (nat)")
print("  式   N    H0       H1       Hshape   H_form   Ĥ=H/log N")
HF := []
t1_ok := true
i := 0
while (i < 7) {
    L := form_layers(EQS[i])
    hf := (L[0] + L[1] + L[2]) / 3
    HF <- hf
    print("  " + NAMES[i] + "  " + pad(L[3], 2) + "  " + fx(L[0], 5) + "  " + fx(L[1], 5) + "  " + fx(L[2], 5) + "  " + fx(hf, 5) + "  " + fx(hf / log(L[3]), 5) + "   " + DESC[i])
    row := PAPER_T1[i]
    if (abs(L[0] - row[0]) > 0.000006) { t1_ok := false }
    if (abs(L[1] - row[1]) > 0.000006) { t1_ok := false }
    if (abs(L[2] - row[2]) > 0.000006) { t1_ok := false }
    if (abs(hf - row[3]) > 0.000006) { t1_ok := false }
    i := i + 1
}
check("表1  7 本すべて論文値 (H0, H1, Hshape, H_form) と 5 桁一致", t1_ok)
Href  := HF[3]                                   # 参照式 E4 = エンジン核
dHmax := abs(HF[0] - Href)                       # 参照からの最大乖離 (E1)
print("  参照 E4 の H_form =", fx(Href, 5), "  ΔHmax = |H(E1) − H(E4)| =", fx(dHmax, 5))
check_close("ΔHmax = 0.24277 (論文)", dHmax, 0.24277, 0.000006)

# ---- 命題0: α 変換不変性 -------------------------------------------------------------------
E1r := eq("(= (Z w) (* (^ 2 w) (* (^ pi (- w 1)) (* (sin (/ (* pi w) 2)) (* (/ (B w (- 1 w)) (G w)) (Z (- 1 w)))))))")
La := form_layers(E1)  Lb := form_layers(E1r)
print("")
print("表2. α 変換不変性 (E1: s→w, ζ→Z, β→B, Γ→G)")
print("  H0     原式", fx(La[0], 12), " 改名後", fx(Lb[0], 12), " 差", sci(abs(La[0] - Lb[0])))
print("  Hshape 原式", fx(La[2], 12), " 改名後", fx(Lb[2], 12), " 差", sci(abs(La[2] - Lb[2])))
check("命題0  H0 が厳密に不変 (差 0)", La[0] == Lb[0])
check("命題0  Hshape が厳密に不変 (差 0)", La[2] == Lb[2])
print("  (注: Z, B, G は未登録なので VAR に落ち、類階層 H1 は変わる — 命題0 は類を保存する付け替えについての主張)")

# ---- 定理1: 単一位相は不活性 (エンジン第二定理の直接の帰結) -------------------------------------
section("定理1  単一位相は不活性 — 方程式の形は出力分布を変えない")
z := [3.0, 1.5, 0.0, -40.0, 1.0, -3.0, -40.0, 0.75]
a := softmax(z)                                  # 確信零 {3, 6} を含む基底分布 (表3 の a を再現)
phi_cos := []  i := 0
while (i < 8) { phi_cos <- cos_(i)  i := i + 1 }
qmod := dist([0.5, 0.5])                         # H(q) = log 2
beta1 := HF[0] / LN2                             # → θ_i = β·H(q)·φ_i = H_form(E1)·cos(i)
q_hat := cognitive_system(a, [[qmod, phi_cos]], [beta1])
print("  index :   0        1        2        3        4        5        6        7")
print("  a     :", fx(a[0], 5), fx(a[1], 5), fx(a[2], 5), fx(a[3], 5), fx(a[4], 5), fx(a[5], 5), fx(a[6], 5), fx(a[7], 5))
print("  q     :", fx(q_hat[0], 5), fx(q_hat[1], 5), fx(q_hat[2], 5), fx(q_hat[3], 5), fx(q_hat[4], 5), fx(q_hat[5], 5), fx(q_hat[6], 5), fx(q_hat[7], 5))
print("  maxdiff(q, a) =", sci(maxdiff(q_hat, a)), "  零点", zeros_of(a), "→", zeros_of(q_hat))
check("定理1  q = a (maxdiff <= 2.3e-16)", maxdiff(q_hat, a) <= 0.00000000000000023)
check("定理1  零点 [3,6] が保存", len(zeros_of(q_hat)) == 2 && zeros_of(q_hat)[0] == 3 && zeros_of(q_hat)[1] == 6)

# ---- 定理2: 二分岐干渉の閉形式 -------------------------------------------------------------------
section("定理2  二分岐干渉  p_i = a_i (1 + cos(β ΔH φ_i)) / Z")
def interf_factor(theta) { c := cos_(theta / 2)  return 2 * c * c }   # = 1 + cos θ (θ = ±π で厳密零)
def interfere2(prior, dH, beta, phi) {           # 式(7) 閉形式。dist() が規格化する
    w := []  i := 0
    while (i < len(prior)) { w <- prior[i] * interf_factor(beta * dH * phi[i])  i := i + 1 }
    return dist(w)
}
def interfere2_direct(prior, H1, H2, beta, phi) { # 式(6) 振幅を二乗前に加算
    w := []  i := 0
    while (i < len(prior)) {
        u := beta * H1 * phi[i]  v := beta * H2 * phi[i]
        re := cos_(u) + cos_(v)  im := sin_(u) + sin_(v)
        w <- prior[i] * (re * re + im * im) / 2
        i := i + 1
    }
    return dist(w)
}
BETAS := [0.5, 1.0, 2.0, 5.0, 12.0]
PAIRS := [[0, 1], [3, 6], [0, 3], [1, 6]]
worst := 0.0  bi := 0
while (bi < 5) {
    pi_ := 0
    while (pi_ < 4) {
        pr := PAIRS[pi_]
        pd := interfere2_direct(a, HF[pr[0]], HF[pr[1]], BETAS[bi], phi_cos)
        pc := interfere2(a, HF[pr[0]] - HF[pr[1]], BETAS[bi], phi_cos)
        d := maxdiff(pd, pc)
        if (d > worst) { worst := d }
        pi_ := pi_ + 1
    }
    bi := bi + 1
}
print("  β ∈ {0.5,1,2,5,12} × 4 方程式対 = 20 ケース: 式(6) 直接振幅和 vs 式(7) 閉形式 の最大差 =", sci(worst))
check("定理2  閉形式と直接計算が一致 (max diff <= 5e-16)", worst <= 0.0000000000000005)

# ---- 命題1 / 表4: 共通位相場では順位が変わらない ------------------------------------------------------
print("")
print("表4. 共通位相モジュール (φ_i = cos i, β = 2) — ΔH 昇順")
def kl_(p, q) {
    s := 0.0  i := 0
    while (i < len(p)) { if (p[i] > 0) { s := s + p[i] * log(p[i] / q[i]) }  i := i + 1 }
    return s
}
def top3_(p) { o := arr_order_desc(p)  return [o[0], o[1], o[2]] }
T4 := [[3, 3], [0, 1], [3, 6], [5, 4], [2, 4], [0, 5], [0, 3], [1, 6]]
print("  対      ΔH_form   maxdiff   KL(p‖a)   厳密零   上位3部品")
prev := -1.0  mono := true  ranks_same := true  zeros_kept := true
ref_top := top3_(a)
ti := 0
while (ti < 8) {
    pr := T4[ti]
    dH := HF[pr[0]] - HF[pr[1]]
    p := interfere2(a, dH, 2.0, phi_cos)
    md := maxdiff(p, a)
    if (md + 0.0000000000001 < prev) { mono := false }
    prev := md
    t3 := top3_(p)
    if (t3[0] != ref_top[0]) { ranks_same := false }
    if (t3[1] != ref_top[1]) { ranks_same := false }
    if (t3[2] != ref_top[2]) { ranks_same := false }
    zs := zeros_of(p)
    if (len(zs) != 2) { zeros_kept := false }
    print("  " + NAMES[pr[0]] + "/" + NAMES[pr[1]] + "   " + fx(dH, 5) + "   " + fx(md, 5) + "   " + fx(kl_(p, a), 5) + "   " + arr_str(zs) + "   " + arr_str(t3))
    ti := ti + 1
}
check("命題1  |ΔH| 昇順で maxdiff は単調非減少", mono)
check("命題1  上位 3 部品の順位は全ケース同一 (否定的結果2)", ranks_same)
check("系1    零点 [3,6] は全ケースで保存", zeros_kept)

# ---- 系2 / 表F: 最大破壊的干渉は新たな厳密零を作る --------------------------------------------------------
print("")
print("表F. 最大破壊的干渉における零点の扱い")
aF := dist([0.30, 0.25, 0.0, 0.20, 0.15, 0.0, 0.06, 0.04])   # 厳密零 {2, 5}
phiF := [0.3, -0.2, 0.1, 0.5, 1.0, -0.4, 0.2, -0.6]          # 最大絶対値成分 index 4 = +1
pF := interfere2(aF, dHmax, PI / dHmax, phiF)               # β = π/ΔHmax (分解ゲイン)
print("  a =", aF)
print("  p =", pF)
print("  β·ΔH·φ_4 =", fx(PI / dHmax * dHmax * phiF[4], 6), "rad  厳密零 {2,5} →", zeros_of(pF))
zF := zeros_of(pF)
check("系2    a の零 {2,5} ⊂ p の零 かつ index 4 に新たな厳密零", len(zF) == 3 && zF[0] == 2 && zF[1] == 4 && zF[2] == 5)

# ---- §6 BadaGPT 合成パイプライン ------------------------------------------------------------------------------
section("§6  BadaGPT 合成パイプライン — 方程式由来の位相場 φ(E) と設計行列 W")
PARTS := ["chat_stream", "pdf_ingest", "plot_panel", "ledger_view", "gate_editor", "tomography", "export_md", "settings"]
W := [ [0, 1, 0, 2, 0, 1],   # chat_stream : 変数の多い式は対話的な同定を要する
       [1, 2, 0, 1, 0, 2],   # pdf_ingest  : 名前付き関数と添字が多い = 出典参照が必要
       [2, 2, 1, 1, 2, 0],   # plot_panel  : 和・積分と定数 = 数値プロットの対象
       [2, 0, 1, 0, 1, 1],   # ledger_view : 束縛作用素 = 逐次的な commit の履歴
       [1, 1, 2, 1, 1, 0],   # gate_editor : 演算子密度 = ゲート列の編集
       [2, 1, 0, 1, 2, 0],   # tomography  : 和と定数 = 反復測定による推定
       [0, 1, 1, 1, 0, 2],   # export_md   : 区切りの多い式 = 整形出力の需要
       [0, 0, 1, 0, 1, 1] ]  # settings    : 既定 (残余)
# W は設計者の宣言であって、データから推定したものではない (§8-3)。
def phi_of(tree) {                               # 式(8): raw = W f(E), 中心化・最大絶対値 1 に正規化
    f := counts_to_dist(class_counts(flatten(tree)))
    raw := []  i := 0
    while (i < 8) { s := 0.0  j := 0  while (j < 6) { s := s + W[i][j] * f[j]  j := j + 1 }  raw <- s  i := i + 1 }
    m := arr_sum(raw) / 8
    dev := []  i := 0
    while (i < 8) { dev <- raw[i] - m  i := i + 1 }
    sc := arr_maxabs(dev)
    out := []  i := 0
    while (i < 8) { out <- dev[i] / sc  i := i + 1 }
    return out
}
def synth_app(tree, ref_H, dHmax_) {
    prior := unknown_prior(8)                    # 一様 = 最大エントロピー (Jaynes)。予備知識なし
    Hf    := form_entropy(tree)
    phi   := phi_of(tree)
    beta  := PI / dHmax_                         # 分解ゲイン
    p     := interfere2(prior, Hf - ref_H, beta, phi)
    synth(prior, Hf - ref_H, beta, phi)          # 台帳へ測定として追記 (reviser 規則 synth)
    return p
}
print("  事前分布 unknown_prior(8): H = log 8 =", fx(entropy(unknown_prior(8)), 5), "  β = π/ΔHmax =", fx(PI / dHmax, 5))
print("")
print("表E. 方程式由来位相場での部品分布 (参照 E4)")
print("  式   ΔH        H(p)     chat    pdf     plot    ledger  gate    tomo    export  set    上位3")
ORDER := [6, 4, 5, 2, 1, 0]                       # ΔH 昇順 (E7, E5, E6, E3, E2, E1)
PAPER_E := [[0.1258, 0.1259, 0.1246, 0.1250, 0.1237, 0.1259, 0.1260, 0.1231],
            [0.1336, 0.1360, 0.1206, 0.1094, 0.1206, 0.1343, 0.1360, 0.1094],
            [0.1426, 0.1426, 0.1065, 0.1242, 0.1065, 0.1409, 0.1426, 0.0940],
            [0.1626, 0.1359, 0.0959, 0.1359, 0.0515, 0.1595, 0.1626, 0.0959],
            [0.2042, 0.1245, 0.0661, 0.1245, 0.0006, 0.1779, 0.2025, 0.0997],
            [0.1595, 0.1001, 0.0017, 0.1402, 0.0000, 0.2315, 0.2267, 0.1402]]
prevH := 99.0  hp_mono := true  tE_ok := true  ledger0 := len(tuplespace)
oi := 0
while (oi < 6) {
    k := ORDER[oi]
    p := synth_app(EQS[k], Href, dHmax)
    hp := entropy(p)
    if (hp > prevH + 0.0000001) { hp_mono := false }
    prevH := hp
    t3 := top3_(p)
    row := PAPER_E[oi]  j := 0
    while (j < 8) { if (abs(p[j] - row[j]) > 0.00006) { tE_ok := false }  j := j + 1 }
    print("  " + NAMES[k] + "  " + pad(fx(HF[k] - Href, 5), 8) + "  " + fx(hp, 5) + "  " + fx(p[0], 4) + "  " + fx(p[1], 4) + "  " + fx(p[2], 4) + "  " + fx(p[3], 4) + "  " + fx(p[4], 4) + "  " + fx(p[5], 4) + "  " + fx(p[6], 4) + "  " + fx(p[7], 4) + "  " + PARTS[t3[0]] + " / " + PARTS[t3[1]] + " / " + PARTS[t3[2]])
    if (k == 0) {
        print("       E1 の禁止部品 zeros_of(p) =", zeros_of(p), "→ " + PARTS[4] + " は以後の合成から恒久的に排除される")
        check("表E   E1 で gate_editor が厳密零", len(zeros_of(p)) == 1 && zeros_of(p)[0] == 4)
    }
    oi := oi + 1
}
check("表E   6 本の部品分布が論文値と 4 桁一致", tE_ok)
check("表E   |ΔH| の増加とともに H(p) が単調減少 (2.07941 → 1.76036)", hp_mono)
check("表E   上位 3 部品の順位が方程式ごとに変化 (φ(E) が方程式依存)", top3_(synth_app(E1, Href, dHmax))[0] != top3_(synth_app(E5, Href, dHmax))[0])
print("  合成 6 回 + 検算 2 回で台帳は", ledger0, "→", len(tuplespace), "facts (文法規則・方程式・測定が同一の追記専用ストアに載る)")

# ---- 結論 ----------------------------------------------------------------------------------------------------
section("結論 (第一巻)")
print("  1. 測る   : 三階層に x log x 核を当て、α 変換不変な H_form を得た (表1・命題0)。")
print("  2. 干渉させる: 単一位相では何も起きず (定理1)、二乗前の振幅加算だけが確率に作用する (定理2)。")
print("              作用は非負因子の乗算であり、確信された零は復活せず、最大破壊的干渉は新たな零を作る (系1・2)。")
print("  3. commit する: 合成結果は測定として台帳に追記され、零点集合は単調に増大する。")
print("  主張しないこと: H_form が方程式の意味を捉えていること。W は宣言であり発見ではない (§8)。")
verdict("@@PAPER-01-OK")
