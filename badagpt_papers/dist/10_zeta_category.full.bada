# ---- generated: 00_prelude.bada + 10_zeta_category.bada (tools/run-papers.js) ----
# ============================================================
# 00_prelude.bada -- BadaGPT 未知事前エンジン論文集 / 共通核
#
# 量子プログラミング言語 Bada の組み込みは softmax / entropy /
# unknown_prior / update / cognitive_system / dist / zeros_of /
# maxdiff / len / sqrt / log / exp / abs / f5 / sci と、量子部分言語
# qubit / H / X / S / T / Rz / CNOT / Measure / commit_measurement、
# 追記専用台帳 tuplespace だけである。床関数も三角関数も Γ も ζ も
# 無い。この核でそれを全部こしらえ、各巻はこの上に乗る。
#
#   数値      floor_ round_ pow_ ipow sin_ cos_ atan_ sinh_ cosh_ log1p_
#   Γ 族      log_gamma gamma_ inv_gamma log_beta beta_ digamma_
#   Bernoulli BERN bernoulli_poly
#   Hurwitz ζ hurwitz (Euler–Maclaurin)  zeta_r  dirichlet_beta
#   二重指数  de_default de_gamma_zeta zeta_de lambda_de zeta_V zm_dist_raw
#   修正核    lambda_em kappa_      (ζ(x,y) = B(y,x−1)·Λ(x,y))
#   配列      arr_zeros set_at arr_sum arr_max arr_maxabs rel_err ...
#   表示      fx f3 f8 f10 f12 pad
#   検査      check check_close check_rel verdict  (結果は台帳へ commit)
#
# 方言上の注意 (この処理系で実測した制約):
#   * 配列の索引代入 a[i] := v は無い -> set_at / 再構築で書く
#   * 論理和 or / || は無い -> && と ! と入れ子の if で書く
#   * 関数の中から大域変数へ := しても外へ出ない -> 配列への <- 追記だけが届く
#   * for は本体の代入を外へ出さない -> 累積は while で書く
# ============================================================

PI          := 3.141592653589793
TWO_PI      := 6.283185307179586
HALF_PI     := 1.5707963267948966
LN2         := 0.6931471805599453
LN10        := 2.302585092994046
SQRT_2PI    := 2.5066282746310002
EULER_GAMMA := 0.5772156649015329
GLAISHER    := 1.2824271291006226
INF         := exp(800)

# ---- 床・丸め・べき --------------------------------------------------
def floor_(x) { r := x - (x % 1)  if (r > x) { r := r - 1 }  return r }
def ceil_(x)  { r := floor_(x)  if (r < x) { r := r + 1 }  return r }
def round_(x) { return floor_(x + 0.5) }
def max_(a, b) { if (a > b) { return a }  return b }
def min_(a, b) { if (a < b) { return a }  return b }
def is_int(x) { return abs(x - round_(x)) < 0.000000000001 }
def sign_(x) { if (x < 0) { return -1 }  if (x > 0) { return 1 }  return 0 }

def ipow(b, n) {                      # 整数べき (n >= 0)
    r := 1.0  k := 0
    while (k < n) { r := r * b  k := k + 1 }
    return r
}
def pow_(b, e) {                      # 実数べき: exp(e log b)  (小さな整数べきは乗算で厳密に)
    if (e % 1 == 0) { if (abs(e) <= 64) {
        if (e >= 0) { return ipow(b, e) }
        return 1.0 / ipow(b, 0 - e)
    } }
    if (b > 0) { return exp(e * log(b)) }
    if (b == 0) { if (e > 0) { return 0.0 }  if (e == 0) { return 1.0 }  return INF }
    if (is_int(e)) {
        n := round_(e)
        if (n >= 0) { return ipow(b, n) }
        return 1.0 / ipow(b, 0 - n)
    }
    return 0 / 0
}

# ---- 三角関数 (Taylor 級数 + 範囲縮約 [-pi/2, pi/2]) ---------------------
def sin_(x) {
    x := x % TWO_PI
    if (x > PI) { x := x - TWO_PI }
    if (x < 0 - PI) { x := x + TWO_PI }
    if (x > HALF_PI) { x := PI - x }
    if (x < 0 - HALF_PI) { x := 0 - PI - x }
    term := x  s := x  k := 1
    while (k <= 12) {
        term := 0 - term * x * x / ((2 * k) * (2 * k + 1))
        s := s + term
        k := k + 1
    }
    return s
}
def cos_(x) { return sin_(HALF_PI - x) }
def tan_(x) { return sin_(x) / cos_(x) }
def sinh_(t) {
    if (abs(t) < 0.5) {               # 桁落ちを避ける級数
        t2 := t * t
        return t * (1 + t2 / 6 * (1 + t2 / 20 * (1 + t2 / 42 * (1 + t2 / 72 * (1 + t2 / 110)))))
    }
    return (exp(t) - exp(0 - t)) / 2
}
def cosh_(t) { return (exp(t) + exp(0 - t)) / 2 }
def atan_(z) {
    neg := false  inv := false
    if (z < 0) { z := 0 - z  neg := true }
    if (z > 1) { z := 1 / z  inv := true }
    z := z / (1 + sqrt(1 + z * z))    # 半角に二度縮約: |z| <= tan(pi/16)
    z := z / (1 + sqrt(1 + z * z))
    s := 0.0  t := z  k := 0  sg := 1
    while (k < 18) { s := s + sg * t / (2 * k + 1)  t := t * z * z  sg := 0 - sg  k := k + 1 }
    s := 4 * s
    if (inv) { s := HALF_PI - s }
    if (neg) { s := 0 - s }
    return s
}
def log1p_(z) {
    if (abs(z) > 0.01) { return log(1 + z) }
    return z * (1 - z * (1/2 - z * (1/3 - z * (1/4 - z * (1/5 - z * (1/6 - z * (1/7 - z * (1/8 - z / 9))))))))
}
def log2_(x)  { return log(x) / LN2 }
def log10_(x) { return log(x) / LN10 }

# ---- 階乗・二項 ----------------------------------------------------------
def fact_(n) { r := 1.0  k := 2  while (k <= n) { r := r * k  k := k + 1 }  return r }
def binom_(n, k) {                    # C(n,k) 整数
    if (k < 0) { return 0 }  if (k > n) { return 0 }
    r := 1.0  j := 0
    while (j < k) { r := r * (n - j) / (j + 1)  j := j + 1 }
    return round_(r)
}
def binom_gen(s, k) {                 # 一般二項係数 C(s+k-1, k) = Γ(s+k)/(Γ(s) k!)
    p := 1.0  j := 0
    while (j < k) { p := p * (s + j)  j := j + 1 }
    return p / fact_(k)
}

# ---- Γ 関数族 (Lanczos g=7, n=9 / 反射公式) -------------------------------
LANCZOS := [0.99999999999980993, 676.5203681218851, -1259.1392167224028,
            771.32342877765313, -176.61502916214059, 12.507343278686905,
            -0.13857109526572012, 0.0000099843695780195716,
            0.00000015056327351493116]
def log_gamma_pos(z) {                # z >= 0.5
    zz := z - 1  a := LANCZOS[0]  t := zz + 7.5  i := 1
    while (i < 9) { a := a + LANCZOS[i] / (zz + i)  i := i + 1 }
    return 0.5 * log(TWO_PI) + (zz + 0.5) * log(t) - t + log(a)
}
def log_gamma(z) {                    # log |Γ(z)|
    if (z >= 0.5) { return log_gamma_pos(z) }
    return log(PI / abs(sin_(PI * z))) - log_gamma_pos(1 - z)
}
def gamma_(z) {                       # Γ(z) 符号つき
    if (z >= 0.5) { return exp(log_gamma_pos(z)) }
    return PI / (sin_(PI * z) * exp(log_gamma_pos(1 - z)))
}
def inv_gamma(z) {                    # 1/Γ(z) 整関数 (非正整数で 0)
    if (z > 0.5) { return exp(0 - log_gamma_pos(z)) }
    return exp(log_gamma_pos(1 - z)) * sin_(PI * z) / PI
}
def log_beta(p, q) { return log_gamma(p) + log_gamma(q) - log_gamma(p + q) }
def beta_(p, q)    { return exp(log_beta(p, q)) }
def digamma_(z) {                     # ψ(z): 漸化式で z >= 10 に上げて漸近展開
    r := 0.0
    while (z < 10) { r := r - 1 / z  z := z + 1 }
    f := 1 / (z * z)
    return r + log(z) - 0.5 / z - f * (1/12 - f * (1/120 - f * (1/252 - f * (1/240 - f / 132))))
}

# ---- Bernoulli 数と多項式 ----------------------------------------------------
BERN := [1, -0.5, 1/6, 0, -1/30, 0, 1/42, 0, -1/30, 0, 5/66, 0, -691/2730, 0, 7/6, 0, -3617/510]
B2K  := [1/6, -1/30, 1/42, -1/30, 5/66, -691/2730, 7/6, -3617/510]
def bernoulli_poly(n, x) {            # B_n(x) = Σ C(n,k) B_k x^{n-k}
    s := 0.0  k := 0
    while (k <= n) { s := s + binom_(n, k) * BERN[k] * pow_(x, n - k)  k := k + 1 }
    return s
}

# ---- Hurwitz ζ(s,a) — Euler–Maclaurin (s != 1 の全域で解析接続として妥当) ----
def hurwitz_nk(s, a, N, K) {
    tot := 0.0  n := 0
    while (n < N) { tot := tot + pow_(n + a, 0 - s)  n := n + 1 }
    A := N + a
    tot := tot + pow_(A, 1 - s) / (s - 1) + 0.5 * pow_(A, 0 - s)
    k := 1
    while (k <= K) {
        p := 1.0  j := 0
        while (j < 2 * k - 1) { p := p * (s + j)  j := j + 1 }
        tot := tot + B2K[k - 1] / fact_(2 * k) * p * pow_(A, 0 - s - 2 * k + 1)
        k := k + 1
    }
    return tot
}
def hurwitz(s, a)      { return hurwitz_nk(s, a, 30, 8) }
def zeta_r(s)          { return hurwitz(s, 1.0) }                 # Riemann ζ
def dirichlet_beta(s)  { return pow_(4, 0 - s) * (hurwitz(s, 0.25) - hurwitz(s, 0.75)) }

# ---- 二重指数節点 (Takahasi–Mori, ロジスティック変換) -------------------------
#   u_k = σ(π sinh(k h)),  w_k = π cosh(k h) h,  h = 2^-5, |k| <= 195 -> 391 節点
#   節点表は (log u, log(1-u), log w) の三つ組で持つ。
def de_nodes(h, kmax) {
    LU := []  LV := []  LW := []
    k := 0 - kmax
    while (k <= kmax) {
        t := k * h
        s := PI * sinh_(t)
        if (s < 700) { if (s > -700) {
            lu := 0.0  lv := 0.0
            if (s >= 0) {
                e := exp(0 - s)
                lu := 0 - log1p_(e)
                lv := (0 - s) - log1p_(e)
            } else {
                e := exp(s)
                lu := s - log1p_(e)
                lv := 0 - log1p_(e)
            }
            if (lu < 0) {
                LU <- lu
                LV <- lv
                LW <- log(PI * cosh_(t) * h)
            }
        } }
        k := k + 1
    }
    return [LU, LV, LW]
}
def de_default() { return de_nodes(0.03125, 195) }

# Σ_k w_k (1-u_k) u_k^{n+y} (log 1/u_k)^{s-1} = Γ(s)/(n+y)^s
def de_moment(nd, s, y, n) {
    LU := nd[0]  LV := nd[1]  LW := nd[2]
    acc := 0.0  i := 0
    while (i < len(LU)) {
        lu := LU[i]
        c := LW[i] + (s - 1) * log(0 - lu) + LV[i] + (n + y) * lu
        if (c > -700) { acc := acc + exp(c) }
        i := i + 1
    }
    return acc
}
# Σ_k w_k u_k^{y} (log 1/u_k)^{s-1} = Γ(s) ζ(s,y)   (1/(1-u) はヤコビアンと相殺)
def de_gamma_zeta(nd, s, y) {
    LU := nd[0]  LW := nd[2]
    acc := 0.0  i := 0
    while (i < len(LU)) {
        lu := LU[i]
        c := LW[i] + (s - 1) * log(0 - lu) + y * lu
        if (c > -700) { acc := acc + exp(c) }
        i := i + 1
    }
    return acc
}
def zeta_de(nd, s, y)   { return exp(log(de_gamma_zeta(nd, s, y)) - log_gamma(s)) }
def zeta_V(nd, x, y, V) { return zeta_de(nd, x, y) - zeta_de(nd, x, y + V) }   # 離散 Newton–Leibniz

# ---- 修正核  ζ(x,y) = B(y,x−1)·Λ(x,y),  Λ = E_Beta(y,x−1)[κ^{x−1}]/Γ(x) ------
def kappa_(u) {                       # κ(u) = log(1/u)/(1−u) = 情報量 ÷ 残余質量
    if (1 - u < 0.000000000001) { e := 1 - u  return 1 + e / 2 + e * e / 3 }
    return (0 - log(u)) / (1 - u)
}
def lambda_de(nd, x, y) { return exp(log(zeta_de(nd, x, y)) - log_beta(y, x - 1)) }
def lambda_em(x, y)     { return hurwitz(x, y) / beta_(y, x - 1) }
def poch_ratio(x, y) {                # Γ(x+y−1)/Γ(x−1) (y が正整数なら多項式で厳密)
    if (is_int(y)) { if (y >= 1) {
        k := round_(y)  p := 1.0  j := 0
        while (j < k) { p := p * (x - 1 + j)  j := j + 1 }
        return p
    } }
    b := x + y - 1
    if (b > 0) { return gamma_(b) * inv_gamma(x - 1) }
    return inv_gamma(x - 1) * PI / (sin_(PI * b) * gamma_(1 - b))
}
def lambda_cont(x, y) { return hurwitz(x, y) * poch_ratio(x, y) / gamma_(y) }   # 解析接続版 Λ

# Zipf–Mandelbrot 分布 (未規格化): P(n) ∝ Σ_k w_k (1-u_k) u_k^{n+y} (log 1/u_k)^{x-1}
def zm_dist_raw(nd, x, y, V) {
    p := []  n := 0
    while (n < V) { p <- de_moment(nd, x, y, n)  n := n + 1 }
    return p
}
def zm_exact(x, y, V) {               # 厳密 (n+y)^{-x} を V 項で切って規格化
    p := []  n := 0
    while (n < V) { p <- pow_(n + y, 0 - x)  n := n + 1 }
    return dist(p)
}

# ---- 複素数 [re, im] (第十巻 Mellin 畳み込み・第十三巻 偏角原理で使う) ------------------
def atan2_(y, x) {
    if (x > 0) { return atan_(y / x) }
    if (x < 0) { if (y >= 0) { return atan_(y / x) + PI }  return atan_(y / x) - PI }
    if (y > 0) { return HALF_PI }
    if (y < 0) { return 0 - HALF_PI }
    return 0.0
}
def c_add(a, b)   { return [a[0] + b[0], a[1] + b[1]] }
def c_sub(a, b)   { return [a[0] - b[0], a[1] - b[1]] }
def c_mul(a, b)   { return [a[0] * b[0] - a[1] * b[1], a[0] * b[1] + a[1] * b[0]] }
def c_div(a, b)   { d := b[0] * b[0] + b[1] * b[1]  return [(a[0] * b[0] + a[1] * b[1]) / d, (a[1] * b[0] - a[0] * b[1]) / d] }
def c_scale(a, k) { return [a[0] * k, a[1] * k] }
def c_abs(a)      { return sqrt(a[0] * a[0] + a[1] * a[1]) }
def c_arg(a)      { return atan2_(a[1], a[0]) }
def c_exp(a)      { r := exp(a[0])  return [r * cos_(a[1]), r * sin_(a[1])] }
def c_log(a)      { return [log(c_abs(a)), atan2_(a[1], a[0])] }
def c_pow(a, z)   { return c_exp(c_mul(z, c_log(a))) }              # a^z (主値)
def c_powr(b, z)  { l := log(b)  return c_exp([z[0] * l, z[1] * l]) } # 実数 b > 0 の複素べき b^z
def c_sin(a)      { return [sin_(a[0]) * cosh_(a[1]), cos_(a[0]) * sinh_(a[1])] }
def c_gamma(z) {                       # 複素 Γ (Lanczos g=7, Re z < 1/2 は反射公式)
    if (z[0] < 0.5) {
        s := c_sin(c_scale(z, PI))
        return c_div([PI, 0], c_mul(s, c_gamma([1 - z[0], 0 - z[1]])))
    }
    zz := [z[0] - 1, z[1]]
    x := [LANCZOS[0], 0]  i := 1
    while (i < 9) { x := c_add(x, c_div([LANCZOS[i], 0], [zz[0] + i, zz[1]]))  i := i + 1 }
    t := [zz[0] + 7.5, zz[1]]
    return c_mul(c_mul(c_scale(c_pow(t, [zz[0] + 0.5, zz[1]]), SQRT_2PI), c_exp([0 - t[0], 0 - t[1]])), x)
}
def c_hurwitz(s, a, N, K) {            # 複素 s の Hurwitz ζ(s,a) (a 実、Euler–Maclaurin)
    tot := [0, 0]  n := 0
    while (n < N) { tot := c_add(tot, c_powr(n + a, [0 - s[0], 0 - s[1]]))  n := n + 1 }
    A := N + a
    tot := c_add(tot, c_div(c_powr(A, [1 - s[0], 0 - s[1]]), [s[0] - 1, s[1]]))
    tot := c_add(tot, c_scale(c_powr(A, [0 - s[0], 0 - s[1]]), 0.5))
    k := 1
    while (k <= K) {
        p := [1, 0]  j := 0
        while (j < 2 * k - 1) { p := c_mul(p, [s[0] + j, s[1]])  j := j + 1 }
        tot := c_add(tot, c_scale(c_mul(p, c_powr(A, [0 - s[0] - 2 * k + 1, 0 - s[1]])), B2K[k - 1] / fact_(2 * k)))
        k := k + 1
    }
    return tot
}

# ---- 配列補助 ---------------------------------------------------------------
def arr_zeros(n) { a := []  i := 0  while (i < n) { a <- 0.0  i := i + 1 }  return a }
def arr_fill(n, v) { a := []  i := 0  while (i < n) { a <- v  i := i + 1 }  return a }
def set_at(a, i, v) {
    b := []  k := 0
    while (k < len(a)) { if (k == i) { b <- v } else { b <- a[k] }  k := k + 1 }
    return b
}
def arr_copy(a)  { b := []  i := 0  while (i < len(a)) { b <- a[i]  i := i + 1 }  return b }
def arr_sum(a)   { s := 0.0  i := 0  while (i < len(a)) { s := s + a[i]  i := i + 1 }  return s }
def arr_max(a)   { m := a[0]  i := 1  while (i < len(a)) { if (a[i] > m) { m := a[i] }  i := i + 1 }  return m }
def arr_min(a)   { m := a[0]  i := 1  while (i < len(a)) { if (a[i] < m) { m := a[i] }  i := i + 1 }  return m }
def arr_maxabs(a){ m := 0.0  i := 0  while (i < len(a)) { if (abs(a[i]) > m) { m := abs(a[i]) }  i := i + 1 }  return m }
def arr_argmax(a){ m := 0  i := 1  while (i < len(a)) { if (a[i] > a[m]) { m := i }  i := i + 1 }  return m }
def arr_scale(a, c) { b := []  i := 0  while (i < len(a)) { b <- a[i] * c  i := i + 1 }  return b }
def arr_add(a, b)   { c := []  i := 0  while (i < len(a)) { c <- a[i] + b[i]  i := i + 1 }  return c }
def arr_dot(a, b)   { s := 0.0  i := 0  while (i < len(a)) { s := s + a[i] * b[i]  i := i + 1 }  return s }
def arr_maxdiff(a, b) {
    m := 0.0  i := 0
    while (i < len(a)) { d := abs(a[i] - b[i])  if (d > m) { m := d }  i := i + 1 }
    return m
}
def arr_maxrel(a, b) {               # max |a_i - b_i| / |b_i|
    m := 0.0  i := 0
    while (i < len(a)) { if (b[i] != 0) { d := abs(a[i] - b[i]) / abs(b[i])  if (d > m) { m := d } }  i := i + 1 }
    return m
}
def rel_err(got, want) { if (want == 0) { return abs(got) }  return abs(got - want) / abs(want) }
def arr_order_desc(a) {               # 値の降順の添字列 (選択ソート)
    idx := []  i := 0
    while (i < len(a)) { idx <- i  i := i + 1 }
    out := []  used := arr_fill(len(a), false)
    k := 0
    while (k < len(a)) {
        best := -1  j := 0
        while (j < len(a)) {
            if (!used[j]) { if (best < 0) { best := j } else { if (a[j] > a[best]) { best := j } } }
            j := j + 1
        }
        out <- best
        used := set_at(used, best, true)
        k := k + 1
    }
    return out
}
def shannon_(p) {                     # −Σ q log q  (x log x 核, 零は寄与ゼロ)
    h := 0.0  i := 0
    while (i < len(p)) { q := p[i]  if (q > 0) { h := h - q * log(q) }  i := i + 1 }
    return h
}

# ---- 表示 (組み込みは f5 / sci のみ。桁を選べる固定小数を自作) ------------------
def fx(x, d) {
    if (x != x) { return "nan" }
    if (x > 1e300) { return "inf" }
    if (x < -1e300) { return "-inf" }
    s := ""
    if (x < 0) { s := "-"  x := 0 - x }
    x := x + 0.5 * pow_(10, 0 - d)
    ip := floor_(x)  fr := x - ip
    s := s + ip
    if (d > 0) { s := s + "." }
    k := 0
    while (k < d) { fr := fr * 10  dg := floor_(fr)  if (dg > 9) { dg := 9 }  s := s + dg  fr := fr - dg  k := k + 1 }
    return s
}
def f3(x)  { return fx(x, 3) }
def f8(x)  { return fx(x, 8) }
def f10(x) { return fx(x, 10) }
def f12(x) { return fx(x, 12) }
def arr_str(a) {                      # 配列を "[a, b, c]" の文字列に (文字列連結では配列が潰れるため)
    s := "["  i := 0
    while (i < len(a)) { if (i > 0) { s := s + ", " }  s := s + a[i]  i := i + 1 }
    return s + "]"
}
def bstr(b)    { if (b) { return "true" }  return "false" }   # 真偽値を文字列連結すると潰れるため
def pad(s, n)  { s := "" + s  while (len(s) < n) { s := " " + s }  return s }
def padr(s, n) { s := "" + s  while (len(s) < n) { s := s + " " }  return s }

# ---- 検査台帳 -------------------------------------------------------------------
#   関数の中から大域の数を書き換えられないので、結果は配列 CHECKS に積み、
#   同時に追記専用台帳 tuplespace へ ["check", label, ok] として commit する。
CHECKS := []
def check(label, ok) {
    if (ok) { print("  [OK] " + label) } else { print("  [NG] " + label) }
    fact := ["check", label, ok]      # 改行は文の区切りではないので、配列リテラルは束縛してから commit する
    fact >> tuplespace
    CHECKS <- ok
    return ok
}
def check_close(label, got, want, tol) {
    err := abs(got - want)
    return check(label + "  got " + fx(got, 10) + "  want " + fx(want, 10) + "  |err| " + sci(err) + " <= " + sci(tol), err <= tol)
}
def check_rel(label, got, want, tol) {
    err := rel_err(got, want)
    return check(label + "  got " + fx(got, 10) + "  want " + fx(want, 10) + "  rel " + sci(err) + " <= " + sci(tol), err <= tol)
}
def checks_failed() {
    n := 0  i := 0
    while (i < len(CHECKS)) { if (!CHECKS[i]) { n := n + 1 }  i := i + 1 }
    return n
}
def verdict(sentinel) {
    total := len(CHECKS)  bad := checks_failed()
    print("")
    print("---- 検査 " + (total - bad) + " / " + total + " 合格  (台帳 " + len(tuplespace) + " facts) ----")
    if (bad == 0) { print(sentinel) } else { print("@@FAILED " + bad + " check(s)") }
}
def section(title) {
    print("")
    print("================================================================")
    print(title)
    print("================================================================")
}


# ================= 10_zeta_category.bada =================
# ============================================================
# 10_zeta_category.bada -- 第十巻
# ゼータ関数の圏 — 一般相対性理論と量子力学はどこまで ζ の中にあるか
# — 極が古典、原点が量子、そして積は畳み込みになる —
#
#   定理1 Mellin 対応  Γ(s)ζ_A(s) = ∫₀^∞ t^{s−1}(θ_A(t) − n₀) dt
#   定理2 極 = 一般相対性理論: Res_{s=(n−k)/2} ζ_A = a_k/Γ((n−k)/2)。単位 S⁴ で Res_{s=1} = a_1 = 1/3 (Einstein–Hilbert)
#   定理3 原点 = 量子力学: W = −½ζ'(0)。周長 L の円周で det_ζ Δ = L²
#   定理4 スペクトル作用 Tr f(Δ/Λ²) = c₃a₀Λ³ + c₁a₁Λ + f(0)(n₀+ζ(0)) + O(1/Λ)  (S³, f = (1+u)^{−4})
#   命題5 直和について ζ は厳密な準同型 ζ_{⊕m_jA_j} = Σ m_j ζ_{A_j}
#   定理6 積は Mellin 畳み込みになる: ζ_{M×N} = ζ_M + ζ_N + (2πi)^{−1}∮Γ(z)ζ_M(z)Γ(s−z)ζ_N(s−z)dz/Γ(s)
#   定理7 ζ : (楕円作用素, ⊕, ×) → (有理型関数, +, ∗_Mellin) は半環準同型
#   定理8 Riemann の ζ そのもの: ζ_{S¹,L}(s) = 2(L/2π)^{2s}ζ_R(2s), Casimir E = (2π/L)ζ_R(−1) = −π/(6L)
#   第V部 入らないもの六つ (a)〜(f) と、外縁としての Hilbert–Pólya 予想
# ============================================================

section("第十巻  ゼータ関数の圏 — 極が古典、原点が量子、そして積は畳み込みになる")

@reviser : grammar < Omega::DATABASE[grammar].mechanism {
    rule "pole"     postfix [ 'pole'     '(' expr ')' ]          => residue_S4(_1)              # 定理2
    rule "origin"   postfix [ 'origin'   '(' expr ')' ]          => zeta_det_S1(_1)             # 定理3
    rule "action"   postfix [ 'action'   '(' expr ')' ]          => spectral_action_S3(_1)      # 定理4
    rule "convolve" stmt    [ 'convolve' '(' expr ')' ]          => commit_measurement(convolve_fact(_1))   # 定理6
}
print("grammar rules committed :", len(tuplespace), "facts (pole / origin / action / convolve)")

# ---- 球面のスペクトルゼータ (実引数) --------------------------------------------------------------------------------
def zeta_S1(s, L) { return 2 * pow_(L / TWO_PI, 2 * s) * zeta_r(2 * s) }          # 定理8: 固有値 (2πn/L)², n ≥ 1, 重複度 2
def zeta_S2(s) { tot := 0.0  k := 0  while (k < 80) { tot := tot + binom_gen(s, k) * pow_(4, 0 - k) * hurwitz_nk(2 * s + 2 * k - 1, 1.5, 40, 8)  k := k + 1 }  return 2 * tot }
def zeta_S3(s) { tot := 0.0  k := 0  while (k < 90) { tot := tot + binom_gen(s, k) * hurwitz_nk(2 * s + 2 * k - 2, 2.0, 40, 8)  k := k + 1 }  return tot }
def zeta_S4(s) {                                  # λ = ℓ(ℓ+3) = ν² − 9/4, d = (ν³ − ν/4)/3, ν = ℓ + 3/2
    tot := 0.0  k := 0
    while (k < 110) {
        tot := tot + binom_gen(s, k) * pow_(2.25, k) * (hurwitz_nk(2 * s + 2 * k - 3, 2.5, 40, 8) - 0.25 * hurwitz_nk(2 * s + 2 * k - 1, 2.5, 40, 8))
        k := k + 1
    }
    return tot / 3
}

# ---- 第I部  定理2: 極 = Einstein–Hilbert --------------------------------------------------------------------------------
section("第I部  定理2  極 = 古典幾何: Res_{s=(n−k)/2} ζ_Δ(s) = a_k/Γ((n−k)/2)。n = 4, s = 1 の留数は (4π)^{−2}(1/6)∫R√g d⁴x")
def residue_S4(eps) { return eps * zeta_S4(1 + eps) }
a1_S4 := pow_(4 * PI, -2) * (12 / 6) * (8 * PI * PI / 3)          # 単位 S⁴: R = 12, Vol = 8π²/3 → 1/3
a0_S4 := (8 * PI * PI / 3) / pow_(4 * PI, 2)                      # = 1/6 (体積項 = 宇宙定数項)
print("  幾何側: a_1 = (4π)^{−2}·(R/6)·Vol = (16π²/3)/(16π²) =", fx(a1_S4, 12), " (= 1/3)")
print("  解析側: ζ_S⁴(s) = (1/3)Σ_k C(s+k−1,k)(9/4)^k[ζ(2s+2k−3, 5/2) − ¼ζ(2s+2k−1, 5/2)]; s = 1 の留数 = (1/3)[(9/4)(1/2)] + (1/3)[(−1/4)(1/2)] = 3/8 − 1/24 = 1/3")
print("  ε          ε·ζ_S⁴(1+ε)       a_1 = 1/3 との差    判定")
eps := 0.01  t2_ok := true  prev := 1.0
while (eps > 0.000005) {
    v := pole(eps)
    d := abs(v - 1 / 3)
    if (d > 0.52 * eps) { t2_ok := false }                          # 誤差は ε に比例 (単純極) : 0.504 ε
    if (d > prev) { t2_ok := false }
    prev := d
    print("  " + padr(eps, 9) + "  " + fx(v, 12) + "     " + pad(sci(d), 9) + "        誤差 ∝ ε (各行ちょうど 1/10)")
    eps := eps / 10
}
check("定理2  ε·ζ_S⁴(1+ε) → 1/3、誤差が ε に完全比例 (単純極であることと留数の値を同時に確認)", t2_ok)
r2 := 0.0001 * zeta_S4(2 + 0.0001)
print("  s = 2 の留数 (体積項 a_0 = Vol/(4π)² = 1/6): ε = 1e-4 で", fx(r2, 9), "  差", sci(abs(r2 - a0_S4)))
check_close("定理2  Res_{s=2} ζ_S⁴ = a_0 = 1/6 (宇宙定数項)", r2, 1 / 6, 0.00001)
print("  一般相対性理論の作用は、ゼータ関数の解析接続における特異部 — ζ_Δ(s) の s = 1 まわりの Laurent 展開の 1/(s−1) の係数 — である。")

section("定理3  原点 = 量子: W = −½ζ'(0)、周長 L の円周で det_ζ Δ_{S¹} = L²")
def zeta_det_S1(L) {                              # ζ'(0) を中心差分 + Richardson (h = 1e-4)
    h := 0.0001
    d1 := (zeta_S1(h, L) - zeta_S1(0 - h, L)) / (2 * h)
    d2 := (zeta_S1(h / 2, L) - zeta_S1(0 - h / 2, L)) / h
    return exp(0 - (4 * d2 - d1) / 3)
}
print("  L           ζ(0)            −ζ'(0) = log det    det_ζ Δ           L² (厳密)        差")
LS := [1.0, TWO_PI, 5.0, 10.0]
t3_ok := true  i := 0
while (i < 4) {
    L := LS[i]
    z0 := (zeta_S1(0.0001, L) + zeta_S1(-0.0001, L)) / 2
    det := origin(L)
    if (abs(det - L * L) > 0.000001 * L * L) { t3_ok := false }
    if (abs(z0 + 1) > 0.000001) { t3_ok := false }
    print("  " + padr(fx(L, 5), 10) + "  " + fx(z0, 10) + "    " + pad(fx(log(det), 12), 16) + "    " + pad(fx(det, 10), 15) + "   " + pad(fx(L * L, 10), 15) + "   " + sci(abs(det - L * L)))
    i := i + 1
}
check("定理3  det_ζ Δ_{S¹} = L² (rel <= 1e-6)、ζ(0) = −1 は L に依らない (位相)、ζ'(0) = −2 log L は L に依る (幾何)", t3_ok)
print("  極 (s > 0 の特異点) = 熱核係数 = 局所的・幾何的 = 古典重力;  ζ(0) = 大域的・離散 = 位相;  ζ'(0) = log det = 大域的・連続 = 量子 (1 ループ)。")

# ---- 第II部  スペクトル作用 ---------------------------------------------------------------------------------------------
section("第II部  定理4  スペクトル作用 Tr f(Δ/Λ²) の漸近展開 — 一つの ζ から宇宙定数・Einstein–Hilbert・量子補正が同時に出る")
a0_S3 := 2 * PI * PI / pow_(4 * PI, 1.5)  a1_S3 := a0_S3          # 単位 S³: Vol = 2π², R = 6 → a_1 = a_0·R/6 = a_0
c3 := gamma_(2.5) / 6  c1 := gamma_(3.5) / 6                      # f̃(z) = B(z, 4−z) = Γ(z)Γ(4−z)/6:  f̃(3/2)/Γ(3/2) = √π/8, f̃(1/2)/Γ(1/2) = 5√π/16
def spectral_action_S3(Lam) {                     # Σ_{ℓ≥0} (ℓ+1)² (1 + ℓ(ℓ+2)/Λ²)^{−4}  (項が相対 1e-16 を下回るまで)
    L2 := Lam * Lam  tot := 0.0  l := 0  go := true
    while (go) {
        t := (l + 1) * (l + 1) * pow_(1 + l * (l + 2) / L2, -4)
        tot := tot + t
        if (l > 50) { if (t < 0.0000000000000001 * tot) { go := false } }
        l := l + 1
        if (l > 400000) { go := false }
    }
    return tot
}
print("  f(u) = (1+u)^{−4} (熱核 e^{−u} ではないので検証は自明な循環にならない)。予測: " + fx(c3 * a0_S3, 10) + "·Λ³ + " + fx(c1 * a1_S3, 10) + "·Λ + f(0)(n₀ + ζ_S³(0)) = 0 + O(1/Λ)")
print("  Λ       Tr f(Δ/Λ²) (実測)      漸近予測 (11)          残差          残差 × Λ")
LAMS := [10.0, 20.0, 40.0, 80.0, 160.0]
RESL_PAPER := [0.436047, 0.431131, 0.429918, 0.429613, 0.429481]
t4_ok := true  i := 0
while (i < 5) {
    Lam := LAMS[i]
    lhs := action(Lam)
    pred := c3 * a0_S3 * Lam * Lam * Lam + c1 * a1_S3 * Lam + 1.0 * (1 + (-1))
    res := lhs - pred
    if (abs(res * Lam - RESL_PAPER[i]) > 0.0002) { t4_ok := false }
    print("  " + padr(fx(Lam, 0), 6) + "  " + pad(fx(lhs, 8), 20) + "   " + pad(fx(pred, 8), 20) + "   " + pad(sci(res), 9) + "     " + fx(res * Lam, 6))
    i := i + 1
}
check("定理4  残差 × Λ が 0.4360 → 0.4295 と一定値に収束 (残差は厳密に O(1/Λ))、論文値と 2e-4 以内", t4_ok)
print("  Λ³ 項: a₀ ∝ Vol — 宇宙定数項。  Λ¹ 項: a₁ ∝ ∫R dV — Einstein–Hilbert。  Λ⁰ 項: f(0)ζ_Δ(0) — 1 ループ量子補正。")
print("  定数項が 0 になるのは n₀ + ζ_S³(0) = 1 + (−1) = 0 — 第九巻の「3 次元では ζ(0) = −1」が、ここでは量子補正項の消失という物理的内容を持つ。")
print("  Connes との距離: 検証したのは可換部分 (重力項) だけであり、既知の定理の再確認。本枠組みが付け加えたものは現時点で無い。")

# ---- 第III部  準同型の正確な形 ------------------------------------------------------------------------------------------
section("第III部  命題5  直和について ζ は厳密な準同型 ζ_{3S² ⊕ 2S¹}(3) = 3ζ_S²(3) + 2ζ_S¹(3)")
s := 3.0
zS2 := zeta_S2(s)  zS1 := zeta_S1(s, TWO_PI)
direct := 0.0  l := 1
while (l <= 40000) { direct := direct + 3 * (2 * l + 1) * pow_(l * (l + 1), 0 - s)  l := l + 1 }
n := 1
while (n <= 40000) { direct := direct + 2 * 2 * pow_(n * n, 0 - s)  n := n + 1 }
print("  ζ_S²(3) =", fx(zS2, 12), "  ζ_S¹(3) (周長 2π) =", fx(zS1, 12))
print("  直和スペクトルから直接 (4×10⁴ 項) =", fx(direct, 12), "   3ζ_S² + 2ζ_S¹ =", fx(3 * zS2 + 2 * zS1, 12), "   相対差", sci(rel_err(direct, 3 * zS2 + 2 * zS1)))
check_rel("命題5  直和準同型 (直接和の打ち切り 4×10⁴ 項の範囲で一致、rel <= 1e-9)", direct, 3 * zS2 + 2 * zS1, 0.000000001)
print("  本枠組みの HΨ = ⊕(iℏ∇)^⊕L の「⊕」は、まさに ζ が厳密に準同型となる唯一の演算 — 準同型域の指定である。")

section("定理6  積は Mellin 畳み込みになる: ζ_{M×N}(s) = ζ_M(s) + ζ_N(s) + (2πi)^{−1}∫Γ(z)ζ_M(z)Γ(s−z)ζ_N(s−z)dz / Γ(s)")
def c_binom_gen(s, k) { p := [1, 0]  j := 0  while (j < k) { p := c_mul(p, [s[0] + j, s[1]])  j := j + 1 }  return c_scale(p, 1 / fact_(k)) }
def c_zeta_S2(s) {                                # 複素 s の ζ_S²: 2 Σ_k C(s+k−1,k) 4^{−k} ζ(2s+2k−1, 3/2)
    tot := [0, 0]  k := 0
    while (k < 24) {
        tot := c_add(tot, c_scale(c_mul(c_binom_gen(s, k), c_hurwitz([2 * s[0] + 2 * k - 1, 2 * s[1]], 1.5, 50, 8)), pow_(0.25, k)))
        k := k + 1
    }
    return c_scale(tot, 2)
}
def c_zeta_S1(s) { return c_scale(c_hurwitz([2 * s[0], 2 * s[1]], 1.0, 60, 8), 2) }   # 周長 2π
def conv_integrand(y, s, c) {                     # Γ(c+iy) ζ_S²(c+iy) Γ(s−c−iy) ζ_S¹(s−c−iy)
    z := [c, y]  w := [s - c, 0 - y]
    return c_mul(c_mul(c_gamma(z), c_zeta_S2(z)), c_mul(c_gamma(w), c_zeta_S1(w)))
}
def mellin_convolution(s, c, T, n) {              # (1/2π)∫_{−T}^{T} g(y) dy / Γ(s);  g(−y) = conj g(y) なので [0, T] の実部 × 2
    # 被積分関数は幅 d = c−1 = 1/2 の帯で解析的 (ζ_S² の極 z = 1) かつ e^{−π|y|} で減衰するので、台形則が e^{−2πd/h} で指数収束する。
    h := T / n  g0 := conv_integrand(0.0, s, c)  re_acc := g0[0] / 2  im_acc := 0.0  i := 1
    while (i <= n) { g := conv_integrand(i * h, s, c)  re_acc := re_acc + g[0]  im_acc := im_acc + g[1]  i := i + 1 }
    return [2 * (re_acc * h) / TWO_PI / gamma_(s), im_acc]
}
def zeta_prod_direct(s, LMAX, NMAX) {             # ζ_{S²×S¹}(s) を積多様体のスペクトル ℓ(ℓ+1) + n² から直接 (第九巻と同じ)
    tot := 0.0  n := 1
    while (n <= NMAX) { tot := tot + 2 * pow_(n * n, 0 - s)  n := n + 1 }
    l := 1
    while (l <= LMAX) {
        mu := l * (l + 1)  inner := pow_(mu, 0 - s)  n := 1
        while (n <= NMAX) { inner := inner + 2 * pow_(mu + n * n, 0 - s)  n := n + 1 }
        tot := tot + (2 * l + 1) * inner
        l := l + 1
    }
    return tot + (PI / 4) * pow_(LMAX, -3.0)
}
def convolve_fact(s) { cv := mellin_convolution(s, 1.5, 12.0, 96)  return dist([zeta_S2(s) + zeta_S1(s, TWO_PI) + cv[0]]) }
print("  積分路 Re z = c = 3/2 (1 < c < s − 1/2 = 5/2)、被積分関数は Γ(3/2+iy)Γ(3/2−iy) ~ e^{−π|y|} で減衰 → |y| <= 12 (切り捨て e^{−38})。")
print("  複素 Hurwitz ζ は Euler–Maclaurin (N = 60, K = 8)、複素 Γ は Lanczos。台形則 h = 0.125 (解析帯幅 1/2 → 誤差 ~e^{−8π} ≈ 1e-11)。")
cv := mellin_convolution(s, 1.5, 12.0, 96)
zP := zeta_prod_direct(s, 800, 200)
total := zS2 + zS1 + cv[0]
print("  ζ_S²(3)                       =", fx(zS2, 10))
print("  ζ_S¹(3)                       =", fx(zS1, 10))
print("  積公式 ζ_S²·ζ_S¹              =", fx(zS2 * zS1, 10), "   相対誤差", fx(abs(zS2 * zS1 - zP) / zP, 2), " ← 誤り")
print("  畳み込み項 (第 3 項)          =", fx(cv[0], 10), "   (g(−y) = conj g(y) なので全区間の積分は実数; 片側の実部 × 2 を用いた)")
print("  (14) の右辺合計               =", fx(total, 10))
print("  スペクトル直接和 (ℓ<=800)     =", fx(zP, 10), "   相対差", sci(rel_err(total, zP)), " ← 一致")
check("定理6  積公式は 70% ずれる (|ζ_Mζ_N − ζ_{M×N}|/ζ_{M×N} > 0.5)", abs(zS2 * zS1 - zP) / zP > 0.5)
check_rel("定理6  畳み込み公式とスペクトル直接和が一致 (rel <= 1e-7; 直接和の尾部補正が残差を支配)", total, zP, 0.0000001)
led0 := len(tuplespace)
convolve(3.0)
check("convolve 規則が ζ_{S²×S¹}(3) を台帳へ commit", len(tuplespace) == led0 + 1)
print("  定理7: 有理型関数に Mellin 畳み込み (F∗G)(s) = (2πi)^{−1}∫F(z)G(s−z)dz を積として入れると ζ : (Ell, ⊕, ×) → (Mer, +, ∗) は半環準同型。")
print("  完備化 ξ_M(s) := Γ(s)ζ_M(s) + Γ(s) (全熱跡の Mellin 変換) を使えば ξ_{M×N} = ξ_M ∗ ξ_N と純粋な積の形になる。")
print("  前巻の「準同型ではない」は維持 (点ごとの積としては偽)。誤っていたのは「積とは何か」の側であった。")

# ---- 第IV部  Riemann の ζ そのもの --------------------------------------------------------------------------------------
section("第IV部  定理8  Riemann の ζ が物理量になる場所: ζ_{S¹,L}(s) = 2(L/2π)^{2s}ζ_R(2s),  Casimir E = (2π/L)ζ_R(−1) = −π/(6L)")
def zeta_S1_direct(s, L, N) { tot := 0.0  n := 1  while (n <= N) { tot := tot + 2 * pow_(TWO_PI * n / L, 0 - 2 * s)  n := n + 1 }  return tot }
print("  L          s    ζ_{S¹}(s) 直接 (5×10⁴ 項)   2(L/2π)^{2s}ζ_R(2s)    差")
t8_ok := true  i := 0
T8 := [[TWO_PI, 2.0], [TWO_PI, 4.0], [3.0, 2.0], [3.0, 4.0]]
while (i < 4) {
    L := T8[i][0]  s := T8[i][1]
    a := zeta_S1_direct(s, L, 50000)  b := zeta_S1(s, L)
    tailb := 2 * pow_(TWO_PI / L, 0 - 2 * s) * pow_(50000, 1 - 2 * s) / (2 * s - 1)
    if (abs(a - b) > 1.5 * tailb + 0.000000000001) { t8_ok := false }
    print("  " + padr(fx(L, 5), 9) + "  " + fx(s, 0) + "    " + pad(fx(a, 12), 18) + "          " + pad(fx(b, 12), 18) + "   " + sci(abs(a - b)))
    i := i + 1
}
check("定理8  ζ_{S¹,L}(s) = 2(L/2π)^{2s}ζ_R(2s) (直接和の尾部の範囲で一致)", t8_ok)
check_close("定理8  L = 3, s = 2: 2(3/2π)⁴ζ(4) = 162/1440 = 0.1125 ちょうど", zeta_S1(2.0, 3.0), 0.1125, 0.000000000000001)
zm1 := zeta_r(-1)
print("  ζ_R(−1) =", fx(zm1, 12), " (−1/12)   Casimir E(L=1) = 2π·ζ_R(−1) =", fx(TWO_PI * zm1, 12), " = −π/6 =", fx(0 - PI / 6, 12), "   E(L=2) =", fx(PI * zm1, 12), " = −π/12")
check_close("定理8  E(L=1) = −π/6", TWO_PI * zm1, 0 - PI / 6, 0.000000000000001)
print("  量子場の真空エネルギーは Riemann ゼータ関数の負整数値そのもの。弦理論の臨界次元 26 が ζ_R(−1) = −1/12 から出るのは、まさにこの計算。")
print("  Epstein ゼータ: 平坦トーラス R^n/Λ のスペクトルゼータは双対格子の Epstein ゼータ。n = 2 正方格子では 4ζ_R(s)β(s) — この β は Dirichlet β であって Euler β (第二巻の B) ではない。")

# ---- 第V部  入らないもの -----------------------------------------------------------------------------------------------
section("第V部  ζ の範疇に入らないもの — 六つの壁と外縁")
WALLS := [["(a) 背景独立性", "計量 g がスペクトルの入力である限り、重力は量子化されていない", "動かず"],
          ["(b) 拘束代数", "微分同相不変性・Wheeler–DeWitt 方程式に対応する構造がない", "動かず"],
          ["(c) 非繰り込み可能性", "純粋重力は二ループで発散。ζ 正則化は 1 ループしか救わない", "動かず"],
          ["(d) 等スペクトル性", "スペクトルは計量を決めない (Milnor の 16 次元対)", "第八巻で確定"],
          ["(e) ζ(0) の縮退", "3 次元以上で ζ(0) が位相情報を失う (常に −1)", "第九巻で確定"],
          ["(f) 新規: ローレンツ符号", "熱跡 e^{−tΔ} は楕円性を要求する。ローレンツ計量では熱核が存在しない (Wick 回転は一般に well-defined でない)", "本巻で明示"]]
i := 0
while (i < 6) { fact := ["wall", WALLS[i][0], WALLS[i][1], WALLS[i][2]]  fact >> tuplespace  print("  " + padr(WALLS[i][0], 26) + padr(WALLS[i][1], 70) + WALLS[i][2])  i := i + 1 }
fact := ["frontier", "Hilbert–Pólya 予想", "Riemann ζ の非自明零点の虚部を固有値とする自己共役作用素の存在 — 逆方向 (ζ → 作用素) は未解決", "未解決"]
fact >> tuplespace
print("  外縁: 物理から ζ へは行ける (写像 (16))。ζ から物理へ戻る道は、Riemann の ζ については Hilbert–Pólya 予想として未解決。")
check("第V部  六つの壁と外縁 (Hilbert–Pólya) が台帳に commit された", len(tuplespace) >= led0 + 8)

section("結論 (第十巻)")
print("  GR はゼータの極 (発散部・古典) にあり、QM はゼータの原点 (有限部・量子) にある。両者は一つの有理型関数の異なる読み取り位置。")
print("  準同型は ⊕ で厳密に成立し、× は Mellin 畳み込みに写る。ここを点ごとの積と取り違えると 70% ずれる。")
print("  Riemann の ζ 自身は 1 次元 (円周) で物理量になる。逆方向の写像 (ζ → 作用素) が、この圏の外縁である。")
verdict("@@PAPER-10-OK")
