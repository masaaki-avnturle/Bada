# ---- generated: 00_prelude.bada + 11_vacuum_analyzer.bada (tools/run-papers.js) ----
# ============================================================
# 00_prelude.bada -- BadaGPT 未知事前エンジン論文集 / 共通核
#
# 量子プログラミング言語 Bada の組み込みは softmax / entropy /
# unknown_prior / update / cognitive_system / dist / zeros_of /
# maxdiff / len / sqrt / log / exp / abs / f5 / sci と、量子部分言語
# qubit / H / X / S / T / Rz / CNOT / Measure / commit_measurement、
# 追記専用台帳 tuplespace だけである。床関数も三角関数も Γ も ζ も
# 無い。この核でそれを全部こしらえ、各巻はこの上に乗る。
#
#   数値      floor_ round_ pow_ ipow sin_ cos_ atan_ sinh_ cosh_ log1p_
#   Γ 族      log_gamma gamma_ inv_gamma log_beta beta_ digamma_
#   Bernoulli BERN bernoulli_poly
#   Hurwitz ζ hurwitz (Euler–Maclaurin)  zeta_r  dirichlet_beta
#   二重指数  de_default de_gamma_zeta zeta_de lambda_de zeta_V zm_dist_raw
#   修正核    lambda_em kappa_      (ζ(x,y) = B(y,x−1)·Λ(x,y))
#   配列      arr_zeros set_at arr_sum arr_max arr_maxabs rel_err ...
#   表示      fx f3 f8 f10 f12 pad
#   検査      check check_close check_rel verdict  (結果は台帳へ commit)
#
# 方言上の注意 (この処理系で実測した制約):
#   * 配列の索引代入 a[i] := v は無い -> set_at / 再構築で書く
#   * 論理和 or / || は無い -> && と ! と入れ子の if で書く
#   * 関数の中から大域変数へ := しても外へ出ない -> 配列への <- 追記だけが届く
#   * for は本体の代入を外へ出さない -> 累積は while で書く
# ============================================================

PI          := 3.141592653589793
TWO_PI      := 6.283185307179586
HALF_PI     := 1.5707963267948966
LN2         := 0.6931471805599453
LN10        := 2.302585092994046
SQRT_2PI    := 2.5066282746310002
EULER_GAMMA := 0.5772156649015329
GLAISHER    := 1.2824271291006226
INF         := exp(800)

# ---- 床・丸め・べき --------------------------------------------------
def floor_(x) { r := x - (x % 1)  if (r > x) { r := r - 1 }  return r }
def ceil_(x)  { r := floor_(x)  if (r < x) { r := r + 1 }  return r }
def round_(x) { return floor_(x + 0.5) }
def max_(a, b) { if (a > b) { return a }  return b }
def min_(a, b) { if (a < b) { return a }  return b }
def is_int(x) { return abs(x - round_(x)) < 0.000000000001 }
def sign_(x) { if (x < 0) { return -1 }  if (x > 0) { return 1 }  return 0 }

def ipow(b, n) {                      # 整数べき (n >= 0)
    r := 1.0  k := 0
    while (k < n) { r := r * b  k := k + 1 }
    return r
}
def pow_(b, e) {                      # 実数べき: exp(e log b)  (小さな整数べきは乗算で厳密に)
    if (e % 1 == 0) { if (abs(e) <= 64) {
        if (e >= 0) { return ipow(b, e) }
        return 1.0 / ipow(b, 0 - e)
    } }
    if (b > 0) { return exp(e * log(b)) }
    if (b == 0) { if (e > 0) { return 0.0 }  if (e == 0) { return 1.0 }  return INF }
    if (is_int(e)) {
        n := round_(e)
        if (n >= 0) { return ipow(b, n) }
        return 1.0 / ipow(b, 0 - n)
    }
    return 0 / 0
}

# ---- 三角関数 (Taylor 級数 + 範囲縮約 [-pi/2, pi/2]) ---------------------
def sin_(x) {
    x := x % TWO_PI
    if (x > PI) { x := x - TWO_PI }
    if (x < 0 - PI) { x := x + TWO_PI }
    if (x > HALF_PI) { x := PI - x }
    if (x < 0 - HALF_PI) { x := 0 - PI - x }
    term := x  s := x  k := 1
    while (k <= 12) {
        term := 0 - term * x * x / ((2 * k) * (2 * k + 1))
        s := s + term
        k := k + 1
    }
    return s
}
def cos_(x) { return sin_(HALF_PI - x) }
def tan_(x) { return sin_(x) / cos_(x) }
def sinh_(t) {
    if (abs(t) < 0.5) {               # 桁落ちを避ける級数
        t2 := t * t
        return t * (1 + t2 / 6 * (1 + t2 / 20 * (1 + t2 / 42 * (1 + t2 / 72 * (1 + t2 / 110)))))
    }
    return (exp(t) - exp(0 - t)) / 2
}
def cosh_(t) { return (exp(t) + exp(0 - t)) / 2 }
def atan_(z) {
    neg := false  inv := false
    if (z < 0) { z := 0 - z  neg := true }
    if (z > 1) { z := 1 / z  inv := true }
    z := z / (1 + sqrt(1 + z * z))    # 半角に二度縮約: |z| <= tan(pi/16)
    z := z / (1 + sqrt(1 + z * z))
    s := 0.0  t := z  k := 0  sg := 1
    while (k < 18) { s := s + sg * t / (2 * k + 1)  t := t * z * z  sg := 0 - sg  k := k + 1 }
    s := 4 * s
    if (inv) { s := HALF_PI - s }
    if (neg) { s := 0 - s }
    return s
}
def log1p_(z) {
    if (abs(z) > 0.01) { return log(1 + z) }
    return z * (1 - z * (1/2 - z * (1/3 - z * (1/4 - z * (1/5 - z * (1/6 - z * (1/7 - z * (1/8 - z / 9))))))))
}
def log2_(x)  { return log(x) / LN2 }
def log10_(x) { return log(x) / LN10 }

# ---- 階乗・二項 ----------------------------------------------------------
def fact_(n) { r := 1.0  k := 2  while (k <= n) { r := r * k  k := k + 1 }  return r }
def binom_(n, k) {                    # C(n,k) 整数
    if (k < 0) { return 0 }  if (k > n) { return 0 }
    r := 1.0  j := 0
    while (j < k) { r := r * (n - j) / (j + 1)  j := j + 1 }
    return round_(r)
}
def binom_gen(s, k) {                 # 一般二項係数 C(s+k-1, k) = Γ(s+k)/(Γ(s) k!)
    p := 1.0  j := 0
    while (j < k) { p := p * (s + j)  j := j + 1 }
    return p / fact_(k)
}

# ---- Γ 関数族 (Lanczos g=7, n=9 / 反射公式) -------------------------------
LANCZOS := [0.99999999999980993, 676.5203681218851, -1259.1392167224028,
            771.32342877765313, -176.61502916214059, 12.507343278686905,
            -0.13857109526572012, 0.0000099843695780195716,
            0.00000015056327351493116]
def log_gamma_pos(z) {                # z >= 0.5
    zz := z - 1  a := LANCZOS[0]  t := zz + 7.5  i := 1
    while (i < 9) { a := a + LANCZOS[i] / (zz + i)  i := i + 1 }
    return 0.5 * log(TWO_PI) + (zz + 0.5) * log(t) - t + log(a)
}
def log_gamma(z) {                    # log |Γ(z)|
    if (z >= 0.5) { return log_gamma_pos(z) }
    return log(PI / abs(sin_(PI * z))) - log_gamma_pos(1 - z)
}
def gamma_(z) {                       # Γ(z) 符号つき
    if (z >= 0.5) { return exp(log_gamma_pos(z)) }
    return PI / (sin_(PI * z) * exp(log_gamma_pos(1 - z)))
}
def inv_gamma(z) {                    # 1/Γ(z) 整関数 (非正整数で 0)
    if (z > 0.5) { return exp(0 - log_gamma_pos(z)) }
    return exp(log_gamma_pos(1 - z)) * sin_(PI * z) / PI
}
def log_beta(p, q) { return log_gamma(p) + log_gamma(q) - log_gamma(p + q) }
def beta_(p, q)    { return exp(log_beta(p, q)) }
def digamma_(z) {                     # ψ(z): 漸化式で z >= 10 に上げて漸近展開
    r := 0.0
    while (z < 10) { r := r - 1 / z  z := z + 1 }
    f := 1 / (z * z)
    return r + log(z) - 0.5 / z - f * (1/12 - f * (1/120 - f * (1/252 - f * (1/240 - f / 132))))
}

# ---- Bernoulli 数と多項式 ----------------------------------------------------
BERN := [1, -0.5, 1/6, 0, -1/30, 0, 1/42, 0, -1/30, 0, 5/66, 0, -691/2730, 0, 7/6, 0, -3617/510]
B2K  := [1/6, -1/30, 1/42, -1/30, 5/66, -691/2730, 7/6, -3617/510]
def bernoulli_poly(n, x) {            # B_n(x) = Σ C(n,k) B_k x^{n-k}
    s := 0.0  k := 0
    while (k <= n) { s := s + binom_(n, k) * BERN[k] * pow_(x, n - k)  k := k + 1 }
    return s
}

# ---- Hurwitz ζ(s,a) — Euler–Maclaurin (s != 1 の全域で解析接続として妥当) ----
def hurwitz_nk(s, a, N, K) {
    tot := 0.0  n := 0
    while (n < N) { tot := tot + pow_(n + a, 0 - s)  n := n + 1 }
    A := N + a
    tot := tot + pow_(A, 1 - s) / (s - 1) + 0.5 * pow_(A, 0 - s)
    k := 1
    while (k <= K) {
        p := 1.0  j := 0
        while (j < 2 * k - 1) { p := p * (s + j)  j := j + 1 }
        tot := tot + B2K[k - 1] / fact_(2 * k) * p * pow_(A, 0 - s - 2 * k + 1)
        k := k + 1
    }
    return tot
}
def hurwitz(s, a)      { return hurwitz_nk(s, a, 30, 8) }
def zeta_r(s)          { return hurwitz(s, 1.0) }                 # Riemann ζ
def dirichlet_beta(s)  { return pow_(4, 0 - s) * (hurwitz(s, 0.25) - hurwitz(s, 0.75)) }

# ---- 二重指数節点 (Takahasi–Mori, ロジスティック変換) -------------------------
#   u_k = σ(π sinh(k h)),  w_k = π cosh(k h) h,  h = 2^-5, |k| <= 195 -> 391 節点
#   節点表は (log u, log(1-u), log w) の三つ組で持つ。
def de_nodes(h, kmax) {
    LU := []  LV := []  LW := []
    k := 0 - kmax
    while (k <= kmax) {
        t := k * h
        s := PI * sinh_(t)
        if (s < 700) { if (s > -700) {
            lu := 0.0  lv := 0.0
            if (s >= 0) {
                e := exp(0 - s)
                lu := 0 - log1p_(e)
                lv := (0 - s) - log1p_(e)
            } else {
                e := exp(s)
                lu := s - log1p_(e)
                lv := 0 - log1p_(e)
            }
            if (lu < 0) {
                LU <- lu
                LV <- lv
                LW <- log(PI * cosh_(t) * h)
            }
        } }
        k := k + 1
    }
    return [LU, LV, LW]
}
def de_default() { return de_nodes(0.03125, 195) }

# Σ_k w_k (1-u_k) u_k^{n+y} (log 1/u_k)^{s-1} = Γ(s)/(n+y)^s
def de_moment(nd, s, y, n) {
    LU := nd[0]  LV := nd[1]  LW := nd[2]
    acc := 0.0  i := 0
    while (i < len(LU)) {
        lu := LU[i]
        c := LW[i] + (s - 1) * log(0 - lu) + LV[i] + (n + y) * lu
        if (c > -700) { acc := acc + exp(c) }
        i := i + 1
    }
    return acc
}
# Σ_k w_k u_k^{y} (log 1/u_k)^{s-1} = Γ(s) ζ(s,y)   (1/(1-u) はヤコビアンと相殺)
def de_gamma_zeta(nd, s, y) {
    LU := nd[0]  LW := nd[2]
    acc := 0.0  i := 0
    while (i < len(LU)) {
        lu := LU[i]
        c := LW[i] + (s - 1) * log(0 - lu) + y * lu
        if (c > -700) { acc := acc + exp(c) }
        i := i + 1
    }
    return acc
}
def zeta_de(nd, s, y)   { return exp(log(de_gamma_zeta(nd, s, y)) - log_gamma(s)) }
def zeta_V(nd, x, y, V) { return zeta_de(nd, x, y) - zeta_de(nd, x, y + V) }   # 離散 Newton–Leibniz

# ---- 修正核  ζ(x,y) = B(y,x−1)·Λ(x,y),  Λ = E_Beta(y,x−1)[κ^{x−1}]/Γ(x) ------
def kappa_(u) {                       # κ(u) = log(1/u)/(1−u) = 情報量 ÷ 残余質量
    if (1 - u < 0.000000000001) { e := 1 - u  return 1 + e / 2 + e * e / 3 }
    return (0 - log(u)) / (1 - u)
}
def lambda_de(nd, x, y) { return exp(log(zeta_de(nd, x, y)) - log_beta(y, x - 1)) }
def lambda_em(x, y)     { return hurwitz(x, y) / beta_(y, x - 1) }
def poch_ratio(x, y) {                # Γ(x+y−1)/Γ(x−1) (y が正整数なら多項式で厳密)
    if (is_int(y)) { if (y >= 1) {
        k := round_(y)  p := 1.0  j := 0
        while (j < k) { p := p * (x - 1 + j)  j := j + 1 }
        return p
    } }
    b := x + y - 1
    if (b > 0) { return gamma_(b) * inv_gamma(x - 1) }
    return inv_gamma(x - 1) * PI / (sin_(PI * b) * gamma_(1 - b))
}
def lambda_cont(x, y) { return hurwitz(x, y) * poch_ratio(x, y) / gamma_(y) }   # 解析接続版 Λ

# Zipf–Mandelbrot 分布 (未規格化): P(n) ∝ Σ_k w_k (1-u_k) u_k^{n+y} (log 1/u_k)^{x-1}
def zm_dist_raw(nd, x, y, V) {
    p := []  n := 0
    while (n < V) { p <- de_moment(nd, x, y, n)  n := n + 1 }
    return p
}
def zm_exact(x, y, V) {               # 厳密 (n+y)^{-x} を V 項で切って規格化
    p := []  n := 0
    while (n < V) { p <- pow_(n + y, 0 - x)  n := n + 1 }
    return dist(p)
}

# ---- 複素数 [re, im] (第十巻 Mellin 畳み込み・第十三巻 偏角原理で使う) ------------------
def atan2_(y, x) {
    if (x > 0) { return atan_(y / x) }
    if (x < 0) { if (y >= 0) { return atan_(y / x) + PI }  return atan_(y / x) - PI }
    if (y > 0) { return HALF_PI }
    if (y < 0) { return 0 - HALF_PI }
    return 0.0
}
def c_add(a, b)   { return [a[0] + b[0], a[1] + b[1]] }
def c_sub(a, b)   { return [a[0] - b[0], a[1] - b[1]] }
def c_mul(a, b)   { return [a[0] * b[0] - a[1] * b[1], a[0] * b[1] + a[1] * b[0]] }
def c_div(a, b)   { d := b[0] * b[0] + b[1] * b[1]  return [(a[0] * b[0] + a[1] * b[1]) / d, (a[1] * b[0] - a[0] * b[1]) / d] }
def c_scale(a, k) { return [a[0] * k, a[1] * k] }
def c_abs(a)      { return sqrt(a[0] * a[0] + a[1] * a[1]) }
def c_arg(a)      { return atan2_(a[1], a[0]) }
def c_exp(a)      { r := exp(a[0])  return [r * cos_(a[1]), r * sin_(a[1])] }
def c_log(a)      { return [log(c_abs(a)), atan2_(a[1], a[0])] }
def c_pow(a, z)   { return c_exp(c_mul(z, c_log(a))) }              # a^z (主値)
def c_powr(b, z)  { l := log(b)  return c_exp([z[0] * l, z[1] * l]) } # 実数 b > 0 の複素べき b^z
def c_sin(a)      { return [sin_(a[0]) * cosh_(a[1]), cos_(a[0]) * sinh_(a[1])] }
def c_gamma(z) {                       # 複素 Γ (Lanczos g=7, Re z < 1/2 は反射公式)
    if (z[0] < 0.5) {
        s := c_sin(c_scale(z, PI))
        return c_div([PI, 0], c_mul(s, c_gamma([1 - z[0], 0 - z[1]])))
    }
    zz := [z[0] - 1, z[1]]
    x := [LANCZOS[0], 0]  i := 1
    while (i < 9) { x := c_add(x, c_div([LANCZOS[i], 0], [zz[0] + i, zz[1]]))  i := i + 1 }
    t := [zz[0] + 7.5, zz[1]]
    return c_mul(c_mul(c_scale(c_pow(t, [zz[0] + 0.5, zz[1]]), SQRT_2PI), c_exp([0 - t[0], 0 - t[1]])), x)
}
def c_hurwitz(s, a, N, K) {            # 複素 s の Hurwitz ζ(s,a) (a 実、Euler–Maclaurin)
    tot := [0, 0]  n := 0
    while (n < N) { tot := c_add(tot, c_powr(n + a, [0 - s[0], 0 - s[1]]))  n := n + 1 }
    A := N + a
    tot := c_add(tot, c_div(c_powr(A, [1 - s[0], 0 - s[1]]), [s[0] - 1, s[1]]))
    tot := c_add(tot, c_scale(c_powr(A, [0 - s[0], 0 - s[1]]), 0.5))
    k := 1
    while (k <= K) {
        p := [1, 0]  j := 0
        while (j < 2 * k - 1) { p := c_mul(p, [s[0] + j, s[1]])  j := j + 1 }
        tot := c_add(tot, c_scale(c_mul(p, c_powr(A, [0 - s[0] - 2 * k + 1, 0 - s[1]])), B2K[k - 1] / fact_(2 * k)))
        k := k + 1
    }
    return tot
}

# ---- 配列補助 ---------------------------------------------------------------
def arr_zeros(n) { a := []  i := 0  while (i < n) { a <- 0.0  i := i + 1 }  return a }
def arr_fill(n, v) { a := []  i := 0  while (i < n) { a <- v  i := i + 1 }  return a }
def set_at(a, i, v) {
    b := []  k := 0
    while (k < len(a)) { if (k == i) { b <- v } else { b <- a[k] }  k := k + 1 }
    return b
}
def arr_copy(a)  { b := []  i := 0  while (i < len(a)) { b <- a[i]  i := i + 1 }  return b }
def arr_sum(a)   { s := 0.0  i := 0  while (i < len(a)) { s := s + a[i]  i := i + 1 }  return s }
def arr_max(a)   { m := a[0]  i := 1  while (i < len(a)) { if (a[i] > m) { m := a[i] }  i := i + 1 }  return m }
def arr_min(a)   { m := a[0]  i := 1  while (i < len(a)) { if (a[i] < m) { m := a[i] }  i := i + 1 }  return m }
def arr_maxabs(a){ m := 0.0  i := 0  while (i < len(a)) { if (abs(a[i]) > m) { m := abs(a[i]) }  i := i + 1 }  return m }
def arr_argmax(a){ m := 0  i := 1  while (i < len(a)) { if (a[i] > a[m]) { m := i }  i := i + 1 }  return m }
def arr_scale(a, c) { b := []  i := 0  while (i < len(a)) { b <- a[i] * c  i := i + 1 }  return b }
def arr_add(a, b)   { c := []  i := 0  while (i < len(a)) { c <- a[i] + b[i]  i := i + 1 }  return c }
def arr_dot(a, b)   { s := 0.0  i := 0  while (i < len(a)) { s := s + a[i] * b[i]  i := i + 1 }  return s }
def arr_maxdiff(a, b) {
    m := 0.0  i := 0
    while (i < len(a)) { d := abs(a[i] - b[i])  if (d > m) { m := d }  i := i + 1 }
    return m
}
def arr_maxrel(a, b) {               # max |a_i - b_i| / |b_i|
    m := 0.0  i := 0
    while (i < len(a)) { if (b[i] != 0) { d := abs(a[i] - b[i]) / abs(b[i])  if (d > m) { m := d } }  i := i + 1 }
    return m
}
def rel_err(got, want) { if (want == 0) { return abs(got) }  return abs(got - want) / abs(want) }
def arr_order_desc(a) {               # 値の降順の添字列 (選択ソート)
    idx := []  i := 0
    while (i < len(a)) { idx <- i  i := i + 1 }
    out := []  used := arr_fill(len(a), false)
    k := 0
    while (k < len(a)) {
        best := -1  j := 0
        while (j < len(a)) {
            if (!used[j]) { if (best < 0) { best := j } else { if (a[j] > a[best]) { best := j } } }
            j := j + 1
        }
        out <- best
        used := set_at(used, best, true)
        k := k + 1
    }
    return out
}
def shannon_(p) {                     # −Σ q log q  (x log x 核, 零は寄与ゼロ)
    h := 0.0  i := 0
    while (i < len(p)) { q := p[i]  if (q > 0) { h := h - q * log(q) }  i := i + 1 }
    return h
}

# ---- 表示 (組み込みは f5 / sci のみ。桁を選べる固定小数を自作) ------------------
def fx(x, d) {
    if (x != x) { return "nan" }
    if (x > 1e300) { return "inf" }
    if (x < -1e300) { return "-inf" }
    s := ""
    if (x < 0) { s := "-"  x := 0 - x }
    x := x + 0.5 * pow_(10, 0 - d)
    ip := floor_(x)  fr := x - ip
    s := s + ip
    if (d > 0) { s := s + "." }
    k := 0
    while (k < d) { fr := fr * 10  dg := floor_(fr)  if (dg > 9) { dg := 9 }  s := s + dg  fr := fr - dg  k := k + 1 }
    return s
}
def f3(x)  { return fx(x, 3) }
def f8(x)  { return fx(x, 8) }
def f10(x) { return fx(x, 10) }
def f12(x) { return fx(x, 12) }
def arr_str(a) {                      # 配列を "[a, b, c]" の文字列に (文字列連結では配列が潰れるため)
    s := "["  i := 0
    while (i < len(a)) { if (i > 0) { s := s + ", " }  s := s + a[i]  i := i + 1 }
    return s + "]"
}
def bstr(b)    { if (b) { return "true" }  return "false" }   # 真偽値を文字列連結すると潰れるため
def pad(s, n)  { s := "" + s  while (len(s) < n) { s := " " + s }  return s }
def padr(s, n) { s := "" + s  while (len(s) < n) { s := s + " " }  return s }

# ---- 検査台帳 -------------------------------------------------------------------
#   関数の中から大域の数を書き換えられないので、結果は配列 CHECKS に積み、
#   同時に追記専用台帳 tuplespace へ ["check", label, ok] として commit する。
CHECKS := []
def check(label, ok) {
    if (ok) { print("  [OK] " + label) } else { print("  [NG] " + label) }
    fact := ["check", label, ok]      # 改行は文の区切りではないので、配列リテラルは束縛してから commit する
    fact >> tuplespace
    CHECKS <- ok
    return ok
}
def check_close(label, got, want, tol) {
    err := abs(got - want)
    return check(label + "  got " + fx(got, 10) + "  want " + fx(want, 10) + "  |err| " + sci(err) + " <= " + sci(tol), err <= tol)
}
def check_rel(label, got, want, tol) {
    err := rel_err(got, want)
    return check(label + "  got " + fx(got, 10) + "  want " + fx(want, 10) + "  rel " + sci(err) + " <= " + sci(tol), err <= tol)
}
def checks_failed() {
    n := 0  i := 0
    while (i < len(CHECKS)) { if (!CHECKS[i]) { n := n + 1 }  i := i + 1 }
    return n
}
def verdict(sentinel) {
    total := len(CHECKS)  bad := checks_failed()
    print("")
    print("---- 検査 " + (total - bad) + " / " + total + " 合格  (台帳 " + len(tuplespace) + " facts) ----")
    if (bad == 0) { print(sentinel) } else { print("@@FAILED " + bad + " check(s)") }
}
def section(title) {
    print("")
    print("================================================================")
    print(title)
    print("================================================================")
}


# ================= 11_vacuum_analyzer.bada =================
# ============================================================
# 11_vacuum_analyzer.bada -- 第十一巻
# 反重力発生器 — ゼータ正則化された真空エネルギーの分析器
# 「Γ 関数における大域的部分積分多様体」を実装し、負のエネルギー密度の実在・符号・大きさ・持続時間を数値で答える
#
#   定理1 E_vac = ½ζ_A(−1/2)  (S¹ 周期: −π/(6L)、Dirichlet 区間: −π/(24a))
#   定理2 平行平板 Casimir  E/A = −π²ℏc/(720a³) (電磁場),  P = −π²ℏc/(240a⁴)  — 係数は解析接続だけから
#   定理3 符号は大域幾何 (スピン構造) が決める: 周期 −π/(6L) < 0、反周期 +π/(12L) > 0
#   定理4 装置の出力 g = 2πGσ = π³ℏG/(360 c a³): a = 10 nm で 2×10⁻³⁰ m/s²、地球重力には a = 13.5 fm が要る
#   定理5 負エネルギーの持続時間制限  ρ̄_min(τ₀) = (ω/2L)[√(1−e^{−4ωτ₀}) − 1]  (Ford–Roman τ₀^{−2} スケーリング)
#   第V部 ANEC (平均零エネルギー条件) が定常的な斥力重力装置を禁じる — 分析器の anec_check は常に真
# 本巻は反重力を発生させていない。作れなかったことを 15 桁の精度で述べる道具を残す。
# ============================================================

section("第十一巻  反重力発生器 — 分析器としての Γ 関数の大域的部分積分多様体")

@reviser : grammar < Omega::DATABASE[grammar].mechanism {
    rule "energy"   postfix [ 'energy'   '(' expr ')' ]          => vac_energy_from_zeta_half(_1)   # 定理1
    rule "pressure" postfix [ 'pressure' '(' expr ')' ]          => casimir_pressure(_1)            # 定理2
    rule "gravity"  postfix [ 'gravity'  '(' expr ')' ]          => casimir_gravity(_1)             # 定理4
    rule "duration" postfix [ 'duration' '(' expr ',' expr ')' ] => rho_bar_min(_1, _2)             # 定理5
    rule "anec"     stmt    [ 'anec'     '(' expr ')' ]          => commit_measurement(anec_check(_1))
}
print("grammar rules committed :", len(tuplespace), "facts (energy / pressure / gravity / duration / anec)")

HBAR := 1.054571817e-34  C := 299792458.0  G := 6.67430e-11  G_E := 9.80665
HC := HBAR * C
def vac_energy_from_zeta_half(zeta_half) { return 0.5 * zeta_half }

# ---- 定理1 ------------------------------------------------------------------------------------------------------------
section("定理1  E_vac = ½ζ_A(−1/2) — 発散する零点振動の和 ½Σω_n の有限部を解析接続で取り出す")
zm1 := zeta_r(-1)  zm3 := zeta_r(-3)
print("  ζ_R(−1) =", fx(zm1, 12), " (−1/12, ビット一致)   ζ_R(−3) =", fx(zm3, 12), " (1/120)")
check_close("定理1  ζ_R(−1) = −1/12", zm1, 0 - 1 / 12, 0.0000000000000001)
check_close("定理1  ζ_R(−3) = 1/120", zm3, 1 / 120, 0.000000001)
print("  系                       ζ_A(−1/2)          E_vac = ½ζ(−1/2)    厳密形")
t1_ok := true  i := 0
LS := [1.0, TWO_PI, 5.0]
while (i < 3) {
    L := LS[i]
    zh := 2 * pow_(L / TWO_PI, -1) * zm1          # ζ_{S¹}(s) = 2(L/2π)^{2s}ζ_R(2s) → s = −1/2
    E := energy(zh)
    if (abs(E + PI / (6 * L)) > 0.000000000001) { t1_ok := false }
    print("  S¹ 周期的 L = " + padr(fx(L, 5), 8) + "   " + pad(fx(zh, 12), 16) + "   " + pad(fx(E, 12), 16) + "   −π/(6L) = " + fx(0 - PI / (6 * L), 9))
    i := i + 1
}
i := 0
AS := [1.0, 2.0]
while (i < 2) {
    a := AS[i]
    zh := pow_(a / PI, -1) * zm1                   # Dirichlet 区間: k = πn/a → ζ(s) = (a/π)^{2s}ζ_R(2s)
    E := energy(zh)
    if (abs(E + PI / (24 * a)) > 0.000000000001) { t1_ok := false }
    print("  Dirichlet 区間 a = " + padr(fx(a, 1), 4) + "   " + pad(fx(zh, 12), 16) + "   " + pad(fx(E, 12), 16) + "   −π/(24a) = " + fx(0 - PI / (24 * a), 9))
    i := i + 1
}
check("定理1  S¹ 周期 (L = 1, 2π, 5) で −π/(6L)、Dirichlet 区間 (a = 1, 2) で −π/(24a)", t1_ok)

# ---- 定理2 ------------------------------------------------------------------------------------------------------------
section("定理2  平行平板 Casimir 力 — 横方向積分 (1/4π)m^{2−2s}/(s−1) と法線方向の和 ζ_R(2s−2) を s = −1/2 へ接続")
s := -0.5
coef := 0.5 * (1 / (4 * PI)) * (1 / (s - 1)) * ipow(PI, 3) * zeta_r(2 * s - 2)   # スカラー場 1 成分: E/A = coef / a³
print("  スカラー E/A 係数 =", fx(coef, 12), "/ a³    −π²/1440 =", fx(0 - PI * PI / 1440, 12), "   差", sci(abs(coef + PI * PI / 1440)))
check_close("定理2  E/A = −π²/(1440a³) (係数誤差 <= 1e-16)", coef, 0 - PI * PI / 1440, 0.0000000000000001)
def casimir_pressure(a) { return 0 - PI * PI * HC / (240 * ipow(a, 4)) }         # 電磁場 (偏光 2 成分)
def casimir_udens(a)    { return 0 - PI * PI * HC / (720 * ipow(a, 4)) }
print("  電磁場 (偏光 2 成分): E/A = −π²ℏc/(720a³),  P = −∂(E/A)/∂a = −π²ℏc/(240a⁴)")
print("  間隔 a      圧力 P [Pa]        エネルギー密度 u [J/m³]   |u|/c² [kg/m³]")
AA := [0.00000001, 0.0000001, 0.000001, 0.00001]
i := 0
while (i < 4) { a := AA[i]  print("  " + padr(sci(a), 10) + "  " + pad(sci(pressure(a)), 12) + "      " + pad(sci(casimir_udens(a)), 12) + "              " + sci(abs(casimir_udens(a)) / (C * C)))  i := i + 1 }
check_rel("定理2  a = 100 nm で P = −13.0 Pa (Lamoreaux 1997 以降 1% 精度で実測されている値)", pressure(0.0000001), -13.001, 0.001)
print("  分析器は正しい。そして出しているのは負のエネルギー密度 — 古典的には存在しえない量。負のエネルギー密度は思弁ではなく実験室の事実。")

# ---- 定理3 ------------------------------------------------------------------------------------------------------------
section("定理3  符号は大域幾何が決める — 同じ L、同じ場、同じ作用素。異なるのは束のねじれ (スピン構造) だけ")
print("  境界条件          ζ_A(−1/2)          E_vac            厳密形        重力的性格")
t3_ok := true  i := 0
LS3 := [1.0, 2.0, PI]
while (i < 3) {
    L := LS3[i]
    zp := 2 * pow_(L / TWO_PI, -1) * zm1                          # 周期的 (自明なスピン構造): k = 2πn/L
    za := 2 * pow_(L / TWO_PI, -1) * (pow_(2, -1) - 1) * zm1      # 反周期的: k = 2π(n+½)/L → (2^{2s}−1)ζ_R(2s)
    Ep := energy(zp)  Ea := energy(za)
    if (abs(Ep + PI / (6 * L)) > 0.000000000001) { t3_ok := false }
    if (abs(Ea - PI / (12 * L)) > 0.000000000001) { t3_ok := false }
    print("  周期   L = " + padr(fx(L, 5), 7) + "  " + pad(fx(zp, 12), 16) + "   " + pad(fx(Ep, 10), 14) + "   −π/(6L)      負 (斥力源)")
    print("  反周期 L = " + padr(fx(L, 5), 7) + "  " + pad(fx(za, 12), 16) + "   " + pad(fx(Ea, 10), 14) + "   +π/(12L)     正 (引力源)")
    i := i + 1
}
check("定理3  周期 → −π/(6L) < 0、反周期 → +π/(12L) > 0 (L = 1, 2, π)", t3_ok)
print("  ガウス的構造の反転: Gauss–Bonnet は局所曲率 → 大域位相。定理3 は局所的に同一の系で大域的なねじれ → 局所的なエネルギー密度の符号。")
print("  設計上の含意: 反重力発生器の第一の設計変数は材料でも電力でもなく装置の位相。符号は無料で選べる。問題は大きさである。")

# ---- 定理4 ------------------------------------------------------------------------------------------------------------
section("定理4  装置の出力 — Casimir 平板 (間隔 a) が作る斥力加速度 g = 2πGσ,  σ = |u|/c²·a")
def casimir_gravity(a) { return TWO_PI * G * (abs(casimir_udens(a)) / (C * C)) * a }
print("  間隔 a      |u|/c² [kg/m³]    面密度 σ [kg/m²]   g = 2πGσ [m/s²]   g / g_地球")
i := 0
while (i < 3) {
    a := AA[i]  rho := abs(casimir_udens(a)) / (C * C)  sig := rho * a  g := gravity(a)
    print("  " + padr(sci(a), 10) + "  " + pad(sci(rho), 12) + "      " + pad(sci(sig), 12) + "       " + pad(sci(g), 12) + "      " + sci(g / G_E))
    i := i + 1
}
check_rel("定理4  a = 10 nm で g = 2.022×10⁻³⁰ m/s² (地球重力の 2×10⁻³¹、重力測定の最高感度 10⁻¹⁵ より 15 桁小さい)", gravity(0.00000001), 2.022126e-30, 0.0001)
M_need := G_E / G  U_need := M_need * C * C
a_need := pow_(PI * PI * HC / (720 * U_need), 0.25)
print("  逆問題: 1 m 先で g = 9.80665 → 必要な負質量 M = g/G =", sci(M_need), "kg,  u = Mc² =", sci(U_need), "J/m³")
print("          必要な平板間隔 a = (π²ℏc/(720u))^{1/4} =", sci(a_need), "m =", fx(a_need * 1e15, 2), "fm  — 水素原子 (1e-10 m) の", sci(a_need / 1e-10), "倍、陽子半径 (8.4e-16 m) の", fx(a_need / 8.4e-16, 1), "倍")
check_close("定理4  地球重力を打ち消すには a = 13.46 fm (原子の 1 万分の 1)", a_need * 1e15, 13.46, 0.01)
sig_Au := 1e-7 * 19300.0
print("  負エネルギー ≠ 負の総質量: Casimir 負質量面密度 / 金平板 (100 nm) の面密度 =", sci((abs(casimir_udens(0.00000001)) / (C * C) * 0.00000001) / sig_Au), "(a = 10 nm)  → 装置は浮かない。")
check("定理4  Casimir 負質量は平板自身の質量の 3e-18 以下 (T00 < 0 は局所で成立、∫T00 dV > 0 は装置全体で成立)", (abs(casimir_udens(0.00000001)) / (C * C) * 0.00000001) / sig_Au < 0.000000000000000003)

# ---- 定理5 ------------------------------------------------------------------------------------------------------------
section("定理5  圧搾真空の負エネルギーは持続できない — ρ̄_min(τ₀) = (ω/2L)[√(1−e^{−4ωτ₀}) − 1]")
def lorentz_cos(b, X, n) {                        # (1/π)∫₀^X cos(bx)/(1+x²)dx の Simpson + 部分積分の主要項による尾部
    h := X / n  tot := 0.0  i := 0
    while (i <= n) {
        x := i * h  w := 2.0  if (i % 2 == 1) { w := 4.0 }  if (i == 0) { w := 1.0 }  if (i == n) { w := 1.0 }
        tot := tot + w * cos_(b * x) / (1 + x * x)
        i := i + 1
    }
    return 2 * (tot * h / 3 - sin_(b * X) / (b * (1 + X * X))) / PI
}
print("  (i) 時間サンプル恒等式 (1/π)∫cos(bx)/(1+x²)dx = e^{−b} (Lorentz 核、留数定理による厳密式) — Simpson [0,140] 40000 分割で確認")
lz_ok := true  b := 1.0
while (b <= 8.5) {
    v := lorentz_cos(b, 140.0, 40000)
    if (rel_err(v, exp(0 - b)) > 0.0001) { lz_ok := false }
    print("  b = " + fx(b, 0) + "   数値 " + fx(v, 12) + "   e^{−b} " + fx(exp(0 - b), 12) + "   差 " + sci(abs(v - exp(0 - b))))
    b := b * 2
}
check("定理5  (i) b = 1, 2, 4, 8 で e^{−b} と 1e-4 以内", lz_ok)
def rho_bar(r, d, tau0) { return sinh_(r) * sinh_(r) + sinh_(r) * cosh_(r) * cos_(d) * exp(0 - 2 * tau0) }   # ω = L = 1
def rho_bar_min(om, tau0) { uu := exp(0 - 2 * om * tau0)  return (om / 2) * (sqrt(1 - uu * uu) - 1) }        # 閉じた式 (9), L = 1
def brute_min(tau0) {                             # r ∈ (0, 3], δ ∈ [0, 2π] の総当り → 局所細分 (閉じた式は一切使わない)
    best := 1000000000.0  br := 0.0  bd := 0.0  i := 0
    while (i <= 72) {
        d := TWO_PI * i / 72  j := 0
        while (j <= 300) { r := 0.000001 + 3 * j / 300  v := rho_bar(r, d, tau0)  if (v < best) { best := v  br := r  bd := d }  j := j + 1 }
        i := i + 1
    }
    step := 3 / 300  k := 0
    while (k < 60) {
        step := step * 0.7  dr := -1
        while (dr <= 1) {
            dd := -1
            while (dd <= 1) { r := br + dr * step  d := bd + dd * step  if (r > 0) { v := rho_bar(r, d, tau0)  if (v < best) { best := v  br := r  bd := d } }  dd := dd + 1 }
            dr := dr + 1
        }
        k := k + 1
    }
    return [best, br, bd]
}
print("  (ii) ωτ₀     閉じた式 (9)        総当り最小化        差         r* 厳密 (tanh 2r = e^{−2ωτ₀})   r* 総当り")
TAU := [0.05, 0.1, 0.25, 0.5, 1.0, 2.0]
t5_ok := true  i := 0
while (i < 6) {
    t0 := TAU[i]
    ex := duration(1.0, t0)  bf := brute_min(t0)
    u := exp(0 - 2 * t0)  rstar := 0.5 * log((1 + u) / (1 - u)) / 2          # tanh(2r*) = u → r* = ¼ log((1+u)/(1−u))
    if (abs(ex - bf[0]) > 0.0000001) { t5_ok := false }
    print("  " + padr(fx(t0, 2), 8) + "   " + pad(fx(ex, 12), 16) + "   " + pad(fx(bf[0], 12), 16) + "   " + pad(sci(abs(ex - bf[0])), 9) + "   " + fx(rstar, 5) + "                         " + fx(bf[1], 5))
    i := i + 1
}
check("定理5  (ii) 閉じた式と総当り最小化が 6 点で 1e-7 以内 (cos δ = −1, tanh 2r = e^{−2ωτ₀} で最小)", t5_ok)
print("  (iii) 漸近 −(ω/4L)e^{−4ωτ₀} との比: ", fx(duration(1.0, 1.0) / (-0.25 * exp(-4)), 6), fx(duration(1.0, 2.0) / (-0.25 * exp(-8)), 6), fx(duration(1.0, 3.0) / (-0.25 * exp(-12)), 6), fx(duration(1.0, 4.0) / (-0.25 * exp(-16)), 6), " → 1")
check_close("定理5  (iii) ωτ₀ = 4 で漸近形との比が 1", duration(1.0, 4.0) / (-0.25 * exp(-16)), 1.0, 0.000001)
print("  Ford–Roman スケーリング: 持続時間 τ₀ の負エネルギーには ω ≲ 1/τ₀ のモードが要り、L ~ cτ₀ なので |ρ̄| ≲ ω/(4L) ~ 1/(4τ₀²) (1+1 次元; 3+1 次元では τ₀^{−4})。")
print("  深くしたければ短時間、長くしたければ浅く。地球重力を打ち消す u = 1.3e28 J/m³ が許される持続時間は原子核のスケールをはるかに下回る。")

# ---- 第V部  ANEC ---------------------------------------------------------------------------------------------------------
section("第V部  ANEC (平均零エネルギー条件) — 定常的な反重力装置は定理で禁じられている")
def anec_check(T00_samples) {                     # 完備な零測地線に沿った ∫⟨T_μν⟩k^μk^ν dλ >= 0 は定理 (Faulkner–Leigh–Parrish–Wang 2016)。
    print("  anec_check: どんな入力配位に対しても ANEC 違反を報告しない — 報告できない。これは実装上の制約ではなく (11) が定理だからである。")
    return dist([1.0])                             # 常に真 (縮退分布として commit)
}
# 定理5 の単一モードで ANEC が要求する構造を確認: cos 項は時間平均でゼロ、残るのは sinh²r >= 0
r := 0.7  d := PI  n := 0  acc := 0.0
while (n < 2000) { t := TWO_PI * n / 2000  acc := acc + (sinh_(r) * sinh_(r) + sinh_(r) * cosh_(r) * cos_(2 * t - d))  n := n + 1 }
avg := acc / 2000
print("  単一モード ⟨:T00:⟩(t) = (ω/L)[sinh²r + sinh r cosh r cos(2ωt − δ)] の一周期平均 =", fx(avg, 12), " = sinh²r =", fx(sinh_(r) * sinh_(r), 12), " >= 0")
check_close("ANEC   負の部分は正の部分で補償される: 一周期平均 = sinh²r", avg, sinh_(r) * sinh_(r), 0.000000000001)
led0 := len(tuplespace)
anec([0.0 - 1, 2.0, 0.5])
check("anec   規則 anec_check は常に真を返し台帳へ commit", len(tuplespace) == led0 + 1)
WALLS := [["(a) 背景独立性", "動かず"], ["(b) 拘束代数", "動かず"], ["(c) 非繰り込み可能性", "動かず"], ["(d) 等スペクトル性", "第八巻で確定"],
          ["(e) ζ(0) の縮退", "第九巻で確定"], ["(f) ローレンツ符号", "第十巻で明示"], ["(g) 新規: 平均エネルギー条件", "ANEC が定常的な斥力重力装置を禁じる。量子不等式が深さ × 持続時間を制限する (本巻 定理5)"]]
i := 0
while (i < 7) { fact := ["wall", WALLS[i][0], WALLS[i][1]]  fact >> tuplespace  print("  " + padr(WALLS[i][0], 30) + WALLS[i][1])  i := i + 1 }

section("結論 (第十一巻)")
print("  負のエネルギー密度は実在する (a = 100 nm で −13 Pa、測定値)。その符号は選べる (スピン構造)。")
print("  しかし大きさは 10⁻³⁰ m/s² であり、必要な平板間隔は原子の 1 万分の 1、持続時間は指数的に制限され、定常版は定理で禁じられている。")
print("  「Γ 関数における大域的部分積分多様体」の正体はゼータ正則化された応力テンソルであり、この計算をするために作られたかのように正確にこの計算をした。")
print("  反重力発生器は作れなかった。作れなかったことを 15 桁の精度で述べられる道具が残った。")
verdict("@@PAPER-11-OK")
