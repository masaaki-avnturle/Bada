# ============================================================
# 99_prelude_selftest.bada -- 付録
# 共通核 (00_prelude.bada) の自己診断
#
# 各巻が依拠する数値核 — 三角関数・Γ 族・Hurwitz ζ・二重指数節点・修正核 Λ・複素演算・
# 配列と表示の補助 — を既知の定数と照合する。これが落ちれば全巻の数値は信用できない。
# ============================================================

section("付録  共通核の自己診断 — 既知の定数との照合")

print("[初等関数]")
check_rel("sin(1)", sin_(1), 0.8414709848078965, 0.000000000000001)
check_close("cos(π) = −1", cos_(PI), -1, 0.000000000000001)
check_close("cos(π/2) = 0 (厳密)", cos_(HALF_PI), 0, 0)
check_rel("atan(1) = π/4", atan_(1), PI / 4, 0.000000000000001)
check_rel("atan(0.25)", atan_(0.25), 0.24497866312686414, 0.000000000000001)
check_rel("atan(3)", atan_(3), 1.2490457723982544, 0.000000000000001)
check_rel("atan2(1, −1) = 3π/4", atan2_(1, -1), 3 * PI / 4, 0.000000000000001)
check_rel("sinh(0.03125) (級数)", sinh_(0.03125), 0.031255086511, 0.0000000001)
check_rel("sinh(2) = (e² − e⁻²)/2", sinh_(2), 3.626860407847019, 0.000000000000001)
check_rel("log1p(1e-5)", log1p_(0.00001), 0.000009999950000333, 0.0000000000001)
check_rel("pow(2, 0.5) = √2", pow_(2, 0.5), sqrt(2), 0.000000000000001)
check_close("pow(−2, 3) = −8 (整数べきは乗算で厳密)", pow_(-2, 3), -8, 0)
check_close("pow(3, −2) = 1/9", pow_(3, -2), 1 / 9, 0)
check_close("floor(−5.75) = −6, floor(3) = 3", floor_(-5.75) + floor_(3), -3, 0)
check_close("binom(10, 3) = 120", binom_(10, 3), 120, 0)
check_rel("binom_gen(2.5, 3) = Γ(5.5)/(Γ(2.5)·3!)", binom_gen(2.5, 3), gamma_(5.5) / (gamma_(2.5) * 6), 0.000000000000005)

print("")
print("[Γ 族]")
check_rel("Γ(1/2)² = π", gamma_(0.5) * gamma_(0.5), PI, 0.00000000000001)
check_rel("Γ(5) = 24", gamma_(5), 24, 0.00000000000001)
check_rel("Γ(−1/2) = −2√π (反射公式)", gamma_(-0.5), 0 - 2 * sqrt(PI), 0.0000000000001)
check_close("1/Γ(0) = 0, 1/Γ(−2) = 0 (整関数の零)", abs(inv_gamma(0)) + abs(inv_gamma(-2)), 0, 0.000000000000001)
check_rel("B(1/2, 1/2) = π", beta_(0.5, 0.5), PI, 0.00000000000001)
check_rel("ψ(1) = −γ", digamma_(1), 0 - EULER_GAMMA, 0.0000000000001)
check_rel("ψ(1/2) = −γ − 2 log 2", digamma_(0.5), 0 - EULER_GAMMA - 2 * LN2, 0.0000000000001)
check_close("B_2(x) = x² − x + 1/6 at x = 0.3", bernoulli_poly(2, 0.3), 0.09 - 0.3 + 1 / 6, 0.000000000000001)

print("")
print("[Hurwitz ζ — Euler–Maclaurin]")
check_rel("ζ(2) = π²/6", zeta_r(2), PI * PI / 6, 0.00000000000001)
check_rel("ζ(3) = 1.2020569031595943", zeta_r(3), 1.2020569031595943, 0.00000000000001)
check_close("ζ(0) = −1/2", zeta_r(0), -0.5, 0.00000000000001)
check_close("ζ(−1) = −1/12", zeta_r(-1), 0 - 1 / 12, 0.00000000000001)
check_close("ζ(−3) = 1/120 (負の x では精度が落ちる)", zeta_r(-3), 1 / 120, 0.0000000001)
check_rel("ζ(2, 1/2) = π²/2", hurwitz(2, 0.5), PI * PI / 2, 0.00000000000001)
check_rel("ζ(2.73037, 2.32534) = 0.193420432579", hurwitz(2.73037, 2.32534), 0.193420432579, 0.0000000001)
check_rel("Dirichlet β(2) = Catalan 定数 0.915965594177219", dirichlet_beta(2), 0.915965594177219, 0.0000000000001)
check_close("Dirichlet β(0) = 1/2", dirichlet_beta(0), 0.5, 0.00000000000001)

print("")
print("[二重指数節点と修正核]")
nd := de_default()
check_close("節点数 = 391", len(nd[0]), 391, 0)
check_rel("ζ_DE(2, 1) = ζ(2)", zeta_de(nd, 2, 1), PI * PI / 6, 0.00000000000001)
check_rel("de_moment = Γ(s)/(n+y)^s", de_moment(nd, 2.5, 1.3, 4), gamma_(2.5) * pow_(5.3, -2.5), 0.00000000000001)
check_rel("Λ_DE(E1) = Λ_EM(E1) = 1.1489288564", lambda_de(nd, 2.73037, 2.32534), lambda_em(2.73037, 2.32534), 0.00000000000001)
check_rel("ζ_V(2, 1, 64) = ζ(2) − ζ(2, 65)", zeta_V(nd, 2, 1, 64), 1.6294305014, 0.000000001)
check_rel("Λ_cont(2, 1) = ζ(2) (y = 1: Λ = (x−1)ζ(x))", lambda_cont(2, 1), zeta_r(2), 0.0000000001)
check_close("Λ_cont(−2, 1) = 0 (自明零点)", lambda_cont(-2, 1), 0, 0.000000001)
check_close("Λ_cont(0, 2.32534) = 0 (非整数 y の非正整数 x)", lambda_cont(0, 2.32534), 0, 0.000000000001)
check_rel("κ(1/2) = 2 log 2", kappa_(0.5), 2 * LN2, 0.000000000000001)
check_rel("κ(u) の u → 1 極限 = 1", kappa_(0.9999999999999), 1, 0.000000000001)
zm := zm_exact(2.0, 1.0, 4)
check_close("zm_exact(2, 1, 4) は規格化されている", arr_sum(zm), 1, 0.000000000000001)

print("")
print("[複素演算]")
check_close("|e^{iπ} + 1| = 0", c_abs(c_add(c_exp([0, PI]), [1, 0])), 0, 0.000000000000001)
g5 := c_gamma([5, 0])
check_rel("複素 Γ(5) = 24", g5[0], 24, 0.00000000000001)
gh := c_gamma([0.5, 0])
check_rel("複素 Γ(1/2) = √π", gh[0], sqrt(PI), 0.00000000000001)
gi := c_gamma([1, 1])                              # Γ(1+i) = 0.4980156681 − 0.1549498283 i
check_close("複素 Γ(1+i) 実部", gi[0], 0.4980156681, 0.0000000001)
check_close("複素 Γ(1+i) 虚部", gi[1], -0.1549498283, 0.0000000001)
z2 := c_hurwitz([2, 0], 1.0, 40, 8)
check_rel("複素 Hurwitz ζ(2) の実部 = π²/6", z2[0], PI * PI / 6, 0.00000000000001)
zc := c_hurwitz([0.5, 14.134725141734693], 1.0, 40, 8)
check_close("複素 ζ(½ + 14.1347i) ≈ 0 (最初の非自明零点)", c_abs(zc), 0, 0.00000001)
check_rel("複素 c_powr(2, 3) = 8", c_powr(2, [3, 0])[0], 8, 0.000000000000001)

print("")
print("[配列・表示・台帳]")
check_close("set_at([1,2,3], 1, 9)[1] = 9", set_at([1, 2, 3], 1, 9)[1], 9, 0)
check_close("arr_order_desc([0.1, 0.9, 0.5])[0] = 1", arr_order_desc([0.1, 0.9, 0.5])[0], 1, 0)
check_close("arr_maxrel([1, 2], [1, 2.02]) ≈ 0.0099", arr_maxrel([1, 2], [1, 2.02]), 0.02 / 2.02, 0.000000000000001)
check("fx(3.14159265358979, 10) = 3.1415926536", fx(3.14159265358979, 10) == "3.1415926536")
check("fx(−0.000123456, 8) = −0.00012346", fx(-0.000123456, 8) == "-0.00012346")
check("fx(0.99999, 3) = 1.000 (丸め)", fx(0.99999, 3) == "1.000")
check("pad / padr", pad("x", 4) == "   x" && padr("ab", 5) == "ab   ")
check("arr_str([3, 6]) = [3, 6]", arr_str([3, 6]) == "[3, 6]")
check("bstr(true) = true", bstr(true) == "true")
led0 := len(tuplespace)
fact := ["selftest", "commit"]
fact >> tuplespace
check("配列リテラルは束縛してから >> tuplespace で 1 fact 追記", len(tuplespace) == led0 + 1)
check("shannon_ of uniform 4 = log 4", abs(shannon_(unknown_prior(4)) - log(4)) < 0.000000000000001)
verdict("@@PAPER-99-OK")
