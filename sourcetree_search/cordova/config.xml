<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada Search (単語補完 大画面 + BadaCineVim).
     起動画面は広島大学病院の検索端末と同じ黒い大画面 complete.html。
     ワークフローが cordova プロジェクトを作成し、この config.xml と
     ../app/www (自己完結アプリ) を差し込みます。 -->
<widget id="io.github.masaaki_avnturle.badasearch" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BadaSearch</name>
  <description>論文(PDF)とソースコードの単語補完検索 + BadaCineVim (Vim ビューア) を融合した検索アプリ。広島大学病院風の黒い大画面 (Bada言語プロジェクト)</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="complete.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff000000" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#000000" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
