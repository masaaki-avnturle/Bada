{
  "name": "bada-search",
  "productName": "BadaSearch",
  "version": "1.0.0",
  "description": "Bada Search — a PDF & source-code search engine that attaches to SourceTree on Windows 10/11 (launch it from a SourceTree custom action with $REPO). Indexes programming-language sources and extracts PDF text (FlateDecode) with zero dependencies.",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.badasearch",
    "productName": "BadaSearch",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json", "core/**", "www/**"],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaSearch-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BadaSearch-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "BadaSearch-Portable-${version}-${arch}.${ext}"
    }
  }
}
