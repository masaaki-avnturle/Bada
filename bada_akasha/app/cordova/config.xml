<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada Akasha.
     ワークフロー (akasha-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_akasha/index.html) を差し込みます。
     アプリは端末内で完結し、外部と通信しません (<access> を置かない)。 -->
<widget id="io.github.masaaki_avnturle.badaakasha" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Bada Akasha</name>
  <description>Bada Akasha — 論文集 16 本を端末内で検索して出典つきで答える BadaGPT、数値で確かめられる方程式だけを出す探索、直感がどの経路 (心臓・予感・パターン) を通って届くかを測る直感ポート。中核は Bada 言語の量子エンジン。</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <preference name="BackgroundColor" value="0xff0f0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0f0e14" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <config-file target="AndroidManifest.xml" parent="/*" xmlns:android="http://schemas.android.com/apk/res/android">
      <uses-permission android:name="android.permission.VIBRATE" />
    </config-file>
  </platform>
</widget>
