{
  "name": "bada-akasha",
  "productName": "Bada Akasha",
  "version": "1.0.0",
  "description": "Bada Akasha — an offline BadaGPT that answers from the 16 submitted papers with citations (and says so when they have no answer), an equation finder that only reports numerically verified relations, and an intuition-port lab (heartbeat interoception, precognition vs crypto RNG, implicit pattern learning). Core engine written in the Bada quantum language.",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.badaakasha",
    "productName": "BadaAkasha",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaAkasha-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "BadaAkasha-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Education",
      "artifactName": "BadaAkasha-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
