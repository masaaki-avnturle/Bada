<?xml version="1.0" encoding="UTF-8"?>
<!-- cordova-plugin-bada-files — Android でファイルを確実に開く・保存する
     open          : ACTION_OPEN_DOCUMENT (ファイル選択画面 / フォルダを開いて選ぶ) → {name, size, data(base64)}
     saveDownloads : MediaStore.Downloads へ保存 (Android 10 以上、権限不要) → 「Download/名前」
     saveAs        : ACTION_CREATE_DOCUMENT (保存先フォルダを選んで保存。Android 9 以下の既定)
     showDownloads : ダウンロード フォルダ (ファイル アプリ) を開く -->
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0" id="cordova-plugin-bada-files" version="1.0.0">
  <name>BadaFiles</name>
  <js-module src="www/badafiles.js" name="BadaFiles">
    <clobbers target="BadaFiles" />
  </js-module>
  <platform name="android">
    <config-file target="res/xml/config.xml" parent="/*">
      <feature name="BadaFiles">
        <param name="android-package" value="io.github.masaaki_avnturle.badafiles.BadaFiles" />
      </feature>
    </config-file>
    <source-file src="src/android/BadaFiles.java" target-dir="src/io/github/masaaki_avnturle/badafiles" />
  </platform>
</plugin>
