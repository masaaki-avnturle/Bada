{
  "name": "contact-transporter-studio",
  "productName": "Contact Transporter Studio",
  "version": "1.1.0",
  "description": "Contact Transporter Studio — three apps written in the Bada quantum programming language (with an in-app Bada IDE): ContactGPT (a from-scratch Transformer trained on the 2111 equations of the contact_blueprint report), a parametric 3D CAD of the inter-dimensional transporter, and a UFO design-drawing (blueprint) generator, as a self-contained HTML app",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.contacttransporter",
    "productName": "Contact Transporter Studio",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../../dist/www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "ContactTransporterStudio-Setup-${arch}.${ext}",
      "signingHashAlgorithms": ["sha256"]
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false },
    "portable": { "artifactName": "ContactTransporterStudio-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Graphics",
      "artifactName": "ContactTransporterStudio-${arch}.${ext}",
      "maintainer": "masaaki-avnturle <masaaki.tabu4@gmail.com>"
    }
  }
}
