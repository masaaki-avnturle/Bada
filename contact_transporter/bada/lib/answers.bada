// answers.bada — 設計値の即答 (ContactGPT / BadaClaude 共通)
//   使う側で lib/blueprint.bada・lib/ufo_flight.bada・lib/quantum.bada を #include し、
//   BP <- blueprint(...) を用意しておく。
#include lib/nlp.bada
#include lib/blueprint.bada
#include lib/ufo_flight.bada
#include lib/quantum.bada

def quick_answers(q) {
  n <- 0
  bp <- BP
  -< has_any(q, ["ローレンツ", "Γ", "18 時間", "18時間", "1秒", "相対論"]) {
    chat_reply("**特殊相対論**: Γ = 18 h / 1 s = " + str(rget(bp, "Gamma")) + "、1 − β = " + sci(rget(bp, "one_minus_beta"), 5) + "、ラピディティ φ = arcosh Γ = " + str(sig(rget(bp, "phi"), 6)))
    n <- n + 1
  }
  -< has_any(q, ["ラピディティ", "φ", "phi", "複素回転", "Θ", "コマ"]) {
    chat_reply("**複素回転体**: Θ = θ + iφ = " + c_text([rget(bp, "theta0"), rget(bp, "phi")], 6) + " (θ₀ = π/6)")
    n <- n + 1
  }
  -< has_any(q, ["計量", "ds²", "T|ψ|"]) {
    chat_reply("**輸送計量**: ds² = e^{−2πT|ψ|}[η + h̄h̄]dx^μdx^ν + T²dψ²、e^{−2πT|ψ|} = 1/Γ → T|ψ| = " + str(sig(rget(bp, "TPsi"), 6)) + " (x log x = 1 の根 " + str(sig(rget(bp, "xlogx_root"), 6)) + ")")
    n <- n + 1
  }
  -< has_any(q, ["ベガ", "vega", "片道", "距離"]) {
    chat_reply("**航程**: ベガ 25.04 ly → 収縮距離 " + sci(rget(bp, "dist_km"), 3) + " km、搭乗者の片道 " + str(sig(rget(bp, "one_way_h"), 5)) + " h")
    n <- n + 1
  }
  -< has_any(q, ["ジンバル", "角速度", "ω", "omega"]) {
    om <- rget(bp, "omega")
    chat_reply("**ジンバル**: ω(外, 中, 内) = " + str(sig(om[0], 6)) + ", " + str(sig(om[1], 6)) + ", " + str(sig(om[2], 6)) + " rad/s (段間比 φ/π)")
    n <- n + 1
  }
  -< has_any(q, ["歳差", "Ω"]) {
    chat_reply("**ポッド歳差**: Ω = Mgl/(I₃ω₃) = " + str(sig(rget(bp, "Omega"), 6)) + " rad/s")
    n <- n + 1
  }
  -< has_any(q, ["リーマン", "riemann", "ジーゲル", "siegel", "ゼータ", "zeta", "ζ", "Z(φ)"]) {
    chat_reply("**Γ・ζ 多様体**: Riemann–Siegel θ(φ) = " + str(sig(rget(bp, "rs_theta"), 6)) + "、Z(φ) = e^{iθ(φ)} ζ(½ + iφ) = " + str(sig(rget(bp, "Z"), 6)))
    n <- n + 1
  }
  -< has_any(q, ["jones", "ジョーンズ", "結び目", "コイル", "共鳴"]) {
    names <- ["3_1", "4_1", "5_1"]
    i <- 0
    -> i < 3 {
      terms <- knot_terms(names[i])
      chat_reply("**Jones " + names[i] + "** (" + knot_name(names[i]) + "): V = " + jones_text(terms) + "、V(t*) = " + c_text(rget(bp, "V" + names[i]), 6) + "、共鳴角 α = " + str(resonance(terms, 1)) + "°")
      i <- i + 1
    }
    n <- n + 1
  }
  -< has_any(q, ["寸法", "半径", "外環", "塔", "井戸", "ポッド", "サイズ"]) {
    chat_reply("**部品寸法 [m]**: 外環 R 60.088 / 中環 R 47.431 / 内環 R 37.440 / 管径 2.066 / ポッド r 5.021 / 塔高 132.194 / 井戸 38.800 / Jones 3_1 R 70.269, 5_1 R 56.215")
    n <- n + 1
  }
  -< has_any(q, ["扉", "cern", "衝突", "消えた"]) {
    d <- rget(bp, "door")
    chat_reply("**衝突段**: √s = 13.6 TeV、E_T^miss = 1348.29 GeV、扉の軸 n̂ = (" + str(sig(d[0], 5)) + ", " + str(sig(d[1], 5)) + ", " + str(sig(d[2], 5)) + ")")
    n <- n + 1
  }
  -< has_any(q, ["ufo", "反重力", "上昇", "浮上"]) {
    tr <- ascend(10, 1, 1)
    chat_reply("**UFO 反重力モデル**: x = 1 + r₀/r、L = cosh(x log x) = " + str(sig(ufo_L(0), 5)) + " (地表)、a = (L − 1)·g_eff = " + str(sig(ufo_accel(0, 1), 5)) + " m/s²、10 s 後 高度 " + str(sig(tr[10][1], 5)) + " m・速度 " + str(sig(tr[10][2], 5)) + " m/s")
    n <- n + 1
  }
  -< has_any(q, ["量子", "もつれ", "ベル", "quantum"]) {
    st <- q_cnot(q_h(q_register(2), 0), 0, 1)
    chat_reply("**量子 (Bada)**: H と CNOT でベル状態 (|00⟩ + |11⟩)/√2 → 確率 " + str(q_probs(st)) + "。ContactGPT は次の文字を ψ_i = √a_i e^{iθ_i} の Born 則測定で選びます (Q.3, Q.10)。")
    n <- n + 1
  }
  -< has_any(q, ["何本", "統計", "件数", "レジストリ"]) {
    chat_reply("**方程式レジストリ**: 全 " + str(eq_count(nil)) + " 本。calc " + str(eq_count("calc")) + " + 成立 " + str(eq_count("holds")) + " + 不成立 " + str(eq_count("differs")) + "、記号式 " + str(eq_count("symb")))
    n <- n + 1
  }
  return n
}
