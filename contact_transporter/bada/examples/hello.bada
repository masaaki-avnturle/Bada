// hello.bada — Bada 言語の入門 (実行先: コンソール)
say "hello, Bada — 量子プログラミング言語"

// <- 代入オブジェクト / <-> 比較オブジェクト / -< 分岐 / >- 合流 / -> 遷移 (while)
x <- 6
y <- 7
-< x * y <-> 42 {
  say "分岐オブジェクト: x·y は 42"
} >- {
  say "no"
}
n <- 3
-> n > 0 {
  print n
  n <- n - 1
}

// 多様体演算子: -< spawn (対) / >- emit (結合) / >> stream / => map
print 1 -< 2
print [1, 2] >- 3
print 4 >> [1, 2, 3]
print [1, 2, 3] => 10

// 関数と再帰
def fib(k) {
  -< k < 2 {
    return k
  }
  return fib(k - 1) + fib(k - 2)
}
print fib(20)

// Omega::DATABASE — アカシック TupleSpace
Omega::DATABASE[akashic] {
  push("contact")
  push(fib(10))
}
say "Γ = 18h/1s = " + str(18 * 3600 / 1)
say "φ = arcosh Γ = " + str(acosh(64800))
