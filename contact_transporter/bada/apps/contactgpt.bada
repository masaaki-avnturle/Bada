// contactgpt.bada — ContactGPT (アプリ本体・Bada)
//
// 1 つの質問・要求 q に対して on_message(q) が
//   ⓪ アプリ作成  → 「…のアプリを作って」に応えて Bada のプログラムを書き (lib/codegen.bada)、
//                   user/ に保存して 3D タブ / コンソールで実行する
//   ① 「計算 …」   → Bada の式として評価 (この VM 上の関数・定数がそのまま使える)
//   ② 方程式 ID   → レジストリ参照 (例: UFO.19)
//   ③ 設計値の即答 → lib/blueprint.bada / lib/ufo_flight.bada で計算
//   ④ 全文検索    → 方程式 2111 本 (BM25)
//   ⑤ 生成        → 同梱の Transformer のロジットを受け取り、Bada 側で
//                   温度付き softmax → 上位 k 文字 → 量子状態 ψ_i = √a_i e^{iθ_i} に符号化 →
//                   Born 則で測定して次の文字を決める (設計図書 Q.1–Q.10)
#include lib/blueprint.bada
#include lib/ufo_flight.bada
#include lib/quantum.bada
#include lib/codegen.bada
#include lib/paper.bada

say "ContactGPT — 量子プログラミング言語 Bada で動く対話エンジン"

ui_section("ContactGPT (Bada)")
ui_check("gen", "生成 (Transformer + 量子測定) を表示", true)
ui_param("temp", "温度", 0.6, 0.05)
ui_param("topk", "上位 k 文字", 10, 1)
ui_param("max_new", "最大生成文字数", 120, 10)
ui_chips(["直径40mで舷窓12個のUFOの設計図アプリを作って", "リング5つの異次元輸送機のCADを作って", "4量子ビットのGHZのプログラムを書いて", "ゼータの零点を60まで求めるアプリを作って", "ローレンツ因子 Γ は？", "Z(φ) とリーマン・ジーゲル", "Jones 結び目の共鳴", "反重力で上昇するには？", "部品の寸法", "UFO.24", "計算 rs_z(14.1347)", "計算 c_text(zeta_c([2, 0]), 8)", "多様体の式を見せて", "量子もつれ"])

BP <- blueprint(18, 1, 25.04, pi() / 6, pi() / 30, 12000, 5.021)
info <- gpt_info()
i <- 0
-> i < len(info) {
  ui_output("gi" + str(i), info[i][0], info[i][1])
  i <- i + 1
}

// ---------------------------------------------------------------- 対話
def on_message(q) {
  // ⓟ 投稿された論文 PDF についての質問・アプリ作成
  -< paper_loaded() {
    -< has_any(q, ["論文", "PDF", "pdf", "投稿"]) {
      return on_paper(q)
    }
  }
  // ⓪ アプリ作成の要求 → Bada のプログラムを書く
  app <- codegen(q)
  -< app != nil {
    file_write(app[0], app[1])
    lines <- len(split(app[1], "\n"))
    chat_reply("**Bada でアプリを書きました** — " + app[3] + "\n`" + app[0] + "` (" + str(lines) + " 行)。下のボタンで実行・IDE で編集できます。")
    chat_code(app[0], app[1], app[2], app[3])
    return nil
  }
  -< startswith(q, "計算") {
    expr <- trim(substr(q, 2))
    -< startswith(expr, ":") {
      expr <- trim(substr(expr, 1))
    }
    v <- bada_expr(expr)
    chat_reply("`" + expr + "` = **" + str(v) + "**   (Bada で評価)")
    return nil
  }
  ids <- regex_find(upper(q), "[A-Z][A-Z0-9_]*\\.[0-9]+")
  i <- 0
  -> i < len(ids) {
    -< eq_get(ids[i]) != nil {
      chat_ref(ids[i])
    }
    i <- i + 1
  }
  answered <- quick_answers(q)
  -< len(ids) <-> 0 {
    n <- 4
    tag <- nil
    -< contains(q, "の式") {
      n <- 8
      tags <- eq_tags(q)
      -< len(tags) > 0 {
        tag <- tags[0]
      }
    }
    refs <- eq_search(q, n, tag)
    i <- 0
    -> i < len(refs) {
      chat_ref(refs[i])
      i <- i + 1
    }
    -< len(refs) <-> 0 {
      -< answered <-> 0 {
        chat_reply("レジストリに一致する式は見つかりませんでした。ID (例: UFO.19)、キーワード (ゼータ, 反重力, Jones …)、または「計算 rs_z(14.13)」のように入力してください。")
      }
    }
  }
  -< param("gen") {
    -< gpt_ready() {
      p <- q
      -< len(ids) > 0 {
        p <- ids[0] + " は？"
      }
      // 1 文字ずつ gen_next(ids) を呼んで流し込む (UI を止めないため)
      chat_stream("Q: " + p + "\nA:", int(param("max_new")))
    }
  }
  return nil
}

// ---------------------------------------------------------------- 設計値の即答
def quick_answers(q) {
  n <- 0
  bp <- BP
  -< has_any(q, ["ローレンツ", "Γ", "18 時間", "18時間", "1秒", "相対論"]) {
    chat_reply("**特殊相対論**: Γ = 18 h / 1 s = " + str(rget(bp, "Gamma")) + "、1 − β = " + sci(rget(bp, "one_minus_beta"), 5) + "、ラピディティ φ = arcosh Γ = " + str(sig(rget(bp, "phi"), 6)))
    n <- n + 1
  }
  -< has_any(q, ["ラピディティ", "φ", "phi", "複素回転", "Θ", "コマ"]) {
    chat_reply("**複素回転体**: Θ = θ + iφ = " + c_text([rget(bp, "theta0"), rget(bp, "phi")], 6) + " (θ₀ = π/6)")
    n <- n + 1
  }
  -< has_any(q, ["計量", "ds²", "T|ψ|"]) {
    chat_reply("**輸送計量**: ds² = e^{−2πT|ψ|}[η + h̄h̄]dx^μdx^ν + T²dψ²、e^{−2πT|ψ|} = 1/Γ → T|ψ| = " + str(sig(rget(bp, "TPsi"), 6)) + " (x log x = 1 の根 " + str(sig(rget(bp, "xlogx_root"), 6)) + ")")
    n <- n + 1
  }
  -< has_any(q, ["ベガ", "vega", "片道", "距離"]) {
    chat_reply("**航程**: ベガ 25.04 ly → 収縮距離 " + sci(rget(bp, "dist_km"), 3) + " km、搭乗者の片道 " + str(sig(rget(bp, "one_way_h"), 5)) + " h")
    n <- n + 1
  }
  -< has_any(q, ["ジンバル", "角速度", "ω", "omega"]) {
    om <- rget(bp, "omega")
    chat_reply("**ジンバル**: ω(外, 中, 内) = " + str(sig(om[0], 6)) + ", " + str(sig(om[1], 6)) + ", " + str(sig(om[2], 6)) + " rad/s (段間比 φ/π)")
    n <- n + 1
  }
  -< has_any(q, ["歳差", "Ω"]) {
    chat_reply("**ポッド歳差**: Ω = Mgl/(I₃ω₃) = " + str(sig(rget(bp, "Omega"), 6)) + " rad/s")
    n <- n + 1
  }
  -< has_any(q, ["リーマン", "riemann", "ジーゲル", "siegel", "ゼータ", "zeta", "ζ", "Z(φ)"]) {
    chat_reply("**Γ・ζ 多様体**: Riemann–Siegel θ(φ) = " + str(sig(rget(bp, "rs_theta"), 6)) + "、Z(φ) = e^{iθ(φ)} ζ(½ + iφ) = " + str(sig(rget(bp, "Z"), 6)))
    n <- n + 1
  }
  -< has_any(q, ["jones", "ジョーンズ", "結び目", "コイル", "共鳴"]) {
    names <- ["3_1", "4_1", "5_1"]
    i <- 0
    -> i < 3 {
      terms <- knot_terms(names[i])
      chat_reply("**Jones " + names[i] + "** (" + knot_name(names[i]) + "): V = " + jones_text(terms) + "、V(t*) = " + c_text(rget(bp, "V" + names[i]), 6) + "、共鳴角 α = " + str(resonance(terms, 1)) + "°")
      i <- i + 1
    }
    n <- n + 1
  }
  -< has_any(q, ["寸法", "半径", "外環", "塔", "井戸", "ポッド", "サイズ"]) {
    chat_reply("**部品寸法 [m]**: 外環 R 60.088 / 中環 R 47.431 / 内環 R 37.440 / 管径 2.066 / ポッド r 5.021 / 塔高 132.194 / 井戸 38.800 / Jones 3_1 R 70.269, 5_1 R 56.215")
    n <- n + 1
  }
  -< has_any(q, ["扉", "cern", "衝突", "消えた"]) {
    d <- rget(bp, "door")
    chat_reply("**衝突段**: √s = 13.6 TeV、E_T^miss = 1348.29 GeV、扉の軸 n̂ = (" + str(sig(d[0], 5)) + ", " + str(sig(d[1], 5)) + ", " + str(sig(d[2], 5)) + ")")
    n <- n + 1
  }
  -< has_any(q, ["ufo", "反重力", "上昇", "浮上"]) {
    tr <- ascend(10, 1, 1)
    chat_reply("**UFO 反重力モデル**: x = 1 + r₀/r、L = cosh(x log x) = " + str(sig(ufo_L(0), 5)) + " (地表)、a = (L − 1)·g_eff = " + str(sig(ufo_accel(0, 1), 5)) + " m/s²、10 s 後 高度 " + str(sig(tr[10][1], 5)) + " m・速度 " + str(sig(tr[10][2], 5)) + " m/s")
    n <- n + 1
  }
  -< has_any(q, ["量子", "もつれ", "ベル", "quantum"]) {
    st <- q_cnot(q_h(q_register(2), 0), 0, 1)
    chat_reply("**量子 (Bada)**: H と CNOT でベル状態 (|00⟩ + |11⟩)/√2 → 確率 " + str(q_probs(st)) + "。ContactGPT は次の文字を ψ_i = √a_i e^{iθ_i} の Born 則測定で選びます (Q.3, Q.10)。")
    n <- n + 1
  }
  -< has_any(q, ["何本", "統計", "件数", "レジストリ"]) {
    chat_reply("**方程式レジストリ**: 全 " + str(eq_count(nil)) + " 本。calc " + str(eq_count("calc")) + " + 成立 " + str(eq_count("holds")) + " + 不成立 " + str(eq_count("differs")) + "、記号式 " + str(eq_count("symb")))
    n <- n + 1
  }
  return n
}

// ---------------------------------------------------------------- 生成 (Transformer + 量子測定)
// 上位 k 個の [ロジット, 文字番号] を大きい順に
def topk(logits, k) {
  top <- []
  used <- fill(len(logits), false)
  repeat k {
    best <- -1
    bv <- 0
    i <- 0
    -> i < len(logits) {
      -< used[i] <-> false {
        -< best < 0 {
          best <- i
          bv <- logits[i]
        } >- {
          -< logits[i] > bv {
            best <- i
            bv <- logits[i]
          }
        }
      }
      i <- i + 1
    }
    used[best] <- true
    append(top, [bv, best])
  }
  return top
}
// 温度付き softmax (Q.1: a_i = softmax(z)_i)
def softmax_t(top, temp) {
  a <- []
  s <- 0
  mx <- top[0][0]
  i <- 0
  -> i < len(top) {
    e <- exp((top[i][0] - mx) / temp)
    append(a, e)
    s <- s + e
    i <- i + 1
  }
  i <- 0
  -> i < len(a) {
    a[i] <- a[i] / s
    i <- i + 1
  }
  return a
}
// 次の 1 文字 (文字番号) を決める: Transformer → 上位 k → softmax → 量子符号化 → 測定
def gen_next(ids) {
  top <- topk(gpt_logits(ids), int(param("topk")))
  a <- softmax_t(top, max2(0.05, param("temp")))
  theta <- []
  i <- 0
  -> i < len(a) {
    append(theta, 2 * pi() * i / len(a))
    i <- i + 1
  }
  return top[q_measure(q_encode(a, theta))][1]
}
// 生成を止めるか (次の質問 "Q:" が始まったら)
def gen_stop(out) {
  return endswith(out, "\nQ:")
}
// 同期版 (REPL 用): generate("Q: Γ は？\nA:")
def generate(prompt) {
  ids <- gpt_encode(prompt)
  out <- ""
  k <- int(param("topk"))
  temp <- max2(0.05, param("temp"))
  repeat int(param("max_new")) {
    top <- topk(gpt_logits(ids), k)
    a <- softmax_t(top, temp)
    // 位相 θ_i (Q.2) — 候補ごとに等間隔の位相を与えて量子状態に符号化 (Q.3)
    theta <- []
    i <- 0
    -> i < len(a) {
      append(theta, 2 * pi() * i / len(a))
      i <- i + 1
    }
    psi <- q_encode(a, theta)
    j <- q_measure(psi)
    tok <- top[j][1]
    append(ids, tok)
    out <- out + gpt_decode([tok])
    -< endswith(out, "\nQ:") {
      return trim(substr(out, 0, len(out) - 3))
    }
  }
  return trim(out)
}

// ---------------------------------------------------------------- 投稿された論文
def on_paper(q) {
  info <- paper_info()
  -< is_build_request(q) {
    kind <- "manifold"
    -< has_any(q, ["UFO", "ufo", "円盤"]) {
      kind <- "ufo"
    }
    -< has_any(q, ["輸送機", "トランスポーター", "CAD"]) {
      kind <- "transporter"
    }
    app <- paper_app(kind)
    file_write(app[0], app[1])
    chat_reply("**論文「" + info[0] + "」から Bada でアプリを書きました** — " + app[3] + "\n`" + app[0] + "` (" + str(len(split(app[1], "\n"))) + " 行)。「📄 論文→アプリ」タブで APK / Linux / HTML / 設計書 PDF としてダウンロードできます。")
    chat_code(app[0], app[1], app[2], app[3])
    return nil
  }
  st <- paper_stat()
  tags <- paper_tags()
  top <- ""
  i <- 0
  -> i < min2(4, len(tags)) {
    top <- top + tags[i][0] + " " + str(tags[i][1]) + "  "
    i <- i + 1
  }
  chat_reply("**論文「" + info[0] + "」** (" + info[1] + ", " + str(info[2]) + " ページ): 方程式 " + str(info[3]) + " 本 (記号式 " + str(st[0]) + " / 数値評価 " + str(st[1]) + " / 成立 " + str(st[2]) + " / 不成立 " + str(st[3]) + ")。多い分類: " + top)
  ps <- paper_params(6)
  -< len(ps) > 0 {
    t <- ""
    i <- 0
    -> i < len(ps) {
      t <- t + ps[i][0] + " = " + str(ps[i][1]) + " " + ps[i][2] + "   "
      i <- i + 1
    }
    chat_reply("本文の数値パラメータ: " + t)
  }
  // 質問の言葉で論文の式を検索
  w <- trim(replace(replace(replace(q, "論文", ""), "の", " "), "？", ""))
  hits <- paper_search(w, 4)
  i <- 0
  -> i < len(hits) {
    e <- paper_eq(hits[i])
    chat_reply("`" + e[0] + "` [" + join(e[2], ", ") + ", " + e[1] + ", p." + str(e[5]) + "] " + e[3] + "  " + e[4])
    i <- i + 1
  }
  chat_reply("「論文からアプリを作って」「論文からUFOを設計して」と頼むと、この論文の Bada アプリを書きます。")
  return nil
}
