// transporter.bada — CONTACT TRANSPORTER 異次元輸送機 3D CAD (アプリ本体・Bada)
//
// 設計図書の方程式から設計パラメータを計算し (lib/blueprint.bada)、
// ジンバル環・ポッド・塔・Jones コイル・扉の軸・共鳴窓を 3D CAD 部品として組み立てる。
// UI (パラメータ欄・計算結果・グラフ・ボタン) もこのプログラムが宣言する。
//
//   build()    パラメータが変わるたびに呼ばれる: 計算 → 部品生成 → 図面注記
//   frame(t)   アニメーションの毎フレーム呼ばれる: ジンバルの回転 (ω) と歳差 (Ω)
//   on_request(q)  日本語の要求・質問に応える (「外環を80mに」「図面を作って」「Γは？」…)
#include lib/blueprint.bada
#include lib/nlp.bada

say "CONTACT TRANSPORTER — 量子プログラミング言語 Bada で設計"

// ---------------------------------------------------------------- UI 宣言
ui_section("設計パラメータ (方程式から再計算)")
ui_param("rider_h", "搭乗者の時間 [h]", 18, 0.1)
ui_param("earth_s", "地球の時間 [s]", 1, 0.1)
ui_param("target_ly", "目的地 [ly] (ベガ)", 25.04, 0.01)
ui_param("theta0", "θ₀ [deg]", 30, 1)
ui_param("rpm", "外環 回転 [rpm]", 1, 0.1)
ui_param("pod_mass", "ポッド質量 [kg]", 12000, 100)
ui_param("speed", "アニメ速度 ×", 1, 0.1)
ui_section("部品寸法 [m] (設計図書 ⑦)")
ui_param("ring_outer", "外環 R", 60.088, 0.001)
ui_param("ring_mid", "中環 R", 47.431, 0.001)
ui_param("ring_inner", "内環 R", 37.44, 0.001)
ui_param("tube", "管径", 2.066, 0.001)
ui_param("pod_r", "ポッド r", 5.021, 0.001)
ui_param("tower", "塔高", 132.194, 0.001)
ui_param("well", "井戸深さ", 38.8, 0.001)
ui_param("coil31", "Jones 3_1 R", 70.269, 0.001)
ui_param("coil51", "Jones 5_1 R", 56.215, 0.001)
ui_param("coil41", "Jones 4_1 R", 30, 0.1)
ui_button("設計図書の値に戻す", "reset_params")
ui_button("図面を作成", "make_sheet")
ui_request("例: 外環を80mに / 塔を1.5倍 / 図面を作って / STLで保存 / Γは？ / 上から見せて")

// build と frame で共有する状態 (大域配列を書き換える)
state <- [nil]

def reset_params() {
  ui_set("rider_h", 18)
  ui_set("earth_s", 1)
  ui_set("target_ly", 25.04)
  ui_set("theta0", 30)
  ui_set("rpm", 1)
  ui_set("pod_mass", 12000)
  ui_set("ring_outer", 60.088)
  ui_set("ring_mid", 47.431)
  ui_set("ring_inner", 37.44)
  ui_set("tube", 2.066)
  ui_set("pod_r", 5.021)
  ui_set("tower", 132.194)
  ui_set("well", 38.8)
  ui_set("coil31", 70.269)
  ui_set("coil51", 56.215)
  ui_set("coil41", 30)
  build()
}

def build() {
  th0 <- param("theta0") * pi() / 180
  w_out <- param("rpm") * 2 * pi() / 60
  bp <- blueprint(param("rider_h"), param("earth_s"), param("target_ly"), th0, w_out, param("pod_mass"), param("pod_r"))
  state[0] <- bp
  show_results(bp)
  assemble(bp)
  frame(0)
  annotate(bp)
}

// ---------------------------------------------------------------- 計算結果
def show_results(bp) {
  G <- rget(bp, "Gamma")
  om <- rget(bp, "omega")
  ui_section("計算結果 (Bada)")
  ui_output("G", "Γ = 18h / 1s", G)
  ui_output("omb", "1 − β", sci(rget(bp, "one_minus_beta"), 5))
  ui_output("phi", "φ = arcosh Γ", sig(rget(bp, "phi"), 6))
  ui_output("tpsi", "T|ψ|", sig(rget(bp, "TPsi"), 6))
  ui_output("xlx", "x log x = 1", sig(rget(bp, "xlogx_root"), 6))
  ui_output("dist", "収縮距離", sci(rget(bp, "dist_km"), 4) + " km")
  ui_output("oneway", "片道", sig(rget(bp, "one_way_h"), 5) + " h")
  ui_output("Theta", "Θ = θ + iφ", c_text([rget(bp, "theta0"), rget(bp, "phi")], 6))
  ui_output("omega", "ω 外/中/内", str(sig(om[0], 5)) + ", " + str(sig(om[1], 5)) + ", " + str(sig(om[2], 5)) + " rad/s")
  ui_output("Omega", "歳差 Ω", str(sig(rget(bp, "Omega"), 6)) + " rad/s")
  ui_output("rsth", "θ(φ)", sig(rget(bp, "rs_theta"), 6))
  ui_output("Z", "Z(φ)", sig(rget(bp, "Z"), 6))
  ui_output("V31", "V_3_1(t*)", c_text(rget(bp, "V3_1"), 6))
  ui_output("V41", "V_4_1(t*)", c_text(rget(bp, "V4_1"), 6))
  ui_output("V51", "V_5_1(t*)", c_text(rget(bp, "V5_1"), 6))
  d <- rget(bp, "door")
  ui_output("door", "扉の軸 n̂", str(sig(d[0], 5)) + ", " + str(sig(d[1], 5)) + ", " + str(sig(d[2], 5)))
  // 臨界線上の Z(t) と φ の位置
  pts <- []
  t <- 1.0
  -> t <= 40 {
    append(pts, [t, rs_z(t)])
    t <- t + 0.25
  }
  ui_plot("zplot", "臨界線上の Z(t) = e^{iθ(t)} ζ(½+it)", [["Z(t)", "#4fc3f7", pts]], [[rget(bp, "phi"), rget(bp, "Z"), "φ → Z = " + str(sig(rget(bp, "Z"), 4))]])
  ui_plot("jplot", "|V_K(e^{iα})| — 極小 = 扉の共鳴角", [["3_1", "#ef5350", jones_curve(knot_terms("3_1"), 2)], ["4_1", "#66bb6a", jones_curve(knot_terms("4_1"), 2)], ["5_1", "#ab47bc", jones_curve(knot_terms("5_1"), 2)]], [])
}

// ---------------------------------------------------------------- 部品
def assemble(bp) {
  cad_clear()
  cad_torus("ring_outer", "外環 R=" + str(param("ring_outer")), "#4fc3f7", param("ring_outer"), param("tube"))
  cad_torus("ring_mid", "中環 R=" + str(param("ring_mid")), "#4fc3f7", param("ring_mid"), param("tube"))
  cad_torus("ring_inner", "内環 R=" + str(param("ring_inner")), "#4fc3f7", param("ring_inner"), param("tube"))
  cad_cylinder("axle_om1", "軸受 外-中", "#b0bec5", 0.7, param("ring_outer") - param("ring_mid"))
  cad_cylinder("axle_om2", "軸受 外-中", "#b0bec5", 0.7, param("ring_outer") - param("ring_mid"))
  cad_cylinder("axle_mi1", "軸受 中-内", "#b0bec5", 0.7, param("ring_mid") - param("ring_inner"))
  cad_cylinder("axle_mi2", "軸受 中-内", "#b0bec5", 0.7, param("ring_mid") - param("ring_inner"))
  cad_sphere("pod", "ポッド r=" + str(param("pod_r")), "#ffd54f", param("pod_r"))
  cad_cylinder("pod_spin", "ポッド スピン軸 (歳差 Ω)", "#ffd54f", 0.6, param("pod_r") * 2.6)
  px <- param("coil31") + 12
  cad_box("pylon_l", "塔 H=" + str(param("tower")), "#90a4ae", 6, 6, param("tower"))
  cad_box("pylon_r", "塔 H=" + str(param("tower")), "#90a4ae", 6, 6, param("tower"))
  cad_box("beam", "ガントリー梁", "#90a4ae", px * 2 + 6, 5, 5)
  cad_cylinder("hanger", "吊り軸 (外環の鉛直軸)", "#b0bec5", 0.9, param("ring_outer") + param("tube") - param("ring_outer"))
  cad_knot("jones31", "Jones 3_1 コイル R=" + str(param("coil31")), "#ef5350", param("coil31") - 4, 4, 2, 3, 1.2)
  cad_knot("jones51", "Jones 5_1 コイル R=" + str(param("coil51")), "#ab47bc", param("coil51") - 3.5, 3.5, 2, 5, 1.0)
  cad_fig8("jones41", "Jones 4_1 コイル (床下)", "#66bb6a", param("coil41") / 3, 1.0)
  cad_lathe("floor", "床版", "#37474f", [[param("ring_inner"), 0], [param("coil31") + 16, 0]], 96)
  cad_lathe("well", "井戸 深さ " + str(param("well")), "#37474f", [[param("ring_inner"), 0], [param("ring_inner"), -param("well")], [0, -param("well")]], 96)
  cad_cylinder("door_axis", "扉の軸 n̂", "#ffffff", 0.5, 110)
  cad_cone("door_tip", "扉の軸 n̂ (先端)", "#ffffff", 2.2, 0, 7)
  cad_torus("res_window", "共鳴窓", "#ff9800", 12, 0.6)
  res <- resonance(knot_terms("3_1"), 1)
  i <- 0
  -> i < len(res) {
    cad_box("res_panel" + str(i), "共鳴窓 α=" + str(res[i]) + "°", "#ff9800", 3.2, 3.2, 0.6)
    i <- i + 1
  }
  state[0] <- rset(bp, "res", res)
}

// ジンバル中心の高さ
def hub() {
  return param("tower") - param("ring_outer") - param("tube")
}

// ---------------------------------------------------------------- アニメーション
def frame(t) {
  bp <- state[0]
  om <- rget(bp, "omega")
  tt <- t * param("speed")
  H0 <- hub()
  C <- ["T", 0, 0, H0]
  a1 <- ["R", 0, 0, 1, om[0] * tt]
  a2 <- ["R", 1, 0, 0, rget(bp, "theta0") + om[1] * tt]
  a3 <- ["R", 0, 1, 0, om[2] * tt]
  Ro <- param("ring_outer")
  Rm <- param("ring_mid")
  Ri <- param("ring_inner")
  // 外環: 鉛直軸まわり / 中環: 外環内の x 軸 / 内環: 中環内の y 軸
  cad_pose("ring_outer", [C, a1, ["R", 1, 0, 0, pi() / 2]])
  cad_pose("ring_mid", [C, a1, a2])
  cad_pose("ring_inner", [C, a1, a2, a3, ["R", 0, 1, 0, pi() / 2]])
  cad_pose("axle_om1", [C, a1, ["T", Rm, 0, 0], ["R", 0, 1, 0, pi() / 2]])
  cad_pose("axle_om2", [C, a1, ["T", -Rm, 0, 0], ["R", 0, 1, 0, -pi() / 2]])
  cad_pose("axle_mi1", [C, a1, a2, ["T", 0, Ri, 0], ["R", 1, 0, 0, -pi() / 2]])
  cad_pose("axle_mi2", [C, a1, a2, ["T", 0, -Ri, 0], ["R", 1, 0, 0, pi() / 2]])
  cad_pose("pod", [C, a1, a2, a3])
  cad_pose("pod_spin", [C, ["R", 0, 0, 1, rget(bp, "Omega") * tt * 0.05], ["R", 1, 0, 0, rget(bp, "theta0")], ["T", 0, 0, -param("pod_r") * 1.3]])
  px <- param("coil31") + 12
  cad_pose("pylon_l", [["T", -px, 0, param("tower") / 2]])
  cad_pose("pylon_r", [["T", px, 0, param("tower") / 2]])
  cad_pose("beam", [["T", 0, 0, param("tower") + 2.5]])
  cad_pose("hanger", [["T", 0, 0, H0 + Ro]])
  cad_pose("jones31", [["T", 0, 0, 4]])
  cad_pose("jones51", [["T", 0, 0, 10]])
  cad_pose("jones41", [["T", 0, 0, -param("well") * 0.55]])
  d <- rget(bp, "door")
  A <- ["A", d[0], d[1], d[2]]
  cad_pose("door_axis", [C, A])
  cad_pose("door_tip", [C, A, ["T", 0, 0, 110]])
  wd <- Ro + 18
  cad_pose("res_window", [C, A, ["T", 0, 0, wd]])
  res <- rget(bp, "res")
  i <- 0
  -> i < len(res) {
    cad_pose("res_panel" + str(i), [C, A, ["T", 0, 0, wd], ["R", 0, 0, 1, res[i] * pi() / 180], ["T", 12, 0, 0]])
    i <- i + 1
  }
  G <- rget(bp, "Gamma")
  ui_hud("地球時間  t = " + fixed(t, 2) + " s\n搭乗者    τ = " + fixed(t * G / 3600, 3) + " h  (Γ = " + str(G) + ")\n外環 " + fixed(imod(int(om[0] * tt * 180 / pi()), 360), 0) + "°   Z(φ) = " + str(sig(rget(bp, "Z"), 6)) + "\n[Bada] frame(t) が姿勢を計算中")
}

// ---------------------------------------------------------------- 図面 (三面図 + 等角図)
def annotate(bp) {
  H0 <- hub()
  Ro <- param("ring_outer")
  c31 <- param("coil31")
  cad_rdim("top", [0, 0], Ro, 135, "R" + str(Ro))
  cad_rdim("top", [0, 0], c31, 45, "R" + str(c31) + " (3_1)")
  cad_dim("front", [c31 + 12, 0], [c31 + 12, param("tower")], 14, str(param("tower")))
  cad_dim("front", [-param("ring_inner"), 0], [-param("ring_inner"), -param("well")], -10, str(param("well")))
  cad_dim("front", [0, 0], [0, H0], -Ro - 14, fixed(H0, 3))
  cad_dim("side", [-Ro, H0], [Ro, H0], Ro + 12, "⌀" + fixed(Ro * 2, 3))
  cad_bom("1", "ジンバル外環", "R" + str(Ro) + " 管径" + str(param("tube")), "1")
  cad_bom("2", "ジンバル中環", "R" + str(param("ring_mid")), "1")
  cad_bom("3", "ジンバル内環", "R" + str(param("ring_inner")), "1")
  cad_bom("4", "ポッド", "r" + str(param("pod_r")), "1")
  cad_bom("5", "塔・ガントリー", "H" + str(param("tower")), "1")
  cad_bom("6", "Jones 3_1 コイル", "R" + str(c31), "1")
  cad_bom("7", "Jones 5_1 コイル", "R" + str(param("coil51")), "1")
  cad_bom("8", "Jones 4_1 コイル (床下)", "井戸 " + str(param("well")), "1")
  cad_bom("9", "扉の軸・共鳴窓", "n̂", "1")
  om <- rget(bp, "omega")
  cad_note("Γ = " + str(rget(bp, "Gamma")) + ", φ = " + str(sig(rget(bp, "phi"), 6)) + ", Z(φ) = " + str(sig(rget(bp, "Z"), 6)))
  cad_note("ω = " + str(sig(om[0], 4)) + " / " + str(sig(om[1], 4)) + " / " + str(sig(om[2], 4)) + " rad/s, Ω = " + str(sig(rget(bp, "Omega"), 5)) + " rad/s")
  cad_note("この図面は Bada プログラム transporter.bada が生成しました。")
  cad_note("論文の方程式に基づく思索的・フィクションの設計図 (幾何的な可視化) です。")
}

def make_sheet() {
  frame(0)
  sc <- sheet_draw("CONTACT TRANSPORTER 異次元輸送機", "CT-TR-001", "Bada transporter.bada", "blue")
  ui_toast("図面を作成しました (尺度 1:" + str(sc) + ")")
}

// ---------------------------------------------------------------- 要求・質問に応える
def param_table() {
  return [[["質量"], "pod_mass", "ポッド質量 [kg]", 1],
    [["外環", "外側のリング"], "ring_outer", "外環 R [m]", 1],
    [["中環"], "ring_mid", "中環 R [m]", 1],
    [["内環"], "ring_inner", "内環 R [m]", 1],
    [["管径", "太さ"], "tube", "管径 [m]", 0.1],
    [["ポッドの半径", "ポッド半径", "ポッド"], "pod_r", "ポッド r [m]", 0.5],
    [["塔", "高さ"], "tower", "塔高 [m]", 10],
    [["井戸"], "well", "井戸深さ [m]", 1],
    [["3_1", "三葉"], "coil31", "Jones 3_1 R [m]", 1],
    [["5_1", "五葉"], "coil51", "Jones 5_1 R [m]", 1],
    [["4_1", "8の字"], "coil41", "Jones 4_1 R [m]", 1],
    [["搭乗者", "時間"], "rider_h", "搭乗者の時間 [h]", 0.001],
    [["目的地", "光年"], "target_ly", "目的地 [ly]", 0.001],
    [["θ", "傾き", "角度"], "theta0", "θ₀ [deg]", -360],
    [["rpm", "回転数"], "rpm", "外環 回転 [rpm]", 0],
    [["アニメ", "速さ"], "speed", "アニメ速度 ×", 0]]
}

def on_request(q) {
  bp <- state[0]
  msgs <- []
  // 1) パラメータ変更
  r <- apply_params(q, param_table())
  -< len(r[0]) > 0 {
    build()
    append(msgs, "設計を変更して再計算しました: " + join(r[0], "、"))
    bp <- state[0]
    append(msgs, "Γ = " + str(rget(bp, "Gamma")) + ", φ = " + str(sig(rget(bp, "phi"), 6)) + ", Z(φ) = " + str(sig(rget(bp, "Z"), 6)) + ", Ω = " + str(sig(rget(bp, "Omega"), 5)) + " rad/s")
  }
  // 2) 操作
  -< has_any(q, ["戻", "リセット", "初期"]) {
    reset_params()
    append(msgs, "設計図書の値に戻しました")
  }
  -< contains(q, "図面") {
    -< export_kind(q) <-> nil {
      make_sheet()
      append(msgs, "三面図 + 等角図の図面を作成しました (右の「図面 SVG / PNG / DXF」で保存できます)")
    }
  }
  k <- export_kind(q)
  -< k != nil {
    export_file(k)
    append(msgs, k + " 形式で書き出しました")
  }
  v <- view_kind(q)
  -< v != nil {
    view_set(v)
    append(msgs, "視点: " + v)
  }
  // 3) 質問
  ans <- answer(q, bp)
  -< ans != nil {
    append(msgs, ans)
  }
  -< len(msgs) <-> 0 {
    return "わかりませんでした。例: 「外環を80mに」「塔を1.5倍」「搭乗者の時間を24時間」「図面を作って」「STLで保存」「Γは？」「共鳴角は？」「上から見せて」"
  }
  return join(msgs, "\n")
}

def answer(q, bp) {
  out <- []
  -< has_any(q, ["Γ", "ローレンツ", "相対論"]) {
    append(out, "Γ = 搭乗者の時間 / 地球の時間 = " + str(rget(bp, "Gamma")) + "、1 − β = " + sci(rget(bp, "one_minus_beta"), 5))
  }
  -< has_any(q, ["φ", "ラピディティ"]) {
    append(out, "φ = arcosh Γ = " + str(sig(rget(bp, "phi"), 7)))
  }
  -< has_any(q, ["Z(", "ゼータ", "ζ"]) {
    append(out, "θ(φ) = " + str(sig(rget(bp, "rs_theta"), 6)) + "、Z(φ) = e^{iθ(φ)} ζ(½ + iφ) = " + str(sig(rget(bp, "Z"), 6)))
  }
  -< has_any(q, ["ω", "角速度"]) {
    om <- rget(bp, "omega")
    append(out, "ω(外, 中, 内) = " + str(sig(om[0], 5)) + ", " + str(sig(om[1], 5)) + ", " + str(sig(om[2], 5)) + " rad/s")
  }
  -< has_any(q, ["歳差", "Ω"]) {
    append(out, "歳差 Ω = Mgl/(I₃ω₃) = " + str(sig(rget(bp, "Omega"), 6)) + " rad/s")
  }
  -< has_any(q, ["共鳴", "Jones", "jones", "結び目"]) {
    append(out, "Jones 3_1: V(t*) = " + c_text(rget(bp, "V3_1"), 6) + "、共鳴角 α = " + str(rget(bp, "res")) + "°")
  }
  -< has_any(q, ["片道", "何時間", "ベガ", "距離"]) {
    append(out, "目的地 " + str(param("target_ly")) + " ly → 収縮距離 " + sci(rget(bp, "dist_km"), 4) + " km、片道 " + str(sig(rget(bp, "one_way_h"), 5)) + " h")
  }
  -< has_any(q, ["寸法", "大きさ", "サイズ", "部品"]) {
    append(out, "外環 R " + str(param("ring_outer")) + " / 中環 R " + str(param("ring_mid")) + " / 内環 R " + str(param("ring_inner")) + " / 塔 " + str(param("tower")) + " / 井戸 " + str(param("well")) + " m、部品 " + str(len(cad_parts())) + " 個")
  }
  -< len(out) <-> 0 {
    return nil
  }
  return join(out, "\n")
}
