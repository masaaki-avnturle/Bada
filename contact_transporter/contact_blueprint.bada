  eq("UFO.9", "β(p,q) = Γ(p)Γ(q)/Γ(p + q)", "beta-gamma identity", ["GAMMA", "BETA"], def() return chk(hB_quad(def(x) return pow(x, 3 - 1) * pow(1 - x, 2 - 1) end, 0, 1, 20), gamma(3) * gamma(2) / gamma(5)) end)
  eq("UFO.10", "Ξ = β(H + 1, M + 1)/log(N + 1)", "entropy invariant from Shannon H, manifold integral M, token count N; preserved under complex-rotation error correction", ["ROT", "BETA", "ENTROPY"], def() return (gamma(4.718 + 1) * gamma(1 + 1) / gamma(4.718 + 1 + 1 + 1)) / log(100 + 1) end)
