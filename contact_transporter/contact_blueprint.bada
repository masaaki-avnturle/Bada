  eqs("ST.631", "y = x, d/df F = m(x), R_ij|_{g_μν(x)} = [∇_i∇_j g(x,y)]^{1/2 + iy}", "fermion/boson quanto eq.: Ricci on critical line", ["ZETA", "MANIFOLD", "QUANTUM"])
