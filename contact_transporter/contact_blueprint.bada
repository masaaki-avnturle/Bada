  eqs("ST.290", "Σ_{k=0}^∞ (a_k x^k/(m dx)) f^k(x) = (m/n!) f^n(x) = ((ζ(s))^k/df) m(x), (δ(x))^{1/2} = (x log x / x^n)^n", "series-zeta-mass relation", ["ZETA"])
