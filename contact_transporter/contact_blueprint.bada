  eqs("ST.39", "∫∫ 1/(x log x)² dx_m + ∫∫ 1/(y log y)^{1/2} dy_m = 0", "Laplace eq. for gravity + antigravity on zeta", ["ZETA", "MANIFOLD"])
  eqs("ST.40", "x^{1/2 + iy} = e^{x log x}", "develops universe of space; zeta resolution", ["ZETA"])
  eqs("ST.41", "d/df F(v_ij, h) = ∫ e^{−f}[−Δv + ∇_i∇_j v_ij − R_ij v_ij − v_ij∇_i∇_j + 2<∇f,∇h> + (R + ∇f²)(v/2 − h)] (×2)", "Perelman first variation; common to 4 forces + antigravity", ["MANIFOLD", "ENTROPY"])
  eqs("ST.42", "F ≥ d/df ∫∫ 1/(x log x)² dx_m + d/df ∫∫ 1/(y log y)^{1/2} dy_m", "F bounded by zeta-resolved manifold integrals", ["ZETA", "MANIFOLD"])
  eqs("ST.43", "π(χ,x) = [iπ(χ,x), f(x)] (×3)", "commutator form; quantum eq. for dimension of symmetry", ["MANIFOLD", "QUANTUM"])
  eqs("ST.44", "∫∫ 1/(x log x)² dx_m + ∫∫ 1/(y log y)^{1/2} dy_m ≥ 0", "gravity+antigravity sum nonnegative", ["ZETA", "MANIFOLD"])
