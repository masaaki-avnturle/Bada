  eqs("INV.325", "V/W = R/C Σ_{k=0}^∞ x^k/(a_k f_k) , W/V = C/R Σ_{k=0}^∞ a_k f_k / x^k , V/W ≅ W/V ≅ R/C (Σ_{r=0}^∞ nCr)^(−1) Σ_{k=0}^∞ x^k", "quotient series", ["OTHER"])
