  eqs("INV.567", "∬_1 (x log x)² dx^m ≥ 1/(2i) (×3) ; y = x ⇒ ∬_1 (y log y)^(1/2) dy^m ≥ 1/2", "entropy bounds", ["ENTROPY"])
