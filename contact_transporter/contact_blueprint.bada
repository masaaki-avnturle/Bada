  eqs("EXP.29", "∫ Γ(γ)'' dx^m = ∫Γ(γ)' dx^m / ∇L = ∫Γ dx^m · (d/dγ)Γ / ∇L ≤ (∫Γ dx^m + (d/dγ)Γ)/∇L ≤ | e^f − e^(−f) ≤ e^(−f) + e^f' | = 0, 1 (=INV.99/100)", "gamma inequality", ["GAMMA"])
