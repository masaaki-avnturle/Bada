  eq("AGZE.64", "i^2 = (0,1)·(0,1) , |a||b| cos θ = −1", "(no gloss in text; continuation of chain)", ["ROT"], def() return chk(cmul(C(0, 1), C(0, 1)), 0 * 0 + 1 * 1) end)
  eqs("AGZE.65", "E = div(E, E_1)", "(no gloss in text; continuation of chain)", ["OTHER"])
  eq("AGZE.66", "{f,g}/[f,g] = i^2 , E = m c^2 , I' = i^2", "Poisson/commutator ratio; mass-energy", ["SR", "QUANTUM"], def() return 1 * C_LIGHT * C_LIGHT end)
  eq("AGZE.67", "d/dγ Γ = m(x) = e^{−x log x}", "Higgs field, zeta, quantum group", ["GAMMA", "ZETA"], def() return chk(hA2_dgam(2), exp(0 - 2 * log(2))) end)
  eq("AGZE.68", "sin(ix) = (e^{−x} + e^{x})/(2i)", "hyper circle function", ["ROT"], def() return chk(csin(C(0, 1)), cdiv(C(exp(0 - 1) + exp(1), 0), C(0, 2))) end)
  eq("AGZE.69", "d/df F = m(x) = e^f + e^{−f} = 2i sin(i x log x)", "hyper circle, beta reverse", ["ROT", "BETA"], def() return chk(C(exp(2 * log(2)) + exp(0 - 2 * log(2)), 0), cmul(C(0, 2), csin(C(0, 2 * log(2))))) end)
