  eq("ST.50", "C = 0.5772156...", "Euler-Mascheroni constant", ["GAMMA", "ZETA"], def() return chk(hB_euler_gamma(), 0.5772156) end)
  eqs("ST.51", "F = d/df ∫ 1/(x log x)² dx_m + d/df ∫ 1/(y log y)^{1/2} dy_m", "F as sum of gravity/antigravity manifold integrals", ["ZETA", "MANIFOLD"])
  eqs("ST.52", "f_z = ∫[√((x1 x2 x3; y1 y2 y3) ∘ (x1 x2 x3; y1 y2 y3))] dx dy dz (×3)", "matrix-root volume integral (quantum group)", ["QUANTUM"])
  eqs("ST.53", "F_t^m = (1/4)(g_ij)²", "quarter squared metric (fourth power)", ["MANIFOLD"])
  eqs("ST.54", "ΔE = −2(T − t)|R_ij + ∇_i∇_j f − g_ij/(2(T − t))|² (×2)", "Perelman shrinking-soliton entropy variation", ["MANIFOLD", "ENTROPY"])
