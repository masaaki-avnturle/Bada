  eqs("INV.337", "∃[ ∇_i∇_j(R + Δf), g(x) ] = ⊕_{k=0}^∞ ∇ ∫ ∇_i∇_j f(x) dm , ∨(∇_i∇_j f) = ⊗ ∇E+", "curvature bracket", ["MANIFOLD"])
  eqs("INV.338", "g(x,y) = O(x)[ f(x) + h̄(x) ] + T² d²ϕ", "metric with warp term", ["MANIFOLD"])
  eqs("INV.339", "O(x) = ∫ [g(x)] e^(−f) dV' − Σ δ(x)", "weighted operator", ["MANIFOLD"])
  eqs("INV.340", "O(x) = [∇_i∇_j f(x)]' ≅ nCr f(x)^n f(y)^(n−r) δ(x,y) , V(τ) = ∫ [f(x)] dm / ∂f_xy", "binomial operator/volume (×2)", ["MANIFOLD"])
  eqs("INV.341", "□ψ = 8πG T_μν , (□ψ)' = ∇_i∇_j (δ(x) ∘ G(x))_μν (p/c³ ∘ V/S) , x^(1/2+iy) = e^(x log x)", "box-psi field eq", ["SR", "ZETA", "MANIFOLD"])
  eqs("INV.342", "δ(x) ϕ = ∨[ ∇_i∇_j f ∘ g(x) ] , ∃(R + Δf)", "delta field", ["MANIFOLD"])
  eqs("INV.343", "−nCr = (1/i) Hψ C ℏψ + [H, ψ] C^(−n−r) ; nCr = nC(n−r)", "Heisenberg-algebra binomial", ["QUANTUM"])
  eqs("INV.344", "∬_1 (x log x)² dx^m → O(x) = [∇_i∇_j f]' / ∂f_xy", "singularity of process", ["ENTROPY"])
  eqs("INV.345", "⋃_{x=0}^∞ f(x) = ∇_i∇_j f(x) ⊕ Σ f(x) = ⊕ ∇f(x) ; ∇_i∇_j f ≅ ∂x∂y ∫ ∇_i∇_j f dm ≅ ∫ [f(x)] dm ≅ {[f(x), g(x)], g^(−1)(x)} ≅ □ψ ≅ ∇ψ² ≅ f(x∘y) ≤ f(x)∘g(x) ≅ |f(x)| + |g(x)|", "chain of operator equivalences", ["MANIFOLD"])
  eqs("INV.346", "δ(x) ψ = <f, g> ∘ |h^(−1)(x)| , ∂f_x · δ(x) ψ = x , x ∈ O(x) , O(x) = { [f∘g, h^(−1)(x)], g(x) }", "delta-psi relations", ["QUANTUM"])
  eqs("INV.347", "lim_{n→∞} Σ_{k=n}^∞ ∇f = [ ∇ ∫ ∇_i∇_j f(x) dx^m, g^(−1)(x) ] → ⊕_{k=0}^∞ ∇E+− = M3 = ⊕_{k=0}^∞ E+−", "tail series to 3-manifold", ["MANIFOLD"])
  eqs("INV.348", "dx² = [g²_μν, dx] , g^(−1) = dx ∫ δ(x) f(x) dx , f(x) = exp[ ∇_i∇_j f(x), g^(−1)(x) ]", "metric commutator", ["MANIFOLD"])
  eqs("INV.349", "( g(x)/f(x) )' = lim_{n→∞} g(x)/f(x) = g'(x)/f'(x)", "L'Hôpital-type limit", ["OTHER"])
  eqs("INV.350", "∇F = f · (1/4)|r|² , ∇_i∇_j f = (d/dx_i)(d/dx_j) f(x) g(x)", "gradient/Hessian", ["MANIFOLD"])
  eqs("INV.351", "∬_1 (x log x)² dx^m = [ ∇_i∇_j ∫ ∇f(x) dη ] × U(r)", "entropy position (Hörmander manifold)", ["ENTROPY"])
  eqs("INV.352", "S^mn_1 ⊗ S^mn_2 = ∫ [D²ψ ⊗ h_μν] dm", "D-brane sheaf (see INV.241)", ["MANIFOLD"])
  eqs("INV.353", "U(r) = (1/2) √(1 + f'(r)) / f(r) + m g r , F_m^t = (1/4)|r|²", "potential with gravity term", ["OTHER"])
  eqs("INV.354", "∬_1 (y log y)^(1/2) dy^m = [ ∇_i∇_j ∫ ∇f(x) dη ] × E+− , E+− = exp[L(x)] dm dψ + O(N^−)", "entropy × Lenz field path integral", ["QUANTUM", "ENTROPY"])
  eq("INV.355", "(d/df) F = [ ∇_i∇_j ∫ ∇f(x) dη ] ( U(r) + E+− ) = (1/2) m v² + m c²", "relativistic energy (kinetic + rest)", ["SR"], def() return 0.5 * 1 * 1e7 * 1e7 + 1 * C_LIGHT * C_LIGHT end)
  eqs("INV.356", "∇_i∇_j ∫ ∇f(x) dη / ∇_i∇_j ⊕ M3 = M3/P^2n ≅ P^2n/M3 ≅ M1 = [M1]", "manifold quotient chain", ["MANIFOLD"])
  eqs("INV.357", "[f(x)] = Σ_{k=0}^∞ a_k f_k , lim_{n→1} [f(x)] = lim_{n→1} Σ_{k=0}^∞ a_k f_k = α , e^(iθ) = cos θ + i sin θ , H3(M1) = 0", "Abel manifold → zeta", ["ROT", "ZETA"])
  eqs("INV.358", "x² cosθ / a + y² sinθ / b = r²", "rotated conic", ["ROT"])
  eq("INV.359", "[[cosθ, −sinθ],[sinθ, cosθ]] [x; y] = [[1,0],[0,−1]]", "rotation matrix set equal to σ_z (sic)", ["ROT", "QUANTUM"], def() return chk(cos(pi() / 6) * cos(pi() / 6) + sin(pi() / 6) * sin(pi() / 6), 1 * (-1) - 0 * 0) end)
  eq("INV.360", "χ(x) = Σ_{k=0}^∞ (−1)^n r^n , (d/df)F = (d/df) ΣΣ a_k f_k = |a1 a2 ... a_n| − |a1 ... a_{n−1}| − |a_n ... a1| , lim_{n→0} χ(x) = 2", "Euler characteristic series", ["MANIFOLD"], def() return chk(hCD_series(-0.5, 80), 2) end)
  eqs("INV.361", "lim_{n→1} Σ_{k=0}^∞ a_k f_k = nCr f(x)^n f(y)^(n−r) δ(x,y) ; lim_{n→∞} nCr f(x)^n f(y)^(n−r) δ(x,y)", "binomial limits", ["OTHER"])
  eq("INV.362", "lim_{n→1} Σ_{k=0}^∞ ( 1/(n+1) )^s = lim_{n→1} Z^r = 1/z", "zeta-type sum", ["ZETA"], def() return chk(hCD_zeta_partial(2, 2000), zeta(2)) end)
  eq("INV.363", "β(p,q) = Γ(p)Γ(q)/Γ(p+q) ≅ Γ(p+q)/(Γ(p)Γ(q)) , lim_{n→1} a_k f_k ≅ lim_{n→∞} ζ(s)/(a_k f_k) , ker f/im f ≅ im f/ker f", "beta–gamma (see INV.272) (×2)", ["GAMMA", "ZETA", "BETA"], def() return chk(beta(2, 3), gamma(5) / (gamma(2) * gamma(3))) end)
  eq("INV.364", "lim_{n→1} ζ(s) = 0 , O(x) = ζ(s) Σ_{x=0}^∞ f(x) → ⊕_{k=0}^∞ ∇f(x) = ∫_M δ(x) f(x) dx", "zeta vanishing claim (sic; ζ has pole at 1)", ["ZETA"], def() return chk(zeta(1.001), 0) end)
  eqs("INV.365", "∭_M V/S² e^(−f) dV = ∬_D −( f(x,y)², g(x,y)² ) − ∬_D ( g(x,y)², f(x,y)² )", "Green-type identity for pressure", ["MANIFOLD"])
  eqs("INV.366", "lim_{n→1} Σ_{k=0}^∞ a_k f_k = ∫ [D²ψ ⊗ h_μν] dm = ∫ exp[L(x)] dψ dm × E+− = S^mn_1 ⊗ S^mn_1 = Z1 ⊕ Z1 = M1", "series = path integral = homology", ["ZETA", "MANIFOLD", "QUANTUM"])
  eqs("INV.367", "H^m_n(χ, h) = ∬_M V (R + Δf) e^(−f) dV , V/S² = ∭_M [Dψ ⊗ h_μν] dm", "cohomology via Perelman weighted curvature", ["MANIFOLD", "ENTROPY"])
  eqs("INV.368", "∭_M V/S² dm = ∫_D (l × l) dm", "pressure equation (string)", ["MANIFOLD"])
  eqs("INV.369", "∬_D −g(x,y)² dm − ∬_D −f(x,y)² dm = −2R_ij , [f(x), g(x)] × [h(x), g^(−1)(x)]", "curvature from squared fields", ["MANIFOLD"])
  eqs("INV.370", "[[D_m, d_x],[d_x, ∂_m]] [[cosθ, −sinθ],[sinθ, cosθ]] [x; y] = [[1,0],[0,−1]]^(1/2) = (D_m, d_x)·(cosθ, sinθ) × (d_x, ∂_m)·(cosθ, sinθ) (×2)", "differential operator matrix × rotation", ["ROT", "QUANTUM"])
  eqs("INV.371", "[[1,0],[0,i]] β(x,θ) [x; y] = [[i,0],[0,−1]]", "phase-gate times beta", ["BETA", "QUANTUM"])
  eq("INV.372", "l = √(ℏG/c³) , σ_m · [[δ(x), −1],[1, ε(x)]]^(1/2) = [[i,0],[0,−i]]", "Planck length and Pauli-type matrix", ["QUANTUM"], def() return sqrt(1.054571817e-34 * 6.674e-11 / pow(C_LIGHT, 3)) end)
  eqs("INV.373", "( ∂/∂τ f(x,y,z) )^(3') = A_μν , (d/dt) g_ij(t) = −2R_ij", "third derivative = gauge field", ["MANIFOLD"])
  eqs("INV.374", "lim_{n→1} Σ_{k=0}^∞ a_k f_k = lim_{n→1} a_n / a_{n−1} ≅ α ; lim_{n→1} Σ_{k=0}^∞ a_k/a_{k+1} = Σ_{k=0}^∞ a_k f_k", "ratio-test type", ["OTHER"])
  eq("INV.375", "□ = (8πG/c⁴) T_μν", "Einstein equation as box (×5)", ["SR", "MANIFOLD"], def() return 8 * pi() * 6.674e-11 / pow(C_LIGHT, 4) end)
  eqs("INV.376", "∫ x log x dx = ∬_M ( e^(x log x) sinθ dθ ) dx dθ = (log sinθ dθ)^(1/2) − (δ(x) · ε(x))^(1/2)", "entropy integral as angular integral", ["ROT", "ENTROPY"])
  eqs("INV.377", "T_μν = || ∬_M [ ∇_i∇_j e^(∫ x log x dx) + O(N^(−1)) ] dm dψ ||", "stress tensor from entropy exponent", ["MANIFOLD", "ENTROPY"])
  eqs("INV.378", "[[d_x, δ(x)],[ε(x), ∂_m(x)]] ( f_mn(x), g_μν(x) ) = [[1,0],[0,−1]]^(1/2)", "operator matrix (Von Neumann)", ["QUANTUM"])
  eqs("INV.379", "||ds²|| = H(x)_mn ⊗ K(y)_mn", "metric norm as tensor product", ["MANIFOLD"])
  eqs("INV.380", "||H(x)||^(−1/2+iy) ⊂ R+− ∪ C+− ≅ M3 ; ||H(x)||^(1/2+iy) ⊆ M3", "Selberg-type critical-line norm", ["ZETA", "MANIFOLD"])
  eqs("INV.381", "K(y) = |x y z; a b c|² / g_μν(x) ≅ f(x,y,z) / ( g(a,b,c) h^(−1)(u,v,w) )", "mass from determinant", ["MANIFOLD"])
  eqs("INV.382", "V = ∫ [D²ψ ⊗ h_μν] dm , S² = ∫ e^(−2 sinθ cosθ) · log sinθ dx_θ + O(N^(−1)) , O(x) = ζ(s) / lim_{x→1} Σ a_k f_k = α", "volume/surface/zeta", ["ROT", "ZETA"])
  eqs("INV.383", "O(x) = T_μν , lim_{x→1} Σ_{k=0}^∞ a_k f_k = T_μν", "stress tensor as series", ["ZETA"])
  eqs("INV.384", "G_μν = R_μν T_μν , M3 = ∭ V/S² dm , −(1/(2(T−t))) | R_ij = □ψ", "three-manifold equation", ["MANIFOLD"])
  eqs("INV.385", "m(x) = [f(x)] , f(x) = ∬ e^(∫ x log x dx) + O(N^(−1)) + T² d²ψ", "route-integral mass", ["ENTROPY"])
  eqs("INV.386", "F(x) = || ∇_i∇_j ∫ ∇f(x,y) dm ||^(1/2+iy)", "critical-line norm", ["ZETA"])
  eqs("INV.387", "G_μν = || [ ∇_i∇_j ∫ ∇g(x,y,z) dx dy dz ] ||^m / (2 sinθ cosθ log sinθ dθ dψ)", "Einstein tensor via rotation log integral", ["ROT", "MANIFOLD"])
  eqs("INV.388", "T_μν = F(x) , 2(T−t) | g²_ij = ∬_1 (x log x)² dx^m", "stress from entropy", ["ENTROPY"])
  eqs("INV.389", "ψδ(x) = [m(x)] , ∇(□ψ) = ∇_i∇_j ∫ ∇g(x,y) dη , ∇·(□ψ) = (1/4) g²_ij , □ψ = (8πG/c⁴) T_μν", "box-psi relations", ["SR", "MANIFOLD"])
  eqs("INV.390", "p V / c³ = S ∘ h_μν = h", "pressure-volume = Planck", ["QUANTUM"])
  eqs("INV.391", "T_μν = ℏν / S , T_μν = ∭ V/S² dm , (d/df) m(x) = V(x)/F(x)", "stress as photon energy density", ["QUANTUM"])
  eqs("INV.392", "y = x , (d/df)F = m(x) , R_ij | g_μν(x) = [∇_i∇_j g(x,y)]^(1/2+iy)", "Ricci critical-line", ["ZETA"])
  eqs("INV.393", "∇ ∘ (□ψ) = (∂/∂f) F = ∬ ∇_i∇_j f(x) dη_μν , ∫ [∇_i∇_j g(x,y)] dm = (∂/∂f) R_ij | g_μν(x)", "partial differential on global metric", ["MANIFOLD"])
  eqs("INV.394", "G(x) = ∇_i∇_j f + R_ij | g_μν(x) + ∇(□ψ) + (□ψ)²", "four-force element", ["MANIFOLD"])
  eqs("INV.395", "G_μν + Λ g_ij = T_μν , T_μν = (d/dx^μ)(d/dx^ν) f_μν + −2(T−t) | R_ij + f'' + (f')² = ∫ exp[L(x)] dm + O(N^(−1)) = ∫ e^((2/m) sinθ cosθ · log(sinθ)) dx + O(N^(−1))", "Einstein with Λ; stress as path integral", ["ROT", "MANIFOLD", "QUANTUM"])
  eqs("INV.396", "(∂/∂f) F = (∇_i∇_j)^(−1) ∘ F(x)", "inverse Hessian", ["MANIFOLD"])
  eqs("INV.397", "O(x) = ∫ [ ∇_i∇_j ∫ ∇f(x) dm ] dψ = ∫ [ ∇_i∇_j f(x) dη_μν ] dψ", "operator", ["MANIFOLD"])
  eqs("INV.398", "∇f = ∫ ∇_i∇_j [ ∫^{S^(−3)} δ(x) dV ] dm", "gradient via delta volume", ["MANIFOLD"])
  eqs("INV.399", "|| ∫ [∇_i∇_j f] dm ||^(1/2+iy) = rot(div, E, E1) = 2<f, h> ; V(x)/f(x) = ρ(x)", "Maxwell as critical-line norm", ["ROT", "ZETA"])
  eqs("INV.400", "∫_M ρ(x) dx = □ψ , −2<g, h> = div(rot E, E1) = −2R_ij", "Higgs field / Maxwell", ["MANIFOLD"])
  eqs("INV.401", "O(x) = || ∇_i∇_j / S² ∫ [∇_i∇_j f · g(x) dx dy] dψ || = ∫ (δ(x))² sinθ cosθ log sinθ dθ dψ", "Hörmander duality operator", ["ROT"])
  eqs("INV.402", "δ · O(x) = [ || ∇_i∇_j f dη || / ∫ e^(2 sinθ cosθ) · log sinθ dθ ]", "open-set group operator", ["ROT"])
  eqs("INV.403", "iℏψ = || ∫ (∂/∂z) [ i(xy + yx) / (z − z̄) ] dm dψ ||", "complex-variable wave equation", ["QUANTUM"])
  eqs("INV.404", "δ(x) ∫_C R² sinθ cosθ = Γ(p + q)", "complex curvature in gamma function", ["ROT", "GAMMA"])
  eqs("INV.405", "(□ + m) · ψ = ( ∇_i∇_j f | g_μν(x) + v ∇_i∇_j ) ∫ [ m(x) ( rot · div(E, E1) ) ] dm dψ", "electroweak + strong", ["ROT", "QUANTUM"])
  eqs("INV.406", "G_μν = □ ∭ (x,y,z)³ dx dy dz = (8πG/c⁴) T_μν", "Einstein tensor as cubic volume", ["SR", "MANIFOLD"])
  eqs("INV.407", "(d/dV) F = δ(x) ∫ ∇_i∇_j f dη_μν", "d'Alembertian duality", ["MANIFOLD"])
  eqs("INV.408", "x^n + y^n = z^n , δ(x) ∫ z^n = (d/dV) z³ , (x,y)·(δm, ∂m) = (x,y)·(z^n, f) , n ⊥ x , n ⊥ y = 0", "Fermat singularity constancy", ["OTHER"])
  eqs("INV.409", "∨(∇_i∇_j f) · XOR(□ψ) = (d/df) ∫_M F dV", "logical operators on fields", ["OTHER"])
  eq("INV.410", "∂(x) ∫ z³ = (d/dV) z³ , Σ_{k=0}^∞ 1/(n+1)^s = O(x)", "zeta series as operator", ["ZETA"], def() return chk(hCD_zeta_partial(3, 2000), zeta(3)) end)
  eqs("INV.411", "∫ O(x) dx = δ(x) π(x) f(x) , O(x) = ∫ σ(x)² sinθ cosθ log sinθ dθ dψ", "Fermat singularity operator", ["ROT", "ZETA"])
  eqs("INV.412", "y = x , O(x) = || ∇_i∇_j f / S² ∫ [∇_i∇_j f ∘ g(x) dx dy] ||", "operator norm", ["MANIFOLD"])
  eq("INV.413", "lim_{n→1} Σ_{k=0}^∞ a_k/a_{k+1} = (log sinθ dx)' = cosθ / sinθ = x/y", "cot as series ratio", ["ROT"], def() return chk(hCD_dnum(def(t) return log(sin(t)) end, pi() / 6), cos(pi() / 6) / sin(pi() / 6)) end)
  eqs("INV.414", "lim_{n→1} Σ_{k=0}^∞ a_k f_k = 1/(1−z)", "geometric sum", ["OTHER"])
  eqs("INV.415", "□ψ = (8πG/c⁴) T_μν , (∂/∂f) □ψ = 4πGρ , ∫ ρ(x) = □ψ , V(x)/f(x) = ρ(x)", "Einstein → Poisson", ["SR", "MANIFOLD"])
  eqs("INV.416", "(∂^n/∂f^(n−1)) F = ∫ [D²ψ ⊗ h_μν] dm = (P1 P3 ... P_{2n−1}) / (P0 P2 ... P_{2n+2})", "Wallis-type product", ["ZETA"])
  eqs("INV.417", "⊗ ∇M1 ⊕ ∇M1 = σ_n(χ,x) ⊕ σ_(n−1)(χ,x) = {f,h} ∘ [f,h]^(−1) = g^(−1)(x)_μν d_x g_μν(x)", "anticommutator/commutator", ["MANIFOLD", "QUANTUM"])
  eqs("INV.418", "Σ_{k=0}^∞ ∇^n nCr f^n(x) ≅ Σ_{k=0}^∞ ∇^n ∇^(n−1) nCr f^n(x) g^(n−r)(x)", "binomial derivative series", ["OTHER"])
  eqs("INV.419", "Σ_{k=0}^∞ (∂^n/∂^(n−1) f) ∘ ζ(x)/n! = lim_{n→1} Σ a_k f_k ; (f)^n = nCr f^n(x) g^(n−r)(x) · δ(x,y)", "zeta Taylor series", ["ZETA"])
  eq("INV.420", "(e^(iθ))' = i e^(iθ) , ∫ e^(iθ) = (1/i) e^(iθ) , i h c = G , h c = (1/i) G", "Euler derivative/integral (×3)", ["ROT"], def() return chk(C(hCD_dnum(def(t) return cos(t) end, 0.7), hCD_dnum(def(t) return sin(t) end, 0.7)), cmul(C(0, 1), cexp(C(0, 0.7)))) end)
  eqs("INV.421", "(□ψ, ∇f²) · ( (8πG/c⁴) T_μν, 4πGρ ) = ( −(1/2) m v² + m c², (1/2) k T² + (1/2) m v² ) · [[cosθ, −sinθ],[sinθ, cosθ]] = [[1,0],[0,i]]", "field eq pair rotated = phase matrix (rotation + relativistic energy)", ["ROT", "SR"])
  eqs("INV.422", "({f,g}/[f,g])' = i² , ∇f² / □ψ = (1/2) ∬ {f,g}/[f,g] = 1/(2i)", "anticommutator ratio", ["QUANTUM"])
  eqs("INV.423", "∬_1 (y log y)^(1/2) dy^m = (1/2) ∬_1 (x log x)² dx^m = 1/(2i) , (d/dt) g_ij = −2R_ij", "entropy integrals = 1/(2i)", ["ENTROPY"])
  eqs("INV.424", "(∂/∂x)( f(x) g(x) )' = ⊕ ∇_i∇_j f(x) g(x) ; ∫ f'(x) g(x) dx = [f(x) g(x)] − ∫ f(x) g'(x) dx", "integration by parts", ["OTHER"])
  eqs("INV.425", "f = n ν λ , λ = x/l , ∫ d n ν λ = f(x) , x f(x) = F(x) , [f(x)] = ν h (see INV.200)", "wave relation", ["QUANTUM"])
  eqs("INV.426", "p_x = m v , λ(x) = esperial f(x) , [F(x)] = 1/(1−z) , 0 < tanθ < i , −1 < tanθ < i , −1 ≤ sinθ ≤ 1 , −1 ≤ cosθ ≤ 1", "momentum and trig bounds", ["ROT", "QUANTUM"])
  eqs("INV.427", "R∇E+ = f(x) ∇ e^(x log x) , Q∇C+ = (d/df)F(x) ∇ ∫ δ(x) f(x) dx , E+∇f = e^(x log x) ∇ n! f(x) / E(X) (see INV.155-158) (×2)", "category Laplace operator", ["ENTROPY"])
  eqs("INV.428", "(u + v + w)(x + y + z) / Γ", "Seifert structure Maxwell term", ["GAMMA"])
  eqs("INV.429", "exp( ∇(R+ ∩ E+), Δ(C ⊃ R) ) = π(R, C∇E+) = rot(E1, div E2) (see INV.153) (×3)", "fundamental group = curl", ["ROT"])
  eqs("INV.430", "d(R∇E+) = Δf(x) ∘ E+(x) ; □x = ∫^{∇i∇j(R+E+)} ∇(R+∩E+) d□x ; x^n + y^n = z^n → □x = ...", "material quantum potential", ["MANIFOLD"])
  eqs("INV.431", "□ = −2(T−t) | R_ij + ∇∇f + (1/(−2(T−t))) g²_ij", "heat equation (Perelman soliton)", ["MANIFOLD", "ENTROPY"])
  eqs("INV.432", "□ = −2 ∫ (R + ∇_i∇_j f) / −(R + Δf) e^(−f) dV", "heat functional", ["MANIFOLD", "ENTROPY"])
  eqs("INV.433", "R∇E+ = Δf(x) ∘ E+(x) , d(R∇E+) = ∇_i∇_j(R + E+) , R∇E+ = f(x) , f(x) = M1", "category relations", ["MANIFOLD"])
  eqs("INV.434", "−2(T−t) | R_ij + ∇∇f = ∬_1 (y log y)^(1/2) dy^m ; 1/(−2(T−t)) | g²_ij = ∬_1 (x log x)² dx^m", "soliton terms as entropy integrals", ["MANIFOLD", "ENTROPY"])
  eqs("INV.435", "(□ + m²) ϕ = 0 , (γ^n ∂_n + m²) ψ = 0", "Klein–Gordon and Dirac (mass² sic)", ["SR", "QUANTUM"])
  eqs("INV.436", "□ = (δϕ + m²) ψ , (δϕ + m² c) ψ = 0 , E = mc² , E = −(1/2) m v² + m c² , □ψ² = (∂ϕ + m²) ψ", "field-energy relations", ["SR", "QUANTUM"])
  eqs("INV.437", "□ϕ² = (8πG/c⁴) T_μν , ∇ϕ² = 8πG(p/c³ + V/S) , (d/dt) g_ij = −2R_ij , f(x) + g(x) ≥ f(x) ∘ g(x)", "field equations bundle", ["SR", "MANIFOLD"])
  eqs("INV.438", "∫_β^α a(x−1)(y−1) ≥ 2 ∫ f(x) g(x) dx", "integral inequality", ["OTHER"])
  eq("INV.439", "m² = 2πT ( (26 − D_n)/24 ) , r^n = 1/(1−z)", "bosonic-string mass (critical dim 26)", ["QUANTUM"], def() return 2 * pi() * 1 * ((26 - 4) / 24) end)
  eqs("INV.440", "(∂ψ + m² c) ϕ = 0 , T_μν = (1/2) m v² − (1/2) k x²", "Lagrangian as stress (×2)", ["QUANTUM"])
  eqs("INV.441", "∫ [f(x)] dx = || ∫ f(x) dx || , ∫ ∇x dx = Δ Σ f(x) dx , (e^(iθ))' = i e^(iθ)", "misc", ["ROT"])
  eqs("INV.442", "T_μν = n h ν ; T_μν = (1/2) m v² − (1/2) k x² ≥ m c² − (1/2) m v²", "light cannot exceed ½kx² energy", ["SR", "QUANTUM"])
  eqs("INV.443", "Z ∈ R ∩ Q , R ⊂ M+ , C+ ⊕_{k=0}^n H_m , E+ ∩ R+ , M+ = Σ_{k=0}^n C+ ⊕ H_M , M+ = Σ_{k=0}^n C+ ∪ H+ , E2 ⊕ E1 , ... , (d/df)F = ⊕ ∇M+− , ⊕ ∇C+−", "eight differential structures in Laplace eq", ["MANIFOLD"])
  eqs("INV.444", "∇ ∘ Δ = ∇ Σ f(x) / Δ → mesh f(x) dx , ∂x/∇ → ∂xy , (d/dx) f(x) (d/dx) g(x) / □x = −[f, g]", "operator mesh / commutator", ["QUANTUM"])
  eqs("INV.445", "lim_{x→∞} Σ f(x) dx = ∫ dx , ∇ ∫ dx", "Riemann-sum limit", ["OTHER"])
  eqs("INV.446", "( E2 ⊕_{k=0}^n E1 ) · (R− ⊂ C+) = ⊕_{k=0}^n ∇C+− , ∨ ∫^{C+−} ∇H_m", "category of complex surface", ["MANIFOLD"])
  eqs("INV.447", "Δ(M+− ∇C+−) = ∧ M+− ⊕_{k=0}^n C+− , ∃(M+− ∇C+−) = XOR( ⊕_{k=0}^n ∇M+− ) , −[E+ ∇R+−] = ∇+ ∇− C+−", "logical-category operators", ["MANIFOLD"])
  eqs("INV.448", "∫ dx, ∂x, ∇_i∇_j, Δx → E+ ∇M1 , E+ ∩ R ∈ M1 , R∇C+", "operator chain", ["MANIFOLD"])
  eq("INV.449", "[[cos x, sin x],[sin x, −cos x]] [x; y] = [[1,0],[0,−1]]", "reflection matrix = σ_z", ["ROT", "QUANTUM"], def() return chk(abs(cos(0) - 1) + abs(sin(0)) + abs(sin(0)) + abs(0 - cos(0) + 1), 0) end)
  eq("INV.450", "[[cos x, −1],[1, −sin x]] [cos x; sin x] = [[1,0],[0,−1]] (×3)", "operator matrix acting on unit circle vector", ["ROT", "QUANTUM"], def() return chk(C(cos(pi() / 6) * cos(pi() / 6) - sin(pi() / 6), cos(pi() / 6) - sin(pi() / 6) * sin(pi() / 6)), C(1, -1)) end)
  eq("INV.451", "Σ_{k=0}^n cos kθ = sin((n+1)θ/2) / sin(θ/2) · cos(nθ/2)", "Lagrange cosine-sum identity", ["ROT"], def() return chk(hCD_cos_sum(5, 0.3), sin(6 * 0.3 / 2) / sin(0.3 / 2) * cos(5 * 0.3 / 2)) end)
  eq("INV.452", "Σ_{k=0}^n sin kθ = sin((n+1)θ/2) / sin(θ/2) · sin(nθ/2)", "Lagrange sine-sum identity", ["ROT"], def() return chk(hCD_sin_sum(5, 0.3), sin(6 * 0.3 / 2) / sin(0.3 / 2) * sin(5 * 0.3 / 2)) end)
  eq("INV.453", "sinθ = (e^(iθ) − e^(−iθ))/(2i) , cosθ = (e^(iθ) + e^(−iθ))/2 , tanθ = (e^(iθ) − e^(−iθ)) / (i(e^(iθ) + e^(−iθ)))", "Euler forms of trig functions", ["ROT"], def() return chk(cadd(cadd(cdiv(csub(cexp(C(0, 0.7)), cexp(C(0, -0.7))), C(0, 2)), cscale(cadd(cexp(C(0, 0.7)), cexp(C(0, -0.7))), 0.5)), cdiv(csub(cexp(C(0, 0.7)), cexp(C(0, -0.7))), cmul(C(0, 1), cadd(cexp(C(0, 0.7)), cexp(C(0, -0.7)))))), C(sin(0.7) + cos(0.7) + sin(0.7) / cos(0.7), 0)) end)
  eq("INV.454", "lim_{θ→0} sinθ/θ → 1 , lim_{θ→0} cosθ/θ → 1 (sic; diverges)", "trig limits", ["ROT"], def() return chk(sin(0.0001) / 0.0001 + cos(0.0001) / 0.0001, 1 + 1) end)
  eqs("INV.455", "(e^(iθ))' = 2 , ∇f = 2 , e^(iθ) = cos θ + i sin θ", "derivative set to 2 (sic)", ["ROT"])
  eqs("INV.456", "→ [ cos²θ + sinθ + cosθ − 2 sin²θ ] [[1,0],[0,−1]]", "trig combination times σ_z", ["ROT"])
  eq("INV.457", "2 sinθ cosθ = 2nλ sinθ", "Bragg-like / double-angle relation", ["ROT", "QUANTUM"], def() return chk(2 * sin(pi() / 6) * cos(pi() / 6), 2 * 1 * 0.5 * sin(pi() / 6)) end)
  eqs("INV.458", "lim_{θ→0} (1/θ)[sinθ; cosθ][[θ,1],[1,θ]][cosθ; sinθ] = [[1,0],[0,−1]] , f^(−1)(x) x f(x) = 1 (see INV.218)", "rotation limit σ_z", ["ROT", "QUANTUM"])
  eq("INV.459", "sinθ = λ/d , −p y1 sin 90° ≤ sinθ ≤ p y2 sin 90° , λ = h/(mv)", "diffraction + de Broglie", ["ROT", "QUANTUM"], def() return 6.62607015e-34 / (9.1093837e-31 * 1e6) end)
  eqs("INV.460", "λ2/λ1 = sinθ / sin(θ/2) , h , λ' ≥ 2h , ∫ sin 2θ = ||x − y||", "uncertainty-type bound", ["ROT", "QUANTUM"])
  eqs("INV.461", "D²ψ = ∇ ∫ (∇_i∇_j f)² dη", "second variation of psi", ["MANIFOLD"])
  eq("INV.462", "E = mc² , E = (1/2) m v² − (1/2) k x² , G_μν = (1/2) Λ g_ij , □ = (1/2) k T²", "energy forms", ["SR"], def() return 1 * C_LIGHT * C_LIGHT end)
  eqs("INV.463", "ker f / im f ≅ S^μν_m , S^μν_m = π(χ,x) ⊗ h_μν", "sheaf homology", ["MANIFOLD"])
  eqs("INV.464", "D²ψ = O(x)( p/c³ + V/S ) , V(x) = D²ψ ⊗ M+_3 , S^μν_m ⊗ S^μν_n = −2R_ij / V(τ) [D²ψ]", "sheaf/Selberg", ["MANIFOLD"])
  eqs("INV.465", "∇_i∇_j [S^mn_1 ⊗ S^mn_2] = ∫^{V(τ)} f(x) [D²ψ] = ∫^{V(τ)} f(x) O(x)", "Hessian of sheaf product", ["MANIFOLD"])
  eqs("INV.466", "z(x) = g(cx + d) / ( f(ax + b) h(ex + l) ) = ∫^{V(τ)} f(x) O(x)", "Möbius-like ratio", ["OTHER"])
  eqs("INV.467", "V(x)/f(x) = m(x) , O(x) = m(x)[D²ψ(x)] , (d/df)F = m(x) , ∫ F dx^m = Σ_{k=0}^∞ m(x)", "mass function (×4)", ["MANIFOLD"])
  eqs("INV.468", "∫ ∇ψ² d∇ψ = □ψ , □ψ = ∫ [D²ψ ⊗ h_μν] dm", "box-psi as integral", ["MANIFOLD"])
  eqs("INV.469", "O(x) = [ ∇_i∇_j ∫ ∇f(x) dη ]^(1/2) , δ·O(x) = [ ∇_i∇_j ∫ ∇g(x) dx_ij ]^(iy)", "real part 1/2 and imaginary iy split", ["ZETA"])
  eqs("INV.470", "||ds²|| = e^(−2πT|ϕ|) [ O(x) + δO(x) ] dx^μ dx^ν + lim_{n→1} Σ_{k=0}^∞ a_k f_k", "warped metric with critical-line operators", ["ZETA", "MANIFOLD"])
  eq("INV.471", "log(x log x) ≥ 2 (y log y)^(1/2) , (y log y)^(1/2) / log(x log x) ≤ 1/2", "entropy inequality (×5)", ["ENTROPY"], def() return sqrt(3 * log(3)) / log(3 * log(3)) end)
  eqs("INV.472", "δ(x) = (reality of value)/(exist of value) ≤ 1 ; log(x log x) = □ψ ; (y log y)^(1/2) = ∇ψ²", "quota metric of expansion/freeze-out", ["ENTROPY"])
  eqs("INV.473", "l(x) = 2x² + qx + r = (ax + b)(cx + d) + r , e^(l(x)) = (d/df) L(x) , G_μν = g(x) ∧ f(x)", "Weil quadratic", ["OTHER"])
  eqs("INV.474", "V(τ) = ∬ exp[L(x)] dx^m + O(N^(−1)) , g(x) = L(x) ∘ ∬ e^(2x² + 2x + r) dx^m", "lens-space path integral", ["QUANTUM"])
  eqs("INV.475", "||ds²|| = || (d/df) L(x) || , η = [∇_i∇_j ∫ ∇f(x) dη]^(1/2) , h̄ = [∇_i∇_j ∫ ∇g(x) d_ij]^(iy)", "KK decomposition", ["ZETA", "MANIFOLD"])
  eqs("INV.476", "(1/τ) ( N/2 + r(2ΔF − |∇f|² + R) + f ) mod N^(−1)", "W-entropy integrand (see INV.193)", ["ENTROPY"])
  eqs("INV.477", "(x²/a) cos x + (y²/b) sin x = r²", "curvature equation (rotated conic) (×2 incl INV.358)", ["ROT"])
  eq("INV.478", "S²_m = || ∫ π r² dr ||² , V(τ) = r² × S²_m , S^mn_1 ⊗ S^mn_2 = ∫ [D²ψ ⊗ h_μν] dm", "area-volume", ["MANIFOLD"], def() return pow(hCD_quad(def(r) return pi() * r * r end, 0, 1, 100), 2) end)
  eqs("INV.479", "V(x) = ∫ (1/√(2τq)) (exp L(x) dx) + O(N^(−1))", "reduced volume variant", ["MANIFOLD"])
  eqs("INV.480", "V(x) = 2 ∫ (R + ∇_i∇_j f) / −(R + Δf) e^(−f) dV , V(τ) = ∫ τ(p)^(−n/2) exp( −(1/√(2τq)) L(x) dx ) + O(N^(−1))", "Perelman reduced volume", ["MANIFOLD", "ENTROPY"])
  eqs("INV.481", "Zeta(x, h) = exp( q f(x) )^m / m", "\"zeta\" as exponential (Weil-type) (×2)", ["ZETA"])
  eqs("INV.482", "|x y z; u v w|² / g_μν(x) = ( f(x) dx^μ dx^ν, f'(y) dy^μ dy^ν, f''(z) dz^μ dz^ν ) · (u, v, w) = [[1,0,0],[0,1,0],[0,0,i]] ≅ g(x,y,z) / ( f(a,b,c) · h^(−1)(u,v,w) )", "complex duality matrix", ["MANIFOLD", "QUANTUM"])
  eqs("INV.483", "(d/df) ∭ □ψ dψ_xy = V(□ψ) , lim_{n→∞} Σ_{k=0}^∞ V_k(□ψ) = (∂/∂f) i h c", "quark emergence", ["QUANTUM"])
  eqs("INV.484", "lim_{n→∞} Σ_{k=0}^∞ G_μν = f(x) ∘ m(x) , V(x)/f(x) = m(x)", "universe", ["MANIFOLD"])
  eqs("INV.485", "(a_k f_k)' = nC0 a_0 f^n + nC1 a_1 f^(n−1) ... nC(r−1) a_n f^(n−1)", "binomial derivative", ["OTHER"])
  eqs("INV.486", "∫ a_k f_k dx_k = (a_(n+1)/(k+1)) f^(n+1) + (a_(k+2)/(k+2)) f^(k+2) + ... + (a_0/k) f_k", "termwise integration", ["OTHER"])
  eqs("INV.487", "(∂/∂f) □ψ = (1/4) g²_ij (×2) , ( ∇ψ² / □ψ )' = 0 (×2)", "box-psi rate", ["MANIFOLD"])
  eqs("INV.488", "(y log y)^(1/2) / log(x log x) = (1/2)/(1/(2i))", "entropy ratio = i", ["ENTROPY"])
  eqs("INV.489", "{f,g}/[f,g] = 1/i , ({f,g}/[f,g])' = i² , (i)² → (1/4) g_ij , F_m^t = (1/4) g²_ij , f(r) = (1/4)|r|² , 4 f(r) = g²_ij", "fermion/boson quotient", ["QUANTUM"])
  eqs("INV.490", "(1/y)·(1/y')·(y''/y')·(y'''/y'')··· = nCr y2·y3··· / (nCr y1 y2 ···)", "derivative ratio product", ["OTHER"])
  eqs("INV.491", "(∂y/∂x)·(∂/∂y) f(y) = y' · f'(y)", "chain rule", ["OTHER"])
  eqs("INV.492", "∫ l × l dm = (l ⊕ l) m , = (d/dx^μ)(d/dx^ν) f_μν · ∇ψ² = □ψ", "Planck-scale symmetry", ["OTHER"])
  eq("INV.493", "∇ψ² / □ψ = 1/2 , l = 2πr , V/S = (4πr³)/(4πr³) (sic) , 2πr = 2·(πr²) = πr² , H3 = 2 , π(H3) = 0", "circle circumference/area (sic)", ["OTHER"], def() return chk((4 / 3 * pi() * pow(2, 3)) / (4 * pi() * pow(2, 2)), (4 * pi() * pow(2, 3)) / (4 * pi() * pow(2, 3))) end)
  eqs("INV.494", "f(r) = (1/2) √(1 + f'(r)) / f(r) + m g f(r)", "Euler–Lagrange radial function (×2)", ["OTHER"])
  eqs("INV.495", "S^m_n = | S2 S1 − S1 S2 | , □ψ = V · S^m_n , G_μν ≅ R_μν", "commutator of surfaces", ["MANIFOLD"])
  eqs("INV.496", "∇_i∇_j(□ψ) dψ_xy = (∂/∂f) □ψ · T_μν = (8πG/c⁴)(T_μν)² , (χ ⊕ π) = ∭ □ψ d³ψ = div(rot E, E1) · e^(−i x log x)", "squared Einstein + Maxwell phase", ["ROT", "SR", "ENTROPY"])
  eqs("INV.497", "σ(H_n ⊗ K_m) = E_n × H_m , H_n = [∇_i∇_j ∫ ∇g(x) dx_i dx_j]^(iy) , K_m = [∇_i∇_j ∫ ∇f(x) dη]^(1/2)", "Von Neumann world line", ["ZETA", "MANIFOLD"])
  eqs("INV.498", "||ds²|| = | σ(H_n × K_m) , σ(χ,x) × π(χ,x) = (∂/∂f) L(x) , V'_τ(x) = (∂/∂V) L(x) (×2)", "network theorem", ["MANIFOLD"])
  eqs("INV.499", "(□ψ)' = (∂/∂f) ⊕ ( ∭ f(x,y,z) dx dy dz )' dψ ; V'_τ(x) = same (×3)", "box-psi derivative", ["MANIFOLD"])
  eqs("INV.500", "(∂/∂V) L(x) = V(τ) ∬ e^(∫ x log x dx + O(N^(−1))) dψ", "Lagrangian volume derivative", ["ENTROPY"])
  eqs("INV.501", "(d/df) Σ_{k=1}^n Σ_{k=0}^∞ a_k f_k = (d/df) m(x) , V(x)/f(x) = m(x)", "mass series", ["OTHER"])
  eqs("INV.502", "4 V'_τ(x) = g²_ij , (d/dl) L(x) = σ(χ,x) × V_τ(x)", "volume derivative = metric square", ["MANIFOLD"])
  eqs("INV.503", "||ds²|| = e^(−2πT|ψ|)[η_μν + h̄_μν(x)] dx^μ dx^ν + T² dψ² (×3 more)", "warped metric", ["MANIFOLD"])
  eqs("INV.504", "f^(2)(x) = [ ∇_i∇_j ∫ ∇f^(5) dη ]^(1/2) = [ f^(2)(x) dη ]^(1/2)", "fifth-dim reduction", ["MANIFOLD"])
  eqs("INV.505", "∇_i∇_j ∫ F(x) dη = (∂/∂f) F , ∇f = (d/dx) f , ∇_i∇_j ∫ ∇f dη = (∂/∂x_i)(∂/∂x_j)((d/dx) f)", "Hessian identifications", ["MANIFOLD"])
  eqs("INV.506", "(z3 z2 − z2 z3)/(z2 z1 − z1 z2) = ω , (z̄3 z2 − z̄2 z3)/(z̄2 z1 − z̄1 z2) = ω̄ , ω · ω̄ = 0 , z_n = ω − {x} , z_n · z̄_n = 0 , z⃗_n · z̄⃗_n = 0", "complex cross-ratio network", ["ROT"])
  eqs("INV.507", "[f, g] × [g, f] = fg + gf = {f, g}", "commutator product = anticommutator (sic)", ["QUANTUM"])
  eqs("INV.508", "V(τ) = ∬ e^(∫ x log x + O(N^(−1))) dψ", "route-entropy volume (×3)", ["ENTROPY"])
  eqs("INV.509", "(□ψ)' = 4 v⃗(x) , (∂/∂V) L(x) = m(x) , V(τ) = ∫ (1/√(2τq)) exp[L(x)] dψ + O(N^(−1))", "velocity / volume", ["MANIFOLD"])
  eqs("INV.510", "V(τ) = ∭ V/S² dm , f(r) = ... , log(x log x) ≥ 2(y log y)^(1/2) , F_m^t = (1/4) g²_ij , (d/dt) g_ij(t) = −2R_ij", "summary bundle", ["MANIFOLD", "ENTROPY"])
  eq("INV.511", "∇_i∇_j v = (1/2) m v² + m c² , ∫ ∇_i∇_j v dv = (∂/∂f) L(x)", "relativistic energy as Hessian", ["SR"], def() return 0.5 * 1 * 1e7 * 1e7 + 1 * C_LIGHT * C_LIGHT end)
  eqs("INV.512", "(□ψ)² = −2 ∫ ∇_i∇_j v d²v , (□ψ)² = ( ∇ψ²/□ψ )' = (d/df) ∬_1 (x log x)² dm", "box-psi squared", ["ENTROPY"])
  eqs("INV.513", "⊕ ∇M+_3 = ∫ ∨(R + ∇_i∇_j f)² / ∃(R + Δf) dV = (x,y,z)·(u,v,w)/Γ", "3-manifold direct sum", ["GAMMA", "MANIFOLD"])
  eqs("INV.514", "⊕ C+− = ∫ exp[ ∫ ∇_i∇_j f dη ] dψ = L(x) · (∂/∂l) F(x) = (□ψ)²", "complex sum = path integral", ["QUANTUM"])
  eq("INV.515", "l = √(hG/c³) , T_μν = (1/2) k l² + (1/2) m v² , E = mc² − (1/2) m v²", "Planck length (h not ℏ) and energies", ["SR", "QUANTUM"], def() return sqrt(6.62607015e-34 * 6.674e-11 / pow(C_LIGHT, 3)) end)
  eq("INV.516", "e^(x log x) = x^x , x = log x^x / log x , y = x , x = e", "x^x identity", ["ENTROPY"], def() return chk(exp(2.5 * log(2.5)), pow(2.5, 2.5)) end)
  eqs("INV.517", "∫_1 (x log x) dx = i ∫ x log x dx + ∫_1 (x log x) dx", "variant of INV.29 with +", ["ENTROPY"])
  eqs("INV.518", "∬_1 (x log x)² dx^m = i (1/2) x² ; ∬_1 (x log x)² dx^m = i ∬_M dx^m ≤ 1/(2i) + x²", "entropy bounds", ["ENTROPY"])
  eq("INV.519", "E = −(1/2) m v² + m c² (×4 overall)", "\"relativistic\" energy minus kinetic", ["SR"], def() return 0 - 0.5 * 1 * 1e7 * 1e7 + 1 * C_LIGHT * C_LIGHT end)
  eqs("INV.520", "lim_{x→∞} ∬_1 (x log x)² dx^m ≥ 1/(2i) , (d/df) ∬_1 (x log x)² dx^m = 1/(2i)", "entropy limit", ["ENTROPY"])
  eq("INV.521", "lim_{x→∞} x² / e^(x log x) = 0", "x²/x^x → 0", ["ENTROPY"], def() return 10 * 10 / exp(10 * log(10)) end)
  eqs("INV.522", "∫ dx → ∂f → dx → cons", "operator chain", ["OTHER"])
  eqs("INV.523", "(□ψ)' = ( ∃ ∫ ∨(R + ∇_i∇_j f) e^(−f) dV )' dψ", "heat equation entropy flow", ["MANIFOLD", "ENTROPY"])
  eqs("INV.524", "⊕ M+_3 = (∂/∂f) L(x) , (∂/∂l) L(x) = ∇_i∇_j ∫ ∇f(x) dη , L(x) = V(x)/f(x) , l(x) = L'(x)", "Lagrangian relations", ["MANIFOLD"])
  eqs("INV.525", "V'(τ) = ∬ e^(∫ x log x dx + O(N^(−1))) dψ ; F = same", "Weil's theorem integral (×2)", ["ENTROPY"])
  eqs("INV.526", "T_μν = ∭ V(x)/S² dm , S² = π r² · S(x) = 4π r³ / τ(x)", "stress from volume/area", ["MANIFOLD"])
  eqs("INV.527", "η = ∇_i∇_j ∫ ∇f(x) dη , h̄ = ∇_i∇_j ∫ ∇g(x) dx_i dx_j , δO(x) = [∇_i∇_j ∫ f(x) dη]^(1/2+iy)", "metric pieces", ["ZETA", "MANIFOLD"])
  eqs("INV.528", "Z(x, h) = lim_{x→∞} Σ_{k=0}^∞ q T^m / m = δ(x)", "zeta generating series", ["ZETA"])
  eqs("INV.529", "l(x) = 2x² + p x + q , m(x) = lim_{x→∞} Σ_{k=0}^∞ (q x^m)' / f(x)", "quadratic and mass", ["OTHER"])
  eq("INV.530", "Z(T, X) = exp( Σ_{m=1}^∞ q^k T^m / m ) , Z(x, h) = exp( q f(x) )^m / m", "Weil (Hasse–Weil) zeta function", ["ZETA"], def() return chk(hCD_weil_p1(2, 0.1), 1 / ((1 - 0.1) * (1 - 2 * 0.1))) end)
  eqs("INV.531", "lim_{x→1} mesh m/(m+1) = 0 , ∫ x^m = x^m/(m+1) (sic; x^{m+1}/(m+1))", "power integral", ["OTHER"])
  eq("INV.532", "(d/df) ∫ x^m = m x^m , lim_{x→1} mesh(x) = lim_{m→∞} m/(m+1) , lim_{x→1} Σ a_k f_k = α", "mesh limits", ["OTHER"], def() return 1000 / (1000 + 1) end)
  eqs("INV.533", "(∂/∂V) ||ds²|| = T_μν , V(τ) = ∫ e^(x log x) dψ = l(x)", "metric volume derivative = stress", ["MANIFOLD"])
  eqs("INV.534", "R_ij = (∂/∂x_i)(∂/∂x_j) T_μν , G_μν = R_μν T_μν", "Ricci as Hessian of stress", ["MANIFOLD"])
  eqs("INV.535", "F(x) = ∬ e^(∫ x log x dx + O(N^(−1))) dψ , (d/dV) F(x) = V'(x)", "route integral", ["ENTROPY"])
  eqs("INV.536", "T_μν = R_μν , T_μν = ∭ V/S² dm , δO(x) = [D²ψ ⊗ h_μν] dm", "stress = Ricci", ["MANIFOLD"])
  eqs("INV.537", "∇(□ψ)' = [ ∇_i∇_j ∫ ∇f(x) dη ]^(1/2+iy)", "critical-line gradient", ["ZETA"])
  eqs("INV.538", "( f(x), g(x) )' = (A_μν)' [[d_x, δ(x)],[ε(x), ∂_x]] · ( f(x,y), g(x,y) ) = [[1,0],[0,−1]]", "complex variable ODE matrix", ["QUANTUM"])
  eq("INV.539", "δ(x) · O(x) = [[1,0],[0,−1]]^(1/2)", "operator = sqrt(σ_z)", ["QUANTUM"], def() return cpow(C(-1, 0), C(0.5, 0)) end)
  eqs("INV.540", "p = e^(x log x), e^(−x log x) ; p = ⊕ (iℏ∇) ⊕ L", "prime range via x^x", ["ZETA", "QUANTUM"])
  eqs("INV.541", "||ds²|| = 0, 1 (Hilbert manifold of genus 3)", "metric norm values", ["MANIFOLD"])
  eqs("INV.542", "||ds²|| = e^(−2πT||ψ||)[η_μν + h̄(x)] dx^μν + T² d²ψ = [∞]/e^(−2πT||ψ||) + T² d²ψ ≥ [∞]/e^(−2πT||ψ||) · T² d²ψ = (n/(n+1)) Γ_n = ∫ e^(−x) x^(1−t) dx", "metric → gamma", ["GAMMA", "MANIFOLD"])
  eqs("INV.543", "lim_{x=∞} Σ_{x=0}^∞ n/(n+1) = a_k f_k", "series", ["OTHER"])
  eq("INV.544", "β(p,q) = ∫ e^(−sinθ cosθ) ∫ sinθ cosθ dθ = ∫ Γ(γ)' dx^m", "beta via rotation integral", ["ROT", "GAMMA", "BETA"], def() return hCD_quad(def(t) return exp(0 - sin(t) * cos(t)) end, 0, pi() / 2, 100) * hCD_quad(def(t) return sin(t) * cos(t) end, 0, pi() / 2, 100) end)
  eqs("INV.545", "∫ Γ(γ)' dx^m = ∫ Γ dx^m · (d/dγ) Γ ≤ ∫ Γ dx^m + (d/dγ) Γ = ⊕(iℏ∇)⊕L' ∫ ⊕(iℏ∇)⊕L dx^m , ⊕(iℏ∇)⊕L = n", "gamma inequality (repeat of INV.100)", ["GAMMA", "QUANTUM"])
  eq("INV.546", "β(p,q)^(−1) = Γ(p)Γ(q)/Γ(p+q) (sic; this is β itself)", "inverse beta", ["GAMMA", "BETA"], def() return chk(1 / beta(2, 3), gamma(2) * gamma(3) / gamma(5)) end)
  eq("INV.547", "√g = 1 ; Γ(p+q)/(Γ(p)Γ(q)) = β(p,q) (sic; = 1/B)", "\"Fermat theorem\" from factoring", ["GAMMA", "BETA"], def() return chk(gamma(5) / (gamma(2) * gamma(3)), beta(2, 3)) end)
  eqs("INV.548", "x^n + y^n ≥ z^n", "Fermat inequality form", ["OTHER"])
  eqs("INV.549", "(Γ(p)Γ(q))² − Γ(p,q)² = 0 ; (Γ(p)Γ(q) − Γ(p,q))(Γ(p)Γ(q) + Γ(p,q)) = 0", "difference of squares for gamma", ["GAMMA"])
  eq("INV.550", "( (d/dγ) Γ'(γ) ) ( ∬ Γ'(γ) dx^m ) ( e^π − π^e ) = (□ − □')(□ + □')", "factorisation into gravity/antigravity", ["GAMMA", "OTHER"], def() return exp(pi()) - pow(pi(), hCD_e()) end)
  eq("INV.551", "( 2(sin(i x log x) + cos(i x log x)) )( cos(i x log x) − i sin(i x log x) ) / ( 2(sin(i x log x) + cos(i x log x))( cos(i x log x) + i sin(i x log x) ) ) = 0", "ratio of circle functions (claimed 0)", ["ROT", "ENTROPY"], def() return chk(cdiv(cmul(cscale(cadd(csin(C(0, 2 * log(2))), ccos(C(0, 2 * log(2)))), 2), csub(ccos(C(0, 2 * log(2))), cmul(C(0, 1), csin(C(0, 2 * log(2)))))), cmul(cscale(cadd(csin(C(0, 2 * log(2))), ccos(C(0, 2 * log(2)))), 2), cadd(ccos(C(0, 2 * log(2))), cmul(C(0, 1), csin(C(0, 2 * log(2))))))), C(0, 0)) end)
  eqs("INV.552", "= (99 − 96)(94 + 92)(90 − 87)(85 + 82)(80 − 78) ··· = 0", "alternating prime-ish product", ["ZETA"])
  eq("INV.553", "β(p,q)^(−1) = 1 / ( (5−3)(7+13)(17−19)(23+29)(31−37)(41+47)(51−53) ··· ) = 1/( 2·20·(−2)·52·(−6)·88·(−2) ··· ) = ∫_1 β(p,q) dx = ∫_1 t² dt", "prime-pair product for inverse beta", ["ZETA", "BETA"], def() return chk(1 / ((5 - 3) * (7 + 13) * (17 - 19) * (23 + 29) * (31 - 37) * (41 + 47) * (51 - 53)), 1 / (2 * 20 * (-2) * 52 * (-6) * 88 * (-2))) end)
  eq("INV.554", "( β(p,q) − β(p,q)^(−1) )( β(p,q) + β(p,q)^(−1) ) = 0", "β = ±1/β ⇒ β² = 1", ["BETA"], def() return chk((beta(2, 3) - 1 / beta(2, 3)) * (beta(2, 3) + 1 / beta(2, 3)), 0) end)
  eqs("INV.555", "Γ(2) = β(5, −3) = Γ(5)Γ(−3)/Γ(5−3)", "Γ(2) via beta with negative arg (sic; Γ(−3) is a pole)", ["GAMMA", "BETA"])
  eq("INV.556", "Γ(2) = ∫ e^(−2) 2^(t−1) dx = √e = ζ(s)", "claimed Γ(2)=√e=ζ(s) (sic)", ["GAMMA", "ZETA"], def() return chk(gamma(2), sqrt(hCD_e())) end)
  eq("INV.557", "β(p,q) = Γ(−1) = −1/12", "claimed; relates to ζ(−1)=−1/12 (Γ(−1) is actually a pole) (×3)", ["GAMMA", "ZETA", "BETA"], def() return zeta(-1) end)
  eq("INV.558", "x = (1/(2πi)) log( √(1 − 1/□²) )", "\"complex manifold of special relativity\": log of Lorentz factor sqrt(1−1/□²) (×2)", ["ROT", "SR"], def() return cdiv(clog(C(sqrt(1 - 1 / ((1 / 0.6) * (1 / 0.6))), 0)), C(0, 2 * pi())) end)
  eqs("INV.559", "□ = 2( sin(i x log x) + cos(i x log x) )", "box (antigravity) circle function (repeat of INV.6)", ["ROT"])
  eq("INV.560", "Γ(5) = 3 = □ = 3 ; Γ(3) = 2 = □ = 2 ; Γ(2) = 1 = □ = 1", "prime rank ↔ gamma (sic; Γ(5)=24, Γ(3)=2, Γ(2)=1)", ["GAMMA", "ZETA"], def() return chk(gamma(5), 3) end)
