  eq("EXP.151", "C = ∬_1 (x log x)² dx^m", "Euler constant as squared-entropy integral (claim)", ["ZETA", "ENTROPY"], def() return chk(hCD_mid(def(x) return x * log(x) * x * log(x) end, 0, 1, 2000), 0.5772156649) end)
  eq("EXP.152", "(D_m, d_x)·(cosθ, sinθ) × (d_x, ∂_m)·(cosθ, sinθ) ; [[1,0],[0,i]] β(x,θ) [x; y] = [[i,0],[0,−1]] ; l = √(ℏG/c³) (=INV.370-372) (×2)", "rotation operator / Planck length", ["ROT", "BETA", "QUANTUM"], def() return sqrt(1.054571817e-34 * 6.674e-11 / pow(C_LIGHT, 3)) end)
  eqs("EXP.153", "( ∂/∂τ f(x,y,z) )^(3') = A_μν , (d/dt) g_ij(t) = −2R_ij (=INV.373)", "gauge field", ["MANIFOLD"])
  eqs("EXP.154", "x^y = 1/y^x →", "reciprocity (=INV.10)", ["OTHER"])
  eqs("EXP.155", "π(χ,x) = [ iπ(χ,x), f(x) ] , (d/df) F = F f'", "commutator, derivative", ["QUANTUM"])
  eqs("EXP.156", "SiO2 prism; (Al, Mg) → S; material list: Cs, Fe·Co60·Pt·Al alloy, H2SO4, Al2O3, He, H2, Mg, Al (heat), CnH2n", "\"UFO materials\" chemistry notes", ["OTHER"])
  eqs("EXP.157", "(∂/∂f) F(x) = ∬ cohom D_k(x) [Im] ; (∂/∂f)F = ^t∬ cohom D_k(x) ≪ p = □' (=INV.114/115) (×6)", "cohomology D-brane", ["MANIFOLD"])
  eqs("EXP.158", "∇_i∇_j ∫ f(x) dη = ∂²/(∂x∂y) ∫ □' dη (=INV.116)", "Hessian", ["MANIFOLD"])
  eq("EXP.159", "R'_μν + (1/2) Λ g'_ij = ∫ ( i v/√(1−(v/t)²) + v/√(1−(v/t)²) ) dvol = (d/df)∬(x log x)² dx^m + (d/df)∬(y log y)^(1/2) dy^m = ∫ C dx^m = ∫ κ T_μν dx^m = T_μν T^μν' (=INV.117/118, EXP.19)", "Einstein ↔ Lorentz-factor ↔ entropy chain", ["SR", "ENTROPY"], def() return C(0.8 / sqrt(1 - 0.8 * 0.8), 0.8 / sqrt(1 - 0.8 * 0.8)) end)
  eqs("EXP.160", "□' = (8πG/c⁴) T_μν / log x ; ^t∭ cohom D_χ[Im] = ∮ (p x^n + q x + r) ∇_l ; (d/dl) L(x,y) = 2∫||sin 2x||² dτ (=INV.119-121)", "antigravity etc.", ["ROT", "SR"])
  eqs("EXP.161", "∯ ≅ ||ds²|| = lim_{x→∞}[ δ(x) ∭ π(Σ ⁿ√p, x/n)^(1/2) dτ ]_μν ; e^(−2πT||ψ||)[η + h̄] dx^μ dx^ν + T² d²ψ (=INV.122/123)", "metric norm", ["ZETA", "MANIFOLD"])
  eqs("EXP.162", "−(16πG/c⁴) T_μν / log x = □' ; −(16πG/c⁴) T_μν / e^(−2πT||ψ||) = 4πGρ (=INV.124)", "Einstein/Poisson", ["SR"])
  eqs("EXP.163", "∂/(∂x∂y) = ∇_i∇_j ; □∭ = ^t∭ ; (∂/∂x)∭ = ∇_i∇_j ∫∇f(x) dη ; (∂/∂f)∭ = □∭ ; Γ|Γ, B|B, E|E, C|C, F|F, β|β, D|D, ^t∬ ≅ ⊕ D ⊕ L (=INV.125/126)", "operator identifications", ["GAMMA", "BETA", "MANIFOLD"])
  eqs("EXP.164", "□ + □' = ∅ , □' | ∅ = □ , [[1,0],[0,−i]]^(1/2) [[1,0],[0,−i]] , x^(1/2) ≅ x , ∅^(1/2) = ∅ (=INV.127-129)", "empty-set box identities", ["QUANTUM"])
  eqs("EXP.165", "∫^{≪n} ||ds²|| = ∭ 8πG ( p/c³ + V/S ) dx dy dz = (∂/∂f^n) ||ds²||", "entropy of 3-manifold as metric integral", ["SR", "ENTROPY"])
  eqs("EXP.166", "∮ r dx^m = O(x,y) ; ^t∭ D(χ,x) Hom[D²ψ] ≪ p ≅ vol(V/S) (=INV.130/131) (×2)", "cohomology volume", ["MANIFOLD"])
  eqs("EXP.167", "(d/df)F = (F)f' , ∫F dx^m = (F)f , (d/df)∬_1(x log x)² dx^m = ∬_1(x log x)² dx^m , f'/f' = 2x(log x + log(x+1)) , ∬F dx^m = (1/(x log x)²)(∫2x(log x+log(x+1))dx) = e^(−f) , (d/df)F = (1/(x log x)²)(2x(log x + log(x+1))) = e^f (=INV.132-136) (×2)", "derivative/integral pair", ["ENTROPY"])
  eqs("EXP.168", "log(x log x) ≥ 2 (y log y)^(1/2) = 2√(y log y) (=INV.137) (×3)", "entropy inequality", ["ENTROPY"])
  eqs("EXP.169", "||ds²|| = 8πG(p/c³ + V/S) ; ∫||ds²|| dx^m = ∫ 8πG(p/c³ + V/S) dvol = ... dy^m = ∫_1 ... dx^m (=INV.45/138)", "integrated metric norm", ["SR"])
  eqs("EXP.170", "(d/df)F = m(x) , ⊕ iℏ∇ ⊕ L = ∇_i∇_j ∫ ∇f(x) dη , dx^m = y/log x , dy^m = x/log x , e^(−f) dV = dy^m = dvol (=INV.139-141)", "measure definitions", ["MANIFOLD"])
  eqs("EXP.171", "β(p,q) = (number) + Abel manifold = AdS5 manifold = (d/df)F + ∫ C dx^m = ∫ Γ(γ)' dx^m (=INV.142) (×2)", "beta = AdS5", ["GAMMA", "BETA"])
  eqs("EXP.172", "||ds²|| = e^(−2πG||ψ||)[η + h̄(x)] dx^μ dx^ν + T² d²ψ (=INV.143)", "warped metric", ["MANIFOLD"])
  eqs("EXP.173", "∫ dvol = □ψ , ∫ ∇ψ² d∇ψ = □ψ (×2) ; expanding = log(x log x) = □ψ ; freeze-out = (y log y)^(1/2) = ∇ψ (=INV.144-146)", "cosmology entropy", ["ENTROPY"])
  eqs("EXP.174", "x^n + y^n = z^n , β(p,q) = x^n + y^n − δ(x) = z^n − δ(x) ; (d/dt)g_ij = −2R_ij ; cos x/((cos x)'·(sin x)') = z^n , z^n = −2e^(x log x) ; z = e^(−f) + e^f − y ; β(p,q) = e^(−f) + e^f (=INV.147-150) (×2)", "Fermat–beta–Ricci", ["ROT", "BETA", "MANIFOLD"])
  eqs("EXP.175", "□x = ∫^{f(x)} ∇(R+∩E+) d□x = ∫^{Δf(x)∘E+} ∇(R+∩E+) □x ; □x = ∫^{d(R∇E+)} ... = ∫^{∇i∇j(R+E+)} ... ; exp(∇(R+∩E+), Δ(C⊃R)) = π(R1⊂∇E+) = rot(E1, div E2) (=INV.151-153)", "box-x integrals", ["ROT", "MANIFOLD"])
  eq("EXP.176", "x f(x) = F(x) , s Γ(s) = Γ(s+1) ; Q∇C+ = (d/df)F(x) ∇ ∫ δ(s) f(x) dx ; E+∇f = e^(x log x) ∇ n! f(x) / E(x) ; (d/df)F F f' = e^(x log x) ; (C∇)⊕Q = e^(x log x) ; R∇E+ = f(x)∇e^(x log x) (=INV.154-158)", "gamma recurrence etc.", ["GAMMA", "ENTROPY"], def() return chk(gamma(4.3), 3.3 * gamma(3.3)) end)
  eqs("EXP.177", "∫ δ(x) f(x) dx ; ∫ ∇ψ² d∇ψ = □ψ ; ∫ dx = x + C (=INV.159)", "misc", ["OTHER"])
  eq("EXP.178", "β(p,q) = ∫ x^(1−t)(1−x)^t dx = ∫ t^x(1−t)^(x−1) dt ; ∫_0^1 x^10(1−x)^20 dx = B(11,21) = 10!20!/31! = 1/931395465 ; series 1/(1−z), 1/(1+z²) ; d^n y/dx^n = n! y^(n+1) ; dy/dx = y² → y = 1/(1−x) (=INV.160-168, EXP.99-103) (×3 overall)", "beta example & ODE", ["GAMMA", "BETA"], def() return chk(931395465 * fact(10) * fact(20) / fact(31), 931395465 / 931395465) end)
  eqs("EXP.179", "(dx, ∂x)·(εx, δx) = [[1,0],[0,−1]]^(1/2) , (d/df)F = m(x) (=INV.169)", "sqrt σ_z", ["QUANTUM"])
  eqs("EXP.180", "□( (σ1 + σ2)/2 ) = [ 3π(χ,x) ∘ f(x), σ(x) ]", "box of averaged Pauli/spin = commutator", ["ROT", "QUANTUM"])
  eqs("EXP.181", "□ψ = 8πG T_μν , (d/dt) g_ij(t) = −2R_ij , ∇ψ² = 4πGρ", "Einstein / Ricci / Poisson", ["SR", "MANIFOLD"])
  eqs("EXP.182", "□(σ1 + σ2) = [ 6π(χ,x) ∘ f(x), σ(x) ] = [ iπ(χ,x), f(x) ] ; □ψ = [ 12π(χ,x) ∘ f(x), σ(x) ]", "spin-sum commutators (3,6,12 multiples)", ["QUANTUM"])
  eqs("EXP.183", "(d/df) F = ∫ e^(−f) [ −Δv + R_ij v_ij + ∇_i∇_j f + v ∇_i∇_j + 2<f,h> + (R + ∇f)(v/2 − h) ] = [ iπ(χ,x), f(x) ]", "Perelman variation = commutator (time route)", ["QUANTUM", "ENTROPY"])
  eqs("EXP.184", "f^(−1)(x) x f(x) = 1 , H_m = E_m × K_m", "conjugation identity", ["QUANTUM"])
  eq("EXP.185", "i = (1,0)·(1,0) (sic) , e^(iθ) = cosθ + i sinθ , e^(−iθ) = cosθ − i sinθ", "Euler and conjugate", ["ROT"], def() return chk(cadd(C(1 * 1 + 0 * 0, 0), cexp(C(0, 0 - 0.7))), cadd(C(0, 1), C(cos(0.7), 0 - sin(0.7)))) end)
  eq("EXP.186", "sinθ = (e^(iθ) − e^(−iθ))/(2i) , sin(iθ) = (e^(−θ) − e^θ)/2 (sic; = i sinh θ)", "sine/imaginary sine", ["ROT"], def() return chk(csin(C(0, 1)), C((exp(-1) - exp(1)) / 2, 0)) end)
  eqs("EXP.187", "π(χ,x) = cosθ + i sinθ", "fundamental group as unit phase", ["ROT", "MANIFOLD"])
  eq("EXP.188", "R(−α) = [[cosα, sinα],[−sinα, cosα]] , R(α) = [[cosα, −sinα],[sinα, cosα]]", "2D rotation matrices", ["ROT"], def() return chk(at(at(hCD_mm2([[cos(0.3), sin(0.3)], [0 - sin(0.3), cos(0.3)]], hCD_rot(0.3)), 0), 0), 1) end)
  eq("EXP.189", "R(α) M R(−α) = R(α)[[1,0],[0,−1]]R(−α) = [[cos²α − sin²α, 2 sinα cosα],[2 sinα cosα, −cos²α + sin²α]] = [[cos 2α, sin 2α],[sin 2α, −cos 2α]]", "conjugating σ_z by rotation = reflection at 2α (correct)", ["ROT", "QUANTUM"], def() return chk(hCD_mdiff2(hCD_mm2(hCD_mm2(hCD_rot(0.3), [[1, 0], [0, -1]]), hCD_rot(-0.3)), [[cos(0.6), sin(0.6)], [sin(0.6), 0 - cos(0.6)]]), 0) end)
  eqs("EXP.190", "[[cosα, −1],[1, −sinα]] [cosα; sinα] = [[1,0],[0,−1]] (=INV.450)", "operator on unit vector", ["ROT"])
  eqs("EXP.191", "[[cosα, sinα],[sinα, −cosα]] [x; y] = [[1,0],[0,−1]] (=INV.449)", "reflection", ["ROT"])
  eqs("EXP.192", "lim_{θ→0} (1/θ)[sinθ; cosθ][[θ,1],[1,θ]][cosθ; sinθ] = [[1,0],[0,−1]] ; f^(−1) x f(x) = 1 (=INV.218)", "rotation limit", ["ROT"])
  eq("EXP.193", "(log x)' = 1/x , x^n + y^n = z^n , x^n = −y^n + c , n x^(n−1) = −n y^(n−1) y' , y' = n x^(n−1)/(n y^(n−1)) = x^(n−1)/y^(n−1) = −(y/x)·(x/y)^n", "implicit differentiation of Fermat curve (sign sic)", ["OTHER"], def() return chk(pow(1 / 2, 3 - 1), 0 - (2 / 1) * pow(1 / 2, 3)) end)
  eq("EXP.194", "−cos x / ((cos x)'(sin x)') = z^n , z^n = −2 e^(x log x)", "trig ratio = Fermat power", ["ROT"], def() return chk((0 - cos(1)) / ((0 - sin(1)) * cos(1)), 0 - 2 * exp(1 * log(1))) end)
  eqs("EXP.195", "lim_{x→∞} f(x) = a , lim_{y→∞} f(y) = b , lim_{x,y→∞} {f(x) + f(y)} = a + b", "limit sum rule", ["OTHER"])
  eqs("EXP.196", "lim_{z→0} f(z) = c , δ ∫ z^n = (d/dV) x³ ; lim_{x→∞} = c − lim f(y) · lim f(x) + lim f(y) = lim_{z→∞} f(z)", "limit relations", ["OTHER"])
  eq("EXP.197", "z^n = cos nθ + i sin nθ = −2 e^(x log x)", "de Moivre = gravity/antigravity", ["ROT"], def() return chk(cpow(cexp(C(0, 0.4)), C(3, 0)), C(cos(3 * 0.4), sin(3 * 0.4))) end)
  eqs("EXP.198", "(d/dσ)[ (σ1 + σ2)/2 ] = σ(↿⇃) + σ(⇈) + σ(⇊) + σ(⇔) + σ(⇒)", "spin-configuration sum", ["QUANTUM"])
  eqs("EXP.199", "(d/df) ∬_1 (x log x)² dx^m = σ(↾) ; (d/df) ∬_1 (y log y)^(1/2) dy^m = σ(⇂)", "entropy integrals as spin states", ["QUANTUM", "ENTROPY"])
  eqs("EXP.200", "σ(↢) + σ(↣) = ∫ e^(−f) [ −Δv + R_ij v_ij + ∇_i∇_j v + v∇_i∇_j + 2<f,h> + (R + ∇f)(v − h/2) ]", "spin sum = Perelman variation", ["QUANTUM", "ENTROPY"])
  eqs("EXP.201", "σ(⇃) = σ(↾⇂ + ⇈ + ⇒) , σ(↿) = σ(↾⇂ + ⇊ + ⇔) , weak electric theorem = σ(↿) , strong electric theorem = σ(⇃)", "force assignment to spin states", ["QUANTUM"])
  eqs("EXP.202", "C = ∫_1 x^s dx − log x = ∬(∫_1 x^s dx − log x) dvol = ∬_1 x^s dvol − ∫ log x dvol", "Euler constant representation (Higgs + Euler = Zeta)", ["ZETA"])
  eqs("EXP.203", "= (d/df) ∬_1 (y log y)^(1/2) dy^m − ∫ e^(−x) x^(1−t) log x dx^m ; ∫ x^(1−t) e^(−x) dV = ∫ x^(1−t) dm = ∫ x^(1−t) dvol ; f = γ = Γ' = ∫ e^(−x) x^(1−t) log x dx = (d/dγ)Γ^(−1) − (γ)γ' = e^(−f) − e^f (=EXP.65-67)", "digamma chain", ["GAMMA"])
  eqs("EXP.204", "e^(−f) − e^f = (d/df)∬_1 (y log y)^(1/2) dy^m − (d/df)∬_1 (x log x)² dx^m = 2 cos(i x log x)", "difference of entropy integrals = 2cos (sic: −2sinh f)", ["ROT", "ENTROPY"])
  eqs("EXP.205", "(d/df)∬_1 (y log y)^(1/2) dy^m + (d/df)∬_1 (x log x)² dx^m = (d/df)F = 2i sin(i x log x)", "sum of entropy integrals = 2i sin", ["ROT", "ENTROPY"])
  eqs("EXP.206", "(d/df) F + ∫ C dx^m = 2( cos(i x log x) + i sin(i x log x) ) = 2 e^(−θ) = 2 e^(−i x log x) = (d/dt) g_ij(t) = −2R_ij", "F + Euler const = 2e^{−i x log x} = Ricci flow", ["ROT", "MANIFOLD", "ENTROPY"])
  eq("EXP.207", "log(x log x) ≥ 2√(y log y) , log(x log x) = log x + log log x", "entropy log identity", ["ENTROPY"], def() return chk(log(3 * log(3)), log(3) + log(log(3))) end)
  eqs("EXP.208", "∇ψ² = 8πG( p/c³ + V/S ) ; ∇ψ² = 8πGℏ + 8π V/S", "entropy/energy (black/white hole)", ["SR", "QUANTUM"])
  eq("EXP.209", "□v = 2√(2πGℏ) + 2√(2π V/S)", "box-v root form", ["QUANTUM"], def() return 2 * sqrt(2 * pi() * 6.674e-11 * 1.054571817e-34) + 2 * sqrt(2 * pi() / 3) end)
  eqs("EXP.210", "√(2πT) = 2√(2π V/S)", "temperature vs volume/area", ["OTHER"])
  eq("EXP.211", "2 cos(i x log x) + 2i sin(i x log x) = 2 e^(−f) ; 2√(2π V/S) = (d/df) ∬_1 (x log x) dx^m", "circle fn = 2e^{−f}", ["ROT", "ENTROPY"], def() return chk(cadd(cscale(ccos(C(0, 2 * log(2))), 2), cmul(C(0, 2), csin(C(0, 2 * log(2))))), 2 * exp(0 - 2 * log(2))) end)
  eqs("EXP.212", "e^(−2π||ψ||)[η_μν + ℏx] dx^μ dx^ν + T² d²ψ = e^(−f) + e^f = (u + d) + c , (w + s) + b = −e^(−f) + e^f", "warped metric = quark flavours (u,d,c / w?,s,b)", ["MANIFOLD", "QUANTUM"])
  eqs("EXP.213", "□ = (atom) → [η_μν + ℏ(x)] dx^μ dx^ν / e^(2πT||ψ||) ; ||ds²|| = e^(2πT||ψ||)([η_μν + ℏ(x)] dx^μ dx^ν)^(−1) + (T² d²ψ)^(−1) ; ||ds²|| = e^(−2πT||ψ||)[η_μν + ℏ(x)] dx^μ dx^ν + T² d²ψ", "inverted warped metric; density y/x", ["MANIFOLD"])
  eqs("EXP.214", "(u + d) + c = e^(−f) + e^f , (w + s) + b = e^(−f) + e^f ; R'_ij = −R_ij (×2)", "quark sums; Ricci sign flip (rotation of T²d²ψ = neutron-star rotation)", ["ROT", "QUANTUM"])
  eqs("EXP.215", "||ds²|| = □ + ρ , ||ds²|| = ∇Ψ² + ψ / (η_μν + h̄(x))", "metric as box + density", ["MANIFOLD"])
  eqs("EXP.216", "ploximetry = Δx Δp − Δp Δx + δ(p, x)", "commutator-type uncertainty (\"proximity\")", ["QUANTUM"])
  eqs("EXP.217", "||ds²|| = e^(−2πT||ψ||) + [η_μν + h̄(x)] dx^μν + T² d²ψ", "metric variant", ["MANIFOLD"])
  eq("EXP.218", "(d/df) F = e^f + e^(−f) , (d/df) ∫ C dx^m = e^f − e^(−f)", "F' = 2cosh f; Euler const' = 2sinh f", ["ZETA"], def() return exp(1) + exp(-1) end)
  eqs("EXP.219", "(u + d) + c = e^(−f) − e^f , b + (w + s) = e^(−f) + e^f", "quark-flavour sums variant", ["QUANTUM"])
  eqs("EXP.220", "∬_1 x^s dvol − ∫ log x dvol = (d/df) ∬_1 (y log y)^(1/2) dy^m − ∫ C dx^m = e^(−f) − e^f", "Euler const vs entropy", ["ZETA", "ENTROPY"])
  eqs("EXP.221", "(d/df) F = (d/df) ∬_1 (x log x)² dx^m + (d/df) ∬_1 (y log y)^(1/2) dy^m = e^f + e^(−f) (Jones; weak electric)", "F = 2cosh f", ["JONES", "ENTROPY"])
  eqs("EXP.222", "||ds²|| = e^(−2πT|ψ|)[η + h̄(x)] dx^μ dx^ν + T² d²ψ", "warped metric (fermion energy distribution)", ["MANIFOLD"])
  eq("EXP.223", "□ = 2( cos(i x log x) + i sin(i x log x) )", "box as circle function (complex manifold)", ["ROT"], def() return cscale(cadd(ccos(C(0, 2 * log(2))), cmul(C(0, 1), csin(C(0, 2 * log(2))))), 2) end)
  eqs("EXP.224", "π(χ,x) = [iπ(χ,x), f(x)] ; ∫_1 (x log x) dx = i ∫_1 (x log x) dx N + N i ∫_1 (x log x) dx", "non-commutative entropy integral", ["QUANTUM", "ENTROPY"])
  eqs("EXP.225", "∫_1 (x log x) dx = i ∫ x log x dx − ∫_1 (x log x) dx (=INV.29) ; ∬_1 (x log x)² dx^m = i (1/2) x² = i ∬_M dx^m ≤ 1/(2i) + x² (=INV.518)", "entropy integrals", ["ENTROPY"])
  eq("EXP.226", "E = −(1/2) m v² + m c² ; lim_{x→∞} ∬_1 (x log x)² dx^m ≥ 1/(2i) ; (d/df) ∬_1 (x log x)² dx^m = 1/(2i) = ∬_1 (x log x)² dx^m (=INV.519/520) (×2)", "energy and entropy", ["SR", "ENTROPY"], def() return 0 - 0.5 * 1 * 1e7 * 1e7 + 1 * C_LIGHT * C_LIGHT end)
  eq("EXP.227", "(f)' / ( (f)(f)' ) = (f f)' = e^(x log x)", "derivative of x^x", ["ENTROPY"], def() return chk(hCD_dnum(def(x) return pow(x, x) end, 2), exp(2 * log(2))) end)
  eqs("EXP.228", "Γ = ∫ e^(−x) x^(1−t) dx , (d/df) F = e^f , ∫ F dx^m = e^(−f) , ∫ x^(1−t) dx = (d/df) F , ∫ e^(−x) dx = ∫ F dx^m", "gamma parts", ["GAMMA"])
  eqs("EXP.229", "x ⊥ y → x · y = 0⃗ ; (d/df) ∬_1 (x log x)² dx^m = 1/(2i) ; (f)'", "orthogonality", ["OTHER"])
  eq("EXP.230", "1/2 + 1/(2i) = 0⃗ , (1/2)·(1/(2i)) ; A + B = 0⃗ , A · B = 1/(4i) , tan 90 ≠ 0 , ||ds²|| = A + B", "critical-line real part 1/2 as vector", ["ZETA"], def() return chk(cadd(C(0.5, 0), cdiv(C(1, 0), C(0, 2))), C(0, 0)) end)
  eqs("EXP.231", "sin 0 = 0 , e^(iθ) = cosθ + i sinθ", "real pole 1/2 note", ["ROT"])
  eqs("EXP.232", "(d/df) F = (d/df) ∬_1 (x log x)² dx^m + (d/df) ∬_1 (y log y)^(1/2) dy^m = Γ(x, y)", "entropy functional = incomplete gamma", ["GAMMA", "ENTROPY"])
  eqs("EXP.233", "(d/dγ) Γ = (e^(−x) x^(1−t)) γ' → (d/dγ) Γ = Γ(γ)'", "gamma derivative", ["GAMMA"])
  eq("EXP.234", "Γ(s) = ∫_0^∞ e^(−x) x^(s−1) dx , Γ'(s) = ∫_0^∞ e^(−x) x^(s−1) log x dx (×2)", "Gamma function and its derivative (correct)", ["GAMMA"], def() return chk(hCD_gammaprime(1), hCD_dnum(def(s) return gamma(s) end, 1)) end)
  eq("EXP.235", "x^(s−1) = e^((s−1) log x) ; (∂/∂s) x^(s−1) = (∂/∂s) e^(−x)·(e^((s−1) log x)) = e^(−x) · log x · e^((s−1) log x) = e^(−x) · log x · x^(s−1)", "differentiating under integral", ["GAMMA"], def() return chk(hCD_dnum(def(s) return exp(-2) * exp((s - 1) * log(2)) end, 3), exp(-2) * log(2) * pow(2, 3 - 1)) end)
  eqs("EXP.236", "(d/dγ) Γ = Γ(γ)' ; (d/dγ) Γ(s) = ∫_0^∞ e^(−x) x^(s−1) dx / ( ∫_0^∞ e^(−x) x^(s−1) log x dx )' = Γ( Γ ∫ log x dx )' = e^(−x log x)", "gamma derivative chain (sic)", ["GAMMA"])
  eqs("EXP.237", "(d/df) F = ∫ x^(s−1) dx , ∫ F dx^m = ∫ e^(−x) dx , (d/df) F = F(f)' , ∫ F dx^m = F(f)", "global diff/integral = gamma pieces", ["GAMMA"])
  eqs("EXP.238", "HΨ = ⊕ (iℏ∇)⊕L = ⊕ HΨ/∇L = e^(x log x) = x^(x)' ; (d/df)F = m(x) (=EXP.94)", "Hamiltonian = x^x", ["QUANTUM"])
  eqs("EXP.239", "(d/dt) ψ(t) = ℏ = (1/(2i)) e^(iĤ) ... (=EXP.80-87 block repeated, 3rd copy)", "Schrödinger/Heisenberg block", ["QUANTUM"])
  eqs("EXP.240", "(d/dγ)Γ = m(x) = e^(−x log x) ; sin(ix) = (e^(−x) + e^x)/(2i) ; (d/df)F = m(x) = e^f + e^(−f) = 2i sin(i x log x) (=EXP.96-98, 2nd copy)", "circle function (hyper circle)", ["ROT", "GAMMA"])
  eqs("EXP.241", "HΨ = ⊕ (iℏ∇)⊕L = iℏψ (1)", "QLDS eq. (1): Hamiltonian as quantum direct sum", ["QUANTUM"])
  eqs("EXP.242", "(d/df) F = m(x) (2)", "QLDS eq. (2): F-derivative is mass", ["MANIFOLD"])
  eqs("EXP.243", "= (d/df) ∬_1 (x log x)² dx^m + (d/df) ∬_1 (y log y)^(1/2) dy^m (3)", "QLDS eq. (3): entropy functional", ["ENTROPY"])
  eqs("EXP.244", "⊕ (iℏ∇)⊕L = ∫ e^(−x) x^(1−t) dx^m (4)", "QLDS eq. (4): quantum sum = gamma", ["GAMMA", "QUANTUM"])
  eqs("EXP.245", "= (d/dγ) Γ = ∫ Γ(γ)' dx^m (5)", "QLDS eq. (5)", ["GAMMA"])
  eq("EXP.246", "= e^f + e^(−f) (6)", "QLDS eq. (6): 2cosh f", ["GAMMA"], def() return exp(1) + exp(-1) end)
  eq("EXP.247", "(d/dγ) Γ^(−1) = e^f − e^(−f) (7)", "QLDS eq. (7): 2sinh f", ["GAMMA"], def() return exp(1) - exp(-1) end)
  # ── bada-source-1 (Bada: The Unknown-Prior Engine Language, full source listing)
  eq("S.1", "a = softmax(z)", "base distribution over V tokens from logits", ["QUANTUM", "ENTROPY"], def() return at(hCD_softmax(hCD_z8()), 0) end)
  eq("S.2", "ψ_i = √(a_i) · exp( i · Σ_m β_m H_m φ_m^(i) )", "entropy-phase cognitive core amplitude (×2: README, cognitive_system comment)", ["QUANTUM", "ENTROPY"], def() return cscale(cexp(C(0, 0.7 * 1.66958 * 1 + 0.5 * 1.65002 * 0.5 + 0.9 * log(8) * 0.5)), sqrt(at(hCD_softmax(hCD_z8()), 0))) end)
  eq("S.3", "q̂_i = |ψ_i|² / Σ_j |ψ_j|²", "posterior from squared amplitude (×2)", ["QUANTUM"], def() return at(hCD_born(hCD_psi(hCD_softmax(hCD_z8()), hCD_theta8())), 0) end)
  eqs("S.4", "|e^{iθ}| = 1 ⇒ |ψ_i|² = a_i (exactly)", "unit-modulus phase preserves base probabilities (×3)", ["QUANTUM"])
  eqs("S.5", "a_i = 0 ⇒ q̂_i = 0", "zero preservation, ruled-out tokens survive (×3)", ["QUANTUM"])
  eq("S.6", "max_i |q̂_i − a_i| = 5.55e-17", "property (ii) verified at machine precision (×3)", ["QUANTUM"], def() return chk(pow(2, -54) * 1e17, 5.55) end)
  eq("S.7", "H(unknown_prior(8)) = 2.0794 → 1.9733 → 1.8364", "unknown-prior entropy strictly decreases (×2)", ["ENTROPY"], def() return chk(hCD_H(hCD_uniform(8)) + hCD_H(hCD_update(hCD_uniform(8), hCD_softmax(hCD_z8()), 0.5)) + hCD_H(hCD_update(hCD_update(hCD_uniform(8), hCD_softmax(hCD_z8()), 0.5), hCD_softmax(hCD_z8()), 0.5)), 2.0794 + 1.9733 + 1.8364) end)
  eq("S.8", "−p log p", "entropic summand (legitimate shape)", ["ENTROPY"], def() return 0 - 0.25 * log(0.25) end)
  eqs("S.9", "e^{iθ}", "Euler unit-modulus phase (native `phase` type) (×2)", ["QUANTUM"])
  eq("S.10", "unknown_prior(V)_i = 1/V", "uniform max-entropy (Jaynes) prior", ["ENTROPY"], def() return chk(hCD_H(hCD_uniform(8)), log(8)) end)
  eqs("S.11", "STAR ~ x = true; x ~ y = (x == y) for num/str, else (type(x)==type(y))", "gradual-typing consistency operator", ["OTHER"])
  eq("S.12", "softmax(z)_i = exp(z_i − max_j z_j) / Σ_k exp(z_k − max_j z_j)", "numerically stable softmax (interp + transpiler) (×2)", ["ENTROPY"], def() return chk(at(hCD_softmax([2, 1, 0, -1]), 0), at(hCD_softmax_naive([2, 1, 0, -1]), 0)) end)
  eq("S.13", "z_i − max_j z_j < −30 ⇒ p_i := 0, then p ← p/Σp", "confident-zero cutoff inside softmax (×2)", ["ENTROPY"], def() return chk(at(hCD_softmax(hCD_z8()), 3), 0) end)
  eq("S.14", "H(p) = −Σ_i q_i ln q_i, q_i = max(p_i, 1e-12)", "Shannon entropy (nats) with floor clamp (×3: entropy, cognitive_system, b_entropy)", ["ENTROPY"], def() return hCD_H(hCD_softmax(hCD_z8())) end)
  eq("S.15", "update(p, e, lr)_i = ((1−lr) p_i + lr e_i) / Σ_k ((1−lr) p_k + lr e_k), lr default 0.5", "prior sharpening by evidence mixture (×2)", ["ENTROPY"], def() return at(hCD_update(hCD_uniform(8), hCD_softmax(hCD_z8()), 0.5), 0) end)
  eq("S.16", "d_i = Σ_j W_ij x_j (or d_i = x_i if no W); d ← d / (‖d‖₂ + 1e-12)", "manifold_embed: L2-normalized linear embedding", ["MANIFOLD"], def() return chk(vnorm(hCD_embed(v3(1, 2, 2))), 1) end)
  eq("S.17", "θ_i = Σ_m β_m · H(q_m) · φ_m[i], β_m default 1, φ_m[i] default 0", "accumulated phase from module entropies", ["QUANTUM", "ENTROPY"], def() return 0.7 * 1.66958 * 1 + 0.5 * 1.65002 * 0.5 + 0.9 * log(8) * 0.5 end)
  eq("S.18", "ψ_i = √(a_i)·cexp(iθ_i); |ψ_i|² = Re(ψ_i)² + Im(ψ_i)²", "how the C code evaluates the amplitude (×2)", ["QUANTUM"], def() return chk(re(cscale(cexp(C(0, 1.3)), sqrt(0.37964))) * re(cscale(cexp(C(0, 1.3)), sqrt(0.37964))) + im(cscale(cexp(C(0, 1.3)), sqrt(0.37964))) * im(cscale(cexp(C(0, 1.3)), sqrt(0.37964))), 0.37964) end)
  eq("S.19", "p_i ← p_i / Σ_k p_k (if Σ_k p_k > 0)", "dist normalization (dist(arr), dist_normalize)", ["OTHER"], def() return at(hCD_norm([1, 2, 3, 4]), 3) end)
  eq("S.20", "maxdiff(a,b) = max_i |a_i − b_i|", "L∞ distance used for property (ii)", ["OTHER"], def() return hCD_maxdiff([0.1, 0.5, 0.4], [0.2, 0.3, 0.5]) end)
  eq("S.21", "zeros_of(d) = { i : d_i = 0 }", "index set of confident zeros", ["OTHER"], def() return hCD_zero_count(hCD_softmax(hCD_z8())) end)
  eq("S.22", "z = [1.6, 0.6, 0.1, −40, −0.4, 1.1, −40, 0.4], V = len(a) = 8, zeros_of(a) = zeros_of(q̂) = [3, 6]", "engine example logits, ruled-out tokens 3 and 6 (×2: engine.bada, core.bada)", ["ENTROPY"], def() return chk(at(hCD_softmax(hCD_z8()), 0) + hCD_zero_idxsum(hCD_softmax(hCD_z8())), 0.37964 + 3 + 6) end)
  eq("S.23", "modules = [[q_ret,φ_ret],[q_syn,φ_syn],[uniform(8), 0.5·1]], β = [0.7, 0.5, 0.9]", "cognitive_system example modules and gains (×2)", ["QUANTUM", "ENTROPY"], def() return chk(hCD_H(hCD_uniform(8)), 2.07944) end)
  eqs("S.24", "θ_i = c (constant) ⇒ q̂ unchanged", "uninformative constant-H modules cancel", ["QUANTUM", "ENTROPY"])
  eqs("S.25", "a/b = 0 if b = 0; a % b = fmod(a,b), 0 if b = 0", "interpreter arithmetic conventions", ["OTHER"])
  eq("S.26", "softmax([2,1,0,−1]) ≈ [0.64391, 0.23688, 0.08714, 0.03206]; H(unknown_prior(4)) = ln 4 = 1.38629", "hello.bada sanity-check values", ["ENTROPY"], def() return chk(at(hCD_softmax([2, 1, 0, -1]), 0) + hCD_H(hCD_update(hCD_uniform(4), hCD_softmax([2, 1, 0, -1]), 0.5)), 0.64391 + 1.28026) end)
  # ── bada-quantum-reviser-paper (Reviser-Extensible Grammars: a Q#-targeted quantum front end)
  eq("Q.1", "a_i = softmax(z)_i", "base distribution over V outcomes (×3: §2.1, App A, App C)", ["QUANTUM", "ENTROPY"], def() return at(hCD_softmax([2, 1, 0, -1]), 0) end)
  eq("Q.2", "θ_i = Σ_m β_m · H_m · φ_m^(i)", "accumulated phase from module entropies (×3)", ["QUANTUM", "ENTROPY"], def() return 0.7 * 1.66958 * 0.3 + 0.5 * 1.65002 * 0.8 + 0.9 * log(8) * 0.5 end)
  eq("Q.3", "ψ_i = √(a_i) · exp(i·θ_i)", "engine native phase value, i.e. the amplitude (×6: abstract, §1, §2.1, §4.1, App A, App C)", ["QUANTUM"], def() return cscale(cexp(C(0, pi() / 4)), sqrt(0.5)) end)
  eq("Q.4", "q_i = |ψ_i|² / Σ_j |ψ_j|² = a_i", "normalized posterior equals base (×2: §2.1, App C)", ["QUANTUM"], def() return chk(hCD_maxdiff(hCD_born(hCD_psi(hCD_softmax(hCD_z8()), hCD_theta8())), hCD_softmax(hCD_z8())), 0) end)
  eqs("Q.5", "|exp(iθ)| = 1", "unit modulus of the phase factor (×2)", ["QUANTUM"])
  eqs("Q.6", "|ψ|² = a", "Theorem 2: phase step changes no probability, i.e. unitarity (×9)", ["QUANTUM"])
  eqs("Q.7", "a_i = 0 ⇒ q_i = 0", "Theorem 1: zero-preservation, no-resurrection (×3)", ["QUANTUM"])
  eq("Q.8", "α_i = √(p_i) · e^{iφ_i}", "Q# quantum amplitude of basis state i (×3: abstract, §2.2, App A)", ["QUANTUM"], def() return cscale(cexp(C(0, pi() / 3)), sqrt(0.25)) end)
  eqs("Q.9", "p_i ↔ a_i, φ_i ↔ θ_i, α_i ↔ ψ_i", "quantum-to-engine correspondence dictionary (×2)", ["QUANTUM"])
  eq("Q.10", "P(outcome i) = |α_i|² = |ψ_i|²", "Born rule as engine squared modulus (×3)", ["QUANTUM"], def() return chk(pow(cabs(cscale(cexp(C(0, pi() / 3)), sqrt(0.25))), 2), 0.25) end)
  eq("Q.11", "V = 2^n", "basis-state count for n-qubit register (×2: §4.1, §5 prepare_unknown(n))", ["QUANTUM"], def() return pow(2, 3) end)
  eq("Q.12", "H|0⟩ : a = [0.5, 0.5]", "Hadamard as uniform distribution plus one phase module (×4)", ["QUANTUM"], def() return chk(at(hCD_uniform(2), 0), 0.5) end)
  eqs("Q.13", "H ≡ cognitive_system(a, [[a, φ_H]], [β_H]), a uniform", "Hadamard denotation on engine core", ["QUANTUM"])
  eqs("Q.14", "S, T, Rz(λ): θ ← θ + Δθ, a unchanged", "phase gates are pure phase contributions", ["QUANTUM"])
  eqs("Q.15", "CNOT: (a, θ)_i ← (a, θ)_{π_c(i)}", "control-conditioned basis-index permutation before the phase step", ["QUANTUM"])
  eq("Q.16", "max_i |q_i − a_i| = 1.11×10^-16", "Hadamard probe unitarity to machine precision (×5)", ["QUANTUM"], def() return chk(pow(2, -53) * 1e16, 1.11) end)
  eq("Q.17", "amplitudes² = [0.62246, 0.00000, 0.37754], zeros = [1]", "forbidden-transition probe, zero survives phase step", ["QUANTUM"], def() return chk(at(hCD_softmax([0.5, -1000, 0]), 0) + hCD_zero_idxsum(hCD_softmax([0.5, -1000, 0])), 0.62246 + 1) end)
  eqs("Q.18", "rule := [ \"rule\", name, head, pattern, denotation ], head ∈ {stmt, expr, postfix}", "grammar production stored as a ledger fact (×2)", ["OTHER"])
  eq("Q.19", "unknown_prior(V)_i = 1/V; prepare_unknown(n) = uniform over 2^n", "maximum-entropy tomography starting prior", ["QUANTUM", "ENTROPY"], def() return chk(at(hCD_uniform(pow(2, 3)), 0), pow(2, -3)) end)
  eqs("Q.20", "H(prior_{k+1}) < H(prior_k)", "entropy decreases monotonically as measurements commit", ["ENTROPY"])
  eqs("Q.21", "estimate() = fold(update, unknown_prior(V), trace); forbidden() = zeros_of(estimate())", "estimator folds over the commit trace", ["QUANTUM", "ENTROPY"])
end
# ════════════════════════════════════════════════════════════════════
#  main_blueprint.bada — 『コンタクト』型 異次元輸送機 3次元設計図 生成器
#
#  パイプライン:
#   ① CERN (Linac4→LHC) の pp 衝突 → 消失運動量の方向 = 異次元への扉の軸
#   ② 特殊相対論: 地球 1 s ↔ 搭乗者 18 h → Γ = 64800, ラピディティ φ
#   ③ 複素回転体（コマ）: 複素角 Θ = θ + iφ で回転する異次元 → 3 環ジンバル
#   ④ ガンマ・ゼータの大域的部分積分多様体: Riemann–Siegel θ(φ), Z(φ)
#   ⑤ Jones 多項式 V_K(t*), t* = e^{iθ(φ)} → 設計図生成機能 (コイル・窓・位相)
#   ⑥ 論文の全方程式レジストリ → 各部品へ割り当て, 数値エネルギーで寸法を変調
#   ⑦ Wavefront OBJ (3D) + 仕様書テキスト + 端末用 ASCII 三面図 を出力
# ════════════════════════════════════════════════════════════════════

def rule(label)
  print ""
  print "━━━━ " + label + " ━━━━"
end
def pad(s, n)
  let out = s
  while len(out) < n
    out = out + " "
  end
  return out
end

print "╔══════════════════════════════════════════════════════════════╗"
print "║  CONTACT TRANSPORTER — Bada 量子設計図生成器                 ║"
print "║  複素回転体(コマ) × 特殊相対論 × Γ・ζ 多様体 × Jones 多項式  ║"
print "╚══════════════════════════════════════════════════════════════╝"

# ─── ① 衝突段 ─────────────────────────────────────────
rule("① CERN 衝突段 (Linac4 → PSB → PS → SPS → LHC, √s = 13.6 TeV)")
let SQRT_S = 13600
let COL = collide(48, SQRT_S)
let DOOR_AXIS = vunit(at(COL, 0))
print "可視粒子 48 本, 可視エネルギー Σ E = " + str(at(COL, 2)) + " GeV"
print "横方向消失運動量 E_T^miss = " + str(at(COL, 1)) + " GeV"
print "粒子が消えた方向 (扉の軸) n̂ = " + str(DOOR_AXIS)

# ─── ② 特殊相対論 ─────────────────────────────────────
rule("② 特殊相対論 — 地球 1 秒 = ベガ往還 18 時間")
let SR = sr_block(1, 18 * 3600)
let GAMMA_L = at(SR, 0)
let PHI = at(SR, 2)
print "ローレンツ因子 Γ = 18h / 1s = " + str(GAMMA_L)
print "1 − β = " + str(at(SR, 1)) + "   (β = v/c)"
print "ラピディティ φ = arcosh Γ = " + str(PHI)
print "地球–ベガ距離 L = " + str(VEGA_LY) + " ly → 収縮距離 L/Γ = " + str(at(SR, 4) / 1000) + " km"
let ONE_WAY_H = at(SR, 5) / 3600
print "片道 (搭乗者時間) = " + str(ONE_WAY_H) + " h, 往復 = " + str(2 * ONE_WAY_H) + " h"
print "ベガ滞在 = 18 − 往復 = " + str(18 - 2 * ONE_WAY_H) + " h"
let BOOST = boost_as_complex_rotation(PHI)
print "ブースト = 虚角回転: cos(iφ) = " + cstr_(at(BOOST, 0)) + "  (= Γ)"

# ─── ②' 異次元輸送の計量 (system_transport) ───────────
rule("②' 次元の輸送計量 ds² = e^{−2πT|ψ|}[η+h̄]dx^μdx^ν + T²dψ²")
#   「次元の回転は、他の次元への次元の輸送である」(system_transport p.66)
#   ワープ因子 e^{−2πT|ψ|} を時間の伸び 1/Γ に一致させる → T|ψ| = ln Γ / 2π
let TPSI = log(GAMMA_L) / (2 * pi())
let WARP = exp(0 - 2 * pi() * TPSI)
print "T|ψ| = ln Γ / 2π = " + str(TPSI) + "   ワープ因子 e^{−2πT|ψ|} = " + str(WARP) + " (= 1/Γ = " + str(1 / GAMMA_L) + ")"
# 論文の x log x = 1 の根 (x ≈ 1.7632) と比較 (数値的近さの記録のみ)
let XR = 1.5
let XI = 0
while XI < 30
  XR = XR - (XR * log(XR) - 1) / (log(XR) + 1)
  XI = XI + 1
end
print "論文の x log x = 1 の根 x = " + str(XR) + "  (T|ψ| との差 " + str(TPSI - XR) + ")"
# BadaUFO-OS: 反重力箱演算子 □ag = 2(sin(i x log x) + cos(i x log x)) の実部 = 2cosh(x log x)
let BOX_AG = cscale(cadd(csin(C(0, TPSI * log(TPSI))), ccos(C(0, TPSI * log(TPSI)))), 2)
print "□ag(x = T|ψ|) = " + cstr_(BOX_AG) + "   揚力比 L = cosh(x log x) = " + str(cosh(TPSI * log(TPSI)))

# ─── ③ 複素回転体（コマ）─────────────────────────────
rule("③ 複素回転体(コマ)の幾何学 — 宇宙の中で回転する異次元")
let THETA0 = pi() / 6
let TOP = complex_top(THETA0, PHI)
print "複素章動角 Θ = θ + iφ = " + cstr_(at(TOP, 0))
print "cos Θ = " + cstr_(at(TOP, 1))
print "|cosΘ|² + |sinΘ|² = cosh 2φ = " + str(at(TOP, 3))
let W0 = 2 * pi() / 60
let OMEGAS = ring_omegas(W0, PHI)
print "3 環の角速度 [rad/s] = " + str(OMEGAS)
let PREC = top_precession(1200, 9.81, 2.5, 5400, at(OMEGAS, 2))
let NUT = top_nutation(3100, 5400, at(OMEGAS, 2))
print "ポッド歳差 Ω_p = Mgl/(I3 ω3) = " + str(PREC) + " rad/s,  章動 ω_n = " + str(NUT) + " rad/s"
let V_RIM = C_LIGHT * (1 - at(SR, 1))
print "Thomas 歳差 (r = 1 AU を β 速度で) ω_T = " + str(thomas_precession(GAMMA_L, V_RIM, 1.496e11)) + " rad/s"

# ─── ④ Γ・ζ 大域的部分積分多様体 ─────────────────────
rule("④ ガンマ関数におけるゼータ関数の大域的部分積分多様体")
let RS_TH = rs_theta(PHI)
let RS_Z = rs_Z(PHI)
print "Riemann–Siegel θ(φ) = " + str(RS_TH)
print "Z(φ) = e^{iθ} ζ(1/2 + iφ) = " + cstr_(RS_Z) + "  (虚部≈0: 多様体上で実)"
print "部分積分検算 ∫₀^∞ x⁴ e^{-x} dx = " + str(gamma_integral(5, 40, 4000)) + " = Γ(5)"
print "Γ(2)ζ(2) = ∫ x/(eˣ−1) dx = " + str(bose_integral(2, 40, 8000)) + "  (厳密値 π²/6 = " + str(pi() * pi() / 6) + ")"
print "大域的部分積分多様体の不変量 Ξ(扉軸²) = " + str(xi(list(at(DOOR_AXIS, 0) * at(DOOR_AXIS, 0), at(DOOR_AXIS, 1) * at(DOOR_AXIS, 1), at(DOOR_AXIS, 2) * at(DOOR_AXIS, 2))))

# ─── ⑤ Jones 多項式 → 設計図生成機能 ──────────────────
rule("⑤ Jones 多項式 V_K(t*) — 異次元への輸送機の設計図生成機能")
let T_STAR = cis(RS_TH)
let KNOTS = list(list("3_1 三葉結び目", [[1,5,2,4],[3,1,4,6],[5,3,6,2]], -3, 2, 3), list("4_1 8の字結び目", [[4,2,5,1],[8,6,1,5],[6,3,7,4],[2,7,3,8]], 0, 0, 0), list("5_1 五葉結び目", [[1,6,2,7],[3,8,4,9],[5,10,6,1],[7,2,8,3],[9,4,10,5]], 5, 2, 5))
let JV = []
let ki = 0
let K = 0
let vA = 0
let val = 0
let res = 0
while ki < len(KNOTS)
  K = at(KNOTS, ki)
  vA = jones_from_bracket(kauffman_bracket(at(K, 1)), at(K, 2))
  val = jones_eval(vA, T_STAR)
  res = jones_unit_zeros(vA, 240)
  JV = append(JV, list(at(K, 0), vA, val, res))
  print at(K, 0) + ":  V(t) = " + jones_string(vA)
  print "    V(t*) = " + cstr_(val) + "   |V| = " + str(cabs(val)) + "   arg = " + str(carg(val))
  print "    扉の共鳴角 (|V(e^{iα})| 極小) α = " + str(len(res)) + " 個"
  ki = ki + 1
end

# ─── ⑥ 全方程式レジストリ ─────────────────────────────
rule("⑥ 論文の全方程式 → 設計図部品への割り当て")
load_all_equations()
print "登録式 " + str(REG_N) + " 本 (数値評価 " + str(REG_CALC) + " / 記号 " + str(REG_N - REG_CALC) + ")"
print "数値検証した等式: 成立 " + str(REG_HOLD) + " / 不成立 " + str(REG_FAIL)
let ci = 0
while ci < len(COMP_NAMES)
  print "  " + pad(at(COMP_NAMES, ci), 10) + " 式 " + pad(str(at(COMP_COUNT, ci)), 4) + " エネルギー " + str(at(COMP_ENERGY, ci))
  ci = ci + 1
end
def comp_e(name)
  return at(COMP_ENERGY, comp_index(name))
end
def comp_n(name)
  return at(COMP_COUNT, comp_index(name))
end

# ─── ⑦ 3次元設計図 ───────────────────────────────────
rule("⑦ 3次元設計図 (単位: m, z 軸 = 扉の軸に整列)")
# 部品寸法: 映画の装置 (直径 ~ 100 m 級の 3 重ジンバル環) を基準に、
# 各方程式群の数値エネルギーで変調する (log 圧縮で有界)
def modul(name)
  return 1 + 0.1 * log(1 + comp_e(name)) / log(10)
end
let R_OUT = 48 * modul("ROT")
# 環の半径比 = φ/(φ+π) (ラピディティと半回転の比)
let R_MID = R_OUT * PHI / (PHI + pi())
let R_IN = R_MID * PHI / (PHI + pi())
let TUBE = 1.6 * modul("MANIFOLD")
let POD_R = 4 * modul("TRANSPORT")
let TOWER_H = R_OUT * 2.2
let COIL_R = R_OUT + 9 * modul("JONES")
let WELL_DEPTH = 17 * TPSI * modul("SR")
# 設計図座標系: 扉の軸 n̂ を z 軸へ (ここでは表示のため z 軸固定、軸ベクトルは仕様書に記録)
let ZUP = v3(0, 0, 1)
let CEN = v3(0, 0, 0)
# 3 環の姿勢: 複素角 Θ の実部 θ と Euler 角 (φ mod 2π) で傾ける
let TILT_MID = vrot(ZUP, v3(1, 0, 0), THETA0)
let TILT_IN = vrot(TILT_MID, v3(0, 1, 0), mod(floor(PHI * 1000), 6283) / 1000)
mesh_torus("gimbal_outer", CEN, ZUP, R_OUT, TUBE, 120, 12)
mesh_torus("gimbal_middle", CEN, TILT_MID, R_MID, TUBE * 0.8, 100, 12)
mesh_torus("gimbal_inner", CEN, TILT_IN, R_IN, TUBE * 0.6, 80, 12)
mesh_sphere("pod", CEN, POD_R, 18, 28)
# 4 本の塔 (映画の装置の支柱) と 頂部ガントリー
let TW = 0
let a = 0
let base = 0
let top = 0
while TW < 4
  a = pi() / 4 + TW * pi() / 2
  base = v3((R_OUT + 12) * cos(a), (R_OUT + 12) * sin(a), 0 - WELL_DEPTH)
  top = v3((R_OUT + 4) * cos(a), (R_OUT + 4) * sin(a), TOWER_H)
  mesh_cylinder("tower_" + str(TW), base, top, 2.4, 16)
  mesh_cylinder("gantry_" + str(TW), top, v3(0, 0, TOWER_H + 6), 1.2, 12)
  TW = TW + 1
end
# ポッド投下シャフト (ガントリー中心 → 扉)
mesh_cylinder("drop_shaft", v3(0, 0, TOWER_H + 6), v3(0, 0, POD_R), 0.5, 12)
# Jones 結び目コイル: 3_1 → T(2,3), 5_1 → T(2,5), 4_1 → 8 の字 (床下)
let J31 = at(at(JV, 0), 2)
let J51 = at(at(JV, 2), 2)
let J41 = at(at(JV, 1), 2)
mesh_tube("jones_coil_3_1", torus_knot_points(CEN, ZUP, COIL_R, 4 + cabs(J31), 2, 3, 360), 0.9, 10, 1)
mesh_tube("jones_coil_5_1", torus_knot_points(v3(0, 0, TOWER_H * 0.5), ZUP, COIL_R * 0.8, 3 + cabs(J51), 2, 5, 480), 0.7, 10, 1)
mesh_tube("jones_coil_4_1", fig8_points(v3(0, 0, 0 - WELL_DEPTH * 0.6), 6 + cabs(J41), 360), 0.8, 10, 1)
# 扉 (消失方向): 扉軸に沿った光線と、共鳴角に置いた窓 (小球)
mesh_tube("door_axis_beam", list(vscale(ZUP, 0 - WELL_DEPTH), vscale(ZUP, 0 - WELL_DEPTH * 0.5), CEN), 0.35, 8, 0)
let RES = at(at(JV, 1), 3)
let ri = 0
let al = 0
while ri < len(RES)
  al = at(at(RES, ri), 0)
  mesh_sphere("resonance_window_" + str(ri), v3(R_IN * 0.7 * cos(al), R_IN * 0.7 * sin(al), 0), 0.9, 8, 12)
  ri = ri + 1
end
let OBJ = "# Contact Transporter — generated by Bada (contact_transporter/main_blueprint.bada)\n" + "# door axis (lab frame) = " + str(DOOR_AXIS) + "\n" + "# Lorentz factor = " + str(GAMMA_L) + ", rapidity = " + str(PHI) + "\n" + buffer_text()
write_file("contact_machine.obj", OBJ)
print "外環 R = " + str(R_OUT) + ", 中環 R = " + str(R_MID) + ", 内環 R = " + str(R_IN) + ", 管径 = " + str(TUBE)
print "ポッド半径 = " + str(POD_R) + ", 塔高 = " + str(TOWER_H) + ", 井戸深さ = " + str(WELL_DEPTH) + ", コイル半径 = " + str(COIL_R)
print "頂点数 = " + str(VCOUNT) + "  → contact_machine.obj に書き出し"

# ─── ASCII 三面図 (上面図 xy / 正面図 xz) ─────────────
def ascii_view(title, pts, ia, ib, w, h, span)
  let line = 0
  let c = 0
  let p = 0
  let x = 0
  let y = 0
  let s = 0
  let row = 0
  let j = 0
  let rows = []
  let r = 0
  while r < h
    line = []
    c = 0
    while c < w
      line = append(line, " ")
      c = c + 1
    end
    rows = append(rows, line)
    r = r + 1
  end
  let k = 0
  while k < len(pts)
    p = at(pts, k)
    x = floor((at(at(p, 0), ia) / span + 1) / 2 * (w - 1) + 0.5)
    y = floor((1 - at(at(p, 0), ib) / span) / 2 * (h - 1) + 0.5)
    if x >= 0 and x < w and y >= 0 and y < h
      rows = put(rows, y, put(at(rows, y), x, at(p, 1)))
    end
    k = k + 1
  end
  print title
  let i = 0
  while i < h
    s = ""
    row = at(rows, i)
    j = 0
    while j < w
      s = s + at(row, j)
      j = j + 1
    end
    print "  |" + s + "|"
    i = i + 1
  end
end
def ring_pts(c, n, R, sym, cnt)
  let u = 0
  let nn = vunit(n)
  let e1 = vunit(vcross(nn, v3(0.37, 0.61, 0.7)))
  let e2 = vcross(nn, e1)
  let out = []
  let i = 0
  while i < cnt
    u = 2 * pi() * i / cnt
    out = append(out, list(vadd(c, vadd(vscale(e1, R * cos(u)), vscale(e2, R * sin(u)))), sym))
    i = i + 1
  end
  return out
end
def concat(a, b)
  let out = a
  let i = 0
  while i < len(b)
    out = append(out, at(b, i))
    i = i + 1
  end
  return out
end
let VIEWP = concat(concat(ring_pts(CEN, ZUP, R_OUT, "O", 90), ring_pts(CEN, TILT_MID, R_MID, "M", 70)), ring_pts(CEN, TILT_IN, R_IN, "I", 50))
let KP = torus_knot_points(CEN, ZUP, COIL_R, 4 + cabs(J31), 2, 3, 120)
let kk = 0
while kk < len(KP)
  VIEWP = append(VIEWP, list(at(KP, kk), "~"))
  kk = kk + 1
end
let TWI = 0
let a = 0
let zz = 0
while TWI < 4
  a = pi() / 4 + TWI * pi() / 2
  zz = 0 - WELL_DEPTH
  while zz < TOWER_H
    VIEWP = append(VIEWP, list(v3((R_OUT + 8) * cos(a), (R_OUT + 8) * sin(a), zz), "#"))
    zz = zz + 8
  end
  TWI = TWI + 1
end
VIEWP = append(VIEWP, list(CEN, "@"))
ascii_view("上面図 (xy)  O=外環 M=中環 I=内環 ~=Jones 3_1 コイル #=塔 @=ポッド", VIEWP, 0, 1, 64, 28, 80)
ascii_view("正面図 (xz)", VIEWP, 0, 2, 64, 24, 120)

# ─── 仕様書 ───────────────────────────────────────────
BUF_PARTS = []
BUF_CHUNK = ""
emit("CONTACT TRANSPORTER — 3D BLUEPRINT SPECIFICATION (generated by Bada)")
emit("====================================================================")
emit("[1] Collider stage (CERN, Linac4 -> LHC, sqrt(s) = 13.6 TeV)")
emit("    E_T^miss = " + str(at(COL, 1)) + " GeV, door axis n = " + str(DOOR_AXIS))
emit("[2] Special relativity: Earth 1 s <-> traveller 18 h")
emit("    Gamma = " + str(GAMMA_L) + ", 1-beta = " + str(at(SR, 1)) + ", rapidity phi = " + str(PHI))
emit("    Vega 25.04 ly contracted to " + str(at(SR, 4) / 1000) + " km; one way " + str(ONE_WAY_H) + " h")
emit("[2'] Transport metric warp e^{-2 pi T|psi|} = 1/Gamma -> T|psi| = " + str(TPSI) + ", box_ag = " + cstr_(BOX_AG))
emit("[3] Complex rotating top: Theta = " + cstr_(at(TOP, 0)) + ", ring omegas = " + str(OMEGAS))
emit("[4] Gamma-zeta manifold: RS theta(phi) = " + str(RS_TH) + ", Z(phi) = " + cstr_(RS_Z))
emit("[5] Jones blueprint function at t* = e^{i theta(phi)} = " + cstr_(T_STAR))
let jj = 0
let J = 0
while jj < len(JV)
  J = at(JV, jj)
  emit("    " + at(J, 0) + ": V(t) = " + jones_string(at(J, 1)) + ", V(t*) = " + cstr_(at(J, 2)))
  jj = jj + 1
end
emit("[6] Components (m)")
emit("    gimbal_outer  R=" + str(R_OUT) + " tube=" + str(TUBE) + " omega=" + str(at(OMEGAS, 0)))
emit("    gimbal_middle R=" + str(R_MID) + " tube=" + str(TUBE * 0.8) + " omega=" + str(at(OMEGAS, 1)) + " tilt=theta0")
emit("    gimbal_inner  R=" + str(R_IN) + " tube=" + str(TUBE * 0.6) + " omega=" + str(at(OMEGAS, 2)))
emit("    pod           r=" + str(POD_R) + "  drop shaft from h=" + str(TOWER_H + 6))
emit("    towers x4     h=" + str(TOWER_H) + " well depth=" + str(WELL_DEPTH))
emit("    Jones coils   3_1 R=" + str(COIL_R) + ", 5_1 R=" + str(COIL_R * 0.8) + ", 4_1 under floor")
emit("[7] Equation registry: " + str(REG_N) + " equations (" + str(REG_CALC) + " numeric, " + str(REG_HOLD) + " hold, " + str(REG_FAIL) + " differ)")
let q = 0
let E = 0
while q < len(REG)
  E = at(REG, q)
  emit("  " + at(E, 0) + " [" + at(E, 4) + "] " + at(E, 1))
  if at(E, 5) != ""
    emit("        = " + at(E, 5) + "    -> " + str(at(E, 3)))
  else
    emit("        -> " + str(at(E, 3)) + "  (" + at(E, 2) + ")")
  end
  q = q + 1
end
emit("")
emit("NOTE: this is a speculative/fictional design derived from the papers' formulas;")
emit("it is a geometric visualisation, not an engineering-validated device.")
write_file("contact_blueprint.txt", buffer_text())
print ""
print "仕様書 → contact_blueprint.txt (全 " + str(REG_N) + " 式の割り当て表を含む)"
print "3D モデル → contact_machine.obj (Blender / MeshLab / 3D ビューアで表示可)"
