  eqs("INV.138", "∫ ||ds²|| dx^m = ∫ 8πG(p/c³ + V/S) dvol = ∫ 8πG(p/c³+V/S) dy^m = ∫_1 8πG(p/c³+V/S) dx^m", "integrated metric norm", ["SR", "MANIFOLD"])
  eqs("INV.139", "(d/df) F = m(x) , ⊕ iℏ∇ ⊕ L = ∇_i∇_j ∫ ∇f(x) dη", "F' = mass function; quantum sum = Hessian integral (×many)", ["MANIFOLD", "QUANTUM"])
