  eqs("ST.348", "∇_i∇_j f ≅ ∂x∂y∫∇_i∇_j f dm ≅ ∫[f(x)]dm ≅ {[f(x),g(x)], g⁻¹(x)} ≅ □ψ ≅ ∇ψ² ≅ f(x∘y) ≤ f(x)∘g(x) ≅ |f(x)| + |g(x)| (×2)", "chain of equivalences of Hessian", ["MANIFOLD"])
