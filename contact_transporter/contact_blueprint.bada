  eqs("INV.209", "∃[R + |∇f|²]^(1/2+iy) = ∫ exp[L(p,q)] dψ = ∃[R + |∇f|²]^(1/2+iy) ⊗ ∫ exp[L(p,q)] dψ + N mod(e^(x log x)) = O(ψ)", "critical-line curvature ↔ path integral", ["ZETA", "QUANTUM"])
