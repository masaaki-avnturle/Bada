  eqs("INV.575", "(d/df) F(v_ij, h) = ∫ e^(−f) [ −Δv + ∇_i∇_j v_ij − R_ij v_ij − v_ij ∇_i∇_j + 2<∇f, ∇h> + (R + ∇f²)(v/2 − h) ]", "Perelman first variation of F", ["MANIFOLD", "ENTROPY"])
  eqs("INV.576", "F ≥ (d/df) ∬_1 (x log x)² dx^m + (d/df) ∬_1 (y log y)^(1/2) dy^m", "F-functional ≥ entropy integrals", ["ENTROPY"])
