  eqs("AGZE.4", "t∭ D(χ,x) Hom[D²ψ]^{≪p} ≅ vol(V/S)", "triple varint = volume", ["MANIFOLD"])
  eqs("AGZE.5", "∂/∂f F(x) = t∬ cohom D_k(x)^{≪p}", "global partial diff = cohomology cut", ["MANIFOLD"])
  eqs("AGZE.6", "d/df F = (F)^{f'} , ∫ F dx^m = (F)^f", "global differential/integral definitions", ["MANIFOLD"])
  eqs("AGZE.7", "d/df ∫∫ 1/(x log x)^2 dx^m = ( ∫∫ 1/(x log x)^2 dx^m )^{f'}", "(no gloss in text; continuation of chain)", ["MANIFOLD"])
  eq("AGZE.8", "f' = 2x( log x + log(x + 1) )", "exponent f'", ["OTHER"], def() return hA2_fp(2) end)
  eq("AGZE.9", "∫∫ F dx^m = ( 1/(x log x)^2 )^{∫ 2x(log x + log(x+1)) dx} = e^{−f}", "global integral value", ["MANIFOLD"], def() return chk(pow(1 / pow(2 * log(2), 2), hA2_f(2)), exp(0 - hA2_f(2))) end)
  eq("AGZE.10", "d/df F = ( 1/(x log x)^2 )^{2x(log x + log(x+1))} = e^{f}", "global differential value", ["MANIFOLD"], def() return chk(pow(1 / pow(2 * log(2), 2), hA2_fp(2)), exp(hA2_f(2))) end)
  eq("AGZE.11", "log(x log x) ≥ 2 (y log y)^{1/2}", "inequality", ["ENTROPY"], def() return chk(hA2_grid(def(x, y) return log(x * log(x)) >= 2 * pow(y * log(y), 0.5) end, 2, 6, 20), 1) end)
  eq("AGZE.12", "log(x log x) ≥ 2 √(y log y)", "inequality", ["ENTROPY"], def() return chk(hA2_grid(def(x, y) return log(x * log(x)) >= 2 * sqrt(y * log(y)) end, 2, 6, 20), 1) end)
  eqs("AGZE.13", "π(χ,x) = [ iπ(χ,x), f(x) ]", "fundamental group commutator", ["MANIFOLD"])
  eqs("AGZE.14", "∫ 1/(x log x) dx = i ∫ 1/(x log x) dx^N + N i ∫ 1/(x log x) dx", "(no gloss in text; continuation of chain)", ["ENTROPY"])
  eqs("AGZE.15", "∫ 1/(x log x) dx = i ∫ x log x dx − ∫ 1/(x log x) dx", "(no gloss in text; continuation of chain)", ["ENTROPY"])
  eqs("AGZE.16", "∫∫ 1/(x log x)^2 dx^m = i (1/2) x^2", "(no gloss in text; continuation of chain)", ["OTHER"])
  eqs("AGZE.17", "∫∫ 1/(x log x)^2 dx^m = i ∬_M dx^m ≤ (1/2) i + x^2", "(no gloss in text; continuation of chain)", ["OTHER"])
  eq("AGZE.18", "E = −(1/2) m v^2 + m c^2", "energy (kinetic sign flipped)", ["SR"], def() return chk(0 - 0.5 * 1 * 0.1 * 0.1 + 1 * 1 * 1, 1 / sqrt(1 - 0.1 * 0.1) * 1 * 1 * 1) end)
  eqs("AGZE.19", "lim_{x→∞} ∫∫ 1/(x log x)^2 dx^m ≥ (1/2) i", "(no gloss in text; continuation of chain)", ["OTHER"])
  eqs("AGZE.20", "d/df ∫∫ 1/(x log x)^2 dx^m = (1/2) i", "(no gloss in text; continuation of chain)", ["OTHER"])
  eqs("AGZE.21", "d/df ∫∫ 1/(x log x)^2 dx^m = ( ∫∫ 1/(x log x)^2 dx^m )^{(f)'}", "(no gloss in text; continuation of chain)", ["OTHER"])
  eq("AGZE.22", "(f)(f)' = (f f)'/2 = e^{x log x}", "(no gloss in text; continuation of chain)", ["ENTROPY"], def() return chk((2 * log(2)) * (log(2) + 1), exp(2 * log(2) * log(2 * log(2)))) end)
  eq("AGZE.23", "Γ = ∫ e^{−x} x^{1−t} dx , d/df F = e^f , ∫ F dx^m = e^{−f}", "gamma as global differential", ["GAMMA"], def() return chk(hA2_gam(2 - 0.5), gamma(2 - 0.5)) end)
  eqs("AGZE.24", "∫ x^{1−t} dx = d/df F , ∫ e^{−x} dx = ∫ F dx^m", "(no gloss in text; continuation of chain)", ["GAMMA"])
  eq("AGZE.25", "e^{iθ} = cos θ + i sin θ", "Euler formula", ["ROT"], def() return chk(cexp(C(0, pi() / 6)), C(cos(pi() / 6), sin(pi() / 6))) end)
  eqs("AGZE.26", "x ⊥ y → x·y = 0⃗ , d/df ∫∫ 1/(x log x)^2 dx^m = (1/2) i", "(no gloss in text; continuation of chain)", ["OTHER"])
  eqs("AGZE.27", "d/df ∫∫ 1/(x log x)^2 dx^m = ( ∫∫ ... )^{(f)'}", "(no gloss in text; continuation of chain)", ["OTHER"])
  eq("AGZE.28", "1/2 + (1/2) i = 0⃗ , (1/2)·(1/2) i", "real pole 1/2 (critical line)", ["ZETA"], def() return chk(C(0.5, 0.5), C(0, 0)) end)
  eq("AGZE.29", "A + B = 0⃗ , A·B = (1/4) i", "(no gloss in text; continuation of chain)", ["ZETA"], def() return chk(C(cabs(cadd(C(0.5, 0), C(0, 0.5))), im(cmul(C(0.5, 0), C(0, 0.5)))), C(0, 0.25)) end)
  eqs("AGZE.30", "tan 90 ≠ 0 , ||ds²|| = A + B", "(no gloss in text; continuation of chain)", ["OTHER"])
  eq("AGZE.31", "sin 0 = 0", "real pole of 1/2", ["ZETA"], def() return chk(sin(0), 0) end)
  eq("AGZE.32", "e^{iθ} = cos θ + i sin θ (repeat)", "non-certain system of particles", ["ROT", "QUANTUM"], def() return chk(cexp(C(0, 1.2)), C(cos(1.2), sin(1.2))) end)
  eq("AGZE.33", "d/df F = d/df ∫∫ 1/(x log x)^2 dx^m + d/df ∫∫ 1/(y log y)^{1/2} dy^m = Γ(x,y)", "gamma of two variables", ["GAMMA"], def() return chk(pow(1 / pow(2 * log(2), 2), hA2_fp(2)) + pow(1 / pow(2 * log(2), 0.5), hA2_fp(2)), hA2_igam(2, 2)) end)
  eqs("AGZE.34", "d/dγ Γ = (e^{−x} x^{1−t})^{γ'} → d/dγ Γ = Γ(γ)'", "(no gloss in text; continuation of chain)", ["GAMMA"])
  eq("AGZE.35", "Γ(s) = ∫ e^{−x} x^{s−1} dx , Γ'(s) = ∫ e^{−x} x^{s−1} log x dx", "gamma and its derivative (correct)", ["GAMMA"], def() return chk(hA2_dgam(1), 0 - 0.5772156649015329) end)
  eq("AGZE.36", "x^{s−1} = e^{(s−1) log x}", "(no gloss in text; continuation of chain)", ["GAMMA"], def() return chk(pow(2, 2.5 - 1), exp((2.5 - 1) * log(2))) end)
  eq("AGZE.37", "∂/∂s x^{s−1} = ∂/∂s e^{−x}·e^{(s−1)log x} = e^{−x}·log x·e^{(s−1)log x} = e^{−x}·log x·x^{s−1}", "derivative of integrand", ["GAMMA"], def() return chk((exp(0 - 2) * pow(2, 2.5 + 0.00001 - 1) - exp(0 - 2) * pow(2, 2.5 - 0.00001 - 1)) / 0.00002, exp(0 - 2) * log(2) * pow(2, 2.5 - 1)) end)
  eq("AGZE.38", "d/dγ Γ = Γ(γ)'", "(no gloss in text; continuation of chain)", ["GAMMA"], def() return chk(hA2_dgam(2), gamma(2) * hA2_digamma(2)) end)
  eqs("AGZE.39", "d/dγ Γ(s) = ∫0^∞ e^{−x} x^{s−1} dx^{(∫0^∞ e^{−x}x^{s−1} log x dx)'} = Γ(Γ ∫ log x dx)' = e^{−x log x}", "(no gloss in text; continuation of chain)", ["GAMMA"])
  eq("AGZE.40", "Γ(s) = ∫0^∞ e^{−x} x^{s−1} dx", "gamma function", ["GAMMA"], def() return chk(hA2_gam(2.5), gamma(2.5)) end)
  eq("AGZE.41", "Γ'(s) = ∫0^∞ e^{−x} x^{s−1} log x dx", "gamma derivative", ["GAMMA"], def() return chk(hA2_dgam(3), (gamma(3 + 0.00001) - gamma(3 - 0.00001)) / 0.00002) end)
  eqs("AGZE.42", "d/df F = ∫ x^{s−1} dx , ∫ F dx^m = ∫ e^{−x} dx", "(no gloss in text; continuation of chain)", ["GAMMA"])
  eqs("AGZE.43", "d/df F = F^{(f)'} , ∫ F dx^m = F^{(f)}", "(no gloss in text; continuation of chain)", ["MANIFOLD"])
  eq("AGZE.44", "HΨ = ⊕(iℏ∇)^{⊕L} = ⊕ HΨ^{∇L} = e^{x log x} = x^{(x)'}", "quantum physics, no Gauss surface", ["QUANTUM"], def() return exp(2 * log(2)) end)
  eqs("AGZE.45", "d/df F = m(x)", "gravity in quantum physics", ["OTHER"])
  eqs("AGZE.46", "d/dt ψ(t) = ℏ = (1/(2i)) e^{iĤ}", "(no gloss in text; continuation of chain)", ["QUANTUM"])
  eqs("AGZE.47", "(iℏ)' = (−e^{iĤ})' = −i e^{iĤ}", "(no gloss in text; continuation of chain)", ["QUANTUM"])
  eq("AGZE.48", "ψ(x) = e^{−iĤt} , ⊕(iℏ∇)^{⊕L} = (1/2) e^{iĤ(−i e^{iĤ})}", "(no gloss in text; continuation of chain)", ["QUANTUM"], def() return cscale(cexp(cmul(C(0, 1), cmul(C(0, -1), cexp(C(0, 1))))), 0.5) end)
  eq("AGZE.49", "= (1/(2f))^{−if} = (1/2)^{−if} · e^{−x log x} · (f)^i", "(no gloss in text; continuation of chain)", ["GAMMA", "QUANTUM"], def() return chk(cpow(C(1 / (2 * 2), 0), C(0, -2)), cmul(cmul(cpow(C(0.5, 0), C(0, -2)), C(exp(0 - 2 * log(2)), 0)), cpow(C(2, 0), C(0, 1)))) end)
  eq("AGZE.50", "= ∫ e^{−x} x^{t−1} dx , d/dγ Γ = e^{−x log x}", "(no gloss in text; continuation of chain)", ["GAMMA"], def() return chk(hA2_gam(3.5), gamma(3.5)) end)
  eq("AGZE.51", "f = x , i = t , 1/2 = a , ⊕ a^{−t} x x^t [Im] ≅ ∫ e^{−x} x^{t−1} dx", "Dirichlet-type sum ≅ gamma", ["GAMMA", "ZETA"], def() return chk(pow(0.5, 0 - 2) * 2 * pow(2, 2), hA2_gam(2)) end)
  eq("AGZE.52", "|ψ(t)⟩_s = e^{−iĤt} |Ψ⟩_H , Â_s = Â_H(0)", "Schrödinger/Heisenberg pictures", ["QUANTUM"], def() return chk(at(hA2_U(0.7), 2), C(0, 0 - sin(0.7))) end)
  eq("AGZE.53", "|Ψ(t)⟩_s → d/dt ; i d/dt |ψ(t)⟩_s = Ĥ |ψ(t)⟩_s", "Schrödinger equation", ["QUANTUM"], def() return chk(at(hA2_schr(1, 100), 1), at(hA2_U(1), 2)) end)
  eq("AGZE.54", "⟨Â(t)⟩ = ⟨Ψ(t)| Â(0) |Ψ(t)⟩", "expectation value", ["QUANTUM"], def() return chk(hA2_expect(0.6), cos(2 * 0.6)) end)
  eq("AGZE.55", "d/dt Â = (1/i) [Â, H]", "Heisenberg equation", ["QUANTUM"], def() return chk(hA2_heis_lhs(0.4), hA2_heis_rhs(0.4)) end)
  eq("AGZE.56", "Â(t) = e^{iĤt} Â(0) e^{−iĤt}", "Heisenberg picture operator", ["QUANTUM"], def() return chk(at(hA2_heis(0.4), 1), C(0, 0 - sin(2 * 0.4))) end)
  eq("AGZE.57", "lim_{θ→0} (sin θ, cos θ) [[θ, 1], [1, θ]] (cos θ, sin θ)^T = [[1, 0], [0, −1]]", "rotation limit to σz", ["ROT"], def() return (sin(0.0001) * 0.0001 + cos(0.0001)) * cos(0.0001) + (sin(0.0001) + cos(0.0001) * 0.0001) * sin(0.0001) end)
  eqs("AGZE.58", "f^{−1}(x) x f(x) = I'_m , I'_m = [1, 0] × [0, 1]", "conjugation identity", ["OTHER"])
  eq("AGZE.59", "x + y ≥ √(x y)", "(no gloss in text; continuation of chain)", ["OTHER"], def() return chk(hA2_grid(def(x, y) return x + y >= sqrt(x * y) end, 0.1, 5, 20), 1) end)
  eq("AGZE.60", "x^{1/2 + iy} / e^{x log x} = 1", "zeta critical-line form", ["ZETA"], def() return chk(cdiv(cpow(C(2, 0), C(0.5, 1)), C(exp(2 * log(2)), 0)), C(1, 0)) end)
  eqs("AGZE.61", "O(x) = ∇_i∇_j ∫ e^{(2/m) sin θ cos θ} × N mod(e^{x log x})", "(no gloss in text; continuation of chain)", ["ROT"])
  eqs("AGZE.62", "O(x) (x + Δ|f|^2)^{1/2}", "(no gloss in text; continuation of chain)", ["OTHER"])
