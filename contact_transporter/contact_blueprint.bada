  eqs("INV.580", "∫ e^(−2) e^3 (−2)^(t−1) (−3)^(t−1) dx = ∫ e^1 (−2)^u (−3)^u dx ; ∫ e^1 (−1) z^n dx = ∫ w e dx = −(log x)' = −1/x", "spurious chain", ["OTHER"])
