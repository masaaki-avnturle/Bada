  eqs("EXP.57", "Z_M = ⟨M1 | M2⟩", "TQFT amplitude as inner product", ["JONES", "QUANTUM"])
  eq("EXP.58", "e^x = Σ x^n / n! (r = ∞)", "exponential series", ["OTHER"], def() return chk(hCD_expseries(1.5, 30), exp(1.5)) end)
  eqs("EXP.59", "(d/df) ∫ dx^m = (1/n!) Σ x^n", "measure derivative", ["OTHER"])
  eq("EXP.60", "∫_n^(n+1) dx/x < 1/n (n ≥ 1)", "Euler-constant bound", ["ZETA"], def() return 1 / 3 - hCD_quad(def(x) return 1 / x end, 3, 4, 100) end)
  eq("EXP.61", "1 + 1/2 + ··· + 1/n > ∫_1^(n+1) dx/x = log(n+1)", "harmonic lower bound", ["ZETA"], def() return hCD_harmonic(10) - hCD_quad(def(x) return 1 / x end, 1, 11, 200) end)
  eqs("EXP.62", "1 + 1/2 + ··· + 1/n − log x > log(n+1) − log n > 0 ; 1/(n+1) < ∫_0^(n+1) dx/x = log(n+1) − log n (sic lower limit n)", "monotone bound", ["ZETA"])
  eq("EXP.63", "lim_{n→∞} ( 1 + 1/2 + ··· + 1/n − log n ) = C = ∫ ( ∫_1 x^s dx − log x ) dvol = ∫ C dx^m , C = 0.5772156···", "Euler–Mascheroni constant", ["GAMMA", "ZETA"], def() return chk(hCD_harmonic(10000) - log(10000), 0.5772156649) end)
  eqs("EXP.64", "C = ∫_1 x^s dx − log x ; = ∫ ( ∫_1 x^s dx − log x ) dvol = ∬_1 x^s dx − ∫ log x dvol", "constant as integral (=INV.9) (×3)", ["ZETA"])
  eqs("EXP.65", "F = Γ = ∫ e^(−x) x^(1−t) dx = (d/df) ∬_1 (y log y)^(1/2) dx^m − ∫ e^(−x) x^(1−t) log x dx^m", "gamma = entropy − digamma integral", ["GAMMA", "ENTROPY"])
  eqs("EXP.66", "∫ x^(1−t) e^(−x) dV = ∫ x^(1−t) dm ; ∫ x^(1−t) e^(−x) dV = ∫ x^(1−t) dvol", "weighted-volume gamma", ["GAMMA", "MANIFOLD"])
  eq("EXP.67", "f = γ = Γ' = ∫ e^(−x) x^(1−t) log x dx = (d/dγ)Γ^(−1) − ∫ e^(−x) x^(1−t) log x dx^m = (d/dγ)Γ^(−1) − (γ)γ' = e^(−f) − e^f = 2 cos(i x log x) (sic)", "Γ'(1) = −γ (Euler–Mascheroni) link", ["GAMMA", "ZETA"], def() return chk(hCD_gammaprime(1), 0.5772156649) end)
  eqs("EXP.68", "ds² = g_μν(x) dx^μ dx^ν + ψ²(x)( dx² + κ² A_μ(x) dx^ν )²", "Kaluza–Klein metric (×2)", ["SR", "MANIFOLD"])
  eqs("EXP.69", "ds² = −N(r)² dt² + ψ²(x)( dr² + r² dθ² )", "static lapse metric (×2)", ["SR", "MANIFOLD"])
  eqs("EXP.70", "ds² = −dt² + r^(−8πGm) ( dr² + r² dθ² )", "2+1 point-mass conical metric (×2)", ["SR", "MANIFOLD"])
  eqs("EXP.71", "dx² = g_μν(x)( g_μν(x) dx² − dx g_μν(x) ) ; dx = ( g_μν(x)² dx² − g_μν(x) dx g_μν(x) )^(1/2) (=INV.197) (×2)", "line-element variant", ["MANIFOLD"])
  eqs("EXP.72", "π(χ,x) = iπ(χ,x) f(x) − f(x) π(χ,x) (=INV.566) (×2)", "non-commutative fundamental group", ["MANIFOLD", "QUANTUM"])
  eq("EXP.73", "ds² = −(1 − r_s/r) c² dt² + dr²/(1 − r_s/r) + r² dθ² + r² sin²θ dψ²", "Schwarzschild metric; gravitational time dilation dτ = √(1−r_s/r) dt (×2)", ["SR", "MANIFOLD"], def() return 1 - sqrt(1 - (2 * 6.674e-11 * 5.972e24 / (C_LIGHT * C_LIGHT)) / 6.371e6) end)
  eq("EXP.74", "R_μν + (1/2) g_ij Λ = κ T_μν", "Einstein field equation (as written, sign/Λ placement sic) (×2)", ["SR", "MANIFOLD"], def() return 8 * pi() * 6.674e-11 / pow(C_LIGHT, 4) end)
  eqs("EXP.75", "∫ κ T_μν dvol = ∫ ( R_μν + (1/2) g_ij Λ ) dvol", "integrated Einstein eq (×2)", ["MANIFOLD"])
  eqs("EXP.76", "∫ Γ · (d/dγ)Γ dx^m ≤ ∫ Γ dx^m + (d/dγ)Γ = ∫ Γ(γ)' dx^m (×2)", "gamma inequality", ["GAMMA"])
  eqs("EXP.77", "∬ ( ∫_1 x^s dx − log x ) dvol = e^f − e^(−f) ≤ e^f + e^(−f) (×2)", "Euler constant manifold integral bound", ["ZETA"])
  eqs("EXP.78", "(d/df) F + ∫ C dx^m = 2( cos(i x log x) − i sin(i x log x) ) (×2)", "F + Euler const = circle fn", ["ROT", "ZETA"])
  eqs("EXP.79", "(d/df) F ≥ (d/df) ∬_1 (x log x)² dx^m + (d/df) ∬_1 (y log y)^(1/2) dy^m (×2; cf INV.576)", "F ≥ entropy integrals", ["ENTROPY"])
  eqs("EXP.80", "HΨ = ⊕ ( iℏ∇ ⊕ L ) = (1/(2i)) e^(iĤ) , (iℏ)' = (−e^(iĤ))' = −i e^(iĤ) (×2)", "Hamiltonian as exponential", ["QUANTUM"])
  eqs("EXP.81", "ψ(x) = e^(−iĤt) , ⊕ (iℏ∇)⊕L = (1/2) e^(iĤ) (−i e^(iĤ)) = (1/(2f))^(−if) = (1/2)^(−if) · e^(−x log x) · (f)^i = ∫ e^(−x) x^(t−1) dx (×2)", "quantum sum → gamma function", ["GAMMA", "QUANTUM"])
  eq("EXP.82", "(d/dγ) Γ = e^(−x log x) ; f = x, i = t, 1/2 = a ; ⊕ a^(−t) x x^t [Im] ≅ ∫ e^(−x) x^(t−1) dx (×2)", "Mellin/gamma identification", ["GAMMA"], def() return chk(gamma(2.5), gamma_integral(2.5, 40, 4000)) end)
  eqs("EXP.83", "|ψ(t)⟩_s = e^(−iĤt) |Ψ⟩_H , Â_s = Â_H(0) (×2)", "Schrödinger vs Heisenberg picture", ["QUANTUM"])
  eq("EXP.84", "|Ψ(t)⟩_s → (d/dt) : i (d/dt) |ψ(t)⟩_s = Ĥ |ψ(t)⟩_s (×2)", "Schrödinger equation (ℏ=1)", ["QUANTUM"], def() return chk(cmul(C(0, 1), C(hCD_dnum(def(t) return cos(t) end, 0.7), 0)), C(0, 0 - sin(0.7))) end)
  eqs("EXP.85", "⟨Â(t)⟩ = ⟨Ψ(t)| Â(0) |Ψ(t)⟩ (×2)", "expectation value", ["QUANTUM"])
  eqs("EXP.86", "(d/dt) Â = (1/i) [Â, H] (×2)", "Heisenberg equation of motion (sign convention sic)", ["QUANTUM"])
  eq("EXP.87", "Â(t) = e^(iĤt) Â(0) e^(−iĤt) (×2)", "Heisenberg-picture evolution", ["QUANTUM"], def() return cmul(cmul(cexp(C(0, 0.7)), C(1, 0)), cexp(C(0, 0.7))) end)
  eqs("EXP.88", "lim_{θ→0} (1/θ) [sinθ; cosθ][[θ,1],[1,θ]][cosθ; sinθ] = [[1,0],[0,−1]] ; f^(−1)(x) x f(x) = I'_m , I'_m = [1,0] × [0,1] (=INV.218/219) (×2)", "rotation limit to σ_z", ["ROT", "QUANTUM"])
  eqs("EXP.89", "x + y ≥ √(xy)", "AM–GM (sic factor 2) (×2)", ["OTHER"])
  eqs("EXP.90", "x^(1/2 + iy) / e^(x log x) = 1", "critical line = x^x (×2)", ["ZETA", "ENTROPY"])
  eqs("EXP.91", "O(x) = ∇_i∇_j ∫ e^((2/m) sinθ cosθ) × N mod(e^(x log x)) ; O(x)(x + Δ|f|²)^(1/2) (=INV.215/216) (×2)", "rotation operator", ["ROT"])
  eqs("EXP.92", "x Γ(x) = 2 ∫ | sin 2θ |² dθ , O(x) = m(x)[D²ψ] (=INV.217) (×2)", "gamma via sin²", ["ROT", "GAMMA"])
  eqs("EXP.93", "i² = (0,1)·(0,1) , |a||b| cosθ = −1 , E = div(E, E1) , {f,g}/[f,g] = i² , E = mc² , I' = i² (=INV.220/221) (×2)", "imaginary / mass-energy", ["ROT", "SR", "QUANTUM"])
  eqs("EXP.94", "HΨ = ⊕ (iℏ∇)⊕L = ⊕ HΨ / ∇L = e^(x log x) = x^(x)' ; (d/df) F = m(x)", "Hamiltonian = x^x", ["QUANTUM", "ENTROPY"])
  eqs("EXP.95", "(d/dt) ψ(t) = ℏ = (1/(2i)) e^(iĤ) , (iℏ)' = −i e^(iĤ)", "time derivative of psi", ["QUANTUM"])
  eqs("EXP.96", "(d/dγ) Γ = m(x) = e^(−x log x)", "gamma derivative = mass = x^(−x)", ["GAMMA", "ENTROPY"])
  eq("EXP.97", "sin(ix) = (e^(−x) + e^x)/(2i) (sic; correct is (e^{−x}−e^{x})/(2i) = i sinh x)", "sine of imaginary argument", ["ROT"], def() return chk(csin(C(0, 1)), cdiv(C(exp(-1) + exp(1), 0), C(0, 2))) end)
  eqs("EXP.98", "(d/df) F = m(x) = e^f + e^(−f) = 2i sin(i x log x) (sic)", "F derivative as cosh", ["ROT", "ENTROPY"])
  eqs("EXP.99", "β(p,q) = ∫ x^(1−t)(1−x)^t dx = ∫ t^x (1−t)^(x−1) dt (=INV.160)", "beta forms", ["BETA"])
  eq("EXP.100", "∫_0^1 x^10 (1−x)^20 dx = B(11,21) = Γ(11)Γ(21)/Γ(32) = 10!20!/31! = 1/931395465 (=INV.161)", "beta numeric example", ["GAMMA", "BETA"], def() return chk(931395465 * hCD_quad(def(x) return pow(x, 10) * pow(1 - x, 20) end, 0, 1, 400), 931395465 / 931395465) end)
  eqs("EXP.101", "1/931395465 = 1/9 = 1/(1−x) ; 1/(1−z) = Σ z^k ; 1/(1+z²) = Σ(−1)^k z^(2k) ; f(x) = Σ a_k z^k (=INV.162-164)", "series", ["OTHER"])
  eqs("EXP.102", "d^n y/dx^n = n! y^(n+1) , f^(0)(0) = n! f(0)^(n+1) = n! , f(x) ≅ Σ x^n = 1/(1−x) (=INV.165/166)", "derivatives of geometric fn", ["OTHER"])
  eq("EXP.103", "dy/dx = y² ⇒ −1/y = x − C ⇒ y = 1/(C − x) ; x=0, y=1 ⇒ y = 1/(1−x) (=INV.167/168)", "separable ODE (\"example script\")", ["OTHER"], def() return chk(hCD_dnum(def(x) return 1 / (1 - x) end, 0.5), pow(1 / (1 - 0.5), 2)) end)
  eq("EXP.104", "HΨ = ⊕ HΨ / ∇L , Γ = ∫ e^(−x) x^(1−t) dx , γ = ∫ e^(−x) x^(1−t) log x dx = ∫ Γ(γ)' dx^m = (d/dγ) Γ", "gamma & digamma-type integral", ["GAMMA"], def() return chk(hCD_gammaprime(2), hCD_dnum(def(s) return gamma(s) end, 2)) end)
  eq("EXP.105", "E = mc² , E = m² c²", "heat-energy change in three manifolds (special relativity)", ["SR"], def() return chk(2 * C_LIGHT * C_LIGHT, 2 * 2 * C_LIGHT * C_LIGHT) end)
  eqs("EXP.106", "∇(iℏ∇)⊕L , ⊕(iℏ∇)⊕L , □(iℏ∇)⊕L (=INV.93) (×2)", "operators on quantum sum (8 geometries / 4 Jones patterns)", ["JONES", "QUANTUM"])
