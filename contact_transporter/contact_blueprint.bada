  eqs("EXP.136", "(d/dL) V(τ) = (d/df) ∬_M 1/(x log x)² dx^m + (d/df) ∬_M 1/(y log y)^(1/2) dy^m (×2)", "D-brane/anti-D-brane volume derivative", ["MANIFOLD", "ENTROPY"])
  eqs("EXP.137", "ε_S(ν) = □v · (∂/∂χ)( ⁵√p ∧ g² ) dχ", "AdS5 graviton differential volume", ["MANIFOLD"])
  eqs("EXP.138", "∧(F_m^t)'' = (1/12) g²_ij", "quarks of other dimension", ["MANIFOLD"])
  eqs("EXP.139", "π(V_τ) = e^(−(√π/16) log x)^δ × 1/(x log x)", "expanding-space volume", ["ENTROPY"])
