  eqs("ST.499", "∫ a_k f^k dx_k = (a_{n+1}/(k + 1)) f^{n+1} + (a_{k+2}/(k + 2)) f^{k+2} + … (a_0/k) f^k", "termwise integration of series", ["OTHER"])
