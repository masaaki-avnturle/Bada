  eqs("ST.635", "G_μν + Λg_ij = T^{μν}, T^{μν} = (d/dx_μ)(d/dx_ν) f_μν + −2(T − t)|R_ij + f″ + (f′)²| = ∫ exp[L(x)] dm + O(N⁻¹) = ∫ e^{(2/m) sin θ cos θ}·log(sin θ) dx + O(N⁻¹)", "Einstein with Λ; four forces with rotating exponential", ["ROT", "SR", "MANIFOLD"])
