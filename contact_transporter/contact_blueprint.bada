  eqs("ST.328", "[−Δv + ∇_i∇_j v_ij − R_ij v_ij − v_ij∇_i∇_j + 2<∇f,∇h> + (R + ∇f²)(v/2 − h)] (×2)", "Perelman variation stored in DATABASE", ["MANIFOLD", "ENTROPY"])
