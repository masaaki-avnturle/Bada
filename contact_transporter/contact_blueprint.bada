  eq("INV.572", "f(r) = (1/(2m)) √(1 + f'(r)) / f(r) − m g f(r) ; m = 1, g = 1 ⇒ f(r) = (1/4)|r|²", "Euler–Lagrange solution", ["OTHER"], def() return chk(0.25 * 2 * 2, (1 / (2 * 1)) * sqrt(1 + 0.5 * 2) / (0.25 * 2 * 2) - 1 * 1 * (0.25 * 2 * 2)) end)
  eqs("INV.573", "∬_1 (x log x)² dx^m + ∬_1 (y log y)^(1/2) dy^m = 0", "imaginary+real entropy cancellation", ["ENTROPY"])
