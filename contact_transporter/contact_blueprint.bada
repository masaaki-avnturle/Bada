  eqs("INV.125", "∂/(∂x∂y) = ∇_i∇_j ; □ ∭ = ^t∭ ; (∂/∂x) ∭ = ∇_i∇_j ∫ ∇f(x) dη ; (∂/∂f)∭ = □ ∭", "operator identifications", ["MANIFOLD"])
