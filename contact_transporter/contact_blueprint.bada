  eq("INV.563", "1 / (x log x) = √g ; e^(x log x) , x = 2 , 2² = 4 , 2² = e^(2 log 2) , 4 = e^(log 4) , log 4 = log log 4 = √(4 log 4) = 1 − 2 = 1 (sic)", "x^x at 2 and spurious chain", ["ENTROPY"], def() return chk(pow(2, 2), exp(2 * log(2))) end)
