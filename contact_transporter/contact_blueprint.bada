  eq("ST.471", "(cos x −1; 1 −sin x)(cos x; sin x) = (1 0; 0 −1) → [cos²θ + sin θ + cos θ − 2sin²θ] |1 0; 0 −1|", "rotation matrix to determinant form", ["ROT"], def() return (pow(cos(pi() / 6), 2) + sin(pi() / 6) + cos(pi() / 6) - 2 * pow(sin(pi() / 6), 2)) * (1 * (0 - 1) - 0 * 0) end)
