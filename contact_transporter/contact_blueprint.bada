  eqs("EXP.108", "(d/dγ) Γ + ∫ C dx^m = 2( cos(i x log x) − i sin(i x log x) )", "gamma derivative + Euler const = circle fn", ["ROT", "GAMMA"])
  eqs("EXP.109", "e^(−θ) = cos(i x log x) − i sin(i x log x)", "\"Jones\" exponential circle identity", ["ROT", "JONES"])
  eqs("EXP.110", "∫ Γ(γ)' dx^m = 2( cos(i x log x) − i sin(i x log x) )", "gamma integral = circle fn", ["ROT", "GAMMA"])
  eq("EXP.111", "□ = −(16πG/c⁴) T_μν", "gravity equation (box form)", ["SR", "MANIFOLD"], def() return 0 - 16 * pi() * 6.674e-11 / pow(C_LIGHT, 4) end)
  eqs("EXP.112", "^t∭ cohom D_χ [Im] = ∮ (p x^n + q x + r) ∇_l ; (d/dl) L(x,y) = 2 ∫ ||sin 2x||² dτ , (d/dγ)Γ (=INV.120/121)", "cohomology/Lagrangian", ["ROT", "MANIFOLD"])
  eqs("EXP.113", "= [ iπ(χ,x), f(x) ] (=INV.25)", "commutator", ["QUANTUM"])
  eq("EXP.114", "(d/dγ) Γ = ∫ C dx^m = ∫ ( ∫_1 x^s dx − log x ) dvol", "gamma derivative = Euler constant integral (\"akashic record\")", ["GAMMA", "ZETA"], def() return 0 - hCD_gammaprime(1) end)
  eqs("EXP.115", "m ⊕(iℏ∇)⊕L + n ⊕(iℏ∇)⊕L = (m+n)⊕(iℏ∇)⊕L ; (m−n) ; ⊕L^m × ⊕L^n = ⊕L^(m+n) ; ⊕L^m / ⊕L^n = ⊕L^(m/n) (=INV.85-88)", "quantum-sum algebra", ["QUANTUM"])
  eqs("EXP.116", "d/df ⊕(iℏ∇)⊕L = ⊕(iℏ∇)⊕L' , ∫ ⊕(iℏ∇)⊕L dx^m , ⊕(iℏ∇)⊕L = n , n^(L+1)/(n+1) = ∫ e^x x^(1−t) dx (=INV.89-91)", "derivative/integral of quantum sum", ["GAMMA", "QUANTUM"])
  eqs("EXP.117", "( ⊕(iℏ∇)⊕L + m ⊕(iℏ∇)⊕L + n ) = n^(L+1)/(n+1) = t ∫ (1−x)^n x^(m−1) dx ; ∫ x^(m−1)(1−x)^(n−1) dx (=INV.92)", "beta from quantum sum", ["GAMMA", "BETA"])
  eqs("EXP.118", "⊠(iℏ∇)|L dx^m , ⊞(iℏ∇|L dx^m) , x^(1/2+iy) = e^(x log x) (=INV.93/47) (×2)", "operators / critical line", ["ZETA", "QUANTUM"])
  eq("EXP.119", "C = b0 + c1/(b1 + c2/(b2 + c3/(b3 + c4/(b4 + ···))))", "Euler constant as continued fraction", ["ZETA"], def() return chk(hCD_cf([0, 1, 1, 2, 1, 2, 1, 4, 3, 13, 5, 1, 1, 8, 1, 2, 4, 1, 1, 40]), 0.5772156649) end)
  eq("EXP.120", "(2.71828)^2.828 = a^a + b^b + c^c + d^d ··· = ∫ e^f · x^(1−t) dx", "e^(2√2) as sum of self-powers = gamma-type integral", ["GAMMA", "ENTROPY"], def() return pow(2.71828, 2.828) end)
  eqs("EXP.121", "(d/df) F(v_ij, h) = ∫ e^(−f) dV [ −Δv + ∇_i∇_j v_ij − R_ij v_ij − v_ij ∇_i∇_j + 2<∇f,∇h> + (R + ∇f²)(v/2 − h) ] = (d/df)F = 2 ∫ (R + ∇_i∇_j f)² / −(R + Δf) dm (=INV.575/570)", "Perelman first variation", ["MANIFOLD", "ENTROPY"])
  eqs("EXP.122", "F ≥ (d/df) ∬_1 (x log x)² dx^m + (d/df) ∬_1 (y log y)^(1/2) dy^m (=INV.576)", "F bound", ["ENTROPY"])
  eqs("EXP.123", "V(τ) = [f(x), g(x)] × [f^(−1)(x), h(x)]", "reduced volume as commutator product", ["MANIFOLD", "QUANTUM"])
  eqs("EXP.124", "Γ(p,q) = ∫ e^(−x) x^(1−t) dx = β(p,q) = π( f(χ,x), x )", "gamma = beta = fundamental group", ["GAMMA", "BETA", "MANIFOLD"])
  eqs("EXP.125", "||ds²|| = O(x)[ (f(x) ∘ g(x))_μν ] dx^μ dx^ν = lim_{x→∞} Σ_{k=0}^∞ a_k f_k", "metric as operator series", ["MANIFOLD"])
  eqs("EXP.126", "G_μν = (∂/∂f) ∫ [ f(x)_μν ∘ G(x)_μν dx^μ dx^ν ]_μν dm = g_μν(x) dx^μ dx^ν − f(x)_μν dx^μ dx^ν", "Einstein tensor as metric difference", ["MANIFOLD"])
  eqs("EXP.127", "[ iπ(χ,x), f(x) ] = iπ f(x) − f(x) π(χ,x)", "commutator expansion", ["QUANTUM"])
  eqs("EXP.128", "T_μν = ( lim_{x→∞} Σ_{k=0}^∞ ∬ [ V(τ) ∘ S_μν(χ,x) ] dm )_μν dx^μ dx^ν , G_μν = R_μν T_μν", "stress from volume series", ["MANIFOLD"])
  eqs("EXP.129", "[[D_m, d_x],[d_x, σ_m]] [[cosθ, −sinθ],[sinθ, cosθ]] [x; y] = [[1,0],[0,−1]]^(1/2) (cf INV.370) (×2)", "operator × rotation = √σ_z", ["ROT", "QUANTUM"])
  eqs("EXP.130", "σ_m [[δ(x), −1],[1, ε(x)]]^(1/2) = [[i,0],[0,−i]] (=INV.372) (×3)", "Pauli-type", ["QUANTUM"])
  eqs("EXP.131", "V(M) = (∂/∂f) ( N ∫ [f ∖ M] ⊕ N )_μν dx^μ dx^ν", "volume via set difference", ["MANIFOLD"])
  eq("EXP.132", "V(M) = π( 2 ∫ sin² dx ) ⊕ (d/df) F_M dx^m", "volume via sin²", ["ROT", "MANIFOLD"], def() return pi() * (2 * hCD_quad(def(x) return sin(x) * sin(x) end, 0, pi(), 200)) end)
  eqs("EXP.133", "lim_{x→∞} Σ_{k=0}^∞ a_k f_k = ∫ ( F(V) dx^m )_μν dx^μ dx^ν , ⊕_{k=0}^∞ [f ∖ g] = ∨(M ∧ N)", "series = volume integral", ["MANIFOLD"])
  eqs("EXP.134", "π1(M) = e^(−f² ∫ sin² x dm + O(N^(−1))) = [ iπ(χ,x), f(x) ]", "fundamental group as exp of sin² integral", ["ROT", "MANIFOLD"])
