  eqs("INV.304", "{f,g}/[f,g] = (fg + gf)/(fg − gf) , ∇f = 2 , ∂H3 = 2 , (1+f)/(1−f) = 1 , (d/df)F = ⊕ ∇C+− , F⃗ = 1/2", "anticommutator/commutator (fermion/boson)", ["QUANTUM"])
