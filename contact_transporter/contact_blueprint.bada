  eq("ACAOS.9", "x = C/log x , C = ∫ (1/x^s) dx − log x", "Euler product as reverse of zeta", ["ZETA"], def() return chk(2, (hA1_quad(def(x) return 1 / pow(x, 2) end, 1, 2, 200) - log(2)) / log(2)) end)
  eq("ACAOS.10", "x^y = 1/y^x", "reciprocal power relation", ["OTHER"], def() return chk(pow(2, 3), 1 / pow(3, 2)) end)
  eq("ACAOS.11", "π^e = ∫ e^{−□} d□ = e^π ∫ e^{□'} d□'", "emerged from beta function", ["BETA"], def() return chk(pow(pi(), exp(1)), exp(pi()) * hA1_quad(def(u) return exp(u) end, -40, 0, 400)) end)
  eqs("ACAOS.12", "□ = □' ⊠ Ψ → □ = Ψ ⊠ □'", "box product swap", ["OTHER"])
  eqs("ACAOS.13", "(1/(d/dl)) □(HΨ)∇ , □ d/dl (HΨ)∇", "global differential equation", ["MANIFOLD", "QUANTUM"])
  eqs("ACAOS.14", "β^{□−□'} / log x = β^{□−□'}", "beta power relation", ["BETA"])
  eqs("ACAOS.15", "t∭ (∇/∇l) □(HΨ)∇ d∇", "varint equation, fundamental function", ["MANIFOLD"])
  eqs("ACAOS.16", "= ∫ π(χ, □) ∇ d∇", "varint via fundamental group", ["MANIFOLD"])
  eqs("ACAOS.17", "= ∨∬ π(□) d∇m", "varint double integral", ["MANIFOLD"])
  eq("ACAOS.18", "e^π = e^{∫∫ e^{−x²−y²} dx dy}", "e^π via Gaussian", ["OTHER"], def() return chk(exp(pi()), exp(hA1_gauss2())) end)
  eq("ACAOS.19", "= x^y = 1/y^x = π^e · (1/e^π)", "chain of power identities", ["OTHER"], def() return chk(pow(exp(1), pi()), pow(pi(), exp(1)) * (1 / exp(pi()))) end)
  eq("ACAOS.20", "1/e^π = 1/∫ e^{−□} d□", "reciprocal", ["OTHER"], def() return chk(1 / exp(pi()), 1 / hA1_quad(def(u) return exp(0 - u) end, 0, 40, 400)) end)
  eq("ACAOS.21", "e^π = ∫ e^{−□} d□ ∫ e^{□'} d□'", "product of integrals", ["OTHER"], def() return chk(exp(pi()), hA1_quad(def(u) return exp(0 - u) end, 0, 40, 400) * hA1_quad(def(u) return exp(u) end, -40, 0, 400)) end)
  eq("ACAOS.22", "π^e = e^π ∫ e^{□'} d□'", "π^e from e^π", ["OTHER"], def() return chk(pow(pi(), exp(1)), exp(pi()) * hA1_quad(def(u) return exp(u) end, -40, 0, 400)) end)
  eq("ACAOS.23", "e^π = π^e ∫ e^{□'} d□'", "e^π from π^e", ["OTHER"], def() return chk(exp(pi()), pow(pi(), exp(1)) * hA1_quad(def(u) return exp(u) end, -40, 0, 400)) end)
  eq("ACAOS.24", "π^e = ( ∫ e^{−(cos θ + i sin θ)} dθ )^e", "circle function to power e", ["ROT"], def() return chk(pow(pi(), exp(1)), cpow(hA1_cquad(def(t) return cexp(cscale(cis(t), -1)) end, 0, 2 * pi(), 200), C(exp(1), 0))) end)
  eq("ACAOS.25", "π^e = 1/e^π = 1/∫ e^{−□} d□", "reciprocal relation", ["OTHER"], def() return chk(pow(pi(), exp(1)), 1 / exp(pi())) end)
  eq("ACAOS.26", "□' = 2( sin(i x log x) + cos(i x log x) ) (repeat)", "antigravity circle function", ["ROT"], def() return hA1_boxp(2) end)
  eq("ACAOS.27", "□ = cos(i x log x) − i sin(i x log x) (repeat)", "d'Alembertian circle function", ["ROT"], def() return chk(hA1_box(2), pow(2, 2)) end)
  eq("ACAOS.28", "∫ e^{−□} d□ = π^e (repeat)", "neipa step", ["OTHER"], def() return chk(hA1_quad(def(u) return exp(0 - u) end, 0, 40, 400), pow(pi(), exp(1))) end)
  eq("ACAOS.29", "log e^π = log ( π^e ∫ e^{□'} d□' )^2", "pi via log, neipa & pi step function", ["ZETA"], def() return chk(log(exp(pi())), log(pow(pow(pi(), exp(1)) * hA1_quad(def(u) return exp(u) end, -40, 0, 400), 2))) end)
  eq("ACAOS.30", "π = □/□'", "pi as ratio of d'Alembertian and antigravity", ["OTHER"], def() return chk(pi(), cdiv(hA1_box(2), hA1_boxp(2))) end)
  eqs("ACAOS.31", "π = e^β ∫ β dx^m", "pi via beta, global integral manifold", ["BETA", "MANIFOLD"])
  eq("ACAOS.32", "π = 1/log x = √g", "pi via log and root of g, zeta", ["ZETA"], def() return exp(1 / pi()) end)
  eq("ACAOS.33", "= 1 = πr² , r = 1/√π", "unit circle radius", ["ROT"], def() return chk(pi() * (1 / sqrt(pi())) * (1 / sqrt(pi())), 1) end)
  eq("ACAOS.34", "1/√π = ∫ (1/log x) dx , π = ∫ log x dx^m", "Kolmogorov function, neipa & pi", ["ZETA", "ENTROPY"], def() return chk(1 / sqrt(pi()), hA1_quad(def(x) return 1 / log(x) end, 2, 3, 200)) end)
  eqs("ACAOS.35", "π(χ,x) = [ iπ(χ,x), f(x) ]", "fundamental group of zeta, reverse function", ["MANIFOLD"])
  eq("ACAOS.36", "iπ(χ,x) ∘ f(x) = i ∫ x log x dx , f(x) ∘ π(χ,x) = ∫ 1/(x log x) dx", "non-commutative compositions", ["ENTROPY"], def() return C(0, hA1_quad(def(x) return x * log(x) end, 1, exp(1), 200)) end)
  eqs("ACAOS.37", "π(χ,x) = [ iπ(χ,x), f(x) ] (repeat)", "non-commutative equation", ["MANIFOLD"])
  eq("ACAOS.38", "π(χ,x) = ∫ x log x dx", "fundamental group as entropy integral", ["ENTROPY"], def() return hA1_quad(def(x) return x * log(x) end, 1, 2, 200) end)
  eq("ACAOS.39", "π(χ,x) = ∫ 1/(x log x) dx", "fundamental group as log-log", ["ENTROPY"], def() return hA1_quad(def(x) return 1 / (x * log(x)) end, 2, 4, 200) end)
  eqs("ACAOS.40", "π(χ,x) = iπ(χ,x) , i ∫ x log x dx ≅ ∫ 1/(x log x) dx", "same entropy energy imaginary/real", ["ENTROPY"])
  eqs("ACAOS.41", "∫ 1/(x log x) dx = i ∫ x log x dx − ∫ 1/(x log x) dx", "Shannon/Kolmogorov entropy integrals equal", ["ENTROPY"])
  eq("ACAOS.42", "∫∫ 1/(x log x)^2 dx^m = (1/2) i^3", "antigravity equation", ["OTHER"], def() return chk(hA1_quad(def(x) return 1 / pow(x * log(x), 2) end, 2, 4, 200), cscale(cmul(cmul(C(0, 1), C(0, 1)), C(0, 1)), 0.5)) end)
  eq("ACAOS.43", "d/df F(x,y) = d/df ∫∫ 1/(x log x)^2 dx^m + d/df ∫∫ 1/(y log y)^{1/2} dy^m", "global integral & differential manifold", ["MANIFOLD"], def() return hA1_quad(def(x) return 1 / pow(x * log(x), 2) end, 2, 4, 200) + hA1_quad(def(y) return 1 / sqrt(y * log(y)) end, 2, 4, 200) end)
  eq("ACAOS.44", "i = x^{90°} , x sin 90° = i", "imaginary as 90-degree rotation", ["ROT"], def() return chk(cexp(C(0, pi() / 2)), C(0, 1)) end)
  eq("ACAOS.45", "i = x^{1/2} , x = −1", "sqrt(−1)", ["ROT"], def() return chk(cpow(C(-1, 0), C(0.5, 0)), C(0, 1)) end)
  eqs("ACAOS.46", "π(χ,x) f(x) = i ∫ 1/(x log x) ∘ f(x) dx = i ∫ x log x dx", "reverse of imaginary result", ["ENTROPY"])
  eqs("ACAOS.47", "f(x) π(χ,x) = f(x) ∫ 1/(x log x) dx = ∫ 1/(x log x) dx", "reverse ordering", ["ENTROPY"])
  eqs("ACAOS.48", "i y = x sin 90°", "imaginary pole", ["ROT"])
  eq("ACAOS.49", "y = i , x = 1 , i x = y", "solution of imaginary pole", ["ROT"], def() return chk(cscale(C(0, 1), 1), C(0, 1)) end)
  eq("ACAOS.50", "i sin 90° = −1", "imaginary rotation (Cartan idea)", ["ROT"], def() return chk(cscale(C(0, 1), sin(pi() / 2)), C(-1, 0)) end)
  eq("ACAOS.51", "1 · sin 90° = i", "reverse pole in circle function", ["ROT"], def() return chk(C(1 * sin(pi() / 2), 0), C(0, 1)) end)
  eq("ACAOS.52", "π^e ≅ e^π", "mystery of Euler product, (anti)gravity", ["ZETA"], def() return chk(pow(pi(), exp(1)), exp(pi())) end)
  eqs("ACAOS.53", "[ ^^∨| : χ → ^^□ ]^{≪(p,q)}", "Heisenberg deprivate manifold", ["QUANTUM"])
  eqs("ACAOS.54", "= [ ^^∨| : y → ^^□ ]^{≪β(□,□')}", "beta step, double acceleration of hat", ["BETA", "QUANTUM"])
  eqs("ACAOS.55", "∨| : χ → HΨD → ⊕ iℏ ⊗ x1 ⊗ x2 ⋯", "D-group module entrance", ["QUANTUM"])
  eqs("ACAOS.56", "Φ(δ(HΨ))∇ = ∭ cohom Dχ(M)", "Heisenberg step into deprivate manifold", ["MANIFOLD", "QUANTUM"])
  eq("ACAOS.57", "= lim_{n→∞} ( nPr f(x)^n g(x)^{n−r} ) ∇", "binomial-type expansion", ["OTHER"], def() return hA1_npr_series(0.5, 0.5, 2, 60) end)
  eqs("ACAOS.58", "⊕(iℏ∇)^{⊕L} = ^^HΨ^{iℏ iℏ ⋯}", "divergence operator = step deprivate function", ["QUANTUM"])
  eqs("ACAOS.59", "= HΨ^{iℏ'}", "iterated derivative of HΨ", ["QUANTUM"])
  eq("ACAOS.60", "= iℏ^{iℏ'}", "iℏ to power iℏ'", ["QUANTUM"], def() return cpow(C(0, 1), C(0, 1)) end)
  eq("ACAOS.61", "= e^{HΨ log HΨ}", "exponential of entropy-like H log H", ["QUANTUM", "ENTROPY"], def() return hA1_expm_hlogh00(2, 1, 2) end)
  # ── category (Category theory escream into Seifert manifold)
  eq("ACAT.1", "E(σ) = K(σ) ⊗ H(σ)", "Seifert manifold to quantum component", ["MANIFOLD", "QUANTUM"], def() return hA1_kron_trace(list(1, 2, 3, 4), list(2, 0, 1, 1)) end)
  eq("ACAT.2", "d/dγ Γ = d/dγ ∫∫ 1/(x log x)^2 dx^m + d/dγ ∫∫ 1/(y log y)^{1/2} dy^m", "gamma derivative as double integrals", ["GAMMA"], def() return chk(hA1_dgamma(2), hA1_quad(def(x) return 1 / pow(x * log(x), 2) end, 2, 4, 200) + hA1_quad(def(y) return 1 / sqrt(y * log(y)) end, 2, 4, 200)) end)
  eqs("ACAT.3", "HΨ = ⊕(iℏ)∇^{⊕L}", "quantum Hamiltonian operator", ["QUANTUM"])
  eq("ACAT.4", "d/dV ∫ z^n dV = x^n + y^n", "Seifert circle zone, GR", ["MANIFOLD"], def() return chk(pow(5, 2), pow(3, 2) + pow(4, 2)) end)
  eq("ACAT.5", "d/dt g_ij(t) = −2 R_ij", "Ricci flow; universe & other dimension", ["MANIFOLD", "TRANSPORT"], def() return chk(hA1_ricci_sphere(1, 2, 0.25, 1000), 1 - 2 * (2 - 1) * 0.25) end)
  eqs("ACAT.6", "□* = −2 · 1/(R + Δ) |g_ij + (R + ∇_ij)| T_ij + R_ij", "space of quantum equation", ["MANIFOLD"])
  eq("ACAT.7", "L(s) = √x e^{i x log x}", "quantum level component L", ["ROT", "ZETA"], def() return cscale(cis(xlogx(2)), sqrt(2)) end)
  eq("ACAT.8", "L(s) = ( Γ(s) ∫∫ e^{i x log x} ) dx^m", "L via gamma times phase integral", ["GAMMA", "ZETA"], def() return cscale(hA1_cquad(def(x) return cis(xlogx(x)) end, 1, 2, 200), gamma(2)) end)
  eq("ACAT.9", "1/L(s) = ζ(1 − s) ζ(s) ζ(1 + s) ⋯", "new session, space to time reversed", ["ZETA", "TRANSPORT"], def() return zeta(1 - 2) * zeta(2) * zeta(1 + 2) end)
  eqs("ACAT.10", "= ∫ C dx^m", "integral of constant", ["OTHER"])
  eq("ACAT.11", "||ds²|| = 8πG ( p/c³ + V/S )", "Seifert AdS5 zone, time machine system", ["SR", "MANIFOLD", "TRANSPORT"], def() return 8 * pi() * 6.6743e-11 * (1 / pow(C_LIGHT, 3) + 1 / 1) end)
  eqs("ACAT.12", "||ds²|| = HΨ = (1/i) [HΨ, ΨH]", "metric as Heisenberg commutator", ["QUANTUM", "TRANSPORT"])
  eqs("ACAT.13", "||h_λ||² = HΨ", "three-manifold energy of entropy", ["MANIFOLD", "ENTROPY"])
  eq("ACAT.14", "∫ 2 sin x cos x dx ∫ e^{2 sin x cos x} dx = β(p,q)", "beta on tuple space, eternal value", ["ROT", "BETA"], def() return chk(hA1_quad(def(x) return 2 * sin(x) * cos(x) end, 0, pi() / 2, 200) * hA1_quad(def(x) return exp(2 * sin(x) * cos(x)) end, 0, pi() / 2, 200), beta(1, 1)) end)
  eqs("ACAT.15", "e^β · □ e^{x log x} = ⊕(iℏ∇)^{⊕L}", "beta emerges on all equations", ["BETA", "QUANTUM"])
  eq("ACAT.16", "∫∫ e^{−x²−y²} dx dy = π", "Gaussian: circle element, neipa step", ["OTHER"], def() return chk(hA1_gauss2(), pi()) end)
  eq("ACAT.17", "π^e = ( ∫ e^{cos θ + i sin θ} dθ )^e", "circle function to power e", ["ROT"], def() return chk(pow(pi(), exp(1)), cpow(hA1_cquad(def(t) return cexp(cis(t)) end, 0, 2 * pi(), 200), C(exp(1), 0))) end)
  eq("ACAT.18", "= ( ∫ e^{iθ} dθ )^e", "rewritten via e^{iθ}", ["ROT"], def() return chk(pow(pi(), exp(1)), cpow(hA1_cquad(def(t) return cis(t) end, 0, 2 * pi(), 200), C(exp(1), 0))) end)
  eq("ACAT.19", "e^f → f = 1 , x log x = 1", "Jones manifold and Shannon entropy", ["JONES", "ENTROPY"], def() return hA1_xlogx_root(1) end)
  eq("ACAT.20", "∫ e^{−iθ} dθ = π^e", "circle integral = π^e", ["ROT"], def() return chk(hA1_cquad(def(t) return cis(0 - t) end, 0, 2 * pi(), 200), pow(pi(), exp(1))) end)
  eq("ACAT.21", "□' = 2( sin(i x log x) + cos(i x log x) )", "antigravity equation as circle function", ["ROT", "OTHER"], def() return hA1_boxp(2) end)
  eq("ACAT.22", "□ = cos(i x log x) − i sin(i x log x)", "d'Alembertian as circle function", ["ROT"], def() return chk(hA1_box(2), pow(2, 2)) end)
  eq("ACAT.23", "∫ e^{−□} d□ = π^e", "circle of neipa step function", ["OTHER"], def() return chk(hA1_quad(def(u) return exp(0 - u) end, 0, 40, 400), pow(pi(), exp(1))) end)
  eq("ACAT.24", "x = C/log x , C = ∫ (1/x^s) dx − log x", "Euler product as reverse of zeta", ["ZETA"], def() return chk(2, (hA1_quad(def(x) return 1 / pow(x, 2) end, 1, 2, 200) - log(2)) / log(2)) end)
  eq("ACAT.25", "x^y = 1/y^x", "reciprocal power relation", ["OTHER"], def() return chk(pow(2, 3), 1 / pow(3, 2)) end)
  eq("ACAT.26", "π^e = ∫ e^{−□} d□ = e^π ∫ e^{□'} d□'", "emerged from beta function", ["BETA"], def() return chk(pow(pi(), exp(1)), exp(pi()) * hA1_quad(def(u) return exp(u) end, -40, 0, 400)) end)
  eqs("ACAT.27", "□ = □' ⊠ Ψ → □ = Ψ ⊠ □'", "box product swap", ["OTHER"])
  eqs("ACAT.28", "(1/(d/dl)) □(HΨ)∇ , □ d/dl (HΨ)∇", "global differential equation", ["MANIFOLD", "QUANTUM"])
  eqs("ACAT.29", "β^{□−□'} / log x = β^{□−□'}", "beta power relation", ["BETA"])
  eqs("ACAT.30", "t∭ (∇/∇l) □(HΨ)∇ d∇", "varint equation, fundamental function", ["MANIFOLD"])
  eqs("ACAT.31", "= ∫ π(χ, □) ∇ d∇", "varint via fundamental group", ["MANIFOLD"])
  eqs("ACAT.32", "= ∨∬ π(□) d∇m", "varint double integral", ["MANIFOLD"])
  eq("ACAT.33", "e^π = e^{∫∫ e^{−x²−y²} dx dy}", "e^π via Gaussian", ["OTHER"], def() return chk(exp(pi()), exp(hA1_gauss2())) end)
  eq("ACAT.34", "= x^y = 1/y^x = π^e · (1/e^π)", "chain of power identities", ["OTHER"], def() return chk(pow(exp(1), pi()), pow(pi(), exp(1)) * (1 / exp(pi()))) end)
  eq("ACAT.35", "1/e^π = 1/∫ e^{−□} d□", "reciprocal", ["OTHER"], def() return chk(1 / exp(pi()), 1 / hA1_quad(def(u) return exp(0 - u) end, 0, 40, 400)) end)
  eq("ACAT.36", "e^π = ∫ e^{−□} d□ ∫ e^{□'} d□'", "product of integrals", ["OTHER"], def() return chk(exp(pi()), hA1_quad(def(u) return exp(0 - u) end, 0, 40, 400) * hA1_quad(def(u) return exp(u) end, -40, 0, 400)) end)
  eq("ACAT.37", "π^e = e^π ∫ e^{□'} d□'", "π^e from e^π", ["OTHER"], def() return chk(pow(pi(), exp(1)), exp(pi()) * hA1_quad(def(u) return exp(u) end, -40, 0, 400)) end)
  eq("ACAT.38", "e^π = π^e ∫ e^{□'} d□'", "e^π from π^e", ["OTHER"], def() return chk(exp(pi()), pow(pi(), exp(1)) * hA1_quad(def(u) return exp(u) end, -40, 0, 400)) end)
  eq("ACAT.39", "π^e = ( ∫ e^{−(cos θ + i sin θ)} dθ )^e", "circle function to power e", ["ROT"], def() return chk(pow(pi(), exp(1)), cpow(hA1_cquad(def(t) return cexp(cscale(cis(t), -1)) end, 0, 2 * pi(), 200), C(exp(1), 0))) end)
  eq("ACAT.40", "π^e = 1/e^π = 1/∫ e^{−□} d□", "reciprocal relation", ["OTHER"], def() return chk(pow(pi(), exp(1)), 1 / exp(pi())) end)
  eq("ACAT.41", "□' = 2( sin(i x log x) + cos(i x log x) ) (repeat)", "antigravity circle function", ["ROT"], def() return hA1_boxp(2) end)
  eq("ACAT.42", "□ = cos(i x log x) − i sin(i x log x) (repeat)", "d'Alembertian circle function", ["ROT"], def() return chk(hA1_box(2), pow(2, 2)) end)
  eq("ACAT.43", "∫ e^{−□} d□ = π^e (repeat)", "neipa step", ["OTHER"], def() return chk(hA1_quad(def(u) return exp(0 - u) end, 0, 40, 400), pow(pi(), exp(1))) end)
  eq("ACAT.44", "□' = −2i cosh dV (pypdf 'cos hdV')", "reverse of square, antigravity", ["ROT", "OTHER"], def() return cscale(C(0, 1), -2 * cosh(1)) end)
  eq("ACAT.45", "□' = 1/□", "antigravity as reciprocal box", ["OTHER"], def() return chk(hA1_boxp(2), cdiv(C(1, 0), hA1_box(2))) end)
  eqs("ACAT.46", "[ ^^∨| : χ → ^^□ ]^{≪(p,q)}", "Heisenberg deprivate manifold", ["QUANTUM"])
  eqs("ACAT.47", "= [ ^^∨| : y → ^^□ ]^{≪β(□,□')}", "beta step, double acceleration of hat", ["BETA", "QUANTUM"])
  eqs("ACAT.48", "∨| : χ → HΨD → ⊕ iℏ ⊗ x1 ⊗ x2 ⋯", "D-group module entrance", ["QUANTUM"])
  eqs("ACAT.49", "Φ(δ(HΨ))∇ = ∭ cohom Dχ(M)", "Heisenberg step into deprivate manifold", ["MANIFOLD", "QUANTUM"])
  eq("ACAT.50", "= lim_{n→∞} ( nPr f(x)^n g(x)^{n−r} ) ∇", "binomial-type expansion", ["OTHER"], def() return hA1_npr_series(0.5, 0.5, 2, 60) end)
  eqs("ACAT.51", "⊕(iℏ∇)^{⊕L} = ^^HΨ^{iℏ iℏ ⋯}", "divergence operator = step deprivate function", ["QUANTUM"])
  eqs("ACAT.52", "= HΨ^{iℏ'}", "iterated derivative of HΨ", ["QUANTUM"])
  eq("ACAT.53", "= iℏ^{iℏ'}", "iℏ to power iℏ'", ["QUANTUM"], def() return cpow(C(0, 1), C(0, 1)) end)
  eq("ACAT.54", "= e^{HΨ log HΨ}", "exponential of entropy-like H log H", ["QUANTUM", "ENTROPY"], def() return hA1_expm_hlogh00(2, 1, 2) end)
  # ── category_stream (Field of projection system)
  eqs("ACATS.1", "g_ij|_{Dχ} (□ : x ⊢ y) → g_ij|_{Dχ} x·y/∼", "projection from Seifert manifold, Ricci flow", ["MANIFOLD"])
  eqs("ACATS.2", "x·y/Γ = −2 ∫ (R + ∇_i∇_j)/(R + Δ) e^{−f} dV", "Perelman-like functional over gamma", ["GAMMA", "MANIFOLD"])
  eqs("ACATS.3", "π(χ,x) = [ iπ(χ,x), f(x) ]", "fundamental group retains", ["MANIFOLD"])
  eqs("ACATS.4", "L(Δx)| : x ⊢ y → g_ij|_{Dχ} ll'·gg'/∼", "L-function projection", ["ZETA", "MANIFOLD"])
  eqs("ACATS.5", "Ll'·Gg'/Γ = β(p,q)", "beta from gamma and L function", ["GAMMA", "ZETA", "BETA"])
  eq("ACATS.6", "L[f(x) : g(x)] = (f(x) + g(x))/2 ≥ √(f(x)·g(x))", "average of add and even (AM-GM)", ["OTHER"], def() return (exp(1) + 1 * 1) / 2 - sqrt(exp(1) * 1 * 1) end)
  eqs("ACATS.7", "∇·Δ = g_μν(x) x g^{−1}_μν(x) = e", "non-commutative differential operator", ["OTHER"])
  eq("ACATS.8", "U^{−1} E U = [[1, 0], [0, −1]]", "Maskawa non-symmetric transform to other dimension", ["QUANTUM", "TRANSPORT"], def() return chk(hA1_m2dist(hA1_m2mul(hA1_m2mul(hA1_m2real(1 / sqrt(2), 1 / sqrt(2), 1 / sqrt(2), -1 / sqrt(2)), hA1_m2real(0, 1, 1, 0)), hA1_m2real(1 / sqrt(2), 1 / sqrt(2), 1 / sqrt(2), -1 / sqrt(2))), hA1_m2real(1, 0, 0, -1)), 0) end)
  eq("ACATS.9", "HΨ = ⊕(iℏ∇)^{⊕L} = e^{iHΨ − iHΨ}", "quantum level function", ["QUANTUM"], def() return cexp(csub(C(0, 3.5), C(0, 3.5))) end)
  eq("ACATS.10", "e^{−iHΨ} f(x) e^{iHΨ} = E_n", "unitary conjugation gives energy", ["QUANTUM"], def() return at(hA1_m2mul(hA1_m2mul(hA1_m2expm(hA1_m2scale(hA1_m2real(1, 0, 0, -1), C(0, -1))), hA1_m2real(2, 1, 1, 3)), hA1_m2expm(hA1_m2scale(hA1_m2real(1, 0, 0, -1), C(0, 1)))), 1) end)
  eqs("ACATS.11", "E_n = K_n × H_n", "Thurston-Perelman manifold", ["MANIFOLD"])
  eq("ACATS.12", "d/dγ Γ = e^{−f} + e^{f} = i sin(i x log x)", "gamma to imaginary complex function", ["ROT", "GAMMA"], def() return chk(C(exp(0 - xlogx(2)) + exp(xlogx(2)), 0), cmul(C(0, 1), csin(C(0, xlogx(2))))) end)
  # ── gamma_beta_zeta_estimate (Global differential/integrate equation; 'David Hilbert' byline)
  eqs("AGBZ.1", "∂/∂f F(x) = ∬ cohom D_k(x) [Im]", "cohomology from isotopy of D-brane", ["MANIFOLD"])
  eqs("AGBZ.2", "∂/∂f F = t∬ cohom D_k(x)^{≪p}", "double integral of projection", ["MANIFOLD"])
  eqs("AGBZ.3", "∮ r dx^m = O(x,y)", "horizon cut integral", ["OTHER"])
  eqs("AGBZ.4", "t∭ D(χ,x) Hom[D²ψ]^{≪p} ≅ vol(V/S)", "triple varint = volume", ["MANIFOLD"])
  eqs("AGBZ.5", "∂/∂f F(x) = t∬ cohom D_k(x)^{≪p}", "global partial diff = cohomology cut", ["MANIFOLD"])
  eqs("AGBZ.6", "d/df F = (F)^{f'} , ∫ F dx^m = (F)^f", "global differential/integral definitions", ["MANIFOLD"])
  eqs("AGBZ.7", "d/df ∫∫ 1/(x log x)^2 dx^m = ( ∫∫ 1/(x log x)^2 dx^m )^{f'}", "(no gloss in text; continuation of chain)", ["MANIFOLD"])
  eq("AGBZ.8", "f' = 2x( log x + log(x + 1) )", "exponent f'", ["OTHER"], def() return hA2_fp(2) end)
  eq("AGBZ.9", "∫∫ F dx^m = ( 1/(x log x)^2 )^{∫ 2x(log x + log(x+1)) dx} = e^{−f}", "global integral value", ["MANIFOLD"], def() return chk(pow(1 / pow(2 * log(2), 2), hA2_f(2)), exp(0 - hA2_f(2))) end)
  eq("AGBZ.10", "d/df F = ( 1/(x log x)^2 )^{2x(log x + log(x+1))} = e^{f}", "global differential value", ["MANIFOLD"], def() return chk(pow(1 / pow(2 * log(2), 2), hA2_fp(2)), exp(hA2_f(2))) end)
  eq("AGBZ.11", "log(x log x) ≥ 2 (y log y)^{1/2}", "inequality", ["ENTROPY"], def() return chk(hA2_grid(def(x, y) return log(x * log(x)) >= 2 * pow(y * log(y), 0.5) end, 2, 6, 20), 1) end)
  eq("AGBZ.12", "log(x log x) ≥ 2 √(y log y)", "inequality", ["ENTROPY"], def() return chk(hA2_grid(def(x, y) return log(x * log(x)) >= 2 * sqrt(y * log(y)) end, 2, 6, 20), 1) end)
  eqs("AGBZ.13", "π(χ,x) = [ iπ(χ,x), f(x) ]", "fundamental group commutator", ["MANIFOLD"])
  eqs("AGBZ.14", "∫ 1/(x log x) dx = i ∫ 1/(x log x) dx^N + N i ∫ 1/(x log x) dx", "(no gloss in text; continuation of chain)", ["ENTROPY"])
  eqs("AGBZ.15", "∫ 1/(x log x) dx = i ∫ x log x dx − ∫ 1/(x log x) dx", "(no gloss in text; continuation of chain)", ["ENTROPY"])
  eqs("AGBZ.16", "∫∫ 1/(x log x)^2 dx^m = i (1/2) x^2", "(no gloss in text; continuation of chain)", ["OTHER"])
  eqs("AGBZ.17", "∫∫ 1/(x log x)^2 dx^m = i ∬_M dx^m ≤ (1/2) i + x^2", "(no gloss in text; continuation of chain)", ["OTHER"])
  eq("AGBZ.18", "E = −(1/2) m v^2 + m c^2", "energy (kinetic sign flipped)", ["SR"], def() return chk(0 - 0.5 * 1 * 0.1 * 0.1 + 1 * 1 * 1, 1 / sqrt(1 - 0.1 * 0.1) * 1 * 1 * 1) end)
  eqs("AGBZ.19", "lim_{x→∞} ∫∫ 1/(x log x)^2 dx^m ≥ (1/2) i", "(no gloss in text; continuation of chain)", ["OTHER"])
  eqs("AGBZ.20", "d/df ∫∫ 1/(x log x)^2 dx^m = (1/2) i", "(no gloss in text; continuation of chain)", ["OTHER"])
  eqs("AGBZ.21", "d/df ∫∫ 1/(x log x)^2 dx^m = ( ∫∫ 1/(x log x)^2 dx^m )^{(f)'}", "(no gloss in text; continuation of chain)", ["OTHER"])
  eq("AGBZ.22", "(f)(f)' = (f f)'/2 = e^{x log x}", "(no gloss in text; continuation of chain)", ["ENTROPY"], def() return chk((2 * log(2)) * (log(2) + 1), exp(2 * log(2) * log(2 * log(2)))) end)
  eq("AGBZ.23", "Γ = ∫ e^{−x} x^{1−t} dx , d/df F = e^f , ∫ F dx^m = e^{−f}", "gamma as global differential", ["GAMMA"], def() return chk(hA2_gam(2 - 0.5), gamma(2 - 0.5)) end)
  eqs("AGBZ.24", "∫ x^{1−t} dx = d/df F , ∫ e^{−x} dx = ∫ F dx^m", "(no gloss in text; continuation of chain)", ["GAMMA"])
  eq("AGBZ.25", "e^{iθ} = cos θ + i sin θ", "Euler formula", ["ROT"], def() return chk(cexp(C(0, pi() / 6)), C(cos(pi() / 6), sin(pi() / 6))) end)
  eqs("AGBZ.26", "x ⊥ y → x·y = 0⃗ , d/df ∫∫ 1/(x log x)^2 dx^m = (1/2) i", "(no gloss in text; continuation of chain)", ["OTHER"])
  eqs("AGBZ.27", "d/df ∫∫ 1/(x log x)^2 dx^m = ( ∫∫ ... )^{(f)'}", "(no gloss in text; continuation of chain)", ["OTHER"])
  eq("AGBZ.28", "1/2 + (1/2) i = 0⃗ , (1/2)·(1/2) i", "real pole 1/2 (critical line)", ["ZETA"], def() return chk(C(0.5, 0.5), C(0, 0)) end)
  eq("AGBZ.29", "A + B = 0⃗ , A·B = (1/4) i", "(no gloss in text; continuation of chain)", ["ZETA"], def() return chk(C(cabs(cadd(C(0.5, 0), C(0, 0.5))), im(cmul(C(0.5, 0), C(0, 0.5)))), C(0, 0.25)) end)
  eqs("AGBZ.30", "tan 90 ≠ 0 , ||ds²|| = A + B", "(no gloss in text; continuation of chain)", ["OTHER"])
  eq("AGBZ.31", "sin 0 = 0", "real pole of 1/2", ["ZETA"], def() return chk(sin(0), 0) end)
  eq("AGBZ.32", "e^{iθ} = cos θ + i sin θ (repeat)", "non-certain system of particles", ["ROT", "QUANTUM"], def() return chk(cexp(C(0, 1.2)), C(cos(1.2), sin(1.2))) end)
  eq("AGBZ.33", "d/df F = d/df ∫∫ 1/(x log x)^2 dx^m + d/df ∫∫ 1/(y log y)^{1/2} dy^m = Γ(x,y)", "gamma of two variables", ["GAMMA"], def() return chk(pow(1 / pow(2 * log(2), 2), hA2_fp(2)) + pow(1 / pow(2 * log(2), 0.5), hA2_fp(2)), hA2_igam(2, 2)) end)
  eqs("AGBZ.34", "d/dγ Γ = (e^{−x} x^{1−t})^{γ'} → d/dγ Γ = Γ(γ)'", "(no gloss in text; continuation of chain)", ["GAMMA"])
  eq("AGBZ.35", "Γ(s) = ∫ e^{−x} x^{s−1} dx , Γ'(s) = ∫ e^{−x} x^{s−1} log x dx", "gamma and its derivative (correct)", ["GAMMA"], def() return chk(hA2_dgam(1), 0 - 0.5772156649015329) end)
  eq("AGBZ.36", "x^{s−1} = e^{(s−1) log x}", "(no gloss in text; continuation of chain)", ["GAMMA"], def() return chk(pow(2, 2.5 - 1), exp((2.5 - 1) * log(2))) end)
  eq("AGBZ.37", "∂/∂s x^{s−1} = ∂/∂s e^{−x}·e^{(s−1)log x} = e^{−x}·log x·e^{(s−1)log x} = e^{−x}·log x·x^{s−1}", "derivative of integrand", ["GAMMA"], def() return chk((exp(0 - 2) * pow(2, 2.5 + 0.00001 - 1) - exp(0 - 2) * pow(2, 2.5 - 0.00001 - 1)) / 0.00002, exp(0 - 2) * log(2) * pow(2, 2.5 - 1)) end)
  eq("AGBZ.38", "d/dγ Γ = Γ(γ)'", "(no gloss in text; continuation of chain)", ["GAMMA"], def() return chk(hA2_dgam(2), gamma(2) * hA2_digamma(2)) end)
  eqs("AGBZ.39", "d/dγ Γ(s) = ∫0^∞ e^{−x} x^{s−1} dx^{(∫0^∞ e^{−x}x^{s−1} log x dx)'} = Γ(Γ ∫ log x dx)' = e^{−x log x}", "(no gloss in text; continuation of chain)", ["GAMMA"])
  eq("AGBZ.40", "Γ(s) = ∫0^∞ e^{−x} x^{s−1} dx", "gamma function", ["GAMMA"], def() return chk(hA2_gam(2.5), gamma(2.5)) end)
  eq("AGBZ.41", "Γ'(s) = ∫0^∞ e^{−x} x^{s−1} log x dx", "gamma derivative", ["GAMMA"], def() return chk(hA2_dgam(3), (gamma(3 + 0.00001) - gamma(3 - 0.00001)) / 0.00002) end)
  eqs("AGBZ.42", "d/df F = ∫ x^{s−1} dx , ∫ F dx^m = ∫ e^{−x} dx", "(no gloss in text; continuation of chain)", ["GAMMA"])
  eqs("AGBZ.43", "d/df F = F^{(f)'} , ∫ F dx^m = F^{(f)}", "(no gloss in text; continuation of chain)", ["MANIFOLD"])
  eq("AGBZ.44", "HΨ = ⊕(iℏ∇)^{⊕L} = ⊕ HΨ^{∇L} = e^{x log x} = x^{(x)'}", "quantum physics, no Gauss surface", ["QUANTUM"], def() return exp(2 * log(2)) end)
  eqs("AGBZ.45", "d/df F = m(x)", "gravity in quantum physics", ["OTHER"])
  eqs("AGBZ.46", "d/dt ψ(t) = ℏ = (1/(2i)) e^{iĤ}", "(no gloss in text; continuation of chain)", ["QUANTUM"])
  eqs("AGBZ.47", "(iℏ)' = (−e^{iĤ})' = −i e^{iĤ}", "(no gloss in text; continuation of chain)", ["QUANTUM"])
  eq("AGBZ.48", "ψ(x) = e^{−iĤt} , ⊕(iℏ∇)^{⊕L} = (1/2) e^{iĤ(−i e^{iĤ})}", "(no gloss in text; continuation of chain)", ["QUANTUM"], def() return cscale(cexp(cmul(C(0, 1), cmul(C(0, -1), cexp(C(0, 1))))), 0.5) end)
  eq("AGBZ.49", "= (1/(2f))^{−if} = (1/2)^{−if} · e^{−x log x} · (f)^i", "(no gloss in text; continuation of chain)", ["GAMMA", "QUANTUM"], def() return chk(cpow(C(1 / (2 * 2), 0), C(0, -2)), cmul(cmul(cpow(C(0.5, 0), C(0, -2)), C(exp(0 - 2 * log(2)), 0)), cpow(C(2, 0), C(0, 1)))) end)
  eq("AGBZ.50", "= ∫ e^{−x} x^{t−1} dx , d/dγ Γ = e^{−x log x}", "(no gloss in text; continuation of chain)", ["GAMMA"], def() return chk(hA2_gam(3.5), gamma(3.5)) end)
  eq("AGBZ.51", "f = x , i = t , 1/2 = a , ⊕ a^{−t} x x^t [Im] ≅ ∫ e^{−x} x^{t−1} dx", "Dirichlet-type sum ≅ gamma", ["GAMMA", "ZETA"], def() return chk(pow(0.5, 0 - 2) * 2 * pow(2, 2), hA2_gam(2)) end)
  eq("AGBZ.52", "|ψ(t)⟩_s = e^{−iĤt} |Ψ⟩_H , Â_s = Â_H(0)", "Schrödinger/Heisenberg pictures", ["QUANTUM"], def() return chk(at(hA2_U(0.7), 2), C(0, 0 - sin(0.7))) end)
  eq("AGBZ.53", "|Ψ(t)⟩_s → d/dt ; i d/dt |ψ(t)⟩_s = Ĥ |ψ(t)⟩_s", "Schrödinger equation", ["QUANTUM"], def() return chk(at(hA2_schr(1, 100), 1), at(hA2_U(1), 2)) end)
  eq("AGBZ.54", "⟨Â(t)⟩ = ⟨Ψ(t)| Â(0) |Ψ(t)⟩", "expectation value", ["QUANTUM"], def() return chk(hA2_expect(0.6), cos(2 * 0.6)) end)
  eq("AGBZ.55", "d/dt Â = (1/i) [Â, H]", "Heisenberg equation", ["QUANTUM"], def() return chk(hA2_heis_lhs(0.4), hA2_heis_rhs(0.4)) end)
  eq("AGBZ.56", "Â(t) = e^{iĤt} Â(0) e^{−iĤt}", "Heisenberg picture operator", ["QUANTUM"], def() return chk(at(hA2_heis(0.4), 1), C(0, 0 - sin(2 * 0.4))) end)
  eq("AGBZ.57", "lim_{θ→0} (sin θ, cos θ) [[θ, 1], [1, θ]] (cos θ, sin θ)^T = [[1, 0], [0, −1]]", "rotation limit to σz", ["ROT"], def() return (sin(0.0001) * 0.0001 + cos(0.0001)) * cos(0.0001) + (sin(0.0001) + cos(0.0001) * 0.0001) * sin(0.0001) end)
  eqs("AGBZ.58", "f^{−1}(x) x f(x) = I'_m , I'_m = [1, 0] × [0, 1]", "conjugation identity", ["OTHER"])
  eq("AGBZ.59", "x + y ≥ √(x y)", "(no gloss in text; continuation of chain)", ["OTHER"], def() return chk(hA2_grid(def(x, y) return x + y >= sqrt(x * y) end, 0.1, 5, 20), 1) end)
  eq("AGBZ.60", "x^{1/2 + iy} / e^{x log x} = 1", "zeta critical-line form", ["ZETA"], def() return chk(cdiv(cpow(C(2, 0), C(0.5, 1)), C(exp(2 * log(2)), 0)), C(1, 0)) end)
  eqs("AGBZ.61", "O(x) = ∇_i∇_j ∫ e^{(2/m) sin θ cos θ} × N mod(e^{x log x})", "(no gloss in text; continuation of chain)", ["ROT"])
  eqs("AGBZ.62", "O(x) (x + Δ|f|^2)^{1/2}", "(no gloss in text; continuation of chain)", ["OTHER"])
  eq("AGBZ.63", "x Γ(x) = 2 ∫ |sin 2θ|^2 dθ , O(x) = m(x)[D²ψ]", "(no gloss in text; continuation of chain)", ["ROT", "GAMMA"], def() return chk(1.5 * gamma(1.5), 2 * hA2_simp(def(t) return pow(abs(sin(2 * t)), 2) end, 0, pi() / 2, 200)) end)
  eq("AGBZ.64", "i^2 = (0,1)·(0,1) , |a||b| cos θ = −1", "(no gloss in text; continuation of chain)", ["ROT"], def() return chk(cmul(C(0, 1), C(0, 1)), 0 * 0 + 1 * 1) end)
  eqs("AGBZ.65", "E = div(E, E_1)", "(no gloss in text; continuation of chain)", ["OTHER"])
  eq("AGBZ.66", "{f,g}/[f,g] = i^2 , E = m c^2 , I' = i^2", "Poisson/commutator ratio; mass-energy", ["SR", "QUANTUM"], def() return 1 * C_LIGHT * C_LIGHT end)
  eq("AGBZ.67", "d/dγ Γ = m(x) = e^{−x log x}", "Higgs field, zeta, quantum group", ["GAMMA", "ZETA"], def() return chk(hA2_dgam(2), exp(0 - 2 * log(2))) end)
  eq("AGBZ.68", "sin(ix) = (e^{−x} + e^{x})/(2i)", "hyper circle function", ["ROT"], def() return chk(csin(C(0, 1)), cdiv(C(exp(0 - 1) + exp(1), 0), C(0, 2))) end)
  eq("AGBZ.69", "d/df F = m(x) = e^f + e^{−f} = 2i sin(i x log x)", "hyper circle, beta reverse", ["ROT", "BETA"], def() return chk(C(exp(2 * log(2)) + exp(0 - 2 * log(2)), 0), cmul(C(0, 2), csin(C(0, 2 * log(2))))) end)
  # ── gamma_mebius_to_klein (Gamma function relativity restream into Mebius/Klein)
  eq("AGMK.1", "F(vertex) − N(edge) + E(face) = 2", "Euler number; vertices ~ universe singularities", ["MANIFOLD"], def() return chk(8 - 12 + 6, 2) end)
  eqs("AGMK.2", "Γ^{(x,y,z)} = ∫ (F − N + E) + (F − E + N) + (N − E + F) dx^m (operators lost in pypdf)", "integrating Euler number gives gamma", ["GAMMA", "MANIFOLD"])
  eqs("AGMK.3", "∂/∂f S Γ^{(x,y,z)}", "partial derivative of gamma volume", ["GAMMA"])
  eq("AGMK.4", "= ∫ ( ∫ (1/x^s) dx − log x ) dvol", "Euler constant integrated over manifold", ["GAMMA", "ZETA"], def() return chk(hA2_euler(2000), 0.5772156649015329) end)
  eq("AGMK.5", "= ∫ e^{−x} x^{1−t} dx^m", "becomes gamma function", ["GAMMA"], def() return chk(hA2_gam(2 - 0.3), gamma(2 - 0.3)) end)
  eq("AGMK.6", "||ds²|| = e^{−2πT||ψ||} [η + h̄(x)] dx^μ dx^ν + T² d²ψ", "AdS5 warped metric", ["SR", "MANIFOLD", "TRANSPORT"], def() return exp(0 - 2 * pi() * 1 * abs(0.5)) end)
  eqs("AGMK.7", "= O(x)", "metric equals O(x)", ["OTHER"])
  eq("AGMK.8", "□ = (8πG/c^4) T_μν", "d'Alembertian variation (gravity)", ["OTHER"], def() return 8 * pi() * 6.674e-11 / pow(C_LIGHT, 4) end)
  eq("AGMK.9", "∇ψ = 4πGρ", "Poisson gravity", ["OTHER"], def() return 4 * pi() * 6.674e-11 * 5514 end)
  eq("AGMK.10", "= ∫ ( ∫ (1/x^s) dx − log x ) dvol (repeat)", "Euler constant into global manifold", ["GAMMA", "ZETA"], def() return chk(hA2_euler(4000), 0.5772156649015329) end)
  eq("AGMK.11", "= ∫ e^{−x} x^{1−t} dx^m (repeat)", "gamma function", ["GAMMA"], def() return chk(hA2_gam(2 - 0.7), gamma(2 - 0.7)) end)
  eq("AGMK.12", "= d/df F = ∫ Γ(γ)' dx^m", "gamma derivative integral", ["GAMMA"], def() return chk(hA2_dgam(2), gamma(2) * hA2_digamma(2)) end)
  eq("AGMK.13", "= ∫ C dx^m = ( ∫ Γ dx^m − d/dγ Γ ) / ( ∫ Γ dx^m + d/dγ Γ )", "ratio of gamma integral and derivative", ["GAMMA"], def() return (hA2_gam(2) - hA2_dgam(2)) / (hA2_gam(2) + hA2_dgam(2)) end)
  eq("AGMK.14", "= e^{−θ} + e^{iθ}", "circle function", ["ROT"], def() return cadd(C(exp(0 - pi() / 6), 0), cexp(C(0, pi() / 6))) end)
  eq("AGMK.15", "= □ = 2( cos(i x log x) − i sin(i x log x) )", "d'Alembertian circle", ["ROT"], def() return chk(cscale(csub(ccos(C(0, 2 * log(2))), cmul(C(0, 1), csin(C(0, 2 * log(2))))), 2), C(2 * exp(2 * log(2)), 0)) end)
  eq("AGMK.16", "= (e^{−f} − e^{f}) / (e^{−f} + e^{f})", "reaches Jones", ["JONES"], def() return chk((exp(0 - 0.5) - exp(0.5)) / (exp(0 - 0.5) + exp(0.5)), 0 - tanh(0.5)) end)
  eqs("AGMK.17", "X → Y , Y → X", "forgetful functor / non-relativity", ["OTHER"])
  eq("AGMK.18", "⊕(iℏ∇)^{⊕L} = e^{−x log x}", "entropy of non-exchange, quantum diff. geometry", ["QUANTUM", "ENTROPY"], def() return exp(0 - 2 * log(2)) end)
  eqs("AGMK.19", "□ → ∇_j : x → y , f(x) → g(y) , f^{−1}(x) x f(x) → g(y)", "magnetic component, gravity/antigravity", ["OTHER"])
  eqs("AGMK.20", "□ → ∇_j : f(x) = g(y)", "(no gloss in text; continuation of chain)", ["OTHER"])
  eq("AGMK.21", "d/dt g_ij(t) = −2 R_ij , F_t^m = −2 ∫ (R + ∇_i∇_j f)/(Δ + f) dm", "Ricci flow & Perelman F", ["MANIFOLD"], def() return chk(hA2_ricci(2, 1, 0.2, 2000), sqrt(1 - 2 * (2 - 1) * 0.2)) end)
  eqs("AGMK.22", "d/df F = m(x)", "(no gloss in text; continuation of chain)", ["OTHER"])
  eqs("AGMK.23", "F_j = d/df F , F_t^m = e^{−f} dV", "Perelman measure", ["MANIFOLD"])
  eq("AGMK.24", "⊕(iℏ∇)^{⊕L} = e^{−x log x} (repeat)", "represent Forgotten theory", ["QUANTUM", "ENTROPY"], def() return exp(0 - 3 * log(3)) end)
  eq("AGMK.25", "β(p,q) = Γ(p)Γ(q)/Γ(p+q)", "beta function (operator lost)", ["GAMMA", "BETA"], def() return chk(hA2_simp(def(t) return pow(t, 2.5 - 1) * pow(1 - t, 1.5 - 1) end, 0, 1, 2000), gamma(2.5) * gamma(1.5) / gamma(2.5 + 1.5)) end)
  eqs("AGMK.26", "Γ(p)Γ(q)/Γ(p+q) [op] 1", "(no gloss in text; continuation of chain)", ["BETA"])
  eqs("AGMK.27", "∫ e^{−x} x^{1−t} dx^m = ∫ e^{−x} x^{1−t} dx [op] e^{−θ}", "(no gloss in text; continuation of chain)", ["GAMMA"])
  eq("AGMK.28", "= Γγ' = e^{−x log x}", "gamma derivative = x^{−x}", ["GAMMA", "ENTROPY"], def() return chk(hA2_dgam(0.5772156649015329), exp(0 - 0.5772156649015329 * log(0.5772156649015329))) end)
  eqs("AGMK.29", "⟨f,g⟩ ↦ ⟨d,d⟩", "Big Bang as collider, plane", ["OTHER"])
