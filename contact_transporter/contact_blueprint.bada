  eqs("ST.650", "x^n + y^n = z^n, δ(x)∫z^n = (d/dV)z³, (x,y)·(δ^m, ∂^m) = (x,y)·(z^n, f), n⊥x, n⊥y = 0", "Dalanvelsian duality; Fermat with orthogonality", ["OTHER"])
