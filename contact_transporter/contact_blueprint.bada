  eqs("INV.327", "Σ_{k=0}^n a_k f_k = (f_k)' , Σ_{k=0}^n a_k f_k = Σ_k nCr f_k = (f_k)' , Σ_{k=0}^∞ a_k f_k = [f(x)] , Σ a_k f_k = α", "series identities", ["OTHER"])
