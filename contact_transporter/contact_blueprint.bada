  eq("INV.329", "∬_1 (x log x)(y log y) dxy = nCr xy / ( nC(n−r) (x log x)(y log y) )^(−1) = (nC(n−r))²", "entropy double integral binomial", ["ENTROPY"], def() return chk(hCD_mid(def(x) return x * log(x) end, 0, 1, 1000) * hCD_mid(def(y) return y * log(y) end, 0, 1, 1000), pow(hCD_binom(2, 1), 2)) end)
