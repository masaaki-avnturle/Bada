  eq("ST.60", "Z(T,X) = exp(Σ_{m=1}^∞ (q^k T)^m / m)", "Weil congruence zeta function", ["ZETA"], def() return chk(hB_weil(2, 0.2, 100), 1 / (1 - 2 * 0.2)) end)
  eqs("ST.61", "Z(T,X) = P_1(T)P_3(T)…P_{2n−1} / (P_0(T)P_2(T)P_4(T)…P_{2n})", "Weil conjecture rationality", ["ZETA"])
  eqs("ST.62", "|v| = |∫(πr² + r⃗)dx|²", "velocity/volume norm", ["OTHER"])
