  eqs("ST.295", "l = √(ℏG/c³) · ∫∫ (1/(y log y)^{1/2}) dy_m / ∫∫ (1/(x log x)²) dx_m = 1/i", "Planck length × antigravity/gravity ratio = 1/i", ["ZETA", "MANIFOLD", "QUANTUM"])
  eqs("ST.296", "ihc = G, hc = G/i, (1/2)/((1/2)i) = v⃗_1/v⃗_2 ≤ 1", "gravity from ihc; velocity ratio", ["QUANTUM"])
  eqs("ST.297", "A = BQ + R, ds² = e^{−2πT|ψ|}[η_μν + h̄_μν(x)]dx^μ dx^ν + T² d²ψ", "quota equation and 5th-dim metric", ["TRANSPORT"])
