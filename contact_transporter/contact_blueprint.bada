  eq("EXP.19", "= R'_μν + (1/2) Λ g'_ij = ∫ ( i v/√(1 − (v/t)²) + v/√(1 − (v/t)²) ) dvol (=INV.117)", "Einstein tensor = Lorentz-factor integral (time dilation form)", ["SR"], def() return hCD_cquad(def(v) return C(v / sqrt(1 - v * v), v / sqrt(1 - v * v)) end, 0, 0.8, 200) end)
