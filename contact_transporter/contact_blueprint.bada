  eqs("INV.331", "Z ⊃ C ⊕ ∇R+ , ∇(R+ ∩ E+) ∋ x , Δ(C ⊂ R) ∋ x , M+− ⊕ R+ , E+ ∈ ⊕ ∇R+ , S+− ⊂ R+_2 , V+− × R+− ≅ V/S", "set relations", ["MANIFOLD"])
