#以下は、上のインタープリタで実行できるサンプルスクリプト（例題）。ファイル名例: `sample.tiny`
#
#内容（そのまま保存して `./tiny_lang sample.tiny` で実行）:

print "Hello, Tiny!"
x <- 3.14
y <- 2
print "x + y =" x + y

print "math.sin(x):" math sin x
print "math.pow(x, y):" math pow x y

s <- "one,two,three"
parts <- split s ","
print "parts:" parts
print "len(parts):" len parts
push parts "four"
print "after push:" parts
popped <- pop parts
print "popped:" popped
print "parts now:" parts

r <- regex_compile "^[0-9]+$"
print "regex match '123':" regex_match r "123"
print "regex match 'abc':" regex_match r "abc"

arr <- list 1 2 3
print "arr:" arr
print "arr[1]:" index arr 1

t <- tuple "a" "b" 42
print "tuple:" t
print "tuple[2]:" index t 2

print "input demo (type something):"
user <- input ">> "
print "you typed:" user

print "exec demo: running 'echo hi'"
exec "echo hi"

print "Done."
