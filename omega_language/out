# セッションデフォルト（URL/レポートリスト）\nprintf("\n");
session_urls <- [] ; printf("\n");
session_reports <- [] ;\nprintf("\n");
\nprintf("\n");
# キャッシュ\nprintf("\n");
_web_cache <- {} ;\nprintf("\n");
_report_cache <- {} ;\nprintf("\n");
\nprintf("\n");
# ユーティリティ（シェル実行ラッパ）\nprintf("\n");
sh_exec <- func(cmd) {\nprintf("\n");
  # exec は tiny_lang の組み込みコマンドを利用\nprintf("\n");
  exec cmd ;\nprintf("\n");
  return null ;\nprintf("\n");
}\nprintf("\n");
\nprintf("\n");
# PDF 読み込み（pdftotext を使う）\nprintf("\n");
fetch_report <- func(path) {\nprintf("\n");
  if (_report_cache[path]) return _report_cache[path] ;\nprintf("\n");
  out <- \"/tmp/tiny_report_\" + ('' + (rand() % 100000)) + \".txt\" ;\nprintf("\n");
  sh_exec(\"sh -c 'if [ -f \\\"\" + path + \"\\\" ]; then pdftotext \\\"\" + path + \"\\\" \\\"\" + out + \"\\\" 2>/dev/null || true; fi'\") ;\nprintf("\n");
  # read file content into string (インタープリタに load_report があれば簡略)\nprintf("\n");
  content <- \"\" ;\nprintf("\n");
  sh_exec(\"sh -c 'if [ -f \" + out + \" ]; then cat \" + out + \" > /tmp/tiny_last_report.txt; else echo -n \\\"\\\" > /tmp/tiny_last_report.txt; fi'\") ;\nprintf("\n");
  # tiny_lang に file_read 組み込みがなければ exec で cat 出力を input で受ける方法を代替\nprintf("\n");
  # ここはインタープリタの file_read がある想定:\nprintf("\n");
  if (file_exists(\"/tmp/tiny_last_report.txt\")) {\nprintf("\n");
    content <- file_read(\"/tmp/tiny_last_report.txt\") ;\nprintf("\n");
  } else {\nprintf("\n");
    # fallback: empty\nprintf("\n");
    content <- \"\" ;\nprintf("\n");
  }\nprintf("\n");
  _report_cache[path] <- content ;\nprintf("\n");
  return content ;\nprintf("\n");
}\nprintf("\n");
\nprintf("\n");
# Web fetch (http_get 組み込みがあればそれを使う／無ければ curl via exec)\nprintf("\n");
fetch_web <- func(url) {\nprintf("\n");
  if (_web_cache[url]) return _web_cache[url] ;\nprintf("\n");
  body <- \"\" ;\nprintf("\n");
  if (typeof(http_get) == \"function\") {\nprintf("\n");
    body <- http_get(url) ;\nprintf("\n");
  } else {\nprintf("\n");
    tmpf <- \"/tmp/tiny_fetch_\" + ('' + (rand() % 100000)) + \".html\" ;\nprintf("\n");
    sh_exec(\"sh -c 'curl -s -L \\\"\" + url + \"\\\" -o \" + tmpf + \" || true'\") ;\nprintf("\n");
    if (file_exists(tmpf)) {\nprintf("\n");
      # crude html->text via sed (shell)\nprintf("\n");
      txtf <- tmpf + \".txt\" ;\nprintf("\n");
      sh_exec(\"sh -c 'sed -e \\\"s/<script[^>]*>.*<\\\\/script>//gI\\\" -e \\\"s/<[^>]*>/ /g\\\" \" + tmpf + \" | tr -s \\\" \\\\n\\\\t\\\" \\\" \\\" > \" + txtf + \" || true'\") ;\nprintf("\n");
      if (file_exists(txtf)) { body <- file_read(txtf); } else { body <- \"\"; }\nprintf("\n");
    } else {\nprintf("\n");
      body <- \"\" ;\nprintf("\n");
    }\nprintf("\n");
  }\nprintf("\n");
  _web_cache[url] <- body ;\nprintf("\n");
  return body ;\nprintf("\n");
}\nprintf("\n");
\nprintf("\n");
# テキスト検索ユーティリティ（行ごとにキーワードを探す）\nprintf("\n");
find_lines <- func(text, keywords) {\nprintf("\n");
  out <- [] ;\nprintf("\n");
  if (text == \"\") return out ;\nprintf("\n");
  lines <- split(text, \"\\n\") ;\nprintf("\n");
  i <- 0 ;\nprintf("\n");
  while (i < len(lines)) {\nprintf("\n");
    ln <- lines[i] ;\nprintf("\n");
    low <- tolower(ln) ;\nprintf("\n");
    j <- 0 ;\nprintf("\n");
    found <- 0 ;\nprintf("\n");
    while (j < len(keywords)) {\nprintf("\n");
      if (index_of(low, tolower(keywords[j])) >= 0) { found <- 1; break; }\nprintf("\n");
      j <- j + 1 ;\nprintf("\n");
    }\nprintf("\n");
    if (found) push(out, ln) ;\nprintf("\n");
    i <- i + 1 ;\nprintf("\n");
  }\nprintf("\n");
  return out ;\nprintf("\n");
}\nprintf("\n");
\nprintf("\n");
# ナレッジベース構築（ノート、レポート、URL を結合して /tmp/tiny_kb.txt に保存）\nprintf("\n");
build_kb <- func(note_path, reports, urls) {\nprintf("\n");
  kb <- \"/tmp/tiny_kb.txt\" ;\nprintf("\n");
  sh_exec(\"sh -c 'rm -f \" + kb + \" ; touch \" + kb + \"'\") ;\nprintf("\n");
  # note\nprintf("\n");
  if (file_exists(note_path)) {\nprintf("\n");
    sh_exec(\"sh -c 'echo \\\"--- NOTE ---\\\" >> \" + kb + \" ; cat \" + note_path + \" >> \" + kb + \"'\") ;\nprintf("\n");
  }\nprintf("\n");
  # reports\nprintf("\n");
  i <- 0 ;\nprintf("\n");
  while (i < len(reports)) {\nprintf("\n");
    rp <- reports[i] ;\nprintf("\n");
    txt <- fetch_report(rp) ;\nprintf("\n");
    if (txt != \"\") {\nprintf("\n");
      # append via temp file\nprintf("\n");
      tmpn <- \"/tmp/tiny_rep_append.txt\" ;\nprintf("\n");
      sh_exec(\"sh -c 'echo \\\"\\\\n--- REPORT: \" + rp + \" ---\\\\n\\\" >> \" + kb + \"'\") ;\nprintf("\n");
      sh_exec(\"sh -c 'cat /dev/null > \" + tmpn + \"'\") ;\nprintf("\n");
      # write content to tmpn (assume file_write exists)\nprintf("\n");
      if (file_write) {\nprintf("\n");
        file_write(tmpn, txt) ;\nprintf("\n");
      } else {\nprintf("\n");
        # fallback: use echo via here-doc (escape naive)\nprintf("\n");
        sh_exec(\"sh -c 'cat > \" + tmpn + \" <<EOF\\n\" + txt + \"\\nEOF'\") ;\nprintf("\n");
      }\nprintf("\n");
      sh_exec(\"sh -c 'cat \" + tmpn + \" >> \" + kb + \"'\") ;\nprintf("\n");
    }\nprintf("\n");
    i <- i + 1 ;\nprintf("\n");
  }\nprintf("\n");
  # urls\nprintf("\n");
  i <- 0 ;\nprintf("\n");
  while (i < len(urls)) {\nprintf("\n");
    u <- urls[i] ;\nprintf("\n");
    txt <- fetch_web(u) ;\nprintf("\n");
    if (txt != \"\") {\nprintf("\n");
      tmpu <- \"/tmp/tiny_url_append.txt\" ;\nprintf("\n");
      if (file_write) {\nprintf("\n");
        file_write(tmpu, txt) ;\nprintf("\n");
      } else {\nprintf("\n");
        sh_exec(\"sh -c 'cat > \" + tmpu + \" <<EOF\\n\" + txt + \"\\nEOF'\") ;\nprintf("\n");
      }\nprintf("\n");
      sh_exec(\"sh -c 'echo \\\"\\\\n--- URL: \" + u + \" ---\\\\n\\\" >> \" + kb + \"'\") ;\nprintf("\n");
      sh_exec(\"sh -c 'cat \" + tmpu + \" >> \" + kb + \"'\") ;\nprintf("\n");
    }\nprintf("\n");
    i <- i + 1 ;\nprintf("\n");
  }\nprintf("\n");
  return kb ;\nprintf("\n");
}\nprintf("\n");
\nprintf("\n");
# 回答生成: OpenAI が使えるなら API 呼び出し、無ければローカル検索で抜粋生成\nprintf("\n");
answer_by_sources <- func(question, kb_path) {\nprintf("\n");
  qlow <- tolower(question) ;\nprintf("\n");
  # local fallback: extract keywords (split by spaces) and grep top matches\nprintf("\n");
  kws <- split(qlow, \" \") ;\nprintf("\n");
  candidates <- [] ;\nprintf("\n");
  if (file_exists(kb_path)) {\nprintf("\n");
    kbtext <- file_read(kb_path) ;\nprintf("\n");
    hits <- find_lines(kbtext, kws) ;\nprintf("\n");
    i <- 0 ;\nprintf("\n");
    while (i < len(hits) && i < 10) { push(candidates, hits[i]); i <- i + 1; }\nprintf("\n");
  }\nprintf("\n");
  if (len(candidates) > 0) {\nprintf("\n");
    # simple inline summary: join up to 5 candidates\nprintf("\n");
    out <- [] ;\nprintf("\n");
    i <- 0 ;\nprintf("\n");
    while (i < len(candidates) && i < 5) { push(out, candidates[i]); i <- i + 1; }\nprintf("\n");
    return join(out, \"\\n\") ;\nprintf("\n");
  }\nprintf("\n");
\nprintf("\n");
  # Try OpenAI if available\nprintf("\n");
  if (env(\"OPENAI_API_KEY\") != \"\") {\nprintf("\n");
    # build prompt file\nprintf("\n");
    pfile <- \"/tmp/tiny_prompt.txt\" ;\nprintf("\n");
    ctx <- \"\" ;\nprintf("\n");
    if (file_exists(kb_path)) { ctx <- substr(file_read(kb_path), 0, 4000); } # trim\nprintf("\n");
    prompt <- \"Context:\\\\n\" + ctx + \"\\\\n\\\\nQuestion: \" + question + \"\\\\nAnswer concisely.\" ;\nprintf("\n");
    # write prompt\nprintf("\n");
    if (file_write) {\nprintf("\n");
      file_write(pfile, prompt) ;\nprintf("\n");
    } else {\nprintf("\n");
      sh_exec(\"sh -c 'cat > \" + pfile + \" <<'EOF'\\n\" + prompt + \"\\nEOF'\") ;\nprintf("\n");
    }\nprintf("\n");
    payload <- \"/tmp/tiny_payload.json\" ;\nprintf("\n");
    sh_exec(\"sh -c 'cat > \" + payload + \" <<JSON\\n{\\\"model\\\":\\\"gpt-3.5-turbo\\\",\\\"messages\\\":[{\\\"role\\\":\\\"user\\\",\\\"content\\\":\\\"'$(sed \\\"s/\\\\\\\"/\\\\\\\\\\\\\\\"/g\\\" \" + pfile + \")'\\\"}],\\\"temperature\\\":0.2}\\nJSON'\") ;\nprintf("\n");
    # call OpenAI\nprintf("\n");
    res <- \"\" ;\nprintf("\n");
    sh_exec(\"sh -c 'curl -s -X POST https://api.openai.com/v1/chat/completions -H \\\"Authorization: Bearer \" + env(\"OPENAI_API_KEY\") + \"\\\" -H \\\"Content-Type: application/json\\\" -d @\" + payload + \" -o /tmp/tiny_openai_resp.json || true'\") ;\nprintf("\n");
    if (file_exists(\"/tmp/tiny_openai_resp.json\")) {\nprintf("\n");
      if (file_read) {\nprintf("\n");
        jtxt <- file_read(\"/tmp/tiny_openai_resp.json\") ;\nprintf("\n");
        # attempt to extract via naive string search for \"content\"\nprintf("\n");
        # (better: use jq; here do simple parse)\nprintf("\n");
        pos <- index_of(jtxt, \"\\\"content\\\"\") ;\nprintf("\n");
        if (pos >= 0) {\nprintf("\n");
          # extract substring after \"content\":\nprintf("\n");
          subtxt <- substr(jtxt, pos + 9) ;\nprintf("\n");
          # crude trim quotes\nprintf("\n");
          # find first quote\nprintf("\n");
          q1 <- index_of(subtxt, \"\\\"\") ;\nprintf("\n");
          if (q1 >= 0) {\nprintf("\n");
            sub2 <- substr(subtxt, q1+1) ;\nprintf("\n");
            q2 <- index_of(sub2, \"\\\"\") ;\nprintf("\n");
            if (q2 >= 0) {\nprintf("\n");
              res <- substr(sub2, 0, q2) ;\nprintf("\n");
            } else { res <- sub2; }\nprintf("\n");
          } else { res <- subtxt; }\nprintf("\n");
        } else {\nprintf("\n");
          res <- jtxt ;\nprintf("\n");
        }\nprintf("\n");
      } else {\nprintf("\n");
        res <- \"\" ;\nprintf("\n");
      }\nprintf("\n");
    }\nprintf("\n");
    if (res != \"\") return res ;\nprintf("\n");
  }\nprintf("\n");
\nprintf("\n");
  # 最終フォールバック\nprintf("\n");
  return \"No relevant content found. Please add report files or URLs using the /use command.\" ;\nprintf("\n");
}\nprintf("\n");
\nprintf("\n");
# コマンド: /edit -> vim でノート編集（Vim のノーマル/インサートをそのまま利用）\nprintf("\n");
#         /use urls=... reports=... -> セッション設定\nprintf("\n");
#         /build -> ナレッジベース構築\nprintf("\n");
#         /ask <question> -> 質問\nprintf("\n");
#         quit or exit -> 終了\nprintf("\n");
\nprintf("\n");
note_file <- \"assistant_note.txt\" ;\nprintf("\n");
\nprintf("\n");
# ensure note exists\nprintf("\n");
if (!file_exists(note_file)) {\nprintf("\n");
  if (file_write) { file_write(note_file, \"# assistant note\\n\"); } else { sh_exec(\"sh -c 'echo \\\"# assistant note\\\" > \" + note_file + \"'\"); }\nprintf("\n");
}\nprintf("\n");
\nprintf("\n");
print(\"Commands: /edit  /use urls=... reports=...  /build  /ask <question>  quit\") ;\nprintf("\n");
\nprintf("\n");
while (1) {\nprintf("\n");
  line <- input(\"You: \") ;\nprintf("\n");
  if (!line) break ;\nprintf("\n");
  if (line == \"quit\" || line == \"exit\") { print(\"Bot: Bye\"); break; }\nprintf("\n");
\nprintf("\n");
  if (substr(line,0,6) == \"/edit \") {\nprintf("\n");
    # allow \"/edit note\" or plain \"/edit\"\nprintf("\n");
    sh_exec(\"sh -c '${EDITOR:-vim} \" + note_file + \"'\") ;\nprintf("\n");
    print(\"Note saved: \" + note_file) ;\nprintf("\n");
    continue ;\nprintf("\n");
  }\nprintf("\n");
\nprintf("\n");
  if (line == \"/edit\") {\nprintf("\n");
    sh_exec(\"sh -c '${EDITOR:-vim} \" + note_file + \"'\") ;\nprintf("\n");
    print(\"Note saved: \" + note_file) ;\nprintf("\n");
    continue ;\nprintf("\n");
  }\nprintf("\n");
\nprintf("\n");
  if (substr(line,0,5) == \"/use \") {\nprintf("\n");
    args <- substr(line,6) ;\nprintf("\n");
    # parse urls= and reports=\nprintf("\n");
    session_urls <- [] ; session_reports <- [] ;\nprintf("\n");
    parts <- split(args, \" \") ;\nprintf("\n");
    i <- 0 ;\nprintf("\n");
    while (i < len(parts)) {\nprintf("\n");
      p <- parts[i] ;\nprintf("\n");
      if (substr(p,0,5) == \"urls=\") {\nprintf("\n");
        ustr <- substr(p,6) ;\nprintf("\n");
        us <- split(ustr, \",\") ;\nprintf("\n");
        j <- 0 ; while (j < len(us)) { push(session_urls, us[j]); j <- j + 1; }\nprintf("\n");
      } else if (substr(p,0,8) == \"reports=\") {\nprintf("\n");
        rstr <- substr(p,9) ;\nprintf("\n");
        rs <- split(rstr, \",\") ;\nprintf("\n");
        j <- 0 ; while (j < len(rs)) { push(session_reports, rs[j]); j <- j + 1; }\nprintf("\n");
      }\nprintf("\n");
      i <- i + 1 ;\nprintf("\n");
    }\nprintf("\n");
    print(\"Configured. URLs: \" + join(session_urls, \", \") + \"  Reports: \" + join(session_reports, \", \")) ;\nprintf("\n");
    continue ;\nprintf("\n");
  }\nprintf("\n");
\nprintf("\n");
  if (line == \"/build\") {\nprintf("\n");
    kbpath <- build_kb(note_file, session_reports, session_urls) ;\nprintf("\n");
    print(\"Knowledge base built at \" + kbpath) ;\nprintf("\n");
    continue ;\nprintf("\n");
  }\nprintf("\n");
\nprintf("\n");
  if (substr(line,0,5) == \"/ask \") {\nprintf("\n");
    q <- substr(line,6) ;\nprintf("\n");
    if (!file_exists(\"/tmp/tiny_kb.txt\")) {\nprintf("\n");
      print(\"KB not found. Run /build first.\") ;\nprintf("\n");
      continue ;\nprintf("\n");
    }\nprintf("\n");
    ans <- answer_by_sources(q, \"/tmp/tiny_kb.txt\") ;\nprintf("\n");
    print(\"Bot: \" + ans) ;\nprintf("\n");
    continue ;\nprintf("\n");
  }\nprintf("\n");
\nprintf("\n");
  # simple free question: auto build KB from existing session and answer\nprintf("\n");
  if (!session_urls) session_urls <- [] ;\nprintf("\n");
  if (!session_reports) session_reports <- [] ;\nprintf("\n");
  # build KB temp for single-shot if not exists\nprintf("\n");
  if (!file_exists(\"/tmp/tiny_kb.txt\")) {\nprintf("\n");
    build_kb(note_file, session_reports, session_urls) ;\nprintf("\n");
  }\nprintf("\n");
  ans <- answer_by_sources(line, \"/tmp/tiny_kb.txt\") ;\nprintf("\n");
  print(\"Bot: \" + ans) ;\nprintf("\n");
}\nprintf("\n");
