  s := Shikijuu.new("ホノカグラ", Element.HONOO, SceneKind.VOLCANO, 50, 65, 45, 55)
  s.learn(mv("ひのこ", Element.HONOO, 40, "火の粉を飛ばす"))
  s.learn(mv("かえんほうしゃ", Element.HONOO, 65, "灼熱の炎を吐く"))
  return s
}

func grass_KUSAmochi() := block {
  s := Shikijuu.new("クサモチ", Element.NORMAL, SceneKind.GRASS, 52, 50, 50, 48)
  s.learn(mv("たいあたり", Element.NORMAL, 40, "体ごとぶつかる"))
  s.learn(mv("でんこうせっか", Element.NORMAL, 40, "先制の一撃"))
  return s
}

func snow_YUKINKO() := block {
  s := Shikijuu.new("ユキンコ", Element.KOORI, SceneKind.SNOW, 46, 48, 50, 52)
  s.learn(mv("こなゆき", Element.KOORI, 40, "冷たい粉雪"))
  s.learn(mv("こおりのつぶて", Element.KOORI, 40, "氷の礫で先制"))
