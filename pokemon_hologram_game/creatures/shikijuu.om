func night_YOInoKAGE() := block {
  s := Shikijuu.new("ヨイノカゲ", Element.GHOST, SceneKind.NIGHT, 44, 62, 44, 60)
  s.learn(mv("したでなめる", Element.GHOST, 30, "影で舐め麻痺させる"))
  s.learn(mv("シャドーボール", Element.GHOST, 65, "影の弾を放つ"))
  return s
}
