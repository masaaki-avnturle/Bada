<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of BadaGPT.
     ワークフロー (badagpt-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_gpt/index.html) を差し込みます。
     アプリはオフラインで動き、通信は行いません。 -->
<widget id="io.github.masaaki_avnturle.badagpt" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>BadaGPT</name>
  <description>BadaGPT — 数学の予想を、計算で確かめられる範囲で調べる対話アプリ (ζ 零点の数値検証 / 深リーマン予想の証拠 / 擬似量子コンピュータによる反例探索 / 数学的帰納法と証明の修正 / Jones 暗号による封印 / PatchGuard)</description>
  <author href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application/activity">
      <activity android:resizeableActivity="true" android:windowSoftInputMode="adjustResize" />
    </edit-config>
  </platform>
</widget>
