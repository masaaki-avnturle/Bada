{
  "name": "bada-gpt",
  "productName": "BadaGPT",
  "version": "1.0.0",
  "description": "BadaGPT — a chat app that examines mathematical conjectures as far as computation can check them: numerical verification of zeta zeros, Deep Riemann Hypothesis evidence, counterexample search on a pseudo-quantum computer, exact induction with proof repair, Jones-cipher sealed certificates and a PatchGuard gate. Open conjectures are always reported as open. Self-contained offline HTML app.",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.badagpt",
    "productName": "BadaGPT",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaGPT-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "BadaGPT-${version}-portable.${ext}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Education",
      "artifactName": "BadaGPT-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
