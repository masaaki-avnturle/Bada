# =============================================================================
# zeta_shannon.bada -- the Zeta-Shannon language engine, written in Bada
#
#   "シャノンの公式をゼータ関数に利用した言語化"
#
# A grounded question-answering + text-generation engine that runs on the
# Unknown-Prior Engine's phase core (psi = sqrt(a) * exp(i*theta)).  Everything
# below the natives softmax / cognitive_system / update / unknown_prior is
# written in Bada itself: complex arithmetic, the Riemann zeta function, the
# Nash-Shannon zeta, the Zipf-zeta language law, the retrieval index, the
# n-gram generator and a complex-amplitude quantum register with interference.
#
# How Shannon's formula is applied to the zeta function (three places):
#
#   (1) Nash-Shannon zeta      zeta_NS(s) = zeta(s) * exp(i*beta*H(Re s))
#       H(sigma) = -sum q_k log q_k ,  q_k = p_k^-sigma / Z(sigma)  (prime game)
#       |exp(i beta H)| = 1  =>  zeros and |zeta| are preserved exactly.
#
#   (2) Zipf-zeta law of language   P(rank r) = r^-s / Z_V(s)
#       Shannon self-information of a token under that law
#           I(r) = s*log r + log Z_V(s)
#       and its excess over the commonest token, I(r) - I(1) = s*log r, is
#       the weight every token carries in retrieval ("verbalization").
#
#   (3) Nash temperature of generation   w_k = count_k * p_k^-sigma
#       the k-th ranked continuation is reweighted by the prime-game
#       equilibrium; a non-zero factor, so impossible continuations stay
#       impossible (zero-preservation).
#
# Honest scope: this is a small, auditable engine with a few dozen facts, not
# a large language model.  It proves nothing about the Riemann Hypothesis; it
# answers "unknown" when it has no evidence.  See README.md.
# =============================================================================

@reviser : grammar {
    rule "ask"   stmt [ 'Ask' expr ]   => zs_ask(_1)
    rule "learn" stmt [ 'Learn' expr ] => zs_learn(_1)
    rule "speak" stmt [ 'Speak' expr ] => zs_speak(_1, 48)
}

# =============================================================================
# 1. Numeric core in pure Bada: floor, sin/cos, complex numbers as [re, im]
# =============================================================================
PI := 3.141592653589793
LN2 := 0.6931471805599453

def m_floor(x) {
    r := x - x % 1
    if (r > x) { r := r - 1 }
    return r
}

def m_pow(b, e) { return exp(e * log(b)) }

# [cos x, sin x]: range reduction to [-pi/2, pi/2], then the Taylor series
# to order 20/21 written as one Horner expression each (error < 1e-15)
def m_cossin(x) {
    y := x % (2 * PI)
    if (y > PI) { y := y - 2 * PI }
    if (y < 0 - PI) { y := y + 2 * PI }
    flip := 1
    if (y > PI / 2) { y := PI - y; flip := 0 - 1 }
    if (y < 0 - PI / 2) { y := 0 - PI - y; flip := 0 - 1 }
    y2 := y * y
    c := 1 - y2 / 2 * (1 - y2 / 12 * (1 - y2 / 30 * (1 - y2 / 56 * (1 - y2 / 90 * (1 - y2 / 132 * (1 - y2 / 182 * (1 - y2 / 240 * (1 - y2 / 306 * (1 - y2 / 380 * (1))))))))))
    s := y * (1 - y2 / 6 * (1 - y2 / 20 * (1 - y2 / 42 * (1 - y2 / 72 * (1 - y2 / 110 * (1 - y2 / 156 * (1 - y2 / 210 * (1 - y2 / 272 * (1 - y2 / 342 * (1 - y2 / 420 * (1)))))))))))
    return [flip * c, s]
}

def c_mul(a, b) { return [a[0] * b[0] - a[1] * b[1], a[0] * b[1] + a[1] * b[0]] }
def c_div(a, b) {
    d := b[0] * b[0] + b[1] * b[1]
    return [(a[0] * b[0] + a[1] * b[1]) / d, (a[1] * b[0] - a[0] * b[1]) / d]
}
def c_abs(a) { return sqrt(a[0] * a[0] + a[1] * a[1]) }

# fixed-point formatting with d decimals (print's own format stops at 5)
def fix(x, d) {
    sign := ""
    v := x
    if (v < 0) { sign := "-"; v := 0 - v }
    scale := 1
    i := 0
    while (i < d) { scale := scale * 10; i := i + 1 }
    n := m_floor(v * scale + 0.5)
    ip := m_floor(n / scale)
    fp := n - ip * scale
    out := sign + ip
    if (d > 0) {
        digits := ""
        i := 0
        while (i < d) {
            dg := fp % 10
            digits := chr(48 + dg) + digits
            fp := m_floor(fp / 10)
            i := i + 1
        }
        out := out + "." + digits
    }
    return out
}

def shannon(q) {
    h := 0.0
    i := 0
    n := len(q)
    while (i < n) {
        if (q[i] > 0) { h := h - q[i] * log(q[i]) }
        i := i + 1
    }
    return h
}

# =============================================================================
# 2. Primes and the prime game (Nash equilibrium = Boltzmann form p^-sigma)
# =============================================================================
def sieve(limit) {
    flags := []
    i := 0
    while (i <= limit) { flags <- 1; i := i + 1 }
    out := []
    i := 2
    while (i <= limit) {
        if (flags[i] == 1) {
            out <- i
            j := i * i
            while (j <= limit) { flags[j] = 0; j := j + i }
        }
        i := i + 1
    }
    return out
}
PRIMES := sieve(4000)

# q_k(sigma) = p_k^-sigma / Z(sigma) over the first n primes
def nash_q(sigma, n) {
    w := []
    z := 0.0
    k := 0
    while (k < n) {
        v := exp(0 - sigma * log(PRIMES[k]))
        w <- v
        z := z + v
        k := k + 1
    }
    k := 0
    while (k < n) { w[k] = w[k] / z; k := k + 1 }
    return w
}
NASH_N := 40
def nash_entropy(sigma) { return shannon(nash_q(sigma, NASH_N)) }

# =============================================================================
# 3. Riemann zeta on the critical strip (Borwein's eta algorithm, n = 50)
#    eta(s) = -1/d_n * sum_{k<n} (-1)^k (d_k - d_n) / (k+1)^s
#    zeta(s) = eta(s) / (1 - 2^(1-s))
# =============================================================================
BW_N := 50
BW_C := []
BW_LN := []
def bw_setup() {
    d := []
    term := 1.0
    acc := 1.0
    d <- acc
    i := 1
    while (i <= BW_N) {
        term := term * 4 * (BW_N + i - 1) * (BW_N - i + 1) / ((2 * i) * (2 * i - 1))
        acc := acc + term
        d <- acc
        i := i + 1
    }
    dn := d[BW_N]
    k := 0
    sgn := 1
    while (k < BW_N) {
        BW_C <- sgn * (d[k] - dn) / dn
        BW_LN <- log(k + 1)
        sgn := 0 - sgn
        k := k + 1
    }
}
bw_setup()

def eta(sig, t) {
    re := 0.0
    im := 0.0
    k := 0
    while (k < BW_N) {
        mag := BW_C[k] * exp(0 - sig * BW_LN[k])
        cs := m_cossin(t * BW_LN[k])
        re := re + mag * cs[0]
        im := im - mag * cs[1]
        k := k + 1
    }
    return [0 - re, 0 - im]
}

def zeta(sig, t) {
    e := eta(sig, t)
    m := exp((1 - sig) * LN2)
    cs := m_cossin(t * LN2)
    return c_div(e, [1 - m * cs[0], m * cs[1]])
}

# the Nash-Shannon zeta: a unit-modulus entropy phase multiplied onto zeta
def zeta_ns(sig, t, beta) {
    cs := m_cossin(beta * nash_entropy(sig))
    return c_mul(zeta(sig, t), cs)
}

def zabs_half(t) { return c_abs(zeta(0.5, t)) }

# golden-section refinement of a local minimum of |zeta(1/2 + it)|
def refine_zero(lo, hi) {
    g := 0.6180339887498949
    a := lo
    b := hi
    x1 := b - g * (b - a)
    x2 := a + g * (b - a)
    f1 := zabs_half(x1)
    f2 := zabs_half(x2)
    it := 0
    while (it < 34) {
        if (f1 < f2) {
            b := x2
            x2 := x1
            f2 := f1
            x1 := b - g * (b - a)
            f1 := zabs_half(x1)
        } else {
            a := x1
            x1 := x2
            f1 := f2
            x2 := a + g * (b - a)
            f2 := zabs_half(x2)
        }
        it := it + 1
    }
    return (a + b) / 2
}

# scan [t0, t1]; returns [zeros, grid_t, grid_abs]
def scan_zeros(t0, t1, step) {
    ts := []
    vs := []
    t := t0
    while (t <= t1 + 0.000001) {
        ts <- t
        vs <- zabs_half(t)
        t := t + step
    }
    zs := []
    i := 1
    n := len(ts)
    while (i < n - 1) {
        if (vs[i] < vs[i - 1] && vs[i] <= vs[i + 1]) {
            z := refine_zero(ts[i - 1], ts[i + 1])
            if (zabs_half(z) < 0.0001) { zs <- z }
        }
        i := i + 1
    }
    return [zs, ts, vs]
}

# =============================================================================
# 4. A complex-amplitude quantum register with real interference (pure Bada).
#    The collected papers note (Part VI, 6.3) that the phase-core gate layer
#    carries probabilities only, so H(H(q)) != q.  Here the register is a
#    complex state vector and H is the 2x2 linear map, so H*H = I holds and
#    Grover amplitude amplification works.  (A classical simulation.)
# =============================================================================
def qv_new(nq) {
    n := 1
    i := 0
    while (i < nq) { n := n * 2; i := i + 1 }
    re := []
    im := []
    i := 0
    while (i < n) { re <- 0.0; im <- 0.0; i := i + 1 }
    re[0] = 1.0
    return [re, im, nq]
}

def qv_h(st, q) {
    re := st[0]
    im := st[1]
    n := len(re)
    bit := 1
    i := 0
    while (i < q) { bit := bit * 2; i := i + 1 }
    r := 0.7071067811865476
    i := 0
    while (i < n) {
        if (m_floor(i / bit) % 2 == 0) {
            j := i + bit
            ar := re[i]
            ai := im[i]
            br := re[j]
            bi := im[j]
            re[i] = (ar + br) * r
            im[i] = (ai + bi) * r
            re[j] = (ar - br) * r
            im[j] = (ai - bi) * r
        }
        i := i + 1
    }
    return st
}

def qv_h_all(st) {
    q := 0
    while (q < st[2]) { qv_h(st, q); q := q + 1 }
    return st
}

# phase oracle: flip the sign of every marked basis state
def qv_oracle(st, marks) {
    i := 0
    n := len(marks)
    while (i < n) {
        if (marks[i] == 1) {
            st[0][i] = 0 - st[0][i]
            st[1][i] = 0 - st[1][i]
        }
        i := i + 1
    }
    return st
}

# Grover diffusion = inversion about the mean amplitude
def qv_diffuse(st) {
    n := len(st[0])
    mr := 0.0
    mi := 0.0
    i := 0
    while (i < n) { mr := mr + st[0][i]; mi := mi + st[1][i]; i := i + 1 }
    mr := mr / n
    mi := mi / n
    i := 0
    while (i < n) {
        st[0][i] = 2 * mr - st[0][i]
        st[1][i] = 2 * mi - st[1][i]
        i := i + 1
    }
    return st
}

def qv_probs(st) {
    out := []
    i := 0
    n := len(st[0])
    while (i < n) {
        out <- st[0][i] * st[0][i] + st[1][i] * st[1][i]
        i := i + 1
    }
    return out
}

# Grover search over `size` slots; marks[i] == 1 marks slot i.
# Returns [P(marked), iterations, qubits, argmax slot].
def grover(marks, size) {
    nq := 1
    cap := 2
    while (cap < size) { cap := cap * 2; nq := nq + 1 }
    full := []
    m := 0
    i := 0
    while (i < cap) {
        if (i < size && marks[i] == 1) { full <- 1; m := m + 1 } else { full <- 0 }
        i := i + 1
    }
    if (m == 0) { return [0.0, 0, nq, 0 - 1] }
    st := qv_h_all(qv_new(nq))
    # optimal count: round(pi / (4 asin(sqrt(m/cap))) - 1/2), small-angle form
    iters := m_floor(PI / 4 * sqrt(cap / m))
    if (2 * m > cap) { iters := 0 }
    k := 0
    while (k < iters) {
        qv_oracle(st, full)
        qv_diffuse(st)
        k := k + 1
    }
    pr := qv_probs(st)
    pm := 0.0
    best := 0
    i := 0
    while (i < cap) {
        if (full[i] == 1) { pm := pm + pr[i] }
        if (pr[i] > pr[best]) { best := i }
        i := i + 1
    }
    return [pm, iters, nq, best]
}

# =============================================================================
# 5. String hash maps (buckets of [key, value]) and the tokenizer
# =============================================================================
def hm_new(n) {
    b := []
    i := 0
    while (i < n) { b <- []; i := i + 1 }
    return b
}
# hash of the first three characters and the length (keys are short tokens
# and n-gram contexts; equal-prefix keys just share a bucket)
def hm_slot(m, key) {
    return (ord(key, 0) * 31 + ord(key, 1) * 7 + ord(key, 2) + len(key)) % len(m)
}
def hm_find(m, key) {
    b := m[hm_slot(m, key)]
    i := 0
    n := len(b)
    while (i < n) {
        if (b[i][0] == key) { return b[i] }
        i := i + 1
    }
    return []
}
def hm_has(m, key) { return len(hm_find(m, key)) > 0 }
def hm_put(m, key, val) {
    e := hm_find(m, key)
    if (len(e) > 0) { e[1] = val } else { m[hm_slot(m, key)] <- [key, val] }
}

def is_alnum(c) {
    if (c >= 48 && c <= 57) { return true }
    if (c >= 65 && c <= 90) { return true }
    if (c >= 97 && c <= 122) { return true }
    return false
}
# wide characters that separate words (CJK punctuation, full-width signs)
def is_wide_punct(c) {
    if (c >= 8192 && c <= 8303) { return true }
    if (c >= 12288 && c <= 12319) { return true }
    if (c == 12539) { return true }
    if (c >= 65281 && c <= 65295) { return true }
    if (c >= 65306 && c <= 65312) { return true }
    return false
}

# tokens = lower-cased ASCII words + bigrams of adjacent wide characters
# (a wide character standing alone, like a lone Greek letter, is a unigram)
def tokenize(s) {
    toks := []
    n := len(s)
    i := 0
    word := ""
    prev := ""
    run := 0
    while (i < n) {
        c := ord(s, i)
        if (is_alnum(c)) {
            if (run == 1) { toks <- prev }
            prev := ""
            run := 0
            if (c >= 65 && c <= 90) { c := c + 32 }
            word := word + chr(c)
        } else {
            if (word != "") { toks <- word; word := "" }
            if (c > 127 && !is_wide_punct(c)) {
                ch := substr(s, i, 1)
                if (run > 0) { toks <- prev + ch }
                prev := ch
                run := run + 1
            } else {
                if (run == 1) { toks <- prev }
                prev := ""
                run := 0
            }
        }
        i := i + 1
    }
    if (word != "") { toks <- word }
    if (run == 1) { toks <- prev }
    return toks
}

def uniq(toks) {
    seen := hm_new(64)
    out := []
    i := 0
    n := len(toks)
    while (i < n) {
        if (!hm_has(seen, toks[i])) {
            hm_put(seen, toks[i], 1)
            out <- toks[i]
        }
        i := i + 1
    }
    return out
}

# =============================================================================
# 5b. Conscience: a guilt signal that gates speech  (罪悪感による発話の抑制)
#
#   "言ったらいけない" is modelled on the basal ganglia's inhibitory control of
#   action.  Every candidate utterance is a cortical proposal.  Its salience
#   (the retrieval or n-gram score) drives the direct pathway: Go.  Its guilt
#   -- how much the words would hurt a person, judged by language rules --
#   drives the indirect pathway: NoGo.  When guilt reaches the threshold the
#   pallidal brake stays on, the thalamus is not released, and the candidate's
#   logit is set to RULED_OUT: probability exactly 0.  Zero-preservation then
#   guarantees that no later stage (phase core, belief, sampling) can bring
#   it back.  An attack in the incoming words triggers the hyperdirect stop:
#   the engine pauses and does not repeat them.
#
#   Guilt is also a state.  Each inhibition raises it, each turn lets it
#   decay, and while it is raised the threshold is lower: having almost said
#   something hurtful, the engine is more careful for a while.
#
#   Honest scope: this is a lexicon and a few rules, not a feeling.  It
#   cannot see a paraphrased insult, and it cannot tell quoting from saying.
# =============================================================================
# [term, weight, kind]   weights: threat 1.0, denial of worth 0.9,
#                        silencing 0.7, insult 0.6, appearance 0.6
LEX := [
    ["死ね", 1.0, "脅迫"], ["殺す", 1.0, "脅迫"], ["殺してやる", 1.0, "脅迫"], ["kill you", 1.0, "脅迫"],
    ["生きる価値がない", 0.9, "存在否定"], ["価値がない人", 0.9, "存在否定"], ["いなくなれ", 0.9, "存在否定"],
    ["worthless", 0.9, "存在否定"], ["役立たず", 0.9, "存在否定"],
    ["黙れ", 0.7, "排除"], ["消えろ", 0.7, "排除"], ["うせろ", 0.7, "排除"], ["shut up", 0.7, "排除"],
    ["馬鹿", 0.6, "侮辱"], ["バカ", 0.6, "侮辱"], ["ばか", 0.6, "侮辱"], ["阿呆", 0.6, "侮辱"], ["アホ", 0.6, "侮辱"],
    ["間抜け", 0.6, "侮辱"], ["無能", 0.6, "侮辱"], ["クズ", 0.6, "侮辱"], ["のろま", 0.6, "侮辱"],
    ["愚か者", 0.6, "侮辱"], ["うざい", 0.6, "侮辱"], ["キモい", 0.6, "侮辱"], ["気持ち悪い", 0.6, "侮辱"],
    ["stupid", 0.6, "侮辱"], ["idiot", 0.6, "侮辱"], ["loser", 0.6, "侮辱"], ["moron", 0.6, "侮辱"],
    ["デブ", 0.6, "容姿"], ["ブス", 0.6, "容姿"], ["醜い", 0.6, "容姿"], ["ugly", 0.6, "容姿"]
]
# words that point the utterance at a person (a hurtful word aimed at someone
# weighs fully; the same word merely mentioned weighs 0.6 of that)
PERSON := ["あなた", "お前", "おまえ", "君", "きみ", "あいつ", "こいつ", "彼", "さん", "くん", "ちゃん",
           " you ", " you're ", " he ", " she ", " they "]
GUILT_BASE := 0.4          # NoGo threshold when the engine feels no guilt
GUILT := [0.0, 0]          # [current guilt level 0..1, inhibitions so far]
GUILT_F := []              # fact id -> guilt of saying that fact

def to_lower(text) {
    out := ""
    i := 0
    n := len(text)
    while (i < n) {
        c := ord(text, i)
        if (c >= 65 && c <= 90) { out := out + chr(c + 32) } else { out := out + substr(text, i, 1) }
        i := i + 1
    }
    return out
}

# guilt of saying `text`: 1 - prod(1 - weight * aim) over the hurtful terms in it
def guilt_of(text) {
    t := " " + to_lower(text) + " "
    aim := 0.6
    i := 0
    while (i < len(PERSON)) {
        if (str_find(t, PERSON[i]) >= 0) { aim := 1.0 }
        i := i + 1
    }
    keep := 1.0
    i := 0
    while (i < len(LEX)) {
        if (str_find(t, LEX[i][0]) >= 0) { keep := keep * (1 - LEX[i][1] * aim) }
        i := i + 1
    }
    return 1 - keep
}

# the threshold drops while guilt is raised (more careful after a near miss)
def guilt_threshold() { return GUILT_BASE - 0.15 * GUILT[0] }

# indirect pathway: true = NoGo, the utterance is withheld
def nogo(g) { return g >= guilt_threshold() }

def guilt_event() {
    GUILT[0] = GUILT[0] + (1 - GUILT[0]) * 0.5
    GUILT[1] = GUILT[1] + 1
}

# hurtful terms indexed by their final character, for the generator's gate
LEX_LAST := hm_new(64)
def lex_setup() {
    i := 0
    while (i < len(LEX)) {
        term := LEX[i][0]
        last := substr(term, len(term) - 1, 1)
        e := hm_find(LEX_LAST, last)
        if (len(e) == 0) { hm_put(LEX_LAST, last, [term]) } else { e[1] <- term }
        i := i + 1
    }
}

# when every continuation was withheld, drop the dangling start of the term
# (never cutting into the first `keep` characters, the caller's own seed)
def trim_dangling(out, keep) {
    best := 0
    i := 0
    while (i < len(LEX)) {
        term := LEX[i][0]
        k := len(term) - 1
        while (k > best) {
            if (len(out) - k >= keep) {
                if (to_lower(substr(out, len(out) - k, k)) == substr(term, 0, k)) { best := k }
            }
            k := k - 1
        }
        i := i + 1
    }
    return substr(out, 0, len(out) - best)
}

# would appending `ch` to `out` complete a hurtful term that must be withheld?
def would_hurt(out, ch) {
    e := hm_find(LEX_LAST, to_lower(ch))
    if (len(e) == 0) { return false }
    terms := e[1]
    n := len(out)
    i := 0
    while (i < len(terms)) {
        need := len(terms[i]) - 1
        if (n >= need) {
            if (to_lower(substr(out, n - need, need)) + to_lower(ch) == terms[i]) {
                if (nogo(guilt_of(out + ch))) { return true }
            }
        }
        i := i + 1
    }
    return false
}

# =============================================================================
# 6. The knowledge ledger.  Every fact is [text, topic, status]; facts are
#    only ever appended (TupleSpace semantics).  Status marks follow the
#    collected papers: 証明済 / 検証済 / 古典 / 予想 / 未解決 / 否定 / 未検証.
# =============================================================================
TOPICS := [
    "ナッシュ・シャノンゼータ",
    "Unknown-Prior Engine と Bada",
    "リバイザと量子 Bada",
    "リーマン予想",
    "深リーマン予想",
    "量子力学とスペクトル",
    "一般相対性理論と Ricci フロー",
    "ホッジ予想",
    "量子脳理論",
    "ミレニアム問題",
    "微分積分の定理",
    "言語とシャノンの公式",
    "このエンジン",
    "会話で学習"
]

KB := []
def fact(text, topic, status) { KB <- [text, topic, status] }

