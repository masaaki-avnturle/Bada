{
  "name": "bada-cppbuilder",
  "productName": "BadaCppBuilder",
  "version": "1.0.0",
  "description": "Bada C++Builder — an unofficial educational homage to the classic Inprise/Borland C++Builder RAD IDE, recreated as a self-contained HTML app (form designer + Object Inspector + component palette + C++-subset interpreter)",
  "author": "Masaaki Yamaguchi",
  "license": "MIT",
  "homepage": "https://github.com/masaaki-avnturle/Bada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "io.github.masaaki_avnturle.cppbuilder",
    "productName": "BadaCppBuilder",
    "publish": null,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BadaCppBuilder-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "artifactName": "BadaCppBuilder-${version}-${arch}.${ext}",
      "maintainer": "masaaki-avnturle"
    }
  }
}
