# player.bada — Bada 言語で書いた実写動画プレーヤーの制御プログラム
# ---------------------------------------------------------------
# bada_ruby の Interpreter と同じ演算子・名前空間文法で書かれ、
# アプリ内蔵の Bada インタプリタが実行時に解釈して <video> を駆動する。
#
#   set NAME = v          値を束縛
#   NAME <- "s"           左作用   π(χ,x)=[iπ,f(x)]
#   NAME -< v             多様体積分 ∬1/(x·log x)² dx_m
#   NAME >- NAME          右量子作用 e^{-x·log x}
#   Omega::push NAME as K  Akashic TupleSpace へ書き込み
#   print NAME            値を出力
#   Media::CMD ...        （拡張）動画トランスポート命令
#
# ── 定数（早送り/巻き戻しの秒数・速度・チャンネル）─────────────
set fwd    = 10        # 早送り（秒）
set back   = -10       # 巻き戻し（秒）
set rate   = 1.0       # 再生速度
set cursor = 0         # 現在のチャンネル番号

# ── 実行証跡：進行位置に大域的部分積分多様体の不変量を効かせる ──
cursor <- "global manifold transport"
cursor -< 1.0
cursor >- cursor
Omega::push cursor as transport_node
print cursor

# ── トランスポート命令（各ボタンのタップで1行ずつ実行される）──
#   ▶  : Media::play
#   ⏸  : Media::pause
#   ⏩  : Media::seek fwd
#   ⏪  : Media::seek back
#   ⏭  : Media::channel next
#   ⏮  : Media::channel prev
#   速度: Media::rate rate
