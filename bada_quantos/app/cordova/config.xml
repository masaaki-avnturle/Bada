<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada QuantOS (擬似量子OS).
     ワークフロー (quantos-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_quantos/index.html) を差し込みます。
     tel:/sms:/mailto: の allow-intent により、電話・SMS・メールの発信は
     端末の電話回線 (標準アプリ) へ委譲されます。 -->
<widget id="io.github.masaaki_avnturle.badaquantos" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BadaQuantOS</name>
  <description>Bada QuantOS — 擬似量子コンピュータ(集大成)のオペレーティングシステム。カーネルは生成AI。タブレット・スマートフォンの機能 (電話回線 / SMS / メール / カメラ / 時計 / 電卓 / メモ / ファイル / 連絡先) を、トポロジーの写像機構 (結び目の Kauffman ブラケット不変量 ↦ 量子レジスタ基底への単射写像) で移植</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <!-- 電話回線・SMS・メール・地図は端末 OS の標準機能へ委譲 -->
  <allow-intent href="tel:*" />
  <allow-intent href="sms:*" />
  <allow-intent href="mailto:*" />
  <allow-intent href="geo:*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
  </platform>
</widget>
