<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada QuantOS (擬似量子OS).
     ワークフロー (quantos-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = bada_quantos/index.html) を差し込みます。
     tel:/sms:/mailto: の allow-intent により、電話・SMS・メールの発信は
     端末の電話回線 (標準アプリ) へ委譲されます。 -->
<widget id="io.github.masaaki_avnturle.badaquantos" version="1.1.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>BadaQuantOS</name>
  <description>Bada QuantOS — 擬似量子コンピュータ(集大成)のオペレーティングシステム。カーネルは生成AI。タブレット・スマートフォンの機能 (電話回線 / SMS / メール / カメラ / 時計 / 電卓 / メモ / ファイル / 連絡先) を、トポロジーの写像機構 (結び目の Kauffman ブラケット不変量 ↦ 量子レジスタ基底への単射写像) で移植</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <!-- 電話回線・SMS・メール・地図は端末 OS の標準機能へ委譲 -->
  <allow-intent href="tel:*" />
  <allow-intent href="sms:*" />
  <allow-intent href="mailto:*" />
  <allow-intent href="geo:*" />
  <!-- インストール済みアプリの起動 + Play ストア (market:) -->
  <allow-intent href="market:*" />
  <allow-intent href="intent:*" />
  <allow-intent href="vnd.youtube:*" />
  <allow-intent href="line:*" />
  <allow-intent href="twitter:*" />
  <allow-intent href="instagram:*" />
  <allow-intent href="fb:*" />
  <allow-intent href="whatsapp:*" />
  <allow-intent href="googlegmail:*" />
  <allow-intent href="googlechrome:*" />
  <allow-intent href="spotify:*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <preference name="Orientation" value="default" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />

    <!-- ── Samsung フリーフォーム / マルチウィンドウ / DeX ──
         resizeableActivity: 分割画面・フリーフォームでのリサイズを許可 (API 24+)。
         configChanges にサイズ系を並べることで、ウィンドウをつまんで拡縮しても
         アクティビティが再生成されず、開いている窓の状態が保たれる。 -->
    <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application/activity">
      <activity android:resizeableActivity="true"
                android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|navigation|fontScale" />
    </edit-config>
    <!-- フリーフォームで開いたときの既定ウィンドウサイズと最小サイズ -->
    <config-file target="AndroidManifest.xml" parent="/manifest/application/activity">
      <layout android:defaultWidth="1080dp" android:defaultHeight="720dp"
              android:gravity="center" android:minWidth="360dp" android:minHeight="300dp" />
    </config-file>
    <!-- Samsung One UI / DeX 向けの宣言 -->
    <config-file target="AndroidManifest.xml" parent="/manifest/application">
      <meta-data android:name="com.samsung.android.supports.multiwindow" android:value="true" />
      <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="true" />
      <meta-data android:name="com.samsung.android.keepalive.density" android:value="true" />
    </config-file>
    <!-- DeX / 大画面・マウス&キーボード環境を必須にはしないが対応を宣言 -->
    <config-file target="AndroidManifest.xml" parent="/manifest">
      <uses-feature android:name="android.hardware.type.pc" android:required="false" />
    </config-file>
  </platform>
</widget>
