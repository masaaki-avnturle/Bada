<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config for the Android APK of Bada Music Studio (音楽制作ソフト / DAW).
     ワークフロー (musicstudio-app-build.yml) が cordova プロジェクトを作成し、
     この config.xml と ../www (自己完結アプリ = music_studio/index.html) を差し込みます。
     打ち込み・音色づくり・ミックスまで端末内で完結し、外部通信は行いません。 -->
<widget id="io.github.masaaki_avnturle.badamusicstudio" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>BadaMusicStudio</name>
  <description>Bada Music Studio — 音楽制作ソフト (DAW)。マルチトラックのアレンジ、ピアノロール、10 音源のステップシーケンサ、2 オシレータのシンセサイザ (ユニゾン / マルチモードフィルタ / ADSR ×2 / LFO)、ドライブ・EQ・コーラス・リバーブ・ディレイ、メーター付きミキサー、WAV (オフラインレンダリング) / MIDI / プロジェクト書き出し。依存ゼロ・単一 HTML・オフライン動作</description>
  <author email="masaaki.tabu4@gmail.com" href="https://github.com/masaaki-avnturle/Bada">Masaaki Yamaguchi</author>
  <content src="index.html" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="BackgroundColor" value="0xff0b0e14" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="AndroidWindowSplashScreenBackgroundColor" value="#0b0e14" />
  <preference name="Orientation" value="landscape" />
  <preference name="Fullscreen" value="false" />
  <platform name="android">
    <preference name="AndroidXEnabled" value="true" />
    <!-- マイク録音のための権限 (使わなければ要求されません) -->
    <config-file target="AndroidManifest.xml" parent="/manifest">
      <uses-permission android:name="android.permission.RECORD_AUDIO" />
    </config-file>
  </platform>
</widget>
